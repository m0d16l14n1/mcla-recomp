+}  // namespace
+#elif defined(__APPLE__)
+namespace {
+
+// macOS has no thread priorities an application can raise the Windows way (and the POSIX SCHED_FIFO one, which
+// set_priority uses, keeps a thread out of the QoS classes). What keeps a thread on time there is its QoS class:
+// user-interactive runs on the performance cores ahead of everything below it (levels 1 and 2). Level 3 also makes
+// it a time-constraint thread, as Core Audio's own threads are: every 5.33 ms (the game's audio frame, 256 samples
+// at 48 kHz) up to 1.5 ms of CPU, within the period. A thread that keeps using more is demoted by the kernel, so a
+// wrong figure costs the boost, not the machine. Runs on the thread itself: QoS can only be set from inside it.
+bool ApplyAppleAudioScheduling(int32_t level, const char* thread_name, std::string& what) {
+  if (level <= 0) {
+    return false;
+  }
+  const int qos = pthread_set_qos_class_self_np(QOS_CLASS_USER_INTERACTIVE, 0);
+  what = qos == 0 ? "QoS user-interactive" : "QoS NOT set (error " + std::to_string(qos) + ")";
+  bool ok = qos == 0;
+  if (level >= 3) {
+    mach_timebase_info_data_t timebase{};
+    mach_timebase_info(&timebase);
+    const auto ticks = [&](double ms) {
+      return uint32_t(ms * 1e6 * double(timebase.denom) / double(timebase.numer));
+    };
+    thread_time_constraint_policy_data_t policy{};
+    policy.period = ticks(16.0 / 3.0);
+    policy.computation = ticks(1.5);
+    policy.constraint = ticks(16.0 / 3.0);
+    policy.preemptible = 1;
+    const kern_return_t result =
+        thread_policy_set(pthread_mach_thread_np(pthread_self()), THREAD_TIME_CONSTRAINT_POLICY,
+                          reinterpret_cast<thread_policy_t>(&policy), THREAD_TIME_CONSTRAINT_POLICY_COUNT);
+    what += result == KERN_SUCCESS ? ", time-constraint (5.33 ms period, 1.5 ms computation)"
+                                   : ", time-constraint NOT set (error " + std::to_string(result) + ")";
+    ok = ok && result == KERN_SUCCESS;
+  }
+  if (ok) {
+    REXAPU_INFO("{}: {} (level {})", thread_name, what, level);
+  } else {
+    REXAPU_WARN("{}: {} (level {})", thread_name, what, level);
+  }
+  return ok;
+}
+
 }  // namespace
 #endif
 
