+// PrimitiveProcessor needs the common shared-memory range service. No uploads or write watches
+// are necessary for the no-copy buffer. Converted indices are invalidated at each draw below.
+class UnifiedMemory final : public SharedMemory {
+ public:
+  explicit UnifiedMemory(memory::Memory& memory) : SharedMemory(memory) { InitializeCommon(); }
+ private:
+  bool UploadRanges(const std::vector<std::pair<uint32_t, uint32_t>>&) override { return true; }
+};
+MTLPixelFormat ColorFormat(xenos::ColorRenderTargetFormat format) {
+  using F = xenos::ColorRenderTargetFormat;
+  switch (format) {
+    case F::k_8_8_8_8: case F::k_8_8_8_8_GAMMA: return MTLPixelFormatRGBA8Unorm;
+    case F::k_2_10_10_10: return MTLPixelFormatRGB10A2Unorm;
+    case F::k_2_10_10_10_FLOAT: case F::k_2_10_10_10_AS_10_10_10_10:
+    case F::k_2_10_10_10_FLOAT_AS_16_16_16_16: return MTLPixelFormatRGBA16Float;
+    case F::k_16_16: return MTLPixelFormatRG16Snorm;
+    case F::k_16_16_16_16: return MTLPixelFormatRGBA16Snorm;
+    case F::k_16_16_FLOAT: return MTLPixelFormatRG16Float;
+    case F::k_16_16_16_16_FLOAT: return MTLPixelFormatRGBA16Float;
+    case F::k_32_FLOAT: return MTLPixelFormatR32Float;
+    case F::k_32_32_FLOAT: return MTLPixelFormatRG32Float;
+    default: return MTLPixelFormatInvalid;
+  }
+}
+MTLBlendFactor BlendFactor(xenos::BlendFactor f) {
+  switch (uint32_t(f)) {
+    case 0: return MTLBlendFactorZero; case 1: return MTLBlendFactorOne;
+    case 4: return MTLBlendFactorSourceColor; case 5: return MTLBlendFactorOneMinusSourceColor;
+    case 6: return MTLBlendFactorSourceAlpha; case 7: return MTLBlendFactorOneMinusSourceAlpha;
+    case 8: return MTLBlendFactorDestinationColor; case 9: return MTLBlendFactorOneMinusDestinationColor;
+    case 10: return MTLBlendFactorDestinationAlpha; case 11: return MTLBlendFactorOneMinusDestinationAlpha;
+    case 12: return MTLBlendFactorBlendColor; case 13: return MTLBlendFactorOneMinusBlendColor;
+    case 14: return MTLBlendFactorBlendAlpha; case 15: return MTLBlendFactorOneMinusBlendAlpha;
+    case 16: return MTLBlendFactorSourceAlphaSaturated;
+    default: return MTLBlendFactorOne;
+  }
+}
+MTLBlendOperation BlendOp(xenos::BlendOp op) {
+  switch (uint32_t(op)) {
+    case 1: return MTLBlendOperationSubtract; case 2: return MTLBlendOperationMin;
+    case 3: return MTLBlendOperationMax; case 4: return MTLBlendOperationReverseSubtract;
+    default: return MTLBlendOperationAdd;
+  }
+}
+MTLStencilOperation StencilOp(uint32_t op) {
+  static const MTLStencilOperation ops[] = {MTLStencilOperationKeep, MTLStencilOperationZero,
+    MTLStencilOperationReplace, MTLStencilOperationIncrementClamp, MTLStencilOperationDecrementClamp,
+    MTLStencilOperationInvert, MTLStencilOperationIncrementWrap, MTLStencilOperationDecrementWrap};
+  return ops[op & 7];
+}
+// ResolveConstants in metal_resolve.h (MSL layout: uint2 x3, uint x6, float, then uint2 at offset 56).
+struct ResolveConstants {
+  uint32_t sx = 0, sy = 0, width = 0, height = 0, dx = 0, dy = 0, pitch = 0, address = 0, format = 0, endian = 0,
+      swap = 0, write_memory = 0;
+  float scale = 1.0f; uint32_t padding = 0;
+  uint32_t samples_x = 1, samples_y = 1, sample_select = 0, padding2 = 0;
+};
+static_assert(sizeof(ResolveConstants) == 72);
+template <typename T> void Key(std::string& key, T value) {
+  key.append(reinterpret_cast<const char*>(&value), sizeof(value));
+}
