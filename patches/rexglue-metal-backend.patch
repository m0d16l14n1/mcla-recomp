+++ b/src/graphics/metal/metal_fx4.h
@@ -0,0 +1,45 @@
+/** Metal 4 queues for the MetalFX effects. BSD-3-Clause, see LICENSE. */
+#pragma once
+#import <Metal/Metal.h>
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <initializer_list>
+#include <memory>
+
+namespace rex::graphics::metal {
+
+// metal_metal4 (on by default): whether the MetalFX effects (the temporal scaler, the frame interpolator, the
+// presenter's spatial scaler) are made and encoded with Metal 4 (MTL4FX*, macOS 26) where the device has them;
+// false is Metal 3 everywhere. The draws themselves are Metal 3 either way.
+bool MetalUseMetal4();
+
+// One effect's Metal 4 queue beside the backend's Metal 3 one. The effect's commands run between Metal 3 work: the
+// command buffer before them signals a shared event where it stands, the Metal 4 queue waits for that, runs them and
+// signals again, and the Metal 3 command buffer after them (the same one or a later one) waits for that. Metal 4
+// doesn't track residency: the textures a call names are put in the effect's residency set. One thread uses it.
+class MetalFx4 {
+ public:
+  // False: no Metal 4 here (or it's turned off); the effect uses Metal 3.
+  bool Init(id<MTLDevice> device, NSString* label) API_AVAILABLE(macos(26.0));
+  bool ready() const { return queue_ != nil; }
+  id<MTL4Compiler> compiler() const API_AVAILABLE(macos(26.0)) { return compiler_; }
+  void Encode(id<MTLCommandBuffer> before, id<MTLCommandBuffer> after, std::initializer_list<id<MTLTexture>> textures,
+              void (^encode)(id<MTL4CommandBuffer>)) API_AVAILABLE(macos(26.0));
+  // GPU time of the Metal 4 commands since the last call, in microseconds.
+  uint64_t TakeGpuUs() { return gpu_us_->exchange(0); }
+
+ private:
+  id queue_ = nil, compiler_ = nil, command_buffer_ = nil, residency_ = nil;  // MTL4CommandQueue, MTL4Compiler, ...
+  std::array<id, 3> allocators_{};                                             // MTL4CommandAllocator
+  std::array<uint64_t, 3> allocator_done_{};  // the event value after each allocator's last commands
+  uint32_t slot_ = 0;
+  id<MTLSharedEvent> event_ = nil;
+  uint64_t value_ = 0;
+  std::array<id<MTLTexture>, 8> resident_{};
+  NSString* label_ = nil;
+  std::shared_ptr<std::atomic<uint64_t>> gpu_us_ = std::make_shared<std::atomic<uint64_t>>(0);
+};
+
+}  // namespace rex::graphics::metal
diff --git a/src/graphics/metal/metal_fx4.mm b/src/graphics/metal/metal_fx4.mm
new file mode 100644
--- /dev/null
+++ b/src/graphics/metal/metal_fx4.mm
@@ -0,0 +1,92 @@
+/** Metal 4 queues for the MetalFX effects. BSD-3-Clause, see LICENSE. */
+#include "metal_fx4.h"
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+REXCVAR_DEFINE_BOOL(metal_metal4, true, "GPU/Metal",
+                    "Metal 4 (macOS 26, a device of the Metal 4 family): the draws on a Metal 4 queue "
+                    "(metal_metal4_draws) and the MetalFX effects (temporal scaler, frame interpolator, the presenter's "
+                    "spatial scaler) made and encoded with Metal 4 (MTL4FX*); false: Metal 3 everywhere (MTLFX*), the "
+                    "earlier path, kept to compare with")
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+
+namespace rex::graphics::metal {
+
+bool MetalUseMetal4() {
+  if (@available(macOS 26.0, *)) return REXCVAR_GET(metal_metal4);
+  return false;
+}
+
+bool MetalFx4::Init(id<MTLDevice> device, NSString* label) {
+  if (queue_) return true;
+  if (!MetalUseMetal4() || !device) return false;
+  NSError* error = nil;
+  auto queue_desc = [MTL4CommandQueueDescriptor new];
+  queue_desc.label = label;
+  id<MTL4CommandQueue> queue = [device newMTL4CommandQueueWithDescriptor:queue_desc error:&error];
+  id<MTL4Compiler> compiler = [device newCompilerWithDescriptor:[MTL4CompilerDescriptor new] error:&error];
+  auto residency_desc = [MTLResidencySetDescriptor new];
+  residency_desc.label = label;
+  residency_desc.initialCapacity = resident_.size();
+  id<MTLResidencySet> residency = [device newResidencySetWithDescriptor:residency_desc error:&error];
+  id<MTL4CommandBuffer> command_buffer = [device newCommandBuffer];
+  bool allocators = true;
+  for (auto& a : allocators_) allocators &= (a = [device newCommandAllocator]) != nil;
+  event_ = [device newSharedEvent];
+  if (!queue || !compiler || !residency || !command_buffer || !allocators || !event_) {
+    REXGPU_WARN("Metal 4: no queue for {} ({}); Metal 3 instead", label.UTF8String,
+                error ? error.localizedDescription.UTF8String : "?");
+    return false;
+  }
+  queue_ = queue; compiler_ = compiler; residency_ = residency; command_buffer_ = command_buffer; label_ = label;
+  return true;
+}
+
+void MetalFx4::Encode(id<MTLCommandBuffer> before, id<MTLCommandBuffer> after,
+                      std::initializer_list<id<MTLTexture>> textures, void (^encode)(id<MTL4CommandBuffer>)) {
+  id<MTL4CommandQueue> queue = queue_;
+  id<MTLResidencySet> residency = residency_;
+  // The residency set follows the textures (made again with a size): the allocations, not their views.
+  std::array<id<MTLTexture>, 8> resident{};
+  size_t count = 0;
+  for (id<MTLTexture> t : textures) {
+    while (t.parentTexture) t = t.parentTexture;
+    if (t && count < resident.size()) resident[count++] = t;
+  }
+  if (resident != resident_) {
+    [residency removeAllAllocations];
+    for (size_t i = 0; i < count; ++i) [residency addAllocation:resident[i]];
+    [residency commit];
+    resident_ = resident;
+  }
+  const uint64_t ready = ++value_;
+  [before encodeSignalEvent:event_ value:ready];
+  // An allocator is reset once the GPU is done with its last commands (two uses back).
+  const uint32_t slot = slot_;
+  slot_ = (slot_ + 1) % uint32_t(allocators_.size());
+  if (event_.signaledValue < allocator_done_[slot]) [event_ waitUntilSignaledValue:allocator_done_[slot] timeoutMS:1000];
+  id<MTL4CommandAllocator> allocator = allocators_[slot];
+  [allocator reset];
+  id<MTL4CommandBuffer> command_buffer = command_buffer_;
+  [command_buffer beginCommandBufferWithAllocator:allocator];
+  command_buffer.label = label_;
+  [command_buffer useResidencySet:residency];
+  encode(command_buffer);
+  [command_buffer endCommandBuffer];
+  [queue waitForEvent:event_ value:ready];
+  auto options = [MTL4CommitOptions new];
+  auto gpu_us = gpu_us_;
+  [options addFeedbackHandler:^(id<MTL4CommitFeedback> feedback) {
+    if (!feedback.error && feedback.GPUEndTime > feedback.GPUStartTime)
+      gpu_us->fetch_add(uint64_t((feedback.GPUEndTime - feedback.GPUStartTime) * 1e6), std::memory_order_relaxed);
+  }];
+  id<MTL4CommandBuffer> commits[1] = {command_buffer};
+  [queue commit:commits count:1 options:options];
+  const uint64_t done = ++value_;
+  [queue signalEvent:event_ value:done];
+  allocator_done_[slot] = done;
+  [after encodeWaitForEvent:event_ value:done];
+}
+
+}  // namespace rex::graphics::metal
diff --git a/src/graphics/metal/metal_gpu.h b/src/graphics/metal/metal_gpu.h
new file mode 100644
--- /dev/null
+++ b/src/graphics/metal/metal_gpu.h
@@ -0,0 +1,261 @@
+/** Native Metal draw path: the command stream, on Metal 3 or Metal 4. BSD-3-Clause, see LICENSE. */
+#pragma once
+#import <Metal/Metal.h>
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <unordered_map>
+#include <vector>
+
+namespace rex::graphics::metal {
+
+// metal_metal4_draws: the draws, resolves, texture loads, EDRAM transfers, temporal AA and the front buffer's
+// copy recorded with Metal 4 (macOS 26, with metal_metal4) on a Metal 4 queue; false: Metal 3, as before.
+bool MetalUseMetal4Draws(id<MTLDevice> device);
+
+class GpuQueue;
+struct GpuRecording;
+struct GpuResident;
+
+// The stage a binding is for: a render encoder's fragment or vertex stage (the order of MetalDraw's `vertex`
+// flag), or a compute encoder.
+enum class GpuStage : uint8_t { kFragment = 0, kVertex = 1, kCompute = 2 };
+
+// What a committed command buffer reports when the GPU is done with it.
+struct GpuDone {
+  double gpu_start = 0, gpu_end = 0;
+  NSError* error = nil;
+};
+using GpuDoneBlock = void (^)(const GpuDone& done);
+
+// A render, compute or blit encoder. Metal 3: the encoder itself, each call forwarded. Metal 4: a render encoder
+// with the command buffer's argument tables, or the command buffer's one compute encoder, which the compute and
+// blit work between two render passes shares (each of its ops after a barrier on the ones before: a Metal 3
+// compute encoder's serial order); bindings are writes into argument tables, inline bytes go to the queue's
+// transient buffers, and every resource named is made resident and kept until the GPU is done with it.
+class GpuEncoder {
+ public:
+  GpuEncoder() = default;
+  explicit operator bool() const { return enc_ != nil; }
+  // Identifies the encoder while it is open (a later one may reuse the address).
+  void* key() const { return (__bridge void*)enc_; }
+  id<MTLRenderCommandEncoder> metal3_render() const { return rec_ ? nil : (id<MTLRenderCommandEncoder>)enc_; }
+  // Metal 4: whether this render encoder's bindings are those `previous` left: both in the same command buffer
+  // (whose argument tables they share) with no render encoder between them. Metal 3: never.
+  bool ContinuesBindingsOf(const GpuEncoder& previous) const {
+    return rec_ && rec_ == previous.rec_ && recording_ == previous.recording_ && render_ == previous.render_ + 1;
+  }
+  void SetLabel(NSString* label);
+  void End();
+
+  // Render.
+  void SetPipeline(id<MTLRenderPipelineState> pipeline);
+  void SetDepthStencil(id<MTLDepthStencilState> state);
+  void SetStencilRef(uint32_t front, uint32_t back);
+  void SetStencilRef(uint32_t value) { SetStencilRef(value, value); }
+  void SetDepthClip(MTLDepthClipMode mode);
+  void SetViewport(const MTLViewport& viewport);
+  void SetScissor(const MTLScissorRect& rect);
+  void SetWinding(MTLWinding winding);
+  void SetCull(MTLCullMode mode);
+  void SetBlendColor(float r, float g, float b, float a);
+  void SetVisibility(MTLVisibilityResultMode mode, NSUInteger offset);
+  void Draw(MTLPrimitiveType type, uint32_t start, uint32_t count);
+  void DrawIndexed(MTLPrimitiveType type, uint32_t count, MTLIndexType index_type, id<MTLBuffer> buffer,
+                   NSUInteger offset);
+
+  // Bindings (the stage is ignored by compute encoders).
+  void SetBuffer(GpuStage stage, id<MTLBuffer> buffer, NSUInteger offset, uint32_t index);
+  void SetBufferOffset(GpuStage stage, NSUInteger offset, uint32_t index);
+  void SetBytes(GpuStage stage, const void* data, size_t size, uint32_t index);
+  void SetTexture(GpuStage stage, id<MTLTexture> texture, uint32_t index);
+  // Metal 4: a view in a texture view pool, by its resource ID. `key` is its identity for the table shadow (not an
+  // object pointer: MetalViews4::Key, bit 63 set); `texture` is the texture it views, made resident and kept until
+  // the GPU is done, as SetTexture does for a texture. Metal 3: not used (no pools).
+  void SetTextureView(GpuStage stage, MTLResourceID view, uint64_t key, id<MTLTexture> texture, uint32_t index);
+  void SetSampler(GpuStage stage, id<MTLSamplerState> sampler, uint32_t index);
+  void SetBuffer(id<MTLBuffer> buffer, NSUInteger offset, uint32_t index) { SetBuffer(GpuStage::kCompute, buffer, offset, index); }
+  void SetBytes(const void* data, size_t size, uint32_t index) { SetBytes(GpuStage::kCompute, data, size, index); }
+  void SetTexture(id<MTLTexture> texture, uint32_t index) { SetTexture(GpuStage::kCompute, texture, index); }
+
+  // Compute.
+  void SetPipeline(id<MTLComputePipelineState> pipeline);
+  void DispatchThreads(MTLSize threads, MTLSize group);
+  void DispatchGroups(MTLSize groups, MTLSize group);
+
+  // Blit.
+  void CopyBuffer(id<MTLBuffer> source, NSUInteger source_offset, id<MTLBuffer> destination,
+                  NSUInteger destination_offset, NSUInteger size);
+  void CopyTexture(id<MTLTexture> source, NSUInteger source_slice, NSUInteger source_level, MTLOrigin source_origin,
+                   MTLSize size, id<MTLTexture> destination, NSUInteger destination_slice,
+                   NSUInteger destination_level, MTLOrigin destination_origin);
+  void CopyBufferToTexture(id<MTLBuffer> source, NSUInteger offset, NSUInteger bytes_per_row,
+                           NSUInteger bytes_per_image, MTLSize size, id<MTLTexture> destination, NSUInteger slice,
+                           NSUInteger level, MTLOrigin origin);
+  void CopyTextureToBuffer(id<MTLTexture> source, NSUInteger slice, NSUInteger level, MTLOrigin origin, MTLSize size,
+                           id<MTLBuffer> destination, NSUInteger offset, NSUInteger bytes_per_row,
+                           NSUInteger bytes_per_image, MTLBlitOption options = MTLBlitOptionNone);
+  void FillBuffer(id<MTLBuffer> buffer, NSRange range, uint8_t value);
+
+  // Metal 4, the compute encoder: builds an acceleration structure (MTLAccelerationStructure) from a
+  // MTL4AccelerationStructureDescriptor, after the ops before it, with `size` bytes of scratch at `offset` (0: the
+  // rest of the buffer). The buffers the descriptor names are the caller's to make resident (GpuCommands::Use).
+  // Metal 3: nothing.
+  void BuildAccelerationStructure(id structure, id descriptor, id<MTLBuffer> scratch, NSUInteger offset = 0,
+                                  NSUInteger size = 0);
+  // A compute binding of an acceleration structure (an instance_acceleration_structure parameter) at a buffer
+  // index; resident and kept as SetBuffer's buffers are. The instances' BLASes are the caller's (GpuCommands::Use).
+  void SetAccelerationStructure(id<MTLAccelerationStructure> structure, uint32_t index);
+
+  // Metal 4, the compute encoder: the ops between these don't wait for each other (they touch nothing another of
+  // them writes); the first waits for the ops before, and the op after the group waits for all of it. Metal 3:
+  // nothing (its compute encoders run their dispatches in order).
+  void BeginConcurrent();
+  void EndConcurrent();
+
+  // Metal 3's fences for the untracked guest memory buffer (Metal 4: the barriers order everything).
+  void WaitForFence(id<MTLFence> fence);
+  void UpdateFence(id<MTLFence> fence);
+
+ private:
+  friend class GpuCommands;
+  enum class Kind : uint8_t { kNone, kRender, kCompute, kBlit };
+  void Op();  // Metal 4: before an op of the shared compute encoder
+  id enc_ = nil;
+  GpuRecording* rec_ = nullptr;  // Metal 4
+  uint64_t recording_ = 0;        // Metal 4: the command buffer's stamp
+  uint32_t render_ = 0;           // Metal 4: which of its render encoders
+  Kind kind_ = Kind::kNone;
+};
+
+// A command buffer being recorded.
+class GpuCommands {
+ public:
+  GpuCommands() = default;
+  explicit operator bool() const { return cb3_ != nil || rec_ != nullptr; }
+  bool operator==(const GpuCommands& o) const { return cb3_ == o.cb3_ && rec_ == o.rec_; }
+  bool operator!=(const GpuCommands& o) const { return !(*this == o); }
+  GpuEncoder Render(MTLRenderPassDescriptor* pass);
+  GpuEncoder Compute();
+  GpuEncoder Blit();
+  void AddCompleted(GpuDoneBlock block);
+  void SetLabel(NSString* label);
+  // Metal 4: the resource is resident for these commands and lives until the GPU is done with them.
+  void Use(id resource);
+  id<MTLCommandBuffer> metal3() const { return cb3_; }
+  // Metal 4, for MetalFX's encoders: the open compute encoder is ended first.
+  id<MTL4CommandBuffer> metal4() const API_AVAILABLE(macos(26.0));
+  // Metal 4: a GPU timestamp into `heap` (an MTL4CounterHeap) at `index`, taken once everything recorded before it
+  // in this command buffer is done (-[MTL4CommandBuffer writeTimestampIntoHeap:atIndex:]). Between encoders: the
+  // open compute encoder is ended first, and no render encoder may be open. Metal 3: nothing.
+  void Timestamp(id heap, NSUInteger index);
+
+ private:
+  friend class GpuQueue;
+  id<MTLCommandBuffer> cb3_ = nil;
+  GpuRecording* rec_ = nullptr;
+};
+
+// A committed command buffer, to wait for.
+struct GpuSubmission {
+  id<MTLCommandBuffer> cb3 = nil;
+  uint64_t serial = 0;
+  explicit operator bool() const { return cb3 != nil || serial != 0; }
+};
+
+class GpuQueue {
+ public:
+  GpuQueue(id<MTLDevice> device, id<MTLCommandQueue> queue3);
+  ~GpuQueue();
+  // Metal 4 where MetalUseMetal4Draws says so (false: Metal 3).
+  bool Initialize();
+  bool metal4() const { return queue4_ != nil; }
+
+  GpuCommands Begin(NSString* label = nil);
+  GpuSubmission Commit(GpuCommands& commands);
+  // Several, in order, as one commit (Metal 4: one commit:count:, one feedback handler, one event signal). The commit
+  // reports one GPU time: the first one's completion blocks get it, the others a zero-length span at its end. Empty
+  // ones are skipped; returns the last one's submission (none if all were empty).
+  GpuSubmission Commit(GpuCommands* const* list, size_t count);
+  void Wait(const GpuSubmission& submission);
+  bool Done(const GpuSubmission& submission);
+
+  // Metal 4: resident for the queue's life (render targets, the guest memory, rings).
+  void MakeResident(id resource);
+  // A texture the draws make often (resolve destinations, composites, texture loads). Metal 4: placed in one of the
+  // queue's heaps, resident with the heap (the residency set doesn't change for it), Private storage only.
+  id<MTLTexture> NewTexture(MTLTextureDescriptor* desc);
+  // Metal 4: whether nothing but `others` references and no recorded or running work holds the resource (the
+  // texture pool's test; Metal 3 command buffers held what they used, Metal 4's don't).
+  bool Idle(__unsafe_unretained id resource, long others);
+  // The frame's end: resources the GPU is done with and nothing else holds leave the residency set.
+  void EndFrame();
+  // A serial by which every command buffer begun so far will have completed (the last committed serial plus the
+  // ones being recorded), and the last completed serial: a texture view pool slot retired now is free again once
+  // CompletedSerial() reaches RetireSerial().
+  uint64_t RetireSerial() const { return serial_ + open_recordings_; }
+  uint64_t CompletedSerial();
+
+  // Ordering against the presenter's Metal 3 queue (Metal 4): the commands committed next wait for everything
+  // committed to it so far; and what is committed to it next waits for everything committed here so far.
+  void WaitForMetal3();
+  void SignalMetal3();
+
+  struct Stats {
+    uint64_t commits = 0, resident = 0, resident_bytes = 0, evicted = 0, transient_bytes = 0, residency_commits = 0;
+    uint64_t heaps = 0, heap_mb = 0, heap_used_mb = 0, set_added = 0, set_removed = 0;
+    uint64_t command_buffers = 0;
+  };
+  Stats TakeStats();
+
+  // Internal (GpuEncoder, GpuCommands).
+  void UseIn(GpuRecording& rec, __unsafe_unretained id resource);
+  // Transient bytes for a binding: copied into a buffer the GPU reads, its address returned.
+  uint64_t Transient(GpuRecording& rec, const void* data, size_t size);
+
+ private:
+  GpuResident& Track(void* key, __unsafe_unretained id resource);
+  // The last entry looked up for a resource, by address (Fibonacci hashing: objects are allocated in strides).
+  static size_t RecentSlot(void* key) { return size_t((uintptr_t(key) * 0x9E3779B97F4A7C15ull) >> (64 - 14)); }
+  void Evict(GpuResident& entry);
+
+  id<MTLDevice> device_;
+  id<MTLCommandQueue> queue3_;
+  id queue4_ = nil;         // MTL4CommandQueue
+  id residency_ = nil;      // MTLResidencySet
+  id<MTLSharedEvent> event_ = nil, event3_ = nil;
+  id<MTLBuffer> scratch_ = nil;  // Metal 4: the fence encoder's copy
+  std::vector<id<MTLHeap>> heaps_;  // Metal 4: NewTexture's
+  uint64_t serial_ = 0, completed_ = 0, value3_ = 0;
+  uint32_t open_recordings_ = 0;  // Metal 4: begun, not committed yet
+  bool residency_dirty_ = false;
+  // What left the residency set at the last sweep, kept to the next (4 frames): the removal takes effect at the
+  // set's next commit, and commits already on their way read the set as it was (Metal's shader validation touches
+  // every allocation in it).
+  std::vector<id> retired_;
+  uint64_t frame_ = 0, stamp_ = 0;
+  std::unordered_map<void*, GpuResident> resident_;
+  std::array<std::pair<void*, GpuResident*>, size_t(1) << 14> recent_{};
+  std::vector<std::unique_ptr<GpuRecording>> recordings_;   // free
+  // Metal 4, metal_metal4_submit_thread: the commits (and the queue's event waits and signals, in their order) on a
+  // serial queue of their own: a commit runs MetalFX's ML graphs (an MPSGraph setup per frame) on the thread that
+  // calls it. The recordings come back through `returned_` once committed.
+  dispatch_queue_t submit_ = nullptr;
+  std::mutex returned_mutex_;
+  std::vector<GpuRecording*> returned_;
+  void Submit(dispatch_block_t block);
+  void Flush();  // waits until every Submit ran
+  std::vector<std::pair<id, uint64_t>> allocators_;          // free MTL4CommandAllocators, with their last serial
+  // Transient buffers: the current one and the ones in use or free.
+  struct Chunk { id<MTLBuffer> buffer; GpuResident* entry; };
+  std::vector<Chunk> chunks_;
+  size_t chunk_ = SIZE_MAX, chunk_used_ = 0;
+  Stats stats_;
+  std::shared_ptr<std::atomic<uint64_t>> gpu_errors_ = std::make_shared<std::atomic<uint64_t>>(0);
+  friend class GpuCommands;
+};
+
+}  // namespace rex::graphics::metal
