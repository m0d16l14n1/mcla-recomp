+  std::chrono::steady_clock::time_point display_hz_checked_{};
+  bool fg_logged_presenting_ = false;
+  uint32_t fg_presented_ = 0, fg_held_back_ = 0, fg_held_ui_ = 0, fg_held_late_ = 0, fg_held_rate_ = 0, fg_dropped_ = 0;
+  std::chrono::steady_clock::time_point fg_log_time_{};
+  // Where an image goes in the drawable (the paint flow's last size and offset), and the HDR paint's constants.
+  struct PaintPlacement {
+    bool draw = false;
+    MTLViewport viewport{};
+    struct { float sdr_nits; uint32_t is_pq, gamma22; } hdr{};
+  };
+  id<MTLCommandBuffer> EncodePaint(id<CAMetalDrawable> target, id<MTLTexture> image, const PaintPlacement& placement,
+                                   bool ui, const HdrOutputState& hdr_state);
+  // The picture enlarged by MetalFX's spatial upscaler (metal_present_scaling), nil: painted as it is. One output
+  // texture: paints are encoded one at a time on one queue (the frame generation thread's and the UI thread's
+  // never at once), so each reads it before the next writes.
+  id<MTLTexture> SpatialUpscale(id<MTLCommandBuffer> command_buffer, id<MTLTexture> image,
+                                const PaintPlacement& placement);
+  std::mutex spatial_mutex_;
+  // id<MTLFXSpatialScalerBase>: an MTL4FXSpatialScaler on spatial_fx4_ (metal_metal4) or an MTLFXSpatialScaler.
+  id spatial_ = nil;
+  bool spatial_metal4_ = false;
+  MetalFx4 spatial_fx4_;
+  id<MTLTexture> spatial_output_ = nil;
+  uint32_t spatial_in_[2] = {}, spatial_out_[2] = {};
+  MTLPixelFormat spatial_format_ = MTLPixelFormatInvalid;
+  bool spatial_failed_ = false;
+  // Frame generation's present thread: the UI thread copies a new frame and the generated one before it into a
