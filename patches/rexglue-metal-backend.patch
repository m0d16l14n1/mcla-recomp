+std::unique_ptr<MetalProvider> MetalProvider::Create() {
+  std::unique_ptr<MetalProvider> provider(new MetalProvider());
+  provider->device_ = MTLCreateSystemDefaultDevice();
+  if (!provider->device_) {
+    REXGPU_ERROR("Metal: no Metal device");
+    return nullptr;
+  }
+  provider->command_queue_ = [provider->device_ newCommandQueue];
+  if (!provider->command_queue_) {
+    REXGPU_ERROR("Metal: could not create a command queue");
+    return nullptr;
+  }
+  provider->command_queue_.label = @"rexglue guest";
+  REXGPU_INFO("Metal device '{}': unified memory {}, recommended working set {} MB, Apple GPU family 9 {}",
+              [provider->device_.name UTF8String], provider->device_.hasUnifiedMemory ? "yes" : "no",
+              provider->device_.recommendedMaxWorkingSetSize >> 20,
+              [provider->device_ supportsFamily:MTLGPUFamilyApple9] ? "yes" : "no");
+  return provider;
+}
