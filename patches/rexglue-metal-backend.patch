+
+GpuQueue::GpuQueue(id<MTLDevice> device, id<MTLCommandQueue> queue3) : device_(device), queue3_(queue3) {}
+
+GpuQueue::~GpuQueue() {
+  if (@available(macOS 26.0, *)) {
+    Flush();
+    if (queue4_ && serial_) [event_ waitUntilSignaledValue:serial_ timeoutMS:5000];
+    for (GpuRecording* rec : returned_) delete rec;
+  }
+}
+
+void GpuQueue::Submit(dispatch_block_t block) {
+  if (submit_) dispatch_async(submit_, block);
+  else block();
+}
+
+void GpuQueue::Flush() {
+  if (submit_) dispatch_sync(submit_, ^{});
+}
+
+bool GpuQueue::Initialize() {
+  if (@available(macOS 26.0, *)) {
+    if (!MetalUseMetal4Draws(device_)) return true;
+    NSError* error = nil;
+    auto queue_desc = [MTL4CommandQueueDescriptor new];
+    queue_desc.label = @"Xenos draws (Metal 4)";
+    id<MTL4CommandQueue> queue = [device_ newMTL4CommandQueueWithDescriptor:queue_desc error:&error];
+    auto residency_desc = [MTLResidencySetDescriptor new];
+    residency_desc.label = @"Xenos draws";
+    residency_desc.initialCapacity = 4096;
+    id<MTLResidencySet> residency = [device_ newResidencySetWithDescriptor:residency_desc error:&error];
+    event_ = [device_ newSharedEvent];
+    event3_ = [device_ newSharedEvent];
+    if (!queue || !residency || !event_ || !event3_) {
+      REXGPU_WARN("Metal 4 draws: no Metal 4 queue ({}); Metal 3 instead",
+                  error ? error.localizedDescription.UTF8String : "?");
+      return true;
+    }
+    [queue addResidencySet:residency];
+    queue4_ = queue;
+    residency_ = residency;
+    scratch_ = [device_ newBufferWithLength:256 options:MTLResourceStorageModePrivate];
+    MakeResident(scratch_);
+    if (REXCVAR_GET(metal_metal4_submit_thread))
+      submit_ = dispatch_queue_create("Xenos draws: Metal 4 commits",
+                                      dispatch_queue_attr_make_with_qos_class(DISPATCH_QUEUE_SERIAL,
+                                                                              QOS_CLASS_USER_INTERACTIVE, 0));
+    REXGPU_INFO("Metal 4 draws: the passes, resolves, texture loads and MetalFX on a Metal 4 queue");
+  }
+  return true;
+}
+
+uint64_t GpuQueue::CompletedSerial() {
+  if (queue4_) completed_ = std::max(completed_, event_.signaledValue);
+  return completed_;
+}
+
+GpuCommands GpuQueue::Begin(NSString* label) {
+  GpuCommands c;
+  if (@available(macOS 26.0, *)) {
+    if (queue4_) {
+      std::unique_ptr<GpuRecording> rec;
+      if (submit_) {
+        std::lock_guard lock(returned_mutex_);
+        for (GpuRecording* r : returned_) recordings_.emplace_back(r);
+        returned_.clear();
+      }
+      if (!recordings_.empty()) { rec = std::move(recordings_.back()); recordings_.pop_back(); }
+      else {
+        rec = std::make_unique<GpuRecording>();
+        rec->queue = this;
+        rec->cb = [device_ newCommandBuffer];
+        for (uint32_t i = 0; i < 3; ++i) {
+          auto& t = rec->tables[i];
+          auto desc = [MTL4ArgumentTableDescriptor new];
+          desc.maxBufferBindCount = kStageBuffers[i];
+          desc.maxTextureBindCount = kStageTextures[i];
+          desc.maxSamplerStateBindCount = kStageSamplers[i];
+          desc.initializeBindings = YES;
+          NSError* error = nil;
+          t = [device_ newArgumentTableWithDescriptor:desc error:&error];
+          if (!t) REXGPU_ERROR("Metal 4 draws: no argument table: {}", error ? error.localizedDescription.UTF8String : "?");
+        }
+      }
+      // An allocator whose commands the GPU has finished (the oldest first), else a new one.
+      completed_ = std::max(completed_, event_.signaledValue);
+      id<MTL4CommandAllocator> allocator = nil;
+      for (size_t i = 0; i < allocators_.size(); ++i) {
+        if (allocators_[i].second <= completed_) {
+          allocator = allocators_[i].first;
+          allocators_.erase(allocators_.begin() + i);
+          break;
+        }
+      }
+      if (!allocator) {
+        if (allocators_.size() >= 32) {
+          // Too many in flight: wait for the oldest.
+          [event_ waitUntilSignaledValue:allocators_.front().second timeoutMS:5000];
+          allocator = allocators_.front().first;
+          allocators_.erase(allocators_.begin());
+        } else {
+          allocator = [device_ newCommandAllocator];
+        }
+      }
+      [allocator reset];
+      rec->allocator = allocator;
+      rec->stamp = ++stamp_;
+      rec->compute = nil;
+      rec->compute_ops = false;
+      rec->label = label;
+      rec->ResetBindings();
+      rec->renders = 0;
+      rec->after_external = false;
+      [rec->cb beginCommandBufferWithAllocator:allocator];
+      if (label) rec->cb.label = label;
+      ++open_recordings_;
+      c.rec_ = rec.release();
+      return c;
+    }
+  }
+  c.cb3_ = [queue3_ commandBuffer];
+  if (label) c.cb3_.label = label;
+  return c;
+}
+
+GpuSubmission GpuQueue::Commit(GpuCommands& commands) {
+  GpuCommands* list[1] = {&commands};
+  return Commit(list, 1);
+}
+
+GpuSubmission GpuQueue::Commit(GpuCommands* const* list, size_t count) {
+  GpuSubmission s;
+  if (@available(macOS 26.0, *)) {
+    if (queue4_) {
+      constexpr uint32_t kMax = 4;
+      if (count > kMax) {
+        Commit(list, kMax);
+        return Commit(list + kMax, count - kMax);
+      }
+      // The command buffers, in list order, and their recordings (back to the free list once committed).
+      struct Batch {
+        std::array<id<MTL4CommandBuffer>, kMax> cbs{};
+        std::array<GpuRecording*, kMax> recs{};
+        uint32_t count = 0;
+      } batch;
+      std::vector<std::vector<GpuDoneBlock>> done;
+      NSString* label = nil;
+      uint64_t serial = 0;
+      for (size_t i = 0; i < count; ++i) {
+        GpuCommands& commands = *list[i];
+        if (!commands.rec_) { commands = {}; continue; }
+        std::unique_ptr<GpuRecording> rec(commands.rec_);
+        commands = {};
+        rec->EndCompute();
+        [rec->cb endCommandBuffer];
+        done.push_back(std::move(rec->done));
+        rec->done.clear();
+        if (!label) label = rec->label;
+        if (open_recordings_) --open_recordings_;
+        serial = ++serial_;
+        for (GpuResident* r : rec->used) { r->serial = serial; --r->open; }
+        rec->used.clear();
+        // The allocator is reset only once the event says the GPU is done with this commit.
+        allocators_.push_back({rec->allocator, serial});
+        rec->allocator = nil;
+        rec->label = nil;
+        batch.cbs[batch.count] = rec->cb;
+        batch.recs[batch.count++] = rec.release();
+      }
+      if (!batch.count) return s;
+      if (residency_dirty_) {
+        [(id<MTLResidencySet>)residency_ commit];
+        residency_dirty_ = false;
+        ++stats_.residency_commits;
+      }
+      auto options = [MTL4CommitOptions new];
+      auto errors = gpu_errors_;
+      const uint32_t n = batch.count;
+      [options addFeedbackHandler:^(id<MTL4CommitFeedback> feedback) {
+        GpuDone d{feedback.GPUStartTime, feedback.GPUEndTime, feedback.error};
+        if (d.error && errors->fetch_add(1) < 16)
+          REXGPU_ERROR("Metal 4 draws: {} ({} command buffers) failed: {}", label ? label.UTF8String : "command buffer",
+                       n, d.error.localizedDescription.UTF8String);
+        // One GPU time for the commit: counted once (the first one's), the others end with it.
+        for (auto& blocks : done) {
+          for (auto& block : blocks) block(d);
+          d.gpu_start = d.gpu_end;
+        }
+      }];
+      id<MTL4CommandQueue> queue = queue4_;
+      id<MTLSharedEvent> event = event_;
+      if (submit_) {
+        Submit(^{
+          [queue commit:batch.cbs.data() count:n options:options];
+          [queue signalEvent:event value:serial];
+          std::lock_guard lock(returned_mutex_);
+          for (uint32_t i = 0; i < n; ++i) returned_.push_back(batch.recs[i]);
+        });
+      } else {
+        [queue commit:batch.cbs.data() count:n options:options];
+        [queue signalEvent:event value:serial];
+        for (uint32_t i = 0; i < n; ++i) recordings_.emplace_back(batch.recs[i]);
+      }
+      ++stats_.commits;
+      stats_.command_buffers += n;
+      s.serial = serial;
+      return s;
+    }
+  }
+  for (size_t i = 0; i < count; ++i) {
+    GpuCommands& commands = *list[i];
+    if (commands.cb3_) {
+      [commands.cb3_ commit];
+      s.cb3 = commands.cb3_;
+      ++stats_.commits;
+      ++stats_.command_buffers;
+    }
+    commands = {};
+  }
+  return s;
+}
+
+void GpuQueue::Wait(const GpuSubmission& submission) {
+  if (submission.cb3) { [submission.cb3 waitUntilCompleted]; return; }
+  if (!submission.serial || submission.serial <= completed_) return;
+  if (@available(macOS 26.0, *)) {
+    completed_ = std::max(completed_, event_.signaledValue);
+    if (submission.serial <= completed_) return;
+    if (![event_ waitUntilSignaledValue:submission.serial timeoutMS:10000])
+      REXGPU_ERROR("Metal 4 draws: commit {} not done after 10 s (the GPU at {})", submission.serial, event_.signaledValue);
+    completed_ = std::max(completed_, event_.signaledValue);
+  }
+}
+
+bool GpuQueue::Done(const GpuSubmission& submission) {
+  if (submission.cb3) return submission.cb3.status >= MTLCommandBufferStatusCompleted;
+  if (submission.serial <= completed_) return true;
+  completed_ = std::max(completed_, event_.signaledValue);
+  return submission.serial <= completed_;
+}
+
+GpuResident& GpuQueue::Track(void* key, __unsafe_unretained id resource) {
+  auto [it, added] = resident_.try_emplace(key);
+  GpuResident& r = it->second;
+  if (added) {
+    r.object = resource;
+    // Placed in a heap (or a view of what is): resident with the heap.
+    r.in_set = ![resource conformsToProtocol:@protocol(MTLResource)] || ((id<MTLResource>)resource).heap == nil;
+    if ([resource conformsToProtocol:@protocol(MTLTexture)]) {
+      id<MTLTexture> texture = resource;
+      if (id<MTLTexture> parent = texture.parentTexture) {
+        // A view is resident with its texture (the set holds the texture's memory, not the view object): only
+        // its lifetime is tracked here, and each use is a use of the texture too.
+        r.in_set = false;
+        r.parent = parent;
+      } else if (id<MTLBuffer> buffer = texture.buffer) {
+        // A texture made on a buffer: its buffer too.
+        r.parent = buffer;
+      }
+    }
+    if (r.in_set) {
+      [(id<MTLResidencySet>)residency_ addAllocation:(id<MTLAllocation>)resource];
+      residency_dirty_ = true;
+      ++stats_.set_added;
+    }
+    if (r.parent) Track((__bridge void*)r.parent, r.parent);
+  }
+  return r;
+}
+
+void GpuQueue::MakeResident(id resource) {
+  if (!queue4_ || !resource) return;
+  Track((__bridge void*)resource, resource).permanent = true;
+}
+
+void GpuQueue::UseIn(GpuRecording& rec, __unsafe_unretained id resource) {
+  void* key = (__bridge void*)resource;
+  auto& slot = recent_[RecentSlot(key)];
+  GpuResident* r = slot.first == key ? slot.second : nullptr;
+  if (!r) {
+    r = &Track(key, resource);
+    slot = {key, r};
+  }
+  if (r->stamp == rec.stamp) return;
+  r->stamp = rec.stamp;
+  r->frame = frame_;
+  ++r->open;
+  rec.used.push_back(r);
+  if (r->parent) UseIn(rec, r->parent);
+}
+
+uint64_t GpuQueue::Transient(GpuRecording& rec, const void* data, size_t size) {
+  const size_t aligned = (size + 255) & ~size_t(255);
+  if (chunk_ == SIZE_MAX || chunk_used_ + aligned > kChunkSize) {
+    // A buffer the GPU is done with, else a new one.
+    completed_ = std::max(completed_, event_.signaledValue);
+    chunk_ = SIZE_MAX;
+    for (size_t i = 0; i < chunks_.size(); ++i) {
+      GpuResident* e = chunks_[i].entry;
+      if (!e->open && e->serial <= completed_ && e->stamp != rec.stamp) { chunk_ = i; break; }
+    }
+    if (chunk_ == SIZE_MAX) {
+      id<MTLBuffer> buffer = [device_ newBufferWithLength:std::max(kChunkSize, aligned)
+                                                  options:MTLResourceStorageModeShared | MTLResourceCPUCacheModeWriteCombined];
+      buffer.label = @"Xenos transient constants (Metal 4)";
+      GpuResident& e = Track((__bridge void*)buffer, buffer);
+      e.permanent = true;
+      chunks_.push_back({buffer, &e});
+      chunk_ = chunks_.size() - 1;
+    }
+    chunk_used_ = 0;
+  }
+  Chunk& c = chunks_[chunk_];
+  UseIn(rec, c.buffer);
+  std::memcpy(static_cast<uint8_t*>(c.buffer.contents) + chunk_used_, data, size);
+  const uint64_t address = c.buffer.gpuAddress + chunk_used_;
+  chunk_used_ += aligned;
+  stats_.transient_bytes += aligned;
+  return address;
+}
+
+bool GpuQueue::Idle(__unsafe_unretained id resource, long others) {
+  const long count = CFGetRetainCount((__bridge CFTypeRef)resource);
+  if (!queue4_) return count == others;
+  auto it = resident_.find((__bridge void*)resource);
+  if (it == resident_.end()) return count == others;
+  const GpuResident& r = it->second;
+  if (r.open) return false;
+  completed_ = std::max(completed_, event_.signaledValue);
+  return r.serial <= completed_ && count == others + (r.in_set ? kOwnReferences : 1);
+}
+
+void GpuQueue::Evict(GpuResident& entry) {
+  if (!entry.in_set) return;
+  [(id<MTLResidencySet>)residency_ removeAllocation:(id<MTLAllocation>)entry.object];
+  residency_dirty_ = true;
+  ++stats_.set_removed;
+}
+
+id<MTLTexture> GpuQueue::NewTexture(MTLTextureDescriptor* desc) {
+  if (!queue4_ || desc.storageMode != MTLStorageModePrivate) return [device_ newTextureWithDescriptor:desc];
+  desc.hazardTrackingMode = MTLHazardTrackingModeUntracked;
+  for (auto it = heaps_.rbegin(); it != heaps_.rend(); ++it)
+    if (id<MTLTexture> t = [*it newTextureWithDescriptor:desc]) return t;
+  // A new heap: 256 MB, or the texture's size if larger.
+  const MTLSizeAndAlign sa = [device_ heapTextureSizeAndAlignWithDescriptor:desc];
+  auto heap_desc = [MTLHeapDescriptor new];
+  heap_desc.type = MTLHeapTypeAutomatic;
+  heap_desc.storageMode = MTLStorageModePrivate;
+  heap_desc.hazardTrackingMode = MTLHazardTrackingModeUntracked;
+  heap_desc.size = std::max<NSUInteger>(NSUInteger(256) << 20, sa.size + sa.align);
+  id<MTLHeap> heap = [device_ newHeapWithDescriptor:heap_desc];
+  if (!heap) return [device_ newTextureWithDescriptor:desc];
+  heap.label = [NSString stringWithFormat:@"Xenos textures %zu (Metal 4)", heaps_.size()];
+  heaps_.push_back(heap);
+  MakeResident(heap);
+  REXGPU_INFO("Metal 4 draws: texture heap {} ({} MB)", heaps_.size(), heap_desc.size >> 20);
+  id<MTLTexture> t = [heap newTextureWithDescriptor:desc];
+  return t ? t : [device_ newTextureWithDescriptor:desc];
+}
+
+void GpuQueue::EndFrame() {
+  ++frame_;
+  // Every fourth frame: each pass that removes something commits the set again.
+  if (!queue4_ || frame_ % 4) return;
+  completed_ = std::max(completed_, event_.signaledValue);
+  retired_.clear();
+  // What the GPU is done with leaves the set when only this queue holds it, or after kIdleFrames unused whoever
+  // holds it (a cached texture lives on in its cache, resident again at its next use). The second bounds the set
+  // where the retain counts can't be trusted (the API validation layer holds references of its own).
+  for (auto it = resident_.begin(); it != resident_.end();) {
+    GpuResident& r = it->second;
+    if (r.permanent || r.open || r.serial > completed_ ||
+        (frame_ - r.frame < kIdleFrames &&
+         CFGetRetainCount((__bridge CFTypeRef)r.object) > (r.in_set ? kOwnReferences : 1))) {
+      ++it;
+      continue;
+    }
+    Evict(r);
+    if (r.in_set) retired_.push_back(r.object);
+    auto& slot = recent_[RecentSlot(it->first)];
+    if (slot.first == it->first) slot = {};
+    it = resident_.erase(it);
+    ++stats_.evicted;
+  }
+}
+
+void GpuQueue::WaitForMetal3() {
+  if (@available(macOS 26.0, *)) {
+    if (!queue4_) return;
+    id<MTLCommandBuffer> cb = [queue3_ commandBuffer];
+    cb.label = @"Metal 3 queue: done so far";
+    const uint64_t value = ++value3_;
+    [cb encodeSignalEvent:event3_ value:value];
+    [cb commit];
+    id<MTL4CommandQueue> queue = queue4_;
+    id<MTLSharedEvent> event3 = event3_;
+    Submit(^{ [queue waitForEvent:event3 value:value]; });
+  }
+}
+
+void GpuQueue::SignalMetal3() {
+  if (!queue4_ || !serial_) return;
+  id<MTLCommandBuffer> cb = [queue3_ commandBuffer];
+  cb.label = @"Metal 3 queue: after the Metal 4 draws";
+  [cb encodeWaitForEvent:event_ value:serial_];
+  [cb commit];
+}
+
+GpuQueue::Stats GpuQueue::TakeStats() {
+  Stats s = stats_;
+  s.resident = resident_.size();
+  s.heaps = heaps_.size();
+  for (id<MTLHeap> h : heaps_) { s.heap_mb += h.size >> 20; s.heap_used_mb += h.usedSize >> 20; }
+  stats_ = {};
+  return s;
+}
+
