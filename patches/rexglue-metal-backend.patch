+namespace rex::graphics::metal {
+class MetalPrimitiveProcessor;
+class MetalDraw {
+ public:
+  MetalDraw(id<MTLDevice> device, id<MTLCommandQueue> queue, id<MTLBuffer> memory_buffer,
+            memory::Memory& memory, RegisterFile& regs, MetalShaderCompiler& shaders, uint32_t edram_tiles);
+  ~MetalDraw();
+  bool Initialize();
+  bool Draw(Shader* vs, Shader* ps);
+  bool Resolve();
+  // A guest fence value stored by the GPU, in order after the work encoded so far (metal_gpu_fences);
+  // false: the caller stores it.
+  bool WriteFence(uint32_t address, uint32_t value);
+  void EndFrame();
+  // Temporal anti-aliasing with MetalFX (the SDK's temporal_aa, which the fork's mcla_anti_aliasing = fsr
+  // turns on): the jitter of the scene's draws (the command processor's TaaJitterNdcOffset), and the pass
+  // before the game's motion blur draw. TaaRun returns the status for temporal_aa_debug 4 ('+' when it ran).
+  // For every draw, with its host viewport and scissor: the jitter (into the NDC offset), then, when the frame's
+  // scene is squeezed for upscaling (temporal_aa_upscale above 1), the viewport and scissor squeezed into the
+  // top-left render size of the target, and the ps_param_gen scale.
+  std::function<void(draw_util::ViewportInfo& viewport, draw_util::Scissor& scissor, float& param_gen_scale)> taa_draw_;
+  // For a resolve while the scene may be squeezed: whether to read the source through the stretch (num the render
+  // size, den the output size); copy_ok is whether this resolve can stretch.
+  std::function<bool(uint32_t pitch_px, uint32_t samples, uint32_t format, bool depth, uint32_t num[2], uint32_t den[2])>
+      taa_resolve_stretch_;
+  struct TaaInputs {
+    const void* vector_constants;  // CommandProcessor::TaaVectorConstants (size and stencil component set here)
+    size_t vector_constants_size;
