+
+bool MetalCommandProcessor::IssueDraw([[maybe_unused]] xenos::PrimitiveType prim_type,
+                                      [[maybe_unused]] uint32_t index_count,
+                                      [[maybe_unused]] IndexBufferInfo* index_buffer_info,
+                                      [[maybe_unused]] bool major_mode_explicit) {
+  // A draw in copy mode is a resolve (EDRAM to memory), as in the other backends.
+  if (register_file_->Get<reg::RB_MODECONTROL>().edram_mode == xenos::EdramMode::kCopy) {
+    return IssueCopy();
+  }
+  ++stats_draws_;
+  if (int32_t us = REXCVAR_GET(metal_draw_spin_us)) SpinMicroseconds(us);
+  if (!REXCVAR_GET(metal_draw)) return true;
+  // Temporal AA: the anti-aliasing pass before the draw that reads the scene (the game's motion blur).
+  if (taa_pending_ && active_pixel_shader() && draw_) {
+    MetalDraw::TaaInputs inputs{&taa_vector_constants_, sizeof(taa_vector_constants_), {}, taa_camera_.reset,
+        taa_up_.out_width, taa_up_.out_height, taa_up_.render_width, taa_up_.render_height, taa_frame_.up_state == 1};
+    TaaFsrJitter(inputs.jitter);
+    taa_frame_.status = draw_->TaaRun(inputs);
+    if (taa_frame_.status == '+') taa_frame_.done = true;
+  }
+  if (!draw_) return false;
+  // MCLA's motion blur draw: its previous-frame matrices (pixel constants 69 to 164, one per vehicle ID; to the
+  // last frame's pixels, x = w/2 (x + w), y = h/2 (w - y) with the size in constant 62) drawn toward this frame's
+  // view-projection (8 to 11, to clip space) taken to the same pixels, so that the blur is no longer than one
+  // frame's motion at metal_motion_blur_fps; the game's values are put back after the draw (the temporal AA's
+  // vectors read them before).
+  constexpr uint64_t kMotionBlurPixelShader = 0xA6B9B6B0FA692C54;
+  constexpr uint32_t kBlurFirst = XE_GPU_REG_SHADER_CONSTANT_256_X + 69 * 4, kBlurCount = 24 * 16;
+  std::array<uint32_t, kBlurCount> blur_saved;
+  bool blur_scaled = false;
+  const double blur_fps = REXCVAR_GET(metal_motion_blur_fps);
+  if (blur_fps > 0.0 && frame_interval_ > 0.0 && active_pixel_shader() &&
+      active_pixel_shader()->ucode_data_hash() == kMotionBlurPixelShader) {
+    const float scale = float(std::min(1.0, 1.0 / (blur_fps * frame_interval_)));
+    if (scale < 0.999f) {
+      RegisterFile& regs = *register_file_;
+      auto read = [&](uint32_t c, float out[4]) {
+        std::memcpy(out, &regs.values[XE_GPU_REG_SHADER_CONSTANT_256_X + c * 4], 4 * sizeof(float));
+      };
+      float size[4];
+      read(62, size);
+      if (size[0] >= 16.0f && size[1] >= 16.0f && size[0] <= 16384.0f && size[1] <= 16384.0f) {
+        float current[16];
+        for (uint32_t i = 0; i < 4; ++i) {
+          float row[4];
+          read(8 + i, row);
+          current[i * 4 + 0] = 0.5f * size[0] * (row[0] + row[3]);
+          current[i * 4 + 1] = 0.5f * size[1] * (row[3] - row[1]);
+          current[i * 4 + 2] = row[2];
+          current[i * 4 + 3] = row[3];
+        }
+        std::memcpy(blur_saved.data(), &regs.values[kBlurFirst], sizeof(blur_saved));
+        for (uint32_t k = 0; k < 24; ++k) {
+          for (uint32_t i = 0; i < 16; ++i) {
+            float previous;
+            std::memcpy(&previous, &regs.values[kBlurFirst + k * 16 + i], sizeof(float));
+            const float value = current[i] + (previous - current[i]) * scale;
+            std::memcpy(&regs.values[kBlurFirst + k * 16 + i], &value, sizeof(float));
+          }
+        }
+        draw_->ConstantsWritten(kBlurFirst, kBlurFirst + kBlurCount);
+        blur_scaled = true;
+      }
+    }
+  }
+  const bool drawn = draw_->Draw(active_vertex_shader(), active_pixel_shader());
+  if (blur_scaled) {
+    std::memcpy(&register_file_->values[kBlurFirst], blur_saved.data(), sizeof(blur_saved));
+    draw_->ConstantsWritten(kBlurFirst, kBlurFirst + kBlurCount);
+  }
+  if (!drawn) return false;
+  // HDR scene: after the tone map draw, from its textures.
+  if (hdr_scene_pending_) {
+    hdr_scene_pending_ = false;
+    if (draw_->HdrRenderScene(&hdr_scene_constants_, sizeof(hdr_scene_constants_), hdr_output_width_,
+                              hdr_output_height_)) {
+      HdrSceneRendered();
+    }
+  }
+  return true;
+}
