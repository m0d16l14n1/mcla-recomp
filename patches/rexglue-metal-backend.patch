diff --git a/src/graphics/metal/metal_resolve.h b/src/graphics/metal/metal_resolve.h
new file mode 100644
--- /dev/null
+++ b/src/graphics/metal/metal_resolve.h
@@ -0,0 +1,493 @@
+/** Metal resolve compute kernels. BSD-3-Clause, see LICENSE. */
+#pragma once
+namespace rex::graphics::metal {
+// The tiling expression is the shared texture_util::GetTiledOffset2D algorithm (Xenia, BSD-3-Clause).
+static const char* kMetalResolveSource = R"MSL(
+#include <metal_stdlib>
+using namespace metal;
+struct ResolveConstants {
+  uint2 origin, size, dest_offset;
+  uint pitch, address, format, endian, swap, write_memory;
+  float scale;
+  uint2 samples;  // EDRAM samples a pixel covers: 1x1, 1x2 (MSAA 2x) or 2x2 (4x).
+  uint sample_select;  // 0 to 3: that sample; 4: the average.
+  uint extent_start, extent_end;  // the guest memory the resolve may write (its copy_dest_extent)
+  // Upscaling (temporal_aa_upscale): the squeezed scene read through a nearest-neighbour stretch, pixel q of the
+  // target (from its origin) at ((2q + 1) * num) / (2 * den), at most num - 1. Single-sampled only.
+  uint stretch;
+  uint2 stretch_num, stretch_den;
+  // EDRAM samples a texel of a single-sample source holds across and down: 1x1, or 2x2 for a 4x surface drawn at
+  // one sample a pixel (metal_4x_as_1x).
+  uint2 tex_ss;
+};
+uint2 stretched(uint2 q, constant ResolveConstants& c) {
+  return min(((2u * q + 1u) * c.stretch_num) / (2u * c.stretch_den), c.stretch_num - 1u);
+}
+// Real MSAA (metal_msaa): a guest sample is a position in EDRAM sample space (MSAA 2x 1x2 samples a pixel, 4x
+// 2x2); a host multisample texture holds it at pixel position / ss, sample index host_sample(position % ss).
+// Metal's standard positions: 2x sample 0 is the lower right, 1 the upper left (guest 2x: 0 top, 1 bottom); 4x
+// 0 to 3 go top, right, left, bottom, the guest's 2x2 order (top left, top right, bottom left, bottom right).
+uint host_sample(uint2 sub, uint2 ss) { return ss.x == 2u ? sub.y * 2u + sub.x : (ss.y == 2u ? 1u - sub.y : 0u); }
+uint2 guest_sub(uint i, uint2 ss) { return ss.x == 2u ? uint2(i & 1u, i >> 1) : (ss.y == 2u ? uint2(0u, 1u - i) : uint2(0u)); }
+uint2 sample_offset(uint i, uint2 samples) {
+  return samples.x == 2 ? uint2(i & 1, i >> 1) : uint2(0, min(i, samples.y - 1));
+}
+uint tiled_offset(uint2 p, uint pitch, uint log_bpp) {
+  uint macro = ((p.x >> 5) + (p.y >> 5) * ((pitch + 31) >> 5)) << (log_bpp + 7);
+  uint micro = ((p.x & 7) + ((p.y & 14) << 2)) << log_bpp;
+  uint offset = macro + ((micro & ~15u) << 1) + (micro & 15) + ((p.y & 1) << 4);
+  return ((offset & ~511u) << 3) + ((p.y & 16) << 7) + ((offset & 448) << 2) +
+         (((((p.y & 8) >> 2) + (p.x >> 3)) & 3) << 6) + (offset & 63);
+}
+void store_raw(uint4 packed, uint log_bpp, uint2 p, constant ResolveConstants& c, device uchar* memory,
+    device atomic_uint* rejected) {
+  uint address = c.address + tiled_offset(p + c.dest_offset, c.pitch, log_bpp);
+  uint xor_mask = c.endian == 1 ? 1 : c.endian == 2 ? 3 : c.endian == 3 ? 2 : c.endian == 4 ? 7 : c.endian == 5 ? 15 : 0;
+  uint bpb = 1u << log_bpp;
+  if (log_bpp >= 2 && xor_mask < bpb && address >= c.extent_start && address + bpb <= c.extent_end) {
+    // Whole words (the swap stays inside the texel): word k of the texel goes to word k ^ (xor_mask >> 2),
+    // its bytes permuted by xor_mask & 3, as the texture load kernel reads them.
+    device uint* words = reinterpret_cast<device uint*>(memory);
+    uint word_xor = xor_mask >> 2, byte_xor = xor_mask & 3u;
+    for (uint k = 0; k < (bpb >> 2); ++k) {
+      uint w = packed[k];
+      if (byte_xor == 1u) w = ((w & 0x00FF00FFu) << 8) | ((w >> 8) & 0x00FF00FFu);
+      else if (byte_xor == 2u) w = (w << 16) | (w >> 16);
+      else if (byte_xor == 3u) w = (w << 24) | ((w & 0xFF00u) << 8) | ((w >> 8) & 0xFF00u) | (w >> 24);
+      words[((address >> 2) + k) ^ word_xor] = w;
+    }
+    return;
+  }
+  for (uint b = 0; b < bpb; ++b) {
+    uint a = (address + b) ^ xor_mask;
+    // Never outside what the guest gave the resolve: memory around it is the CPU's.
+    if (a >= c.extent_start && a < c.extent_end) memory[a] = uchar(packed[b >> 2] >> ((b & 3) * 8));
+    else atomic_fetch_add_explicit(rejected, 1u, memory_order_relaxed);
+  }
+}
+void store_guest(float4 value, uint2 p, constant ResolveConstants& c, device uchar* memory,
+    device atomic_uint* rejected) {
+  if (!c.write_memory) return;
+  uint4 packed = uint4(0); uint log_bpp = 2;
+  uint4 unorm8 = uint4(rint(saturate(value) * 255.0f));
+  uint4 unorm16 = uint4(rint(saturate(value) * 65535.0f));
+  switch (c.format) {
+    case 2: case 8: case 9: packed.x = unorm8.x; log_bpp = 0; break;
+    case 10: packed.x = unorm8.x | (unorm8.y << 8); log_bpp = 1; break;
+    case 6: case 14: case 50: packed.x = unorm8.x | (unorm8.y << 8) | (unorm8.z << 16) | (unorm8.w << 24); break;
+    case 7: case 54: { uint4 u = uint4(rint(saturate(value) * float4(1023, 1023, 1023, 3)));
+      packed.x = u.x | (u.y << 10) | (u.z << 20) | (u.w << 30); break; }
+    case 24: packed.x = unorm16.x; log_bpp = 1; break;
+    case 25: packed.x = unorm16.x | (unorm16.y << 16); break;
+    case 26: packed.xy = uint2(unorm16.x | (unorm16.y << 16), unorm16.z | (unorm16.w << 16)); log_bpp = 3; break;
+    case 30: packed.x = as_type<ushort>(half(value.x)); log_bpp = 1; break;
+    case 31: packed.x = as_type<uint>(half2(value.xy)); break;
+    case 32: packed.xy = as_type<uint2>(half4(value)); log_bpp = 3; break;
+    case 36: packed.x = as_type<uint>(value.x); break;
+    case 37: packed.xy = as_type<uint2>(value.xy); log_bpp = 3; break;
+    case 38: packed = as_type<uint4>(value); log_bpp = 4; break;
+    default: return;
+  }
+  store_raw(packed, log_bpp, p, c, memory, rejected);
+}
+// xenos::Float32To20e4 with rounding to nearest even.
+uint float32_to_20e4(float f) {
+  if (!(f > 0.0f)) return 0;
+  uint u = as_type<uint>(f);
+  if (u >= 0x3FFFFFF8u) return 0xFFFFFFu;
+  if (u < 0x38800000u) u = (0x800000u | (u & 0x7FFFFFu)) >> min(113u - (u >> 23), 24u);
+  else u += 0xC8000000u;
+  u += 3 + ((u >> 3) & 1);
+  return (u >> 3) & 0xFFFFFFu;
+}
+kernel void resolve_color(texture2d<float, access::read> source [[texture(0)]],
+    texture2d<float, access::write> destination [[texture(1)]],
+    constant ResolveConstants& c [[buffer(0)]], device uchar* memory [[buffer(1)]],
+    device atomic_uint* rejected [[buffer(2)]], uint2 p [[thread_position_in_grid]]) {
+  if (any(p >= c.size)) return;
+  uint2 base = c.origin + p * c.samples;
+  if (c.stretch) base = stretched(c.origin + p, c);
+  float4 value;
+  if (c.stretch) {
+    value = source.read(base);
+  } else if (c.sample_select < 4) {
+    value = source.read((base + sample_offset(c.sample_select, c.samples)) / c.tex_ss);
+  } else {
+    value = float4(0);
+    for (uint y = 0; y < c.samples.y; ++y) for (uint x = 0; x < c.samples.x; ++x) value += source.read((base + uint2(x, y)) / c.tex_ss);
+    value /= float(c.samples.x * c.samples.y);
+  }
+  value *= c.scale;
+  if (c.swap) value = value.bgra;
+  destination.write(value, p);
+  store_guest(value, p, c, memory, rejected);
+}
+kernel void resolve_depth(depth2d<float, access::read> source [[texture(0)]],
+    texture2d<float, access::write> destination [[texture(1)]],
+    texture2d<uint, access::read> stencil [[texture(2)]],
+    constant ResolveConstants& c [[buffer(0)]], device uchar* memory [[buffer(1)]],
+    device atomic_uint* rejected [[buffer(2)]], uint2 p [[thread_position_in_grid]]) {
+  if (any(p >= c.size)) return;
+  uint2 at = c.stretch ? stretched(c.origin + p, c)
+                       : (c.origin + p * c.samples + sample_offset(c.sample_select, c.samples)) / c.tex_ss;
+  float depth = source.read(at) * c.scale;
+  destination.write(float4(depth), p);
+  // Depth resolves write the EDRAM depth format whatever the destination format says: 24-bit
+  // depth over 8-bit stencil (the stencil read through an X32_Stencil8 view of the target).
+  if (!c.write_memory) return;
+  uint d24 = c.format == 23 ? float32_to_20e4(depth) : uint(rint(saturate(depth) * 16777215.0f));
+  store_raw(uint4((d24 << 8) | (stencil.read(at).r & 0xFFu), 0, 0, 0), 2, p, c, memory, rejected);
+}
+kernel void resolve_color_ms(texture2d_ms<float, access::read> source [[texture(0)]],
+    texture2d<float, access::write> destination [[texture(1)]],
+    constant ResolveConstants& c [[buffer(0)]], device uchar* memory [[buffer(1)]],
+    device atomic_uint* rejected [[buffer(2)]], uint2 p [[thread_position_in_grid]]) {
+  if (any(p >= c.size)) return;
+  uint2 base = c.origin + p * c.samples;
+  float4 value;
+  if (c.sample_select < 4) {
+    uint2 at = base + sample_offset(c.sample_select, c.samples);
+    value = source.read(at / c.samples, host_sample(at % c.samples, c.samples));
+  } else {
+    value = float4(0);
+    uint n = c.samples.x * c.samples.y;
+    for (uint i = 0; i < n; ++i) value += source.read(base / c.samples, i);
+    value /= float(n);
+  }
+  value *= c.scale;
+  if (c.swap) value = value.bgra;
+  destination.write(value, p);
+  store_guest(value, p, c, memory, rejected);
+}
+kernel void resolve_depth_ms(depth2d_ms<float, access::read> source [[texture(0)]],
+    texture2d<float, access::write> destination [[texture(1)]],
+    texture2d_ms<uint, access::read> stencil [[texture(2)]],
+    constant ResolveConstants& c [[buffer(0)]], device uchar* memory [[buffer(1)]],
+    device atomic_uint* rejected [[buffer(2)]], uint2 p [[thread_position_in_grid]]) {
+  if (any(p >= c.size)) return;
+  uint2 at = c.origin + p * c.samples + sample_offset(c.sample_select, c.samples);
+  uint2 pixel = at / c.samples; uint index = host_sample(at % c.samples, c.samples);
+  float depth = source.read(pixel, index) * c.scale;
+  destination.write(float4(depth), p);
+  if (!c.write_memory) return;
+  uint d24 = c.format == 23 ? float32_to_20e4(depth) : uint(rint(saturate(depth) * 16777215.0f));
+  store_raw(uint4((d24 << 8) | (stencil.read(pixel, index).r & 0xFFu), 0, 0, 0), 2, p, c, memory, rejected);
+}
+// Guest texture memory to linear blocks, for a blit into the texture (any format, compressed too).
+struct LoadConstants {
+  uint src_base, slice_stride, row_pitch_bytes, pitch_blocks, log_bpp, ox, oy, tiled, xor_mask, bw, bh, convert;
+};
+float float20e4_to_32(uint f24) {
+  f24 &= 0xFFFFFFu;
+  if (!f24) return 0.0f;
+  uint mantissa = f24 & 0xFFFFFu, exponent = f24 >> 20;
+  if (!exponent) {
+    uint lz = clz(mantissa) - (32 - 21);
+    exponent = uint(1 - int(lz)); mantissa = (mantissa << lz) & 0xFFFFFu;
+  }
+  return as_type<float>(((exponent + 112) << 23) | (mantissa << 3));
+}
+kernel void load_texture(device const uchar* memory [[buffer(0)]], device uchar* out [[buffer(1)]],
+    constant LoadConstants& c [[buffer(2)]], uint3 p [[thread_position_in_grid]]) {
+  if (p.x >= c.bw || p.y >= c.bh) return;
+  uint bpb = 1u << c.log_bpp;
+  uint offset = c.tiled ? tiled_offset(uint2(p.x + c.ox, p.y + c.oy), c.pitch_blocks, c.log_bpp)
+                        : (p.y + c.oy) * c.row_pitch_bytes + (p.x + c.ox) * bpb;
+  uint src = c.src_base + p.z * c.slice_stride + offset;
+  uint dst = ((p.z * c.bh + p.y) * c.bw + p.x) * (c.convert >= 3 ? 4u : bpb);
+  bool inside = src + bpb <= 0x20000000u;
+  if (c.convert >= 3) {
+    // 16-bit packed, red in the low bits: 3 k_1_5_5_5, 4 k_5_6_5, 5 k_6_5_5, 6 k_4_4_4_4. Formats
+    // without alpha repeat blue there, like the Vulkan backend's RGBB swizzle.
+    uint v = inside ? (uint(memory[src ^ c.xor_mask]) | (uint(memory[(src + 1) ^ c.xor_mask]) << 8)) : 0u;
+    float4 f;
+    if (c.convert == 3) f = float4(v & 31u, (v >> 5) & 31u, (v >> 10) & 31u, 0) / 31.0f, f.w = float(v >> 15);
+    else if (c.convert == 4) f = float4(float(v & 31u) / 31.0f, float((v >> 5) & 63u) / 63.0f, float(v >> 11) / 31.0f, 0);
+    else if (c.convert == 5) f = float4(float(v & 31u) / 31.0f, float((v >> 5) & 31u) / 31.0f, float(v >> 10) / 63.0f, 0);
+    else f = float4(v & 15u, (v >> 4) & 15u, (v >> 8) & 15u, v >> 12) / 15.0f;
+    if (c.convert == 4 || c.convert == 5) f.w = f.z;
+    uint4 u = uint4(rint(saturate(f) * 255.0f));
+    for (uint i = 0; i < 4; ++i) out[dst + i] = uchar(u[i]);
+    return;
+  }
+  if (c.convert) {
+    // k_24_8 and k_24_8_FLOAT as R32Float depth, like a depth resolve's own texture.
+    uint v = 0;
+    for (uint i = 0; i < 4; ++i) v |= uint(inside ? memory[(src + i) ^ c.xor_mask] : 0) << (i * 8);
+    uint d24 = v >> 8;
+    float depth = c.convert == 1 ? float(d24 + (d24 >> 23)) * (1.0f / 16777216.0f) : float20e4_to_32(d24);
+    uint bits = as_type<uint>(depth);
+    for (uint i = 0; i < 4; ++i) out[dst + i] = uchar(bits >> (i * 8));
+    return;
+  }
+  if (bpb >= 4) {
+    // Whole words: byte i of the texel is memory byte (src + i) ^ xor_mask, so word k comes from word
+    // k ^ (xor_mask >> 2), permuted inside by xor_mask & 3 (byte loads and stores were 4 to 8 times
+    // the memory transactions).
+    device const uint* words = reinterpret_cast<device const uint*>(memory);
+    device uint* out_words = reinterpret_cast<device uint*>(out);
+    uint word_xor = c.xor_mask >> 2, byte_xor = c.xor_mask & 3u;
+    for (uint k = 0; k < (bpb >> 2); ++k) {
+      uint w = inside ? words[((src >> 2) + k) ^ word_xor] : 0u;
+      if (byte_xor == 1u) w = ((w & 0x00FF00FFu) << 8) | ((w >> 8) & 0x00FF00FFu);
+      else if (byte_xor == 2u) w = (w << 16) | (w >> 16);
+      else if (byte_xor == 3u) w = (w << 24) | ((w & 0xFF00u) << 8) | ((w >> 8) & 0xFF00u) | (w >> 24);
+      out_words[(dst >> 2) + k] = w;
+    }
+    return;
+  }
+  for (uint i = 0; i < bpb; ++i) out[dst + i] = inside ? memory[(src + i) ^ c.xor_mask] : uchar(0);
+}
+struct PresentConstants { uint2 size; uint mode; };  // mode 0: as is, 1: 256-entry table, 2: PWL
+struct GammaRamp { uint table[256]; uint pwl[128 * 3]; };
+// DC_LUT_30_COLOR: blue in bits 0:9, green 10:19, red 20:29.
+float ramp_table(constant GammaRamp& g, float v, uint shift) {
+  return float((g.table[uint(saturate(v) * 255.0f + 0.5f)] >> shift) & 1023u) / 1023.0f;
+}
+// DC_LUT_PWL_DATA: 128 segments of 8 steps over the 10-bit input, base and delta in the high 10 of 16 bits.
+float ramp_pwl(constant GammaRamp& g, float v, uint channel) {
+  uint x = uint(saturate(v) * 1023.0f + 0.5f);
+  uint d = g.pwl[(x >> 3) * 3 + channel];
+  float value = float(d & 0xFFFFu) + float((x & 7u) * (d >> 16)) * 0.125f;
+  return saturate(value * 1.52737048e-05f);
+}
+kernel void present_color(texture2d_array<float, access::read> source [[texture(0)]],
+    texture2d<float, access::write> destination [[texture(1)]],
+    constant PresentConstants& c [[buffer(0)]], constant GammaRamp& g [[buffer(1)]],
+    uint2 p [[thread_position_in_grid]]) {
+  if (any(p >= c.size)) return;
+  float4 color = source.read(p, 0);
+  if (c.mode == 1) color.rgb = float3(ramp_table(g, color.r, 20), ramp_table(g, color.g, 10), ramp_table(g, color.b, 0));
+  else if (c.mode == 2) color.rgb = float3(ramp_pwl(g, color.r, 0), ramp_pwl(g, color.g, 1), ramp_pwl(g, color.b, 2));
+  destination.write(color, p);
+}
+
+// EDRAM ownership transfers: a target takes over the tiles another one (another format, pitch, or
+// depth against color) wrote since, as the same raw dwords, like Xenos EDRAM. A tile row is 80 dwords:
+// 80 samples of a 32bpp format or 40 of a 64bpp one (sample x in dwords 2x, its red and green or its
+// first half, and 2x + 1).
+// Kinds: 0 k_8_8_8_8, 1 k_2_10_10_10, 2 k_2_10_10_10_FLOAT (7e3), 3 k_16_16, 4 k_16_16_FLOAT,
+// 5 k_32_FLOAT, 6 D24S8, 7 D24FS8 (the host keeps half of the guest's 20e4 depth); 64bpp:
+// 8 k_16_16_16_16, 9 k_16_16_16_16_FLOAT, 10 k_32_32_FLOAT.
+struct TransferConstants {
+  uint dst_base, dst_pitch, src_base, src_pitch;  // tiles; a tile is 80x16 samples (32bpp)
+  uint lo, hi;  // the EDRAM tiles taken over
+  uint src_kind, dst_kind;
+  uint2 dst_ss, src_ss;  // samples a texel of each holds (1x1 for a single-sample texture; metal_msaa)
+  uint dst_dw, src_dw;  // dwords a sample (2 for 64bpp)
+};
+// Resolve clears: a scissored full-screen triangle over only the resolved rectangle.
+struct ClearConstants { float4 color; float depth; };
+fragment float4 clear_color_fs(constant ClearConstants& c [[buffer(0)]]) { return c.color; }
+struct ClearDepthOut { float depth [[depth(any)]]; };
+fragment ClearDepthOut clear_depth_fs(constant ClearConstants& c [[buffer(0)]]) { ClearDepthOut o; o.depth = c.depth; return o; }
+vertex float4 transfer_vs(uint id [[vertex_id]]) {
+  return float4(float2((id << 1) & 2, id & 2) * 2.0f - 1.0f, 0.0f, 1.0f);
+}
+float f7e3_to_32(uint v) {
+  uint m = v & 0x7Fu, e = (v >> 7) & 7u;
+  return e ? ldexp(1.0f + float(m) / 128.0f, int(e) - 3) : ldexp(float(m) / 128.0f, -2);
+}
+uint f32_to_7e3(float f) {
+  f = clamp(f, 0.0f, 31.875f);
+  if (f < 0.25f) return uint(rint(f * 512.0f));
+  int e = clamp(int(floor(log2(f))) + 3, 1, 7);
+  uint m = uint(rint((f / exp2(float(e - 3)) - 1.0f) * 128.0f));
+  if (m >= 128u) { m = 0; ++e; }
+  return e > 7 ? 0x3FFu : ((uint(e) << 7) | m);
+}
+uint snorm16x2(float2 v) { int2 i = int2(rint(clamp(v, -1.0f, 1.0f) * 32767.0f)); return (uint(i.x) & 0xFFFFu) | (uint(i.y) << 16); }
+float2 snorm16x2(uint b) { return max(float2(int(b << 16) >> 16, int(b) >> 16) / 32767.0f, -1.0f); }
+uint pack_color32(float4 v, uint kind) {
+  switch (kind) {
+    case 0: { uint4 u = uint4(rint(saturate(v) * 255.0f)); return u.x | (u.y << 8) | (u.z << 16) | (u.w << 24); }
+    case 1: { uint4 u = uint4(rint(saturate(v) * float4(1023, 1023, 1023, 3))); return u.x | (u.y << 10) | (u.z << 20) | (u.w << 30); }
+    case 2: return f32_to_7e3(v.x) | (f32_to_7e3(v.y) << 10) | (f32_to_7e3(v.z) << 20) | (uint(rint(saturate(v.w) * 3.0f)) << 30);
+    case 3: return snorm16x2(v.xy);
+    case 4: return as_type<uint>(half2(v.xy));
+    default: return as_type<uint>(v.x);
+  }
+}
+uint2 pack_color(float4 v, uint kind) {
+  switch (kind) {
+    case 8: return uint2(snorm16x2(v.xy), snorm16x2(v.zw));
+    case 9: return as_type<uint2>(half4(v));
+    case 10: return as_type<uint2>(v.xy);
+    default: return uint2(pack_color32(v, kind), 0u);
+  }
+}
+float4 unpack_color32(uint b, uint kind) {
+  switch (kind) {
+    case 0: return float4(b & 255u, (b >> 8) & 255u, (b >> 16) & 255u, b >> 24) / 255.0f;
+    case 1: return float4(float(b & 1023u) / 1023.0f, float((b >> 10) & 1023u) / 1023.0f, float((b >> 20) & 1023u) / 1023.0f, float(b >> 30) / 3.0f);
+    case 2: return float4(f7e3_to_32(b & 1023u), f7e3_to_32((b >> 10) & 1023u), f7e3_to_32((b >> 20) & 1023u), float(b >> 30) / 3.0f);
+    case 3: return float4(snorm16x2(b), 0.0f, 1.0f);
+    case 4: return float4(float2(as_type<half2>(b)), 0.0f, 1.0f);
+    default: return float4(as_type<float>(b), 0.0f, 0.0f, 1.0f);
+  }
+}
+float4 unpack_color(uint2 b, uint kind) {
+  switch (kind) {
+    case 8: return float4(snorm16x2(b.x), snorm16x2(b.y));
+    case 9: return float4(as_type<half4>(b));
+    case 10: return float4(as_type<float2>(b), 0.0f, 1.0f);
+    default: return unpack_color32(b.x, kind);
+  }
+}
+uint pack_depth(float depth, uint stencil, uint kind) {
+  uint d24 = kind == 7 ? float32_to_20e4(depth * 2.0f) : uint(rint(saturate(depth) * 16777215.0f));
+  return (d24 << 8) | (stencil & 0xFFu);
+}
+// Where dword k of this destination sample (both in EDRAM sample space) is in the source, through the EDRAM tile
+// both cover: the source sample s and its dword sk.
+bool transfer_source(uint2 d, uint k, constant TransferConstants& c, uint2 source_size, thread uint2& s, thread uint& sk) {
+  uint x = d.x * c.dst_dw + k;
+  uint column = x / 80u;
+  if (column >= c.dst_pitch) return false;
+  uint tile = c.dst_base + (d.y >> 4) * c.dst_pitch + column;
+  if (tile < c.lo || tile >= c.hi || tile < c.src_base) return false;
+  uint rel = tile - c.src_base;
+  uint sx = (rel % c.src_pitch) * 80u + x % 80u;
+  s = uint2(sx / c.src_dw, (rel / c.src_pitch) * 16u + (d.y & 15u));
+  sk = sx % c.src_dw;
+  return all(s < source_size);
+}
+struct TransferDepthOut { float depth [[depth(any)]]; uint stencil [[stencil]]; };
+TransferDepthOut unpack_depth(uint b, uint kind) {
+  TransferDepthOut out;
+  uint d24 = b >> 8;
+  out.depth = kind == 7 ? float20e4_to_32(d24) * 0.5f : float(d24) / 16777215.0f;
+  out.stencil = b & 0xFFu;
+  return out;
+}
+// Reading a source at a sample-space position, single-sample or multisample.
+float4 read_color(texture2d<float, access::read> t, uint2 s, uint2 ss) { return t.read(s / ss); }
+float4 read_color(texture2d_ms<float, access::read> t, uint2 s, uint2 ss) { return t.read(s / ss, host_sample(s % ss, ss)); }
+float read_depth(depth2d<float, access::read> t, uint2 s, uint2 ss) { return t.read(s / ss); }
+float read_depth(depth2d_ms<float, access::read> t, uint2 s, uint2 ss) { return t.read(s / ss, host_sample(s % ss, ss)); }
+uint read_stencil(texture2d<uint, access::read> t, uint2 s, uint2 ss) { return t.read(s / ss).r; }
+uint read_stencil(texture2d_ms<uint, access::read> t, uint2 s, uint2 ss) { return t.read(s / ss, host_sample(s % ss, ss)).r; }
+template <typename T> uint2 sample_size(T t, uint2 ss) { return uint2(t.get_width(), t.get_height()) * ss; }
+// A single-sample texture's texel may hold several samples (metal_4x_as_1x: 2x2): it is drawn as its first.
+// Variants: _sm a multisample source, _dm a multisample destination (run per sample).
+#define SRC_COLOR_P texture2d<float, access::read>
+#define SRC_COLOR_M texture2d_ms<float, access::read>
+#define SRC_DEPTH_P depth2d<float, access::read>
+#define SRC_DEPTH_M depth2d_ms<float, access::read>
+#define SRC_STENCIL_P texture2d<uint, access::read>
+#define SRC_STENCIL_M texture2d_ms<uint, access::read>
+#define DST_ARGS_P
+#define DST_ARGS_M , uint sid [[sample_id]]
+#define DST_COORD_P (uint2(position.xy) * c.dst_ss)
+#define DST_COORD_M (uint2(position.xy) * c.dst_ss + guest_sub(sid, c.dst_ss))
+// The destination sample's dwords (b) from a color or a depth source; discarded where the source has none.
+#define TRANSFER_DWORDS(D, PACK) \
+  uint2 d = DST_COORD_##D, s, s1; uint sk, sk1; \
+  if (!transfer_source(d, 0u, c, sample_size(source, c.src_ss), s, sk)) discard_fragment(); \
+  uint2 p = PACK(s), b = uint2(p[sk], 0u); \
+  if (c.dst_dw > 1u && transfer_source(d, 1u, c, sample_size(source, c.src_ss), s1, sk1)) { \
+    if (any(s1 != s)) p = PACK(s1); \
+    b.y = p[sk1]; \
+  }
+#define PACK_COLOR(at) pack_color(read_color(source, at, c.src_ss), c.src_kind)
+#define PACK_DEPTH(at) uint2(pack_depth(read_depth(source, at, c.src_ss), read_stencil(stencil, at, c.src_ss), c.src_kind), 0u)
+#define TRANSFERS(SUFFIX, S, D) \
+fragment float4 transfer_color_from_color##SUFFIX(float4 position [[position]], constant TransferConstants& c [[buffer(0)]], \
+    SRC_COLOR_##S source [[texture(0)]] DST_ARGS_##D) { \
+  TRANSFER_DWORDS(D, PACK_COLOR) \
+  return unpack_color(b, c.dst_kind); \
+} \
+fragment float4 transfer_color_from_depth##SUFFIX(float4 position [[position]], constant TransferConstants& c [[buffer(0)]], \
+    SRC_DEPTH_##S source [[texture(0)]], SRC_STENCIL_##S stencil [[texture(1)]] DST_ARGS_##D) { \
+  TRANSFER_DWORDS(D, PACK_DEPTH) \
+  return unpack_color(b, c.dst_kind); \
+} \
+fragment TransferDepthOut transfer_depth_from_color##SUFFIX(float4 position [[position]], constant TransferConstants& c [[buffer(0)]], \
+    SRC_COLOR_##S source [[texture(0)]] DST_ARGS_##D) { \
+  TRANSFER_DWORDS(D, PACK_COLOR) \
+  return unpack_depth(b.x, c.dst_kind); \
+} \
+fragment TransferDepthOut transfer_depth_from_depth##SUFFIX(float4 position [[position]], constant TransferConstants& c [[buffer(0)]], \
+    SRC_DEPTH_##S source [[texture(0)]], SRC_STENCIL_##S stencil [[texture(1)]] DST_ARGS_##D) { \
+  TRANSFER_DWORDS(D, PACK_DEPTH) \
+  return unpack_depth(b.x, c.dst_kind); \
+}
+TRANSFERS(, P, P)
+TRANSFERS(_sm, M, P)
+TRANSFERS(_dm, P, M)
+TRANSFERS(_sm_dm, M, M)
+// The same into color attachment N of a draw's own pass (EDRAM transfers drawn first in the pass that
+// needs them, instead of a pass of their own that loads and stores the target once more).
+#define TRANSFER_INTO_COLOR(N, SUFFIX, S, D) \
+fragment TransferColorOut##N transfer_color_from_color_##N##SUFFIX(float4 position [[position]], \
+    constant TransferConstants& c [[buffer(0)]], SRC_COLOR_##S source [[texture(0)]] DST_ARGS_##D) { \
+  TRANSFER_DWORDS(D, PACK_COLOR) \
+  TransferColorOut##N o; o.color = unpack_color(b, c.dst_kind); return o; \
+} \
+fragment TransferColorOut##N transfer_color_from_depth_##N##SUFFIX(float4 position [[position]], \
+    constant TransferConstants& c [[buffer(0)]], SRC_DEPTH_##S source [[texture(0)]], \
+    SRC_STENCIL_##S stencil [[texture(1)]] DST_ARGS_##D) { \
+  TRANSFER_DWORDS(D, PACK_DEPTH) \
+  TransferColorOut##N o; o.color = unpack_color(b, c.dst_kind); return o; \
+}
+#define TRANSFER_OUT(N) struct TransferColorOut##N { float4 color [[color(N)]]; };
+#define TRANSFERS_INTO_COLOR(N) TRANSFER_OUT(N) TRANSFER_INTO_COLOR(N, , P, P) TRANSFER_INTO_COLOR(N, _sm, M, P) \
+    TRANSFER_INTO_COLOR(N, _dm, P, M) TRANSFER_INTO_COLOR(N, _sm_dm, M, M)
+TRANSFERS_INTO_COLOR(0)
+TRANSFERS_INTO_COLOR(1)
+TRANSFERS_INTO_COLOR(2)
+TRANSFERS_INTO_COLOR(3)
+// Resolve clears drawn first in the next pass on their target, into its color attachment N.
+#define CLEAR_INTO_COLOR(N) \
+struct ClearColorOut##N { float4 color [[color(N)]]; }; \
+fragment ClearColorOut##N clear_color_fs_##N(constant ClearConstants& c [[buffer(0)]]) { \
+  ClearColorOut##N o; o.color = c.color; return o; \
+}
+CLEAR_INTO_COLOR(0)
+CLEAR_INTO_COLOR(1)
+CLEAR_INTO_COLOR(2)
+CLEAR_INTO_COLOR(3)
+// Temporal anti-aliasing (MetalFX, at Midnight Club's motion blur draw): motion vectors from the game's own
+// reprojection (taa_motion_vectors_mcla.cs.xesl of rexglue-temporal-aa.patch, the same maths): per pixel, the
+// unjittered centre and the depth (1 near, 0 far) make the clip position, which the matrix of the pixel's
+// vehicle ID (the stencil >> 2) takes to the previous frame's guest pixels. Previous minus current, in pixels.
+// With upscaling (taa_upscale_gather_mcla.cs.xesl of rexglue-fsr-upscaling.patch) the scene was drawn into the
+// render-size corner and resolved stretched to the output size: render pixel i is output pixel
+// (2 * output * i + render - 1) / (2 * render), the first to show it, where the depth, the stencil and (when
+// asked) the colour are taken from. At the native size that is pixel i itself.
+struct TaaMvConstants { float4 previous[96]; float4 size; float4 jitter; uint4 map; };  // map: output w, h, render w, h
+uint2 taa_source(uint2 i, uint4 map) { return min((i * map.xy * 2u + map.zw - 1u) / (map.zw * 2u), map.xy - 1u); }
+kernel void taa_motion_vectors(constant TaaMvConstants& c [[buffer(0)]],
+    texture2d_array<float, access::read> depth [[texture(0)]], texture2d_array<float, access::read> stencil [[texture(1)]],
+    texture2d<float, access::write> dest [[texture(2)]], texture2d_array<float, access::read> scene [[texture(3)]],
+    texture2d<float, access::write> color [[texture(4)]], uint2 p [[thread_position_in_grid]]) {
+  if (p.x >= uint(c.size.x) || p.y >= uint(c.size.y)) return;
+  uint2 source = taa_source(p, c.map);
+  if (c.jitter.w != 0.0f) color.write(scene.read(source, 0), p);
+  float d = depth.read(source, 0).x;
+  float s = stencil.read(source, 0)[uint(c.jitter.z)];
+  uint id = uint(s * 255.0f + 0.5f) >> 2u;
+  if (id >= 24u) id = 0u;
+  float2 position = float2(p) + 0.5f - c.jitter.xy;
+  float2 uv = position / c.size.xy;
+  float4 clip = float4(uv.x * 2.0f - 1.0f, 1.0f - uv.y * 2.0f, 1.0f - d, 1.0f);
+  uint row = id * 4u;
+  float4 previous = clip.x * c.previous[row] + clip.y * c.previous[row + 1u] + clip.z * c.previous[row + 2u] +
+                    clip.w * c.previous[row + 3u];
+  float2 motion = float2(0.0f);
+  if (abs(previous.w) > 1.0e-20f) {
+    motion = previous.xy / previous.w * c.size.zw - position;
+    if ((as_type<uint>(motion.x) & 0x7FFFFFFFu) > 0x7F800000u || (as_type<uint>(motion.y) & 0x7FFFFFFFu) > 0x7F800000u)
+      motion = float2(0.0f);
+    motion = clamp(motion, -c.size.xy, c.size.xy);
+  }
+  dest.write(float4(motion, 0.0f, 0.0f), p);
+}
+// The depth for MetalFX, which takes a depth format (at the render size, from the same pixels as the vectors).
+struct TaaDepthOut { float depth [[depth(any)]]; };
+fragment TaaDepthOut taa_depth_fs(float4 position [[position]], texture2d_array<float, access::read> source [[texture(0)]],
+    constant uint4& map [[buffer(0)]]) {
+  TaaDepthOut o; o.depth = source.read(taa_source(uint2(position.xy), map), 0).x; return o;
+}
+)MSL";
+}
diff --git a/src/graphics/metal/metal_shader_translator.cpp b/src/graphics/metal/metal_shader_translator.cpp
new file mode 100644
