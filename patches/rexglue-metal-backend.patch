+
+GpuEncoder GpuCommands::Render(MTLRenderPassDescriptor* pass) {
+  GpuEncoder e;
+  e.kind_ = GpuEncoder::Kind::kRender;
+  if (@available(macOS 26.0, *)) {
+    if (rec_) {
+      GpuRecording& r = *rec_;
+      r.EndCompute();
+      auto p = [MTL4RenderPassDescriptor new];
+      for (NSUInteger i = 0; i < 8; ++i) {
+        MTLRenderPassColorAttachmentDescriptor* a = pass.colorAttachments[i];
+        if (!a.texture) continue;
+        r.queue->UseIn(r, a.texture);
+        if (a.resolveTexture) r.queue->UseIn(r, a.resolveTexture);
+        p.colorAttachments[i] = a;
+      }
+      if (pass.depthAttachment.texture) { r.queue->UseIn(r, pass.depthAttachment.texture); p.depthAttachment = pass.depthAttachment; }
+      if (pass.stencilAttachment.texture) { r.queue->UseIn(r, pass.stencilAttachment.texture); p.stencilAttachment = pass.stencilAttachment; }
+      p.renderTargetWidth = pass.renderTargetWidth;
+      p.renderTargetHeight = pass.renderTargetHeight;
+      p.renderTargetArrayLength = pass.renderTargetArrayLength;
+      p.defaultRasterSampleCount = pass.defaultRasterSampleCount;
+      if (pass.visibilityResultBuffer) {
+        r.queue->UseIn(r, pass.visibilityResultBuffer);
+        p.visibilityResultBuffer = pass.visibilityResultBuffer;
+        p.visibilityResultType = pass.visibilityResultType;
+      }
+      id<MTL4RenderCommandEncoder> encoder = [r.cb renderCommandEncoderWithDescriptor:p];
+      if (REXCVAR_GET(metal_metal4_narrow_barriers) && !r.after_external) {
+        // Writes before it come from compute and copies (resolves, texture loads, guest memory) and from earlier
+        // passes' fragments (attachments it loads, textures it samples or overwrites). No pass's vertex stage writes.
+        [encoder barrierAfterQueueStages:kComputeStages beforeStages:kRenderStages visibilityOptions:MTL4VisibilityOptionDevice];
+        [encoder barrierAfterQueueStages:MTLStageFragment beforeStages:MTLStageFragment
+                       visibilityOptions:MTL4VisibilityOptionDevice];
+      } else {
+        [encoder barrierAfterQueueStages:kAllStages beforeStages:kRenderStages visibilityOptions:MTL4VisibilityOptionDevice];
+      }
+      r.after_external = false;
+      r.state = {};
+      [encoder setArgumentTable:r.tables[1] atStages:MTLRenderStageVertex];
+      [encoder setArgumentTable:r.tables[0] atStages:MTLRenderStageFragment];
+      e.enc_ = encoder;
+      e.rec_ = rec_;
+      e.recording_ = r.stamp;
+      e.render_ = ++r.renders;
+      return e;
+    }
+  }
+  e.enc_ = [cb3_ renderCommandEncoderWithDescriptor:pass];
+  return e;
+}
+
+GpuEncoder GpuCommands::Compute() {
+  GpuEncoder e;
+  e.kind_ = GpuEncoder::Kind::kCompute;
+  if (@available(macOS 26.0, *)) {
+    if (rec_) {
+      GpuRecording& r = *rec_;
+      if (!r.compute) {
+        r.compute = [r.cb computeCommandEncoder];
+        r.after_external = false;  // it waits for all stages anyway
+        r.compute_pipeline = nullptr;
+        [r.compute barrierAfterQueueStages:kAllStages beforeStages:kComputeStages
+                         visibilityOptions:MTL4VisibilityOptionDevice];
+        [r.compute setArgumentTable:r.tables[2]];
+        r.compute_ops = false;
+      }
+      e.enc_ = r.compute;
+      e.rec_ = rec_;
+      return e;
+    }
+  }
+  e.enc_ = [cb3_ computeCommandEncoder];
+  return e;
+}
+
+GpuEncoder GpuCommands::Blit() {
+  if (@available(macOS 26.0, *)) {
+    if (rec_) {
+      GpuEncoder e = Compute();
+      e.kind_ = GpuEncoder::Kind::kBlit;
+      return e;
+    }
+  }
+  GpuEncoder e;
+  e.kind_ = GpuEncoder::Kind::kBlit;
+  e.enc_ = [cb3_ blitCommandEncoder];
+  return e;
+}
+
+void GpuCommands::AddCompleted(GpuDoneBlock block) {
+  if (@available(macOS 26.0, *)) {
+    if (rec_) { rec_->done.push_back(block); return; }
+  }
+  [cb3_ addCompletedHandler:^(id<MTLCommandBuffer> cb) {
+    GpuDone done{cb.GPUStartTime, cb.GPUEndTime, cb.status == MTLCommandBufferStatusError ? cb.error : nil};
+    block(done);
+  }];
+}
