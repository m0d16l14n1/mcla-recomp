+      swap = 0, write_memory = 0;
+  float scale = 1.0f; uint32_t padding = 0;
+  uint32_t samples_x = 1, samples_y = 1, sample_select = 0, extent_start = 0, extent_end = 0, stretch = 0;
+  uint32_t stretch_num[2] = {}, stretch_den[2] = {};  // temporal_aa_upscale: the render and output sizes
+  uint32_t tex_ss[2] = {1, 1};  // samples a texel of a single-sample source holds (metal_4x_as_1x)
+  uint32_t rs = 1, padding2 = 0;  // resolution_scale: source and destination texels across and down a guest pixel
