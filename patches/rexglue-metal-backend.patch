+  uint32_t dst_ss[2], src_ss[2];
+  uint32_t dst_dw, src_dw;  // EDRAM dwords a sample: 2 for 64bpp formats
+  uint32_t scale = 1, padding = 0;  // the resolution scale (MetalResolutionScale), both single-sample targets
+};
+template <typename T> void Key(std::string& key, T value) {
+  key.append(reinterpret_cast<const char*>(&value), sizeof(value));
