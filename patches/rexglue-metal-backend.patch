+REXCVAR_DEFINE_BOOL(metal_gpu_fences, false, "GPU/Metal",
+    "Guest fences (EVENT_WRITE_SHD) written by the GPU after the work before them, not by the command processor");
+REXCVAR_DEFINE_BOOL(metal_resolve_to_memory, true, "GPU/Metal", "Resolves write guest memory (diagnostic: false keeps them on the GPU only)");
+REXCVAR_DEFINE_BOOL(metal_draw_cpu_only, false, "GPU/Metal", "Draws stop after the primitive processor and the vertex snapshot (diagnostic)");
+REXCVAR_DEFINE_BOOL(metal_texture_loads, true, "GPU/Metal", "Load textures from guest memory (diagnostic: false binds a blank texture)");
+REXCVAR_DEFINE_BOOL(metal_draw_calls, true, "GPU/Metal", "Issue the draw calls (diagnostic: false encodes everything else of a draw)");
+REXCVAR_DEFINE_INT32(metal_draw_stop, 0, "GPU/Metal",
+    "Diagnostic: draws stop after the shaders (2), the pipeline (3) or the texture loads (4); 0 draws");
+REXCVAR_DEFINE_INT32(metal_frame_sleep_ms, 0, "GPU/Metal", "Diagnostic: the command processor sleeps this long at every frame's end");
+REXCVAR_DEFINE_BOOL(metal_gamma_ramp, true, "GPU/Metal", "Apply the guest's display gamma ramp at the swap (false: the front buffer as it is)");
+REXCVAR_DEFINE_BOOL(metal_resolve_wait, false, "GPU/Metal", "Wait for the GPU after every resolve (diagnostic)");
+REXCVAR_DEFINE_UINT32(metal_snapshot_trust_size, 65536, "GPU/Metal",
+    "Vertex or index ranges at least this large are hashed once a frame, not at every draw (0xFFFFFFFF: every draw)");
+REXCVAR_DEFINE_BOOL(metal_snapshot_vertices, true, "GPU/Metal", "Snapshot guest vertices and indices at draw time (disable only for diagnosis)");
+REXCVAR_DEFINE_UINT32(metal_debug_frame, 0, "GPU/Metal", "Dump every resolve in this swap frame (0 disables)");
+REXCVAR_DEFINE_BOOL(metal_debug_all_draws, false, "GPU/Metal", "In a dumped frame, log every draw (not every 64th)");
+REXCVAR_DEFINE_INT32(metal_debug_depth_dumps, 0, "GPU/Metal", "In a dumped frame, dump the depth target after depth-ALWAYS draws (1) or every draw (2)");
+REXCVAR_DEFINE_INT32(metal_debug_rt_base, -1, "GPU/Metal", "In a dumped frame, dump color target 0 after every draw into this EDRAM base (-1: off)");
+REXCVAR_DEFINE_BOOL(metal_edram_transfers, true, "GPU/Metal", "Targets sharing EDRAM tiles take over each other's writes (raw bits, like Xenos EDRAM)");
+REXCVAR_DEFINE_BOOL(metal_debug_capture, false, "GPU/Metal", "Dump the next swap frame like metal_debug_frame (for pad scripts: set metal_debug_capture true)");
+REXCVAR_DEFINE_STRING(metal_debug_dir, "", "GPU/Metal", "Folder for native Metal resolve diagnostics");
+
+namespace rex::graphics::metal {
+namespace {
+// PrimitiveProcessor needs the common shared-memory range service. No uploads or write watches
+// are necessary for the no-copy buffer. Converted indices are invalidated at each draw below.
+class UnifiedMemory final : public SharedMemory {
+ public:
+  explicit UnifiedMemory(memory::Memory& memory) : SharedMemory(memory) { InitializeCommon(); }
+ private:
+  bool UploadRanges(const std::vector<std::pair<uint32_t, uint32_t>>&) override { return true; }
+};
+MTLPixelFormat ColorFormat(xenos::ColorRenderTargetFormat format) {
+  using F = xenos::ColorRenderTargetFormat;
+  switch (format) {
+    case F::k_8_8_8_8: case F::k_8_8_8_8_GAMMA: return MTLPixelFormatRGBA8Unorm;
+    case F::k_2_10_10_10: return MTLPixelFormatRGB10A2Unorm;
+    case F::k_2_10_10_10_FLOAT: case F::k_2_10_10_10_AS_10_10_10_10:
+    case F::k_2_10_10_10_FLOAT_AS_16_16_16_16: return MTLPixelFormatRGBA16Float;
+    case F::k_16_16: return MTLPixelFormatRG16Snorm;
+    case F::k_16_16_16_16: return MTLPixelFormatRGBA16Snorm;
+    case F::k_16_16_FLOAT: return MTLPixelFormatRG16Float;
+    case F::k_16_16_16_16_FLOAT: return MTLPixelFormatRGBA16Float;
+    case F::k_32_FLOAT: return MTLPixelFormatR32Float;
+    case F::k_32_32_FLOAT: return MTLPixelFormatRG32Float;
+    default: return MTLPixelFormatInvalid;
+  }
+}
+MTLBlendFactor BlendFactor(xenos::BlendFactor f) {
+  switch (uint32_t(f)) {
+    case 0: return MTLBlendFactorZero; case 1: return MTLBlendFactorOne;
+    case 4: return MTLBlendFactorSourceColor; case 5: return MTLBlendFactorOneMinusSourceColor;
+    case 6: return MTLBlendFactorSourceAlpha; case 7: return MTLBlendFactorOneMinusSourceAlpha;
+    case 8: return MTLBlendFactorDestinationColor; case 9: return MTLBlendFactorOneMinusDestinationColor;
+    case 10: return MTLBlendFactorDestinationAlpha; case 11: return MTLBlendFactorOneMinusDestinationAlpha;
+    case 12: return MTLBlendFactorBlendColor; case 13: return MTLBlendFactorOneMinusBlendColor;
+    case 14: return MTLBlendFactorBlendAlpha; case 15: return MTLBlendFactorOneMinusBlendAlpha;
+    case 16: return MTLBlendFactorSourceAlphaSaturated;
+    default: return MTLBlendFactorOne;
+  }
+}
+MTLBlendOperation BlendOp(xenos::BlendOp op) {
+  switch (uint32_t(op)) {
+    case 1: return MTLBlendOperationSubtract; case 2: return MTLBlendOperationMin;
+    case 3: return MTLBlendOperationMax; case 4: return MTLBlendOperationReverseSubtract;
+    default: return MTLBlendOperationAdd;
+  }
+}
+MTLStencilOperation StencilOp(uint32_t op) {
+  static const MTLStencilOperation ops[] = {MTLStencilOperationKeep, MTLStencilOperationZero,
+    MTLStencilOperationReplace, MTLStencilOperationIncrementClamp, MTLStencilOperationDecrementClamp,
+    MTLStencilOperationInvert, MTLStencilOperationIncrementWrap, MTLStencilOperationDecrementWrap};
+  return ops[op & 7];
+}
+// ResolveConstants in metal_resolve.h (MSL layout: uint2 x3, uint x6, float, then uint2 at offset 56).
+struct ResolveConstants {
+  uint32_t sx = 0, sy = 0, width = 0, height = 0, dx = 0, dy = 0, pitch = 0, address = 0, format = 0, endian = 0,
+      swap = 0, write_memory = 0;
+  float scale = 1.0f; uint32_t padding = 0;
+  uint32_t samples_x = 1, samples_y = 1, sample_select = 0, extent_start = 0, extent_end = 0, padding2 = 0;
+};
+static_assert(sizeof(ResolveConstants) == 80);
+template <typename T> void Key(std::string& key, T value) {
+  key.append(reinterpret_cast<const char*>(&value), sizeof(value));
+}
+}
+
+class MetalPrimitiveProcessor final : public PrimitiveProcessor {
+ public:
+  MetalPrimitiveProcessor(id<MTLDevice> device, const RegisterFile& regs, memory::Memory& memory, SharedMemory& shared)
+      : PrimitiveProcessor(regs, memory, shared), device_(device) {}
+  bool Initialize() { return InitializeCommon(true, false, false, false, false, false); }
+  void NextDraw() { ClearPerFrameCache(); buffers_.clear(); }
+  std::pair<id<MTLBuffer>, size_t> Buffer(const ProcessingResult& p) const {
+    if (p.index_buffer_type == kHostConverted) return buffers_.at(p.host_index_buffer_handle);
+    return {builtin_, GetBuiltinIndexBufferOffsetBytes(p.host_index_buffer_handle)};
+  }
+ private:
+  bool InitializeBuiltinIndexBuffer(size_t size, std::function<void(void*)> fill) override {
+    builtin_ = [device_ newBufferWithLength:size options:MTLResourceStorageModeShared];
+    if (!builtin_) return false;
+    fill(builtin_.contents); return true;
+  }
+  void* RequestHostConvertedIndexBufferForCurrentFrame(xenos::IndexFormat format, uint32_t count,
+      bool align, uint32_t original, size_t& handle) override {
+    size_t size = count * (format == xenos::IndexFormat::kInt16 ? 2 : 4) + XE_GPU_PRIMITIVE_PROCESSOR_SIMD_SIZE;
+    id<MTLBuffer> buffer = [device_ newBufferWithLength:size options:MTLResourceStorageModeShared];
+    if (!buffer) return nullptr;
+    size_t offset = align ? GetSimdCoalignmentOffset(buffer.contents, original) : 0;
+    handle = buffers_.size(); buffers_.emplace_back(buffer, offset);
+    return static_cast<uint8_t*>(buffer.contents) + offset;
+  }
+  id<MTLDevice> device_;
+  id<MTLBuffer> builtin_;
+  std::vector<std::pair<id<MTLBuffer>, size_t>> buffers_;
+};
+
+MetalDraw::MetalDraw(id<MTLDevice> device, id<MTLCommandQueue> queue, id<MTLBuffer> memory_buffer,
+    memory::Memory& memory, RegisterFile& regs, MetalShaderCompiler& shaders, uint32_t edram_tiles)
+    : device_(device), queue_(queue), memory_buffer_(memory_buffer), memory_(memory), regs_(regs),
+      shaders_(shaders), edram_tiles_(edram_tiles) {}
+MetalDraw::~MetalDraw() { Submit(); primitives_.reset(); shared_.reset(); }
+bool MetalDraw::Initialize() {
+  for (auto& buffer : snapshot_buffers_) {
+    buffer = [device_ newBufferWithLength:64 * 1024 * 1024 options:MTLResourceStorageModeShared];
+    if (!buffer) return false;
+    buffer.label = @"Xenos draw-time vertex and index snapshots";
+  }
+  snapshot_buffer_ = snapshot_buffers_[0];
+  resolve_rejected_ = [device_ newBufferWithLength:4 options:MTLResourceStorageModeShared];
+  fence_values_ = [device_ newBufferWithLength:4096 * 4 options:MTLResourceStorageModeShared];
+  *static_cast<uint32_t*>(resolve_rejected_.contents) = 0;
+  NSError* error = nil;
+  auto library = [device_ newLibraryWithSource:[NSString stringWithUTF8String:kMetalResolveSource] options:nil error:&error];
+  if (library) {
+    resolve_color_ = [device_ newComputePipelineStateWithFunction:[library newFunctionWithName:@"resolve_color"] error:&error];
+    resolve_depth_ = [device_ newComputePipelineStateWithFunction:[library newFunctionWithName:@"resolve_depth"] error:&error];
+    present_ = [device_ newComputePipelineStateWithFunction:[library newFunctionWithName:@"present_color"] error:&error];
+    load_texture_ = [device_ newComputePipelineStateWithFunction:[library newFunctionWithName:@"load_texture"] error:&error];
+  }
+  helper_library_ = library;
+  {
+    // EDRAM transfers into depth: every sample written, depth and stencil from the shader.
+    auto desc = [MTLDepthStencilDescriptor new];
+    desc.depthCompareFunction = MTLCompareFunctionAlways; desc.depthWriteEnabled = YES;
+    auto stencil = [MTLStencilDescriptor new];
+    stencil.stencilCompareFunction = MTLCompareFunctionAlways;
+    stencil.depthStencilPassOperation = MTLStencilOperationReplace;
+    stencil.readMask = stencil.writeMask = 0xFF;
+    desc.frontFaceStencil = desc.backFaceStencil = stencil;
+    transfer_depth_state_ = [device_ newDepthStencilStateWithDescriptor:desc];
+  }
+  if (!resolve_color_ || !resolve_depth_ || !present_ || !load_texture_) {
+    REXGPU_ERROR("Metal resolve shader failed: {}", error.localizedDescription.UTF8String); return false;
+  }
+  shared_ = std::make_unique<UnifiedMemory>(memory_);
+  primitives_ = std::make_unique<MetalPrimitiveProcessor>(device_, regs_, memory_, *shared_);
+  return primitives_->Initialize();
+}
+void MetalDraw::EndEncoder() { if (encoder_) { [encoder_ endEncoding]; encoder_ = nil; } attachments_ = {}; }
+void MetalDraw::Submit(bool wait) {
+  EndEncoder();
+  if (commands_) {
+    auto errors = gpu_errors_; auto gpu_us = gpu_us_;
+    [commands_ addCompletedHandler:^(id<MTLCommandBuffer> done) {
+      if (done.GPUEndTime > done.GPUStartTime) gpu_us->fetch_add(uint64_t((done.GPUEndTime - done.GPUStartTime) * 1e6));
+      if (done.status == MTLCommandBufferStatusError && errors->fetch_add(1) < 16)
+        REXGPU_ERROR("Metal draw command buffer failed: {}", done.error.localizedDescription.UTF8String);
+    }];
+    [commands_ commit];
+    last_committed_ = commands_; commands_ = nil;
+  }
+  // Command buffers keep what they use alive; the uploads list only has to outlive the encoding.
+  uploads_.clear();
+  if (wait) {
+    // One queue: its last command buffer completes after the ones before it.
+    if (last_committed_) [last_committed_ waitUntilCompleted];
+    snapshots_.clear(); snapshot_used_ = 0;
+  }
+}
+bool MetalDraw::DebugFrame() const {
+  return frame_ == REXCVAR_GET(metal_debug_frame) || frame_ == capture_frame_;
+}
+bool MetalDraw::WriteFence(uint32_t address, uint32_t value) {
+  if (!REXCVAR_GET(metal_gpu_fences) || !memory_buffer_ || !fence_values_ || address > 0x1FFFFFFCu) return false;
+  // 4096 slots: about 8 fences a frame and two frames in flight, so a slot is long done before its reuse.
+  uint32_t slot = fence_slot_++ & 4095;
+  static_cast<uint32_t*>(fence_values_.contents)[slot] = value;
+  EndEncoder();
+  if (!commands_) { commands_ = [queue_ commandBuffer]; commands_.label = @"Xenos M1 draws"; }
+  auto blit = [commands_ blitCommandEncoder];
+  [blit copyFromBuffer:fence_values_ sourceOffset:slot * 4 toBuffer:memory_buffer_ destinationOffset:address size:4];
+  [blit endEncoding];
+  // Committed now, so a guest waiting for it doesn't wait for the end of the frame.
+  Submit(false);
+  ++fences_;
+  return true;
+}
+void MetalDraw::EndFrame() {
+  if (int32_t ms = REXCVAR_GET(metal_frame_sleep_ms)) std::this_thread::sleep_for(std::chrono::milliseconds(ms));
+  // The frame goes to the GPU without waiting for it; the next one is encoded meanwhile, into the other
+  // snapshot buffer, once the frame before last (its previous user) is done.
+  Submit(false);
+  frame_done_[slot_] = last_committed_;
+  slot_ ^= 1;
+  snapshot_buffer_ = snapshot_buffers_[slot_];
+  if (frame_done_[slot_]) {
+    auto wait_start = std::chrono::steady_clock::now();
+    [frame_done_[slot_] waitUntilCompleted]; frame_done_[slot_] = nil;
+    wait_us_ += uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - wait_start).count());
+  }
+  if (++stats_frames_ == 150) {
+    double wall = std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() - stats_start_).count();
+    if (uint32_t rejected = *static_cast<uint32_t*>(resolve_rejected_.contents)) {
+      REXGPU_WARN("Metal resolves: {} bytes outside their destination extent not written", rejected);
+      *static_cast<uint32_t*>(resolve_rejected_.contents) = 0;
+    }
+    REXGPU_INFO("Metal fences: {:.1f} a frame written by the GPU", fences_ / 150.0);
+    fences_ = 0;
+    if (memexport_skipped_) {
+      REXGPU_WARN("Metal: {} memexport draws skipped in 150 frames (their memory writes are lost)", memexport_skipped_);
+      memexport_skipped_ = 0;
+    }
+    REXGPU_INFO("Metal frame time: {:.1f} ms a frame, GPU busy {:.1f} ms, CPU waiting for the GPU {:.1f} ms; {:.1f} texture loads, "
+        "{:.1f} MB of vertices and indices hashed and {:.1f} MB copied, {:.1f} EDRAM transfers a frame; {} pipelines created ({:.1f} ms)",
+        wall / 1000.0 / 150, gpu_us_->exchange(0) / 1000.0 / 150, wait_us_ / 1000.0 / 150, texture_loads_ / 150.0,
+        snapshot_hashed_ / 1048576.0 / 150, snapshot_copied_ / 1048576.0 / 150, edram_transfers_ / 150.0, pipelines_created_, pipeline_us_ / 1000.0);
+    edram_transfers_ = 0; pipelines_created_ = 0; pipeline_us_ = 0;
+    stats_frames_ = 0; wait_us_ = 0; texture_loads_ = 0; snapshot_hashed_ = 0; snapshot_copied_ = 0; stats_start_ = std::chrono::steady_clock::now();
+  }
+  snapshots_.clear(); snapshot_used_ = 0;
+  ++frame_;
+  if (REXCVAR_GET(metal_debug_capture)) {
+    capture_frame_ = frame_;
+    rex::cvar::SetFlagByName("metal_debug_capture", "false");
+    REXGPU_INFO("Metal debug capture: frame {}", frame_);
+  }
+  if (textures_.size() > 4096) {
+    textures_.clear(); texture_hashes_.clear(); texture_checked_frame_.clear(); texture_ranges_.clear(); range_index_.clear(); max_range_length_ = 0; views_.clear();
+  }
+}
+void MetalDraw::DropViews(id<MTLTexture> texture) {
+  if (!texture) return;
+  views_.erase(reinterpret_cast<uintptr_t>((__bridge void*)texture));
+}
+void MetalDraw::InvalidateRange(uint32_t start, uint32_t length) {
+  if (!length) return;
+  uint64_t end = uint64_t(start) + length;
+  for (auto it = resolved_.begin(); it != resolved_.end();) {
+    if (it->second.start < end && uint64_t(it->second.start) + it->second.length > start) it = resolved_.erase(it);
+    else ++it;
+  }
+  auto it = range_index_.lower_bound(start > max_range_length_ ? start - max_range_length_ : 0);
+  while (it != range_index_.end() && it->first < end) {
+    auto r = texture_ranges_.find(it->second);
+    if (r == texture_ranges_.end() || uint64_t(r->second.first) + r->second.second <= start) { ++it; continue; }
+    if (auto t = textures_.find(it->second); t != textures_.end()) { DropViews(t->second); textures_.erase(t); }
+    texture_hashes_.erase(it->second); texture_checked_frame_.erase(it->second);
+    texture_ranges_.erase(r);
+    it = range_index_.erase(it);
+  }
+}
+void MetalDraw::SetTextureRange(const std::string& key, uint32_t start, uint32_t length) {
+  auto [r, inserted] = texture_ranges_.try_emplace(key, start, length);
+  if (!inserted) {
+    if (r->second.first == start && r->second.second == length) return;
+    for (auto [i, e] = range_index_.equal_range(r->second.first); i != e; ++i)
+      if (i->second == key) { range_index_.erase(i); break; }
+    r->second = {start, length};
+  }
+  range_index_.emplace(start, key);
+  max_range_length_ = std::max(max_range_length_, length);
+}
+id<MTLBuffer> MetalDraw::Upload(const void* data, size_t size) {
+  id<MTLBuffer> buffer = [device_ newBufferWithBytes:data length:size options:MTLResourceStorageModeShared];
+  if (buffer) uploads_.push_back(buffer);
+  return buffer;
+}
+id<MTLTexture> MetalDraw::Target(uint32_t base, MTLPixelFormat format, uint32_t width, bool is_64bpp) {
+  // EDRAM is kept in samples (MSAA 2x as 1x2, 4x as 2x2), so that the views of the same tiles
+  // with another sample count and pitch (a 4x clear at half the pitch of a 2x scene) meet in one
+  // texture. Its height is what is left of EDRAM after the base, so it does not depend on the draw.
+  std::string key; Key(key, base); Key(key, format); Key(key, width);
+  auto found = targets_.find(key);
+  if (found != targets_.end()) return found->second;
+  uint32_t pitch_tiles = std::max(1u, (width + (is_64bpp ? 39 : 79)) / (is_64bpp ? 40 : 80));
+  uint32_t height = std::min(8192u, (edram_tiles_ - std::min(base, edram_tiles_ - 1) + pitch_tiles - 1) / pitch_tiles * 16);
+  auto desc = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:format width:width height:height mipmapped:NO];
+  desc.storageMode = MTLStorageModePrivate;
+  desc.usage = MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead | MTLTextureUsagePixelFormatView;
+  id<MTLTexture> result = [device_ newTextureWithDescriptor:desc];
+  if (result) {
+    result.label = [NSString stringWithFormat:@"Xenos RT base %u", base];
+    targets_[key] = result;
+    target_layouts_[reinterpret_cast<uintptr_t>((__bridge void*)result)] =
+        {base, pitch_tiles, is_64bpp, format == MTLPixelFormatDepth32Float_Stencil8, result,
+         std::vector<uint32_t>(edram_tiles_, 0)};
+    if (tile_version_.size() != edram_tiles_) {
+      tile_version_.assign(edram_tiles_, 0); tile_kind_.assign(edram_tiles_, kNoTransfer); tile_owner_.assign(edram_tiles_, 0);
+    }
+    EndEncoder();
+    if (!commands_) commands_ = [queue_ commandBuffer];
+    auto pass = [MTLRenderPassDescriptor renderPassDescriptor];
+    if (format == MTLPixelFormatDepth32Float_Stencil8) {
+      pass.depthAttachment.texture = pass.stencilAttachment.texture = result;
+      pass.depthAttachment.loadAction = pass.stencilAttachment.loadAction = MTLLoadActionClear;
+      pass.depthAttachment.storeAction = pass.stencilAttachment.storeAction = MTLStoreActionStore;
+      // The initial EDRAM contents are zero. This title uses reversed depth (GreaterEqual),
+      // so a conventional host far-depth clear of 1 rejects its UI and geometry.
+      pass.depthAttachment.clearDepth = 0.0;
+    } else {
+      pass.colorAttachments[0].texture = result;
+      pass.colorAttachments[0].loadAction = MTLLoadActionClear;
+      pass.colorAttachments[0].storeAction = MTLStoreActionStore;
+    }
+    [[commands_ renderCommandEncoderWithDescriptor:pass] endEncoding];
+  }
+  return result;
+}
+
+bool MetalDraw::Draw(Shader* vs, Shader* ps) {
+  @autoreleasepool {
+    if (!vs) return true;
+    auto mode = regs_.Get<reg::RB_MODECONTROL>().edram_mode;
+    bool polygonal = draw_util::IsPrimitivePolygonal(regs_);
+    if (!draw_util::IsRasterizationPotentiallyDone(regs_, polygonal)) return true;
+    uint32_t pitch = regs_.Get<reg::RB_SURFACE_INFO>().surface_pitch;
+    if (!pitch) return true;
+    shaders_.translator().EnsureAnalyzed(*vs);
+    if (mode != xenos::EdramMode::kColorDepth) ps = nullptr;
+    if (ps) { shaders_.translator().EnsureAnalyzed(*ps);
+      if (!draw_util::IsPixelShaderNeededWithRasterization(*ps, regs_)) ps = nullptr; }
+    // Memexport needs a coherent writeback path (M2).
+    if (vs->memexport_eM_written() || (ps && ps->memexport_eM_written())) {
+      // Not done yet (M2): the shader's writes to guest memory are lost. Counted in the stats line.
+      ++memexport_skipped_;
+      return true;
+    }
+    primitives_->NextDraw();
+    PrimitiveProcessor::ProcessingResult primitive{};
+    if (!primitives_->Process(primitive)) { ++failures_; return false; }
+    if (primitive.IsTessellated() || !primitive.host_draw_vertex_count) return true;
+    if (REXCVAR_GET(metal_snapshot_vertices) && !SnapshotDraw(*vs, primitive)) { ++failures_; return false; }
+    if (REXCVAR_GET(metal_draw_cpu_only)) return true;
+    uint64_t vm, pm;
+    shaders_.translator().GetDrawModifications(regs_, *vs, ps, vm, pm, primitive.host_vertex_shader_type);
+    shaders_.Request(*vs, vm); if (ps) shaders_.Request(*ps, pm);
+    shaders_.Wait();
+    if (REXCVAR_GET(metal_draw_stop) == 2) return true;
+    auto vt = vs->GetOrCreateTranslation(vm);
+    auto pt = ps ? ps->GetOrCreateTranslation(pm) : nullptr;
+    id<MTLLibrary> vl = shaders_.GetLibrary(vt), pl = pt ? shaders_.GetLibrary(pt) : nil;
+    if (!vl || (ps && !pl)) { ++failures_; return false; }
+    auto dc = draw_util::GetNormalizedDepthControl(regs_);
+    uint32_t mask = draw_util::GetNormalizedColorMask(regs_, ps ? ps->writes_color_targets() : 0);
+    auto msaa = regs_.Get<reg::RB_SURFACE_INFO>().msaa_samples;
+    uint32_t ssx = msaa >= xenos::MsaaSamples::k4X ? 2 : 1, ssy = msaa >= xenos::MsaaSamples::k2X ? 2 : 1;
+    draw_util::ViewportInfo viewport{};
+    draw_util::GetHostViewportInfo(regs_, ssx, ssy, false, 16384, 16384, true, dc, false, true,
+                                   ps && ps->writes_depth(), viewport);
+    draw_util::Scissor scissor{}; draw_util::GetScissor(regs_, scissor);
+    scissor.offset[0] *= ssx; scissor.extent[0] *= ssx; scissor.offset[1] *= ssy; scissor.extent[1] *= ssy;
+    if (!scissor.extent[0] || !scissor.extent[1] || !viewport.xy_extent[0] || !viewport.xy_extent[1]) return true;
+    const uint32_t width = pitch * ssx;
+    std::array<id<MTLTexture>, 5> next{};
+    std::string key; Key(key, reinterpret_cast<uintptr_t>(vt)); Key(key, reinterpret_cast<uintptr_t>(pt));
+    Key(key, mask);
+    std::array<MTLPixelFormat, 4> formats{};
+    std::array<uint32_t, 4> blends{};
+    std::array<uint32_t, 5> kinds{};
+    for (uint32_t i = 0; i < 4; ++i) {
+      MTLPixelFormat format = MTLPixelFormatInvalid;
+      if ((mask >> (4 * i)) & 15) {
+        auto color = regs_.Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[i]);
+        format = ColorFormat(color.color_format);
+        if (format == MTLPixelFormatInvalid) { ++failures_; return false; }
+        next[i] = Target(color.GetBaseTiles(edram_tiles_), format, width,
+                         xenos::IsColorRenderTargetFormat64bpp(color.color_format));
+        kinds[i] = ColorKind(color.color_format);
+        if (!next[i]) return false;
+      }
+      formats[i] = format;
+      blends[i] = regs_.Get<reg::RB_BLENDCONTROL>(reg::RB_BLENDCONTROL::rt_register_indices[i]).value;
+      Key(key, format); Key(key, blends[i]);
+    }
+    bool depth = dc.z_enable || dc.stencil_enable;
+    Key(key, depth);
+    if (depth) {
+      next[4] = Target(regs_.Get<reg::RB_DEPTH_INFO>().GetBaseTiles(edram_tiles_), MTLPixelFormatDepth32Float_Stencil8, width, false);
+      kinds[4] = DepthKind();
+      if (!next[4]) return false;
+    }
+    if (!mask && !depth) return true;
+    id<MTLRenderPipelineState> pipeline;
+    auto pi = pipelines_.find(key);
+    if (pi != pipelines_.end()) pipeline = pi->second;
+    else {
+      // The descriptor only for a new pipeline (building it for every draw was 9% of the thread).
+      auto pd = [MTLRenderPipelineDescriptor new];
+      pd.vertexFunction = [vl newFunctionWithName:vl.functionNames.firstObject];
+      if (pl) pd.fragmentFunction = [pl newFunctionWithName:pl.functionNames.firstObject];
+      for (uint32_t i = 0; i < 4; ++i) {
+        reg::RB_BLENDCONTROL bc; bc.value = blends[i];
+        auto a = pd.colorAttachments[i]; a.pixelFormat = formats[i];
+        uint32_t wm = (mask >> (4 * i)) & 15;
+        a.writeMask = MTLColorWriteMask(((wm & 1) ? MTLColorWriteMaskRed : 0) |
+          ((wm & 2) ? MTLColorWriteMaskGreen : 0) | ((wm & 4) ? MTLColorWriteMaskBlue : 0) |
+          ((wm & 8) ? MTLColorWriteMaskAlpha : 0));
+        a.blendingEnabled = formats[i] != MTLPixelFormatInvalid && (bc.value & 0x1FFF1FFF) != 0x00010001;
+        a.sourceRGBBlendFactor = BlendFactor(bc.color_srcblend); a.destinationRGBBlendFactor = BlendFactor(bc.color_destblend);
+        a.sourceAlphaBlendFactor = BlendFactor(bc.alpha_srcblend); a.destinationAlphaBlendFactor = BlendFactor(bc.alpha_destblend);
+        a.rgbBlendOperation = BlendOp(bc.color_comb_fcn); a.alphaBlendOperation = BlendOp(bc.alpha_comb_fcn);
+      }
+      if (depth) pd.depthAttachmentPixelFormat = pd.stencilAttachmentPixelFormat = MTLPixelFormatDepth32Float_Stencil8;
+      NSError* error = nil;
+      auto pipeline_start = std::chrono::steady_clock::now();
+      pipeline = [device_ newRenderPipelineStateWithDescriptor:pd error:&error];
+      ++pipelines_created_;
+      pipeline_us_ += std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - pipeline_start).count();
+      pipelines_[key] = pipeline;
+      if (!pipeline) { ++failures_; REXGPU_ERROR("Metal pipeline failed: {}", error.localizedDescription.UTF8String); }
+    }
+    if (!pipeline) return false;
+    if (REXCVAR_GET(metal_draw_stop) == 3) return true;
+    // Texture loads are compute work and cannot run inside a render pass: do them first (a load
+    // needed while a pass is open ends it).
+    for (auto* t : {vt, pt}) if (t) for (auto& b : shaders_.translator().bindings(t).textures) Texture(b);
+    if (REXCVAR_GET(metal_draw_stop) == 4) return true;
+    if (!commands_) { commands_ = [queue_ commandBuffer]; commands_.label = @"Xenos M1 draws"; }
+    // The EDRAM rows (in samples) this draw can touch.
+    int64_t rows_from = std::max<int64_t>(scissor.offset[1], viewport.xy_offset[1]);
+    int64_t rows_to = std::min<int64_t>(int64_t(scissor.offset[1]) + scissor.extent[1],
+                                        int64_t(viewport.xy_offset[1]) + viewport.xy_extent[1]);
+    uint32_t y0 = uint32_t(std::max<int64_t>(rows_from, 0)), y1 = uint32_t(std::max<int64_t>(rows_to, rows_from));
+    // Screen-space draws (clears by drawing rectangles) have the window scissor (16384) as their
+    // extent: bound them by their own vertices, or a clear would claim all EDRAM after its base.
+    if (!(regs_[XE_GPU_REG_PA_CL_VTE_CNTL] & 0x3F) && primitive.guest_draw_vertex_count &&
+        primitive.guest_draw_vertex_count <= 96 &&
+        regs_.Get<reg::VGT_DRAW_INITIATOR>().source_select == xenos::SourceSelect::kAutoIndex) {
+      for (const auto& binding : vs->vertex_bindings()) {
+        const Shader::VertexBinding::Attribute* position = nullptr;
+        for (const auto& a : binding.attributes)
+          if (a.fetch_instr.attributes.offset == 0 &&
+              (a.fetch_instr.attributes.data_format == xenos::VertexFormat::k_32_32_FLOAT ||
+               a.fetch_instr.attributes.data_format == xenos::VertexFormat::k_32_32_32_FLOAT ||
+               a.fetch_instr.attributes.data_format == xenos::VertexFormat::k_32_32_32_32_FLOAT))
+            position = &a;
+        if (!position || binding.stride_words < 2) break;
+        auto f = regs_.GetVertexFetch(binding.fetch_constant);
+        uint32_t address = (f.address << 2) & 0x1FFFFFFF;
+        uint32_t words_needed = primitive.guest_draw_vertex_count * binding.stride_words;
+        if (words_needed > f.size || uint64_t(address) + words_needed * 4 > SharedMemory::kBufferSize) break;
+        auto* words = memory_.TranslatePhysical<const uint32_t*>(address);
+        float low = INFINITY, high = -INFINITY;
+        for (uint32_t v = 0; v < primitive.guest_draw_vertex_count; ++v) {
+          uint32_t w = xenos::GpuSwap(words[v * binding.stride_words + 1], f.endian); float y; std::memcpy(&y, &w, 4);
+          low = std::min(low, y); high = std::max(high, y);
+        }
+        if (std::isfinite(low) && std::isfinite(high) && high >= low && high < 16384.0f) {
+          y0 = std::max<uint32_t>(y0, uint32_t(std::max(0.0f, std::floor(low))) * ssy);
+          y1 = std::min<uint32_t>(y1, uint32_t(std::ceil(high) + 1.0f) * ssy);
+          if (y1 < y0) y1 = y0;
+        }
+        break;
+      }
+    }
+    bool depth_writes = depth && (dc.z_write_enable || dc.stencil_enable);
+    if (!encoder_ || next != attachments_) {
+      EndEncoder();
+      if (REXCVAR_GET(metal_edram_transfers)) {
+        for (uint32_t i = 0; i < 5; ++i) if (next[i]) SyncTarget(next[i], kinds[i], y0, y1);
+        pass_ranges_ = {};
+      }
+      attachments_ = next;
+      auto pass = [MTLRenderPassDescriptor renderPassDescriptor];
+      for (uint32_t i = 0; i < 4; ++i) if (next[i]) {
+        pass.colorAttachments[i].texture = next[i]; pass.colorAttachments[i].loadAction = MTLLoadActionLoad;
+        pass.colorAttachments[i].storeAction = MTLStoreActionStore;
+      }
+      if (depth) {
+        pass.depthAttachment.texture = pass.stencilAttachment.texture = next[4];
+        pass.depthAttachment.loadAction = pass.stencilAttachment.loadAction = MTLLoadActionLoad;
+        pass.depthAttachment.storeAction = pass.stencilAttachment.storeAction = MTLStoreActionStore;
+      }
+      encoder_ = [commands_ renderCommandEncoderWithDescriptor:pass];
+      if (DebugFrame()) {
+        auto si = regs_.Get<reg::RB_SURFACE_INFO>();
+        std::string rts;
+        for (uint32_t i = 0; i < 4; ++i) if (next[i]) {
+          auto color = regs_.Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[i]);
+          rts += fmt::format(" rt{} base {} fmt {} {}x{}", i, color.GetBaseTiles(edram_tiles_),
+                             uint32_t(color.color_format), next[i].width, next[i].height);
+        }
+        if (depth) rts += fmt::format(" depth base {} fmt {} zfunc {} zwrite {} stencil {}",
+            regs_.Get<reg::RB_DEPTH_INFO>().GetBaseTiles(edram_tiles_), uint32_t(regs_.Get<reg::RB_DEPTH_INFO>().depth_format),
+            uint32_t(dc.zfunc), uint32_t(dc.z_write_enable), uint32_t(dc.stencil_enable));
+        REXGPU_INFO("Metal pass debug: draw {} pitch {} msaa {} viewport {},{} {}x{} z {}..{} scissor {},{} {}x{} window_offset {:08X}:{}",
+            draws_, pitch, uint32_t(si.msaa_samples), viewport.xy_offset[0], viewport.xy_offset[1],
+            viewport.xy_extent[0], viewport.xy_extent[1], viewport.z_min, viewport.z_max,
+            scissor.offset[0], scissor.offset[1], scissor.extent[0], scissor.extent[1],
+            regs_[XE_GPU_REG_PA_SC_WINDOW_OFFSET], rts);
+      }
+    }
+    if (REXCVAR_GET(metal_edram_transfers)) {
+      for (uint32_t i = 0; i < 4; ++i) if (next[i]) MarkWritten(next[i], kinds[i], y0, y1, &pass_ranges_[i]);
+      if (depth_writes) MarkWritten(next[4], kinds[4], y0, y1, &pass_ranges_[4]);
+    }
+    [encoder_ setRenderPipelineState:pipeline];
+    std::string dk; Key(dk, dc.value);
+    auto sf = regs_.Get<reg::RB_STENCILREFMASK>();
+    auto sb = regs_.Get<reg::RB_STENCILREFMASK>(XE_GPU_REG_RB_STENCILREFMASK_BF);
+    Key(dk, sf.value); Key(dk, sb.value);
+    auto ds = depth_states_.find(dk);
+    id<MTLDepthStencilState> state;
+    if (ds != depth_states_.end()) state = ds->second;
+    else {
+      auto desc = [MTLDepthStencilDescriptor new];
+      desc.depthCompareFunction = dc.z_enable ? MTLCompareFunction(dc.zfunc) : MTLCompareFunctionAlways;
+      desc.depthWriteEnabled = dc.z_enable && dc.z_write_enable;
+      if (dc.stencil_enable) {
+        auto front = [MTLStencilDescriptor new]; auto back = [MTLStencilDescriptor new];
+        front.stencilCompareFunction = MTLCompareFunction(dc.stencilfunc);
+        front.stencilFailureOperation = StencilOp(uint32_t(dc.stencilfail));
+        front.depthFailureOperation = StencilOp(uint32_t(dc.stencilzfail));
+        front.depthStencilPassOperation = StencilOp(uint32_t(dc.stencilzpass));
+        front.readMask = sf.stencilmask; front.writeMask = sf.stencilwritemask;
+        back.stencilCompareFunction = MTLCompareFunction(dc.stencilfunc_bf);
+        back.stencilFailureOperation = StencilOp(uint32_t(dc.stencilfail_bf));
+        back.depthFailureOperation = StencilOp(uint32_t(dc.stencilzfail_bf));
+        back.depthStencilPassOperation = StencilOp(uint32_t(dc.stencilzpass_bf));
+        back.readMask = sb.stencilmask; back.writeMask = sb.stencilwritemask;
+        desc.frontFaceStencil = front; desc.backFaceStencil = dc.backface_enable ? back : front;
+      }
+      state = [device_ newDepthStencilStateWithDescriptor:desc]; depth_states_[dk] = state;
+    }
+    [encoder_ setDepthStencilState:state];
+    [encoder_ setStencilFrontReferenceValue:sf.stencilref backReferenceValue:dc.backface_enable ? sb.stencilref : sf.stencilref];
+    // Clipping off (PA_CL_CLIP_CNTL.clip_disable, as screen-space clears draw): depth is clamped to the
+    // viewport's range instead of the primitive being cut away, as the Vulkan backend's depth clamp does.
+    [encoder_ setDepthClipMode:regs_.Get<reg::PA_CL_CLIP_CNTL>().clip_disable ? MTLDepthClipModeClamp : MTLDepthClipModeClip];
+    [encoder_ setViewport:MTLViewport{double(viewport.xy_offset[0]), double(viewport.xy_offset[1]),
+        double(viewport.xy_extent[0]), double(viewport.xy_extent[1]), viewport.z_min, viewport.z_max}];
+    uint32_t height = UINT32_MAX;
+    for (auto t : next) if (t) height = std::min(height, uint32_t(t.height));
+    uint32_t sx = std::min(scissor.offset[0], width), sy = std::min(scissor.offset[1], height);
+    [encoder_ setScissorRect:MTLScissorRect{sx, sy, std::min(scissor.extent[0], width - sx), std::min(scissor.extent[1], height - sy)}];
+    auto raster = regs_.Get<reg::PA_SU_SC_MODE_CNTL>();
+    [encoder_ setFrontFacingWinding:raster.face ? MTLWindingClockwise : MTLWindingCounterClockwise];
+    [encoder_ setCullMode:!polygonal ? MTLCullModeNone : raster.cull_front ? MTLCullModeFront : raster.cull_back ? MTLCullModeBack : MTLCullModeNone];
+    [encoder_ setBlendColorRed:regs_.Get<float>(XE_GPU_REG_RB_BLEND_RED) green:regs_.Get<float>(XE_GPU_REG_RB_BLEND_GREEN)
+                        blue:regs_.Get<float>(XE_GPU_REG_RB_BLEND_BLUE) alpha:regs_.Get<float>(XE_GPU_REG_RB_BLEND_ALPHA)];
+    auto system = BuildMetalSystemConstants(regs_, primitive, viewport);
+    debug_draw_log_ = DebugFrame() && primitive.host_draw_vertex_count <= 6;
+    Bind(*vs, vt, true, system); if (ps) Bind(*ps, pt, false, system);
+    MTLPrimitiveType topology;
+    switch (primitive.host_primitive_type) {
+      case xenos::PrimitiveType::kPointList: topology = MTLPrimitiveTypePoint; break;
+      case xenos::PrimitiveType::kLineList: topology = MTLPrimitiveTypeLine; break;
+      case xenos::PrimitiveType::kLineStrip: topology = MTLPrimitiveTypeLineStrip; break;
+      case xenos::PrimitiveType::kTriangleList: topology = MTLPrimitiveTypeTriangle; break;
+      case xenos::PrimitiveType::kTriangleStrip: topology = MTLPrimitiveTypeTriangleStrip; break;
+      default: ++failures_; return false;
+    }
+    if (!REXCVAR_GET(metal_draw_calls)) {
+      // Diagnostic: everything of the draw but the draw itself.
+    } else if (primitive.index_buffer_type == PrimitiveProcessor::kNone) {
+      [encoder_ drawPrimitives:topology vertexStart:0 vertexCount:primitive.host_draw_vertex_count];
+    } else {
+      id<MTLBuffer> buffer; size_t offset;
+      if (primitive.index_buffer_type == PrimitiveProcessor::kGuestDMA) { buffer = REXCVAR_GET(metal_snapshot_vertices) ? snapshot_buffer_ : memory_buffer_; offset = primitive.guest_index_base; }
+      else { auto b = primitives_->Buffer(primitive); buffer = b.first; offset = b.second; }
+      [encoder_ drawIndexedPrimitives:topology indexCount:primitive.host_draw_vertex_count
+          indexType:primitive.host_index_format == xenos::IndexFormat::kInt16 ? MTLIndexTypeUInt16 : MTLIndexTypeUInt32
+          indexBuffer:buffer indexBufferOffset:offset];
+    }
+    if (DebugFrame() && (REXCVAR_GET(metal_debug_all_draws) || (draws_ % 64) == 0)) {
+      auto fetch = regs_.GetTextureFetch(0); auto vf = regs_.GetVertexFetch(0);
+      REXGPU_INFO("Metal draw debug: draw {} VS {:016X} PS {:016X}, prim {} index {} count {}, RT {:08X} depth {:08X} info {:08X}, "
+        "vte {:08X} clip {:08X} z {}..{} zscale {} zoffset {}, vfetch {:08X} size {}, tex {:08X} fmt {} swizzle {:03X} signs {:02X}, blend0 {:08X} mask {:08X} colorcontrol {:08X} modecontrol {:08X}",
+        draws_, vs->ucode_data_hash(), ps ? ps->ucode_data_hash() : 0, uint32_t(primitive.host_vertex_shader_type),
+        uint32_t(primitive.index_buffer_type), primitive.host_draw_vertex_count,
+        regs_[XE_GPU_REG_RB_COLOR_INFO], dc.value, regs_[XE_GPU_REG_RB_DEPTH_INFO], regs_[XE_GPU_REG_PA_CL_VTE_CNTL],
+        regs_[XE_GPU_REG_PA_CL_CLIP_CNTL], viewport.z_min, viewport.z_max, regs_.Get<float>(XE_GPU_REG_PA_CL_VPORT_ZSCALE),
+        regs_.Get<float>(XE_GPU_REG_PA_CL_VPORT_ZOFFSET), uint32_t(vf.address << 2), uint32_t(vf.size),
+        uint32_t(fetch.base_address << 12), uint32_t(fetch.format), uint32_t(fetch.swizzle), uint32_t((fetch.dword_0 >> 2) & 255),
+        regs_[XE_GPU_REG_RB_BLENDCONTROL0], regs_[XE_GPU_REG_RB_COLOR_MASK], regs_[XE_GPU_REG_RB_COLORCONTROL],
+        regs_[XE_GPU_REG_RB_MODECONTROL]);
+      if (vf.size <= 64) {
+        // Small draws (clears by drawing): the vertex data as floats, big-endian guest words.
+        std::string words;
+        auto* data = memory_.TranslatePhysical<const uint32_t*>((vf.address << 2) & 0x1FFFFFFF);
+        for (uint32_t i = 0; i < vf.size; ++i) {
+          uint32_t w = rex::byte_swap(data[i]); float f; std::memcpy(&f, &w, 4);
+          words += fmt::format(" {}", f);
+        }
+        REXGPU_INFO("Metal draw debug vertices: draw {}:{}", draws_, words);
+      }
+    }
+    if (DebugFrame() && REXCVAR_GET(metal_debug_depth_dumps) && attachments_[4] &&
+        (dc.zfunc == xenos::CompareFunction::kAlways || REXCVAR_GET(metal_debug_depth_dumps) > 1)) {
+      // What a depth-ALWAYS draw (a clear by drawing) left in the depth target; 2: after every draw.
+      id<MTLTexture> target = attachments_[4];
+      EndEncoder();
+      DumpDepth(target, fmt::format("depth_after_draw_{}", draws_));
+    }
+    if (DebugFrame() && REXCVAR_GET(metal_debug_rt_base) >= 0 && attachments_[0] &&
+        regs_.Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[0]).GetBaseTiles(edram_tiles_) ==
+            uint32_t(REXCVAR_GET(metal_debug_rt_base))) {
+      // The first color target after every draw into this EDRAM base (alpha logged by DumpTexture).
+      id<MTLTexture> target = attachments_[0];
+      EndEncoder();
+      DumpTexture(target, fmt::format("rt_after_draw_{}", draws_));
+    }
+    ++draws_;
+    return true;
+  }
+}
+
+uint32_t MetalDraw::Snapshot(uint32_t address, uint32_t size) {
+  if (!size) return 0;
+  const void* source = memory_.TranslatePhysical<const void*>(address);
+  // A range copied earlier in the frame is reused if its data is the same. (Tried 2026-11-01: the write
+  // watches' page validity instead of the hash, 23 FPS against 28 to 30 in free roam: watching every
+  // vertex range costs more than hashing it.) A large range is hashed only the first time in a frame:
+  // those are the game's static geometry, a few MB each, which draws share (free roam hashed 154 MB a
+  // frame for 20 MB copied); small ranges, where dynamic vertices are, are checked at every draw.
+  std::string key; Key(key, address); Key(key, size);
+  auto found = snapshots_.find(key);
+  if (found != snapshots_.end() && size >= REXCVAR_GET(metal_snapshot_trust_size)) return found->second.first;
+  uint64_t hash = XXH3_64bits(source, size);
+  snapshot_hashed_ += size;
+  if (found != snapshots_.end() && found->second.second == hash) return found->second.first;
+  uint32_t offset = uint32_t(snapshot_used_);
+  std::memcpy(static_cast<uint8_t*>(snapshot_buffer_.contents) + offset, source, size);
+  snapshot_copied_ += size;
+  snapshot_used_ += (size + 255) & ~size_t(255);
+  snapshots_[key] = {offset, hash};
+  return offset;
+}
+
+bool MetalDraw::SnapshotDraw(Shader& vertex, PrimitiveProcessor::ProcessingResult& primitive) {
+  std::memcpy(draw_fetch_.data(), &regs_[XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0], sizeof(draw_fetch_));
+  const auto& map = vertex.constant_register_map();
+  size_t required = 0;
+  struct Range { uint32_t fetch, address, size; };
+  std::vector<Range> ranges;
+  for (uint32_t i = 0; i < 96; ++i) {
+    if (!(map.vertex_fetch_bitmap[i / 32] & (1u << (i % 32)))) continue;
+    auto fetch = regs_.GetVertexFetch(i);
+    uint32_t address = (fetch.address << 2) & 0x1FFFFFFF;
+    uint32_t size = std::min(uint32_t(fetch.size) * 4, SharedMemory::kBufferSize - address);
+    ranges.push_back({i, address, size}); required += (size + 255) & ~size_t(255);
+  }
+  uint32_t index_bytes = 0;
+  if (primitive.index_buffer_type == PrimitiveProcessor::kGuestDMA ||
+      primitive.index_buffer_type == PrimitiveProcessor::kHostBuiltinForDMA) {
+    index_bytes = primitive.guest_draw_vertex_count *
+        (regs_.Get<reg::VGT_DRAW_INITIATOR>().index_size == xenos::IndexFormat::kInt16 ? 2 : 4);
+    if (uint64_t(primitive.guest_index_base) + index_bytes > SharedMemory::kBufferSize) return false;
+    required += (index_bytes + 255) & ~size_t(255);
+  }
+  if (required > snapshot_buffer_.length) return false;
+  if (snapshot_used_ + required > snapshot_buffer_.length) Submit();
+  for (auto range : ranges) {
+    uint32_t offset = Snapshot(range.address, range.size);
+    draw_fetch_[range.fetch * 2] = (draw_fetch_[range.fetch * 2] & 3) | offset;
+  }
+  if (index_bytes) primitive.guest_index_base = Snapshot(primitive.guest_index_base, index_bytes);
+  return true;
+}
+
+void MetalDraw::Bind(Shader& shader, Shader::Translation* translation, bool vertex, const std::vector<uint8_t>& system) {
+  auto buffer = [&](id<MTLBuffer> b, uint32_t slot) {
+    if (vertex) [encoder_ setVertexBuffer:b offset:0 atIndex:slot];
+    else [encoder_ setFragmentBuffer:b offset:0 atIndex:slot];
+  };
+  // Inline constants (Metal copies up to 4 KB with the command); a buffer only if larger.
+  auto bytes = [&](const void* data, size_t size, uint32_t slot) {
+    if (size > 4096) { buffer(Upload(data, size), slot); return; }
+    if (vertex) [encoder_ setVertexBytes:data length:size atIndex:slot];
+    else [encoder_ setFragmentBytes:data length:size atIndex:slot];
+  };
+  bytes(system.data(), system.size(), 0);
+  std::array<uint32_t, 1024> floats{}; size_t count = 0;
+  uint32_t base = vertex ? XE_GPU_REG_SHADER_CONSTANT_000_X : XE_GPU_REG_SHADER_CONSTANT_256_X;
+  const auto& map = shader.constant_register_map();
+  for (uint32_t i = 0; i < 256; ++i) if ((map.float_bitmap[i / 64] >> (i % 64)) & 1) {
+    std::memcpy(floats.data() + count * 4, &regs_[base + i * 4], 16); ++count;
+  }
+  bytes(floats.data(), std::max(count, size_t(1)) * 16, vertex ? 1 : 2);
+  bytes(&regs_[XE_GPU_REG_SHADER_CONSTANT_BOOL_000_031], 40 * 4, 3);
+  bytes(vertex && REXCVAR_GET(metal_snapshot_vertices) ? draw_fetch_.data() : &regs_[XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0], 32 * 6 * 4, 4);
+  buffer(REXCVAR_GET(metal_snapshot_vertices) ? snapshot_buffer_ : memory_buffer_, 5);
+  const auto& bindings = shaders_.translator().bindings(translation);
+  for (auto& t : bindings.textures) {
+    auto texture = Texture(t);
+    if (DebugFrame() && debug_draw_log_) {
+      auto f = regs_.GetTextureFetch(t.fetch_constant);
+      uint32_t a = (f.base_address << 12) & 0x1FFFFFFF;
+      auto r = resolved_.find(a);
+      REXGPU_INFO("Metal texture debug: draw {} {} slot {} fetch {} addr {:08X} fmt {} {}x{} tiled {} -> {}x{} {} ({})",
+          draws_, vertex ? "VS" : "PS", t.index, t.fetch_constant, a, uint32_t(f.format),
+          uint32_t(f.size_2d.width) + 1, uint32_t(f.size_2d.height) + 1, uint32_t(f.tiled),
+          texture.width, texture.height, uint32_t(texture.pixelFormat),
+          r != resolved_.end() ? fmt::format("resolve {}x{} fmt {}", r->second.width, r->second.height, r->second.format) : std::string("memory"));
+    }
+    if (vertex) [encoder_ setVertexTexture:texture atIndex:t.index];
+    else [encoder_ setFragmentTexture:texture atIndex:t.index];
+  }
+  for (auto& s : bindings.samplers) {
+    auto sampler = Sampler(s);
+    if (vertex) [encoder_ setVertexSamplerState:sampler atIndex:s.index];
+    else [encoder_ setFragmentSamplerState:sampler atIndex:s.index];
+  }
+}
+
+id<MTLTexture> MetalDraw::Texture(const MetalTextureBinding& binding) {
+  auto fetch = regs_.GetTextureFetch(binding.fetch_constant);
+  // The texture's identity is its memory and layout only; the sampler fields and the swizzle vary between
+  // passes that read the same texture, which is then loaded once and viewed with each swizzle.
+  std::string key;
+  Key(key, fetch.dword_0 & 0xFFC00003u); Key(key, fetch.dword_1); Key(key, fetch.dword_2); Key(key, fetch.dword_5);
+  Key(key, binding.dimension); Key(key, binding.is_signed);
+  bool cube = binding.dimension == xenos::FetchOpDimension::kCube;
+  auto cached = textures_.find(key);
+  if (cached != textures_.end() && texture_checked_frame_[key] == frame_) return View(cached->second, fetch.swizzle, cube);
+  bool volume = binding.dimension == xenos::FetchOpDimension::k3DOrStacked;
+  uint32_t address = (fetch.base_address << 12) & 0x1FFFFFFF;
+  uint64_t content_hash = 0;
+  uint32_t range = 0;
+  const ResolvedTexture* resolved = nullptr;
+  if (fetch.type == xenos::FetchConstantType::kTexture && fetch.dimension != xenos::DataDimension::k3D) {
+    uint32_t w, h, layers, base, mip, lo, hi;
+    texture_util::GetSubresourcesFromFetchConstant(fetch, &w, &h, &layers, &base, &mip, &lo, &hi);
+    auto layout = texture_util::GetGuestTextureLayout(fetch.dimension, fetch.pitch, w + 1, h + 1, layers + 1,
+        fetch.tiled, GetBaseFormat(fetch.format), fetch.packed_mips, base != 0, 0);
+    range = layout.base.level_data_extent_bytes;
+    // A resolve's texture stands in only for exactly what it wrote: a scene drawn in tiles is
+    // resolved piece by piece to one surface, and memory is often reused for other resolves.
+    auto r = resolved_.find(address);
+    if (r != resolved_.end() && !cube && !volume && r->second.width == w + 1 && r->second.height == h + 1 &&
+        r->second.format == uint32_t(GetBaseFormat(fetch.format)))
+      resolved = &r->second;
+    else if (base && uint64_t(address) + range <= SharedMemory::kBufferSize)
+      content_hash = XXH3_64bits(memory_.TranslatePhysical<const void*>(address), range);
+  }
+  texture_checked_frame_[key] = frame_;
+  SetTextureRange(key, address, resolved ? resolved->length : range);
+  if (cached != textures_.end() && texture_hashes_[key] == content_hash) return View(cached->second, fetch.swizzle, cube);
+  if (DebugFrame())
+    REXGPU_INFO("Metal texture load debug: addr {:08X} fmt {} {}x{} range {} - {}", address, uint32_t(fetch.format),
+        uint32_t(fetch.size_2d.width) + 1, uint32_t(fetch.size_2d.height) + 1, range,
+        cached == textures_.end() ? (texture_hashes_.contains(key) ? "dropped by a resolve" : "new") : "content changed");
+  texture_hashes_[key] = content_hash;
+  id<MTLTexture> texture = nil;
+  if (resolved) {
+    auto source = resolved->texture;
+    texture = [source newTextureViewWithPixelFormat:source.pixelFormat textureType:MTLTextureType2DArray
+        levels:NSMakeRange(0, 1) slices:NSMakeRange(0, 1)];
+  } else if (fetch.type == xenos::FetchConstantType::kTexture && !volume && REXCVAR_GET(metal_texture_loads)) {
+    auto format = GetBaseFormat(fetch.format);
+    MTLPixelFormat metal_format = MTLPixelFormatInvalid;
+    using F = xenos::TextureFormat;
+    switch (format) {
+      case F::k_8: case F::k_8_A: case F::k_8_B: metal_format = binding.is_signed ? MTLPixelFormatR8Snorm : MTLPixelFormatR8Unorm; break;
+      case F::k_8_8: metal_format = binding.is_signed ? MTLPixelFormatRG8Snorm : MTLPixelFormatRG8Unorm; break;
+      case F::k_8_8_8_8: metal_format = binding.is_signed ? MTLPixelFormatRGBA8Snorm : MTLPixelFormatRGBA8Unorm; break;
+      case F::k_16: metal_format = binding.is_signed ? MTLPixelFormatR16Snorm : MTLPixelFormatR16Unorm; break;
+      case F::k_16_16: metal_format = binding.is_signed ? MTLPixelFormatRG16Snorm : MTLPixelFormatRG16Unorm; break;
+      case F::k_16_16_16_16: metal_format = binding.is_signed ? MTLPixelFormatRGBA16Snorm : MTLPixelFormatRGBA16Unorm; break;
+      case F::k_16_FLOAT: metal_format = MTLPixelFormatR16Float; break;
+      case F::k_16_16_FLOAT: metal_format = MTLPixelFormatRG16Float; break;
+      case F::k_16_16_16_16_FLOAT: metal_format = MTLPixelFormatRGBA16Float; break;
+      case F::k_32_FLOAT: metal_format = MTLPixelFormatR32Float; break;
+      case F::k_32_32_FLOAT: metal_format = MTLPixelFormatRG32Float; break;
+      case F::k_32_32_32_32_FLOAT: metal_format = MTLPixelFormatRGBA32Float; break;
+      case F::k_2_10_10_10: metal_format = MTLPixelFormatRGB10A2Unorm; break;
+      case F::k_24_8: case F::k_24_8_FLOAT: metal_format = MTLPixelFormatR32Float; break;
+      // 16-bit packed formats, expanded to RGBA8 by the load kernel.
+      case F::k_1_5_5_5: case F::k_5_6_5: case F::k_6_5_5: case F::k_4_4_4_4: metal_format = MTLPixelFormatRGBA8Unorm; break;
+      case F::k_DXT1: metal_format = MTLPixelFormatBC1_RGBA; break;
+      case F::k_DXT2_3: metal_format = MTLPixelFormatBC2_RGBA; break;
+      case F::k_DXT4_5: metal_format = MTLPixelFormatBC3_RGBA; break;
+      case F::k_DXN: metal_format = binding.is_signed ? MTLPixelFormatBC5_RGSnorm : MTLPixelFormatBC5_RGUnorm; break;
+      default: if (unsupported_formats_.insert(uint32_t(format)).second)
+        REXGPU_WARN("Metal M1: unsupported texture format {}", uint32_t(format)); break;
+    }
+    uint32_t w, h, layers, base_page, mip_page, mip_min, mip_max;
+    texture_util::GetSubresourcesFromFetchConstant(fetch, &w, &h, &layers, &base_page, &mip_page, &mip_min, &mip_max);
+    ++w; ++h; ++layers;
+    if (metal_format != MTLPixelFormatInvalid && base_page && w <= 8192 && h <= 8192 && (!cube || w == h)) {
+      auto desc = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:metal_format width:w height:h mipmapped:NO];
+      desc.textureType = cube ? MTLTextureTypeCube : MTLTextureType2DArray;
+      desc.arrayLength = cube ? 1 : layers;
+      desc.storageMode = MTLStorageModePrivate; desc.usage = MTLTextureUsageShaderRead | MTLTextureUsagePixelFormatView;
+      texture = [device_ newTextureWithDescriptor:desc];
+      if (texture) {
+        // Untiled on the GPU straight from guest memory (the no-copy buffer), ordered after the
+        // resolves already encoded, then blitted: any format, compressed ones by blocks.
+        auto info = FormatInfo::Get(format);
+        uint32_t bpb = info->bytes_per_block(), bw = (w + info->block_width - 1) / info->block_width;
+        uint32_t bh = (h + info->block_height - 1) / info->block_height;
+        auto layout = texture_util::GetGuestTextureLayout(fetch.dimension, fetch.pitch, w, h, layers,
+            fetch.tiled, format, fetch.packed_mips, true, 0);
+        uint32_t ox = 0, oy = 0, oz = 0;
+        if (fetch.packed_mips) texture_util::GetPackedMipOffset(w, h, 1, format, 0, ox, oy, oz);
+        uint32_t convert = format == F::k_24_8 ? 1u : format == F::k_24_8_FLOAT ? 2u : format == F::k_1_5_5_5 ? 3u :
+            format == F::k_5_6_5 ? 4u : format == F::k_6_5_5 ? 5u : format == F::k_4_4_4_4 ? 6u : 0u;
+        uint32_t out_bpb = convert >= 3 ? 4u : bpb;
+        size_t image = size_t(bw) * bh * out_bpb;
+        id<MTLBuffer> staging = [device_ newBufferWithLength:image * layers options:MTLResourceStorageModePrivate];
+        if (!staging || !memory_buffer_) {
+          texture = nil;
+        } else {
+          struct {
+            uint32_t src_base, slice_stride, row_pitch_bytes, pitch_blocks, log_bpp, ox, oy, tiled, xor_mask, bw, bh, convert;
+          } c{(base_page << 12) & 0x1FFFFFFF, layout.base.array_slice_stride_bytes, layout.base.row_pitch_bytes,
+              layout.base.row_pitch_bytes / bpb, rex::log2_floor(bpb), ox, oy, fetch.tiled ? 1u : 0u,
+              fetch.endianness == xenos::Endian::k8in16 ? 1u : fetch.endianness == xenos::Endian::k8in32 ? 3u :
+                  fetch.endianness == xenos::Endian::k16in32 ? 2u : 0u,
+              bw, bh, convert};
+          EndEncoder();
+          if (!commands_) { commands_ = [queue_ commandBuffer]; commands_.label = @"Xenos M1 draws"; }
+          auto compute = [commands_ computeCommandEncoder];
+          [compute setComputePipelineState:load_texture_];
+          [compute setBuffer:memory_buffer_ offset:0 atIndex:0]; [compute setBuffer:staging offset:0 atIndex:1];
+          [compute setBytes:&c length:sizeof(c) atIndex:2];
+          [compute dispatchThreads:MTLSizeMake(bw, bh, layers) threadsPerThreadgroup:MTLSizeMake(8, 8, 1)];
+          [compute endEncoding];
+          auto blit = [commands_ blitCommandEncoder];
+          for (uint32_t layer = 0; layer < layers; ++layer)
+            [blit copyFromBuffer:staging sourceOffset:layer * image sourceBytesPerRow:bw * out_bpb sourceBytesPerImage:image
+                sourceSize:MTLSizeMake(w, h, 1) toTexture:texture destinationSlice:layer destinationLevel:0
+                destinationOrigin:MTLOriginMake(0, 0, 0)];
+          [blit endEncoding];
+          ++texture_loads_;
+        }
+      }
+    }
+  }
+  if (!texture) {
+    // Valid zero fallback for unsupported formats/dimensions, including the unused signed binding.
+    auto desc = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm width:1 height:1 mipmapped:NO];
+    desc.textureType = cube ? MTLTextureTypeCube : volume ? MTLTextureType3D : MTLTextureType2DArray;
+    desc.storageMode = MTLStorageModeShared; desc.usage = MTLTextureUsageShaderRead | MTLTextureUsagePixelFormatView;
+    texture = [device_ newTextureWithDescriptor:desc];
+    uint32_t zero = 0;
+    for (uint32_t i = 0; i < (cube ? 6u : 1u); ++i)
+      [texture replaceRegion:MTLRegionMake3D(0, 0, 0, 1, 1, 1) mipmapLevel:0 slice:i withBytes:&zero bytesPerRow:4 bytesPerImage:4];
+  }
+  if (cached != textures_.end()) DropViews(cached->second);
+  textures_[key] = texture; return View(texture, fetch.swizzle, cube);
+}
+
+id<MTLTexture> MetalDraw::View(id<MTLTexture> texture, uint32_t swizzle_bits, bool cube) {
+  if (!texture) return nil;
+  auto& views = views_[reinterpret_cast<uintptr_t>((__bridge void*)texture)];
+  auto found = views.find(swizzle_bits);
+  if (found != views.end()) return found->second;
+  // The guest's components of a format with fewer channels repeat the last one (the Vulkan backend's
+  // host swizzles: k_24_8, k_32_FLOAT, k_8, k_16... RRRR; k_8_8, k_16_16, DXN... RGGG), not 0 and 1.
+  uint32_t channels_in_format = 4;
+  switch (texture.pixelFormat) {
+    case MTLPixelFormatR8Unorm: case MTLPixelFormatR8Snorm: case MTLPixelFormatR16Unorm: case MTLPixelFormatR16Snorm:
+    case MTLPixelFormatR16Float: case MTLPixelFormatR32Float: case MTLPixelFormatA8Unorm: case MTLPixelFormatBC4_RUnorm:
+    case MTLPixelFormatBC4_RSnorm:
+      channels_in_format = 1; break;
+    case MTLPixelFormatRG8Unorm: case MTLPixelFormatRG8Snorm: case MTLPixelFormatRG16Unorm: case MTLPixelFormatRG16Snorm:
+    case MTLPixelFormatRG16Float: case MTLPixelFormatRG32Float: case MTLPixelFormatBC5_RGUnorm: case MTLPixelFormatBC5_RGSnorm:
+      channels_in_format = 2; break;
+    default: break;
+  }
+  static const MTLTextureSwizzle color[] = {MTLTextureSwizzleRed, MTLTextureSwizzleGreen, MTLTextureSwizzleBlue,
+    MTLTextureSwizzleAlpha};
+  MTLTextureSwizzle swizzle[8];
+  for (uint32_t i = 0; i < 4; ++i) swizzle[i] = color[std::min(i, channels_in_format - 1)];
+  swizzle[4] = MTLTextureSwizzleZero; swizzle[5] = MTLTextureSwizzleOne; swizzle[6] = swizzle[7] = MTLTextureSwizzleZero;
+  MTLTextureSwizzleChannels channels = MTLTextureSwizzleChannelsMake(swizzle[swizzle_bits & 7],
+    swizzle[(swizzle_bits >> 3) & 7], swizzle[(swizzle_bits >> 6) & 7], swizzle[(swizzle_bits >> 9) & 7]);
+  id<MTLTexture> view = [texture newTextureViewWithPixelFormat:texture.pixelFormat textureType:texture.textureType
+    levels:NSMakeRange(0, texture.mipmapLevelCount) slices:NSMakeRange(0, cube ? 6 : texture.arrayLength) swizzle:channels];
+  views[swizzle_bits] = view;
+  return view;
+}
+
+id<MTLSamplerState> MetalDraw::Sampler(const MetalSamplerBinding& b) {
+  auto fetch = regs_.GetTextureFetch(b.fetch_constant);
+  auto mag = b.mag_filter == xenos::TextureFilter::kUseFetchConst ? fetch.mag_filter : b.mag_filter;
+  auto min = b.min_filter == xenos::TextureFilter::kUseFetchConst ? fetch.min_filter : b.min_filter;
+  std::string key; Key(key, mag); Key(key, min); Key(key, uint32_t(fetch.clamp_x));
+  Key(key, uint32_t(fetch.clamp_y)); Key(key, uint32_t(fetch.clamp_z));
+  auto found = samplers_.find(key); if (found != samplers_.end()) return found->second;
+  auto d = [MTLSamplerDescriptor new];
+  d.magFilter = mag == xenos::TextureFilter::kLinear ? MTLSamplerMinMagFilterLinear : MTLSamplerMinMagFilterNearest;
+  d.minFilter = min == xenos::TextureFilter::kLinear ? MTLSamplerMinMagFilterLinear : MTLSamplerMinMagFilterNearest;
+  auto clamp = [](xenos::ClampMode c) { return uint32_t(c) == 0 ? MTLSamplerAddressModeRepeat :
+    uint32_t(c) == 1 ? MTLSamplerAddressModeMirrorRepeat : MTLSamplerAddressModeClampToEdge; };
+  d.sAddressMode = clamp(fetch.clamp_x); d.tAddressMode = clamp(fetch.clamp_y); d.rAddressMode = clamp(fetch.clamp_z);
+  id<MTLSamplerState> state = [device_ newSamplerStateWithDescriptor:d]; samplers_[key] = state; return state;
+}
+
+bool MetalDraw::Resolve() {
+  @autoreleasepool {
+    draw_util::ResolveInfo info;
+    if (!draw_util::GetResolveInfo(regs_, memory_, 1, 1, edram_tiles_, true, true, info)) return false;
+    EndEncoder();
+    if (!commands_) commands_ = [queue_ commandBuffer];
+    bool depth = info.IsCopyingDepth();
+    auto ei = depth ? info.depth_edram_info : info.color_edram_info;
+    uint32_t original = depth ? info.depth_original_base : info.color_original_base;
+    uint32_t ssx = ei.msaa_samples >= xenos::MsaaSamples::k4X ? 2 : 1, ssy = ei.msaa_samples >= xenos::MsaaSamples::k2X ? 2 : 1;
+    uint32_t pitch = regs_.Get<reg::RB_SURFACE_INFO>().surface_pitch * ssx;
+    MTLPixelFormat format = depth ? MTLPixelFormatDepth32Float_Stencil8 : ColorFormat(xenos::ColorRenderTargetFormat(ei.format));
+    id<MTLTexture> source = nil;
+    std::string identity; Key(identity, original); Key(identity, format); Key(identity, pitch);
+    auto current = targets_.find(identity);
+    if (current != targets_.end()) source = current->second;
+    uint32_t width = info.coordinate_info.width_div_8 * 8, height = info.height_div_8 * 8;
+    uint32_t resolve_rows[2] = {0, 0};
+    uint32_t depth_kind = info.depth_edram_info.format == uint32_t(xenos::DepthRenderTargetFormat::kD24FS8) ? 7u : 6u;
+    uint32_t source_kind = depth ? depth_kind : ColorKind(xenos::ColorRenderTargetFormat(ei.format));
+    if (source && width && height && info.copy_dest_extent_length) {
+      uint32_t delta = (ei.GetBaseTiles() - original) & (edram_tiles_ - 1);
+      uint32_t sx = (delta % std::max(1u, uint32_t(ei.pitch_tiles))) * (ei.format_is_64bpp ? 40 : 80) +
+                    info.coordinate_info.edram_offset_x_div_8 * 8 * ssx;
+      uint32_t sy = (delta / std::max(1u, uint32_t(ei.pitch_tiles))) * 16 + info.coordinate_info.edram_offset_y_div_8 * 8 * ssy;
+      if (sx < source.width && sy < source.height) {
+        width = std::min(width, (uint32_t(source.width) - sx) / ssx); height = std::min(height, (uint32_t(source.height) - sy) / ssy);
+      }
+      if (sx < source.width && sy < source.height && width && height) {
+        resolve_rows[0] = sy; resolve_rows[1] = sy + height * ssy;
+        if (REXCVAR_GET(metal_edram_transfers)) SyncTarget(source, source_kind, resolve_rows[0], resolve_rows[1]);
+        MTLPixelFormat dest_format = MTLPixelFormatRGBA8Unorm;
+        if (depth) dest_format = MTLPixelFormatR32Float;
+        else switch (uint32_t(info.copy_dest_info.copy_dest_format)) {
+          case 2: case 8: case 9: dest_format = MTLPixelFormatR8Unorm; break;
+          case 10: dest_format = MTLPixelFormatRG8Unorm; break;
+          case 7: case 54: dest_format = MTLPixelFormatRGB10A2Unorm; break;
+          case 24: dest_format = MTLPixelFormatR16Unorm; break;
+          case 25: dest_format = MTLPixelFormatRG16Unorm; break;
+          case 26: dest_format = MTLPixelFormatRGBA16Unorm; break;
+          case 30: dest_format = MTLPixelFormatR16Float; break;
+          case 31: dest_format = MTLPixelFormatRG16Float; break;
+          case 32: dest_format = MTLPixelFormatRGBA16Float; break;
+          case 36: dest_format = MTLPixelFormatR32Float; break;
+          case 37: dest_format = MTLPixelFormatRG32Float; break;
+          case 38: dest_format = MTLPixelFormatRGBA32Float; break;
+        }
+        auto desc = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:dest_format width:width height:height mipmapped:NO];
+        desc.storageMode = MTLStorageModePrivate; desc.usage = MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite | MTLTextureUsagePixelFormatView;
+        id<MTLTexture> destination = [device_ newTextureWithDescriptor:desc];
+        if (!destination) return false;
+        bool depth_float = info.depth_edram_info.format == uint32_t(xenos::DepthRenderTargetFormat::kD24FS8);
+        ResolveConstants constants{sx, sy, width, height, info.copy_dest_coordinate_info.offset_x_div_8 * 8u,
+          info.copy_dest_coordinate_info.offset_y_div_8 * 8u, info.copy_dest_coordinate_info.pitch_aligned_div_32 * 32u,
+          info.copy_dest_base, uint32_t(info.copy_dest_info.copy_dest_format), uint32_t(info.copy_dest_info.copy_dest_endian),
+          info.copy_dest_info.copy_dest_swap, memory_buffer_ && REXCVAR_GET(metal_resolve_to_memory) ? 1u : 0u,
+          !depth ? std::ldexp(1.0f, info.copy_dest_info.copy_dest_exp_bias) : depth_float ? 2.0f : 1.0f, 0, ssx, ssy,
+          // One sample (depth always: averaging depth is meaningless) or the average of all.
+          depth || xenos::IsSingleCopySampleSelected(info.rb_copy_control.copy_sample_select)
+              ? (depth ? 0u : uint32_t(info.rb_copy_control.copy_sample_select)) : 4u};
+        // Depth resolves write the EDRAM depth format (xenos.h: no format conversion for depth).
+        constants.extent_start = info.copy_dest_extent_start & 0x1FFFFFFF;
+        constants.extent_end = std::min(constants.extent_start + info.copy_dest_extent_length, 0x20000000u);
+        if (depth) constants.format = depth_float ? uint32_t(xenos::TextureFormat::k_24_8_FLOAT) : uint32_t(xenos::TextureFormat::k_24_8);
+        if (depth && DebugFrame() && REXCVAR_GET(metal_debug_depth_dumps))
+          DumpDepth(source, fmt::format("depth_before_resolve_{}_{}_{}", resolves_ + 1, sx, sy));
+        auto compute = [commands_ computeCommandEncoder];
+        [compute setComputePipelineState:depth ? resolve_depth_ : resolve_color_];
+        [compute setTexture:source atIndex:0]; [compute setTexture:destination atIndex:1];
+        if (depth) {
+          // The stencil half of the depth target, for the 24-bit depth over 8-bit stencil in memory.
+          auto& view = stencil_views_[reinterpret_cast<uintptr_t>((__bridge void*)source)];
+          if (!view) view = [source newTextureViewWithPixelFormat:MTLPixelFormatX32_Stencil8];
+          [compute setTexture:view atIndex:2];
+        }
+        [compute setBytes:&constants length:sizeof(constants) atIndex:0];
+        [compute setBuffer:memory_buffer_ && REXCVAR_GET(metal_resolve_to_memory) ? memory_buffer_ : snapshot_buffer_ offset:0 atIndex:1];
+        [compute setBuffer:resolve_rejected_ offset:0 atIndex:2];
+        [compute dispatchThreads:MTLSizeMake(width, height, 1) threadsPerThreadgroup:MTLSizeMake(8, 8, 1)];
+        [compute endEncoding];
+        uint32_t address = info.copy_dest_base & 0x1FFFFFFF;
+        InvalidateRange(info.copy_dest_extent_start & 0x1FFFFFFF, info.copy_dest_extent_length);
+        if (!constants.dx && !constants.dy)
+          resolved_[address] = {destination, info.copy_dest_extent_start & 0x1FFFFFFF, info.copy_dest_extent_length,
+                                width, height, depth ? constants.format : uint32_t(info.copy_dest_info.copy_dest_format)};
+        ++resolves_;
+        if (!resolve_verified_ && memory_buffer_ && frame_ >= 650 && dest_format == MTLPixelFormatRGBA8Unorm)
+          VerifyResolve(destination, info);
+        if (DebugFrame()) {
+          REXGPU_INFO("Metal resolve debug {}: base {} -> {:08X}, format {} -> {}, source {}x{} origin {},{} size {}x{}, exponent {}, swap {}",
+            resolves_, original, address, uint32_t(ei.format), uint32_t(info.copy_dest_info.copy_dest_format),
+            source.width, source.height, sx, sy, width, height, int(info.copy_dest_info.copy_dest_exp_bias), uint32_t(info.copy_dest_info.copy_dest_swap));
+          DumpTexture(destination, fmt::format("resolve_{}_{:08X}", resolves_, address));
+        }
+      }
+    }
+    if (!depth && info.IsClearingDepth()) {
+      for (auto& [key, target] : targets_) {
+        uint32_t base; std::memcpy(&base, key.data(), sizeof(base));
+        if (base != info.depth_original_base || target.pixelFormat != MTLPixelFormatDepth32Float_Stencil8 ||
+            target.width != regs_.Get<reg::RB_SURFACE_INFO>().surface_pitch *
+                (info.depth_edram_info.msaa_samples >= xenos::MsaaSamples::k4X ? 2 : 1)) continue;
+        auto pass = [MTLRenderPassDescriptor renderPassDescriptor];
+        pass.depthAttachment.texture = pass.stencilAttachment.texture = target;
+        pass.depthAttachment.loadAction = pass.stencilAttachment.loadAction = MTLLoadActionClear;
+        pass.depthAttachment.storeAction = pass.stencilAttachment.storeAction = MTLStoreActionStore;
+        pass.depthAttachment.clearDepth = (info.depth_edram_info.format == uint32_t(xenos::DepthRenderTargetFormat::kD24FS8)
+            ? xenos::Float20e4To32(info.rb_depth_clear >> 8) * 0.5 : double(info.rb_depth_clear >> 8) / 16777215.0);
+        pass.stencilAttachment.clearStencil = info.rb_depth_clear & 255;
+        [[commands_ renderCommandEncoderWithDescriptor:pass] endEncoding];
+        if (REXCVAR_GET(metal_edram_transfers)) MarkWritten(target, depth_kind, resolve_rows[0], resolve_rows[1], nullptr);
+      }
+    }
+    // Clear the same host allocation after copying it; load actions apply at the next encoder boundary.
+    if (source && ((depth && info.IsClearingDepth()) || (!depth && info.IsClearingColor()))) {
+      auto pass = [MTLRenderPassDescriptor renderPassDescriptor];
+      if (depth) {
+        pass.depthAttachment.texture = pass.stencilAttachment.texture = source;
+        pass.depthAttachment.loadAction = pass.stencilAttachment.loadAction = MTLLoadActionClear;
+        pass.depthAttachment.storeAction = pass.stencilAttachment.storeAction = MTLStoreActionStore;
+        pass.depthAttachment.clearDepth = (info.depth_edram_info.format == uint32_t(xenos::DepthRenderTargetFormat::kD24FS8)
+            ? xenos::Float20e4To32(info.rb_depth_clear >> 8) * 0.5 : double(info.rb_depth_clear >> 8) / 16777215.0);
+        pass.stencilAttachment.clearStencil = info.rb_depth_clear & 255;
+      } else {
+        pass.colorAttachments[0].texture = source; pass.colorAttachments[0].loadAction = MTLLoadActionClear;
+        pass.colorAttachments[0].storeAction = MTLStoreActionStore;
+        uint32_t c = info.rb_color_clear;
+        pass.colorAttachments[0].clearColor = MTLClearColorMake((c & 255) / 255.0, ((c >> 8) & 255) / 255.0,
+            ((c >> 16) & 255) / 255.0, (c >> 24) / 255.0);
+      }
+      [[commands_ renderCommandEncoderWithDescriptor:pass] endEncoding];
+      if (REXCVAR_GET(metal_edram_transfers)) MarkWritten(source, source_kind, resolve_rows[0], resolve_rows[1], nullptr);
+    }
+    // Diagnostic: the GPU done with the resolve before the guest goes on, as before two frames were
+    // in flight (the guest may reuse the memory once the command processor has passed the resolve).
+    if (REXCVAR_GET(metal_resolve_wait) && commands_) Submit(true);
+    if (DebugFrame())
+      REXGPU_INFO("Metal resolve clear debug: draw {} {} base color {} depth {}, clear color {} ({:08X}) depth {} ({:08X}), source {}",
+          draws_, depth ? "depth" : "color", info.color_original_base, info.depth_original_base,
+          info.IsClearingColor(), info.rb_color_clear, info.IsClearingDepth(), info.rb_depth_clear, source ? "found" : "missing");
+    return true;
+  }
+}
+
+void MetalDraw::VerifyResolve(id<MTLTexture> texture, const draw_util::ResolveInfo& info) {
+  Submit();
+  // Preserve the caller's pending resolve clears even if allocation or readback fails.
+  commands_ = [queue_ commandBuffer];
+  size_t stride = (texture.width * 4 + 255) & ~size_t(255);
+  auto buffer = [device_ newBufferWithLength:stride * texture.height options:MTLResourceStorageModeShared];
+  if (!buffer) return;
+  auto commands = [queue_ commandBuffer]; auto blit = [commands blitCommandEncoder];
+  [blit copyFromTexture:texture sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 0)
+    sourceSize:MTLSizeMake(texture.width, texture.height, 1) toBuffer:buffer destinationOffset:0
+    destinationBytesPerRow:stride destinationBytesPerImage:stride * texture.height];
+  [blit endEncoding]; [commands commit]; [commands waitUntilCompleted];
+  if (commands.status != MTLCommandBufferStatusCompleted) return;
+  uint32_t mismatch = 0, checked = 0, nonzero = 0;
+  uint32_t endian = uint32_t(info.copy_dest_info.copy_dest_endian);
+  uint32_t xor_mask = endian == 1 ? 1 : endian == 2 ? 3 : endian == 3 ? 2 : endian == 4 ? 7 : endian == 5 ? 15 : 0;
+  auto* physical = memory_.physical_membase();
+  for (uint32_t y = 0; y < texture.height; y += std::max(1u, uint32_t(texture.height) / 16))
+    for (uint32_t x = 0; x < texture.width; x += std::max(1u, uint32_t(texture.width) / 16)) {
+      uint32_t address = info.copy_dest_base + texture_util::GetTiledOffset2D(
+          x + info.copy_dest_coordinate_info.offset_x_div_8 * 8,
+          y + info.copy_dest_coordinate_info.offset_y_div_8 * 8,
+          info.copy_dest_coordinate_info.pitch_aligned_div_32 * 32, 2);
+      auto* expected = static_cast<const uint8_t*>(buffer.contents) + y * stride + x * 4;
+      for (uint32_t c = 0; c < 4; ++c) {
+        uint32_t a = (address + c) ^ xor_mask;
+        if (a >= SharedMemory::kBufferSize) { ++mismatch; continue; }
+        ++checked; mismatch += physical[a] != expected[c]; nonzero += expected[c] != 0;
+      }
+    }
+  resolve_verified_ = true;
+  REXGPU_INFO("Metal resolve CPU visibility: {} bytes checked ({} nonzero), {} mismatches", checked, nonzero, mismatch);
+  if (mismatch) ++failures_;
+}
+
+uint32_t MetalDraw::ColorKind(xenos::ColorRenderTargetFormat format) const {
+  using F = xenos::ColorRenderTargetFormat;
+  switch (format) {
+    case F::k_8_8_8_8: case F::k_8_8_8_8_GAMMA: return 0;
+    case F::k_2_10_10_10: case F::k_2_10_10_10_AS_10_10_10_10: return 1;
+    case F::k_2_10_10_10_FLOAT: case F::k_2_10_10_10_FLOAT_AS_16_16_16_16: return 2;
+    case F::k_16_16: return 3;
+    case F::k_16_16_FLOAT: return 4;
+    case F::k_32_FLOAT: return 5;
+    default: return kNoTransfer;
+  }
+}
+uint32_t MetalDraw::DepthKind() const {
+  return regs_.Get<reg::RB_DEPTH_INFO>().depth_format == xenos::DepthRenderTargetFormat::kD24FS8 ? 7u : 6u;
+}
+bool MetalDraw::TileRange(const TargetLayout& l, uint32_t height, uint32_t y0, uint32_t y1, uint32_t& lo, uint32_t& hi) const {
+  y1 = std::min(y1, height);
+  if (y0 >= y1 || l.base >= edram_tiles_) return false;
+  lo = l.base + (y0 / 16) * l.pitch_tiles;
+  hi = std::min(edram_tiles_, l.base + ((y1 + 15) / 16) * l.pitch_tiles);
+  return lo < hi;
+}
+void MetalDraw::MarkWritten(id<MTLTexture> target, uint32_t kind, uint32_t y0, uint32_t y1,
+                            std::pair<uint32_t, uint32_t>* claimed) {
+  auto key = reinterpret_cast<uintptr_t>((__bridge void*)target);
+  auto layout = target_layouts_.find(key);
+  if (layout == target_layouts_.end()) return;
+  auto& l = layout->second;
+  uint32_t lo, hi;
+  if (!TileRange(l, uint32_t(target.height), y0, y1, lo, hi)) return;
+  if (l.is_64bpp) kind = kNoTransfer;
+  auto mark = [&](uint32_t from, uint32_t to) {
+    for (uint32_t t = from; t < to; ++t) {
+      tile_version_[t] = ++edram_version_; tile_owner_[t] = key; tile_kind_[t] = kind; l.have[t] = tile_version_[t];
+    }
+  };
+  if (!claimed || claimed->first == claimed->second) {
+    mark(lo, hi);
+    if (claimed) *claimed = {lo, hi};
+    return;
+  }
+  // Only what this pass has not claimed yet: its own later draws change nothing for the others.
+  if (lo < claimed->first) mark(lo, std::min(hi, claimed->first));
+  if (hi > claimed->second) mark(std::max(lo, claimed->second), hi);
+  *claimed = {std::min(lo, claimed->first), std::max(hi, claimed->second)};
+}
+void MetalDraw::SyncTarget(id<MTLTexture> target, uint32_t kind, uint32_t y0, uint32_t y1) {
+  auto key = reinterpret_cast<uintptr_t>((__bridge void*)target);
+  auto layout = target_layouts_.find(key);
+  if (layout == target_layouts_.end()) return;
+  auto& l = layout->second;
+  uint32_t lo, hi;
+  if (!TileRange(l, uint32_t(target.height), y0, y1, lo, hi)) return;
+  bool can_take = kind != kNoTransfer && !l.is_64bpp;
+  // Runs of tiles another target wrote since, by writer and format.
+  uint32_t run_start = 0; uintptr_t run_owner = 0; uint32_t run_kind = kNoTransfer;
+  auto flush = [&](uint32_t end) {
+    if (!run_owner) return;
+    auto source = target_layouts_.find(run_owner);
+    if (source != target_layouts_.end() && run_kind != kNoTransfer && can_take)
+      Transfer(source->second, run_kind, target, kind, run_start, end);
+    run_owner = 0;
+  };
+  for (uint32_t t = lo; t < hi; ++t) {
+    uintptr_t owner = tile_owner_[t];
+    bool stale = l.have[t] != tile_version_[t] && owner && owner != key;
+    if (!stale) { flush(t); l.have[t] = tile_version_[t]; continue; }
+    if (run_owner && (owner != run_owner || tile_kind_[t] != run_kind)) flush(t);
+    if (!run_owner) { run_owner = owner; run_kind = tile_kind_[t]; run_start = t; }
+    l.have[t] = tile_version_[t];
+  }
+  flush(hi);
+}
+void MetalDraw::Transfer(const TargetLayout& sl, uint32_t source_kind, id<MTLTexture> target, uint32_t kind,
+                         uint32_t lo, uint32_t hi) {
+  auto target_layout = target_layouts_.find(reinterpret_cast<uintptr_t>((__bridge void*)target));
+  if (target_layout == target_layouts_.end() || !helper_library_) return;
+  const auto& dl = target_layout->second;
+  id<MTLTexture> source_texture = sl.texture;
+  if (hi <= dl.base) return;
+  uint32_t first_row = lo > dl.base ? (lo - dl.base) / dl.pitch_tiles : 0;
+  uint32_t end_row = (hi - dl.base + dl.pitch_tiles - 1) / dl.pitch_tiles;
+  uint32_t y0 = first_row * 16, y1 = std::min<uint32_t>(end_row * 16, uint32_t(target.height));
+  if (y0 >= y1) return;
+  uint32_t pipeline_key = (sl.is_depth ? 1u : 0u) | (dl.is_depth ? 2u : 0u) | (uint32_t(target.pixelFormat) << 2);
+  id<MTLRenderPipelineState> pipeline = transfer_pipelines_[pipeline_key];
+  if (!pipeline) {
+    static const char* names[] = {"transfer_color_from_color", "transfer_color_from_depth", "transfer_depth_from_color",
+                                  "transfer_depth_from_depth"};
+    auto pd = [MTLRenderPipelineDescriptor new];
+    pd.vertexFunction = [helper_library_ newFunctionWithName:@"transfer_vs"];
+    pd.fragmentFunction = [helper_library_ newFunctionWithName:[NSString stringWithUTF8String:names[pipeline_key & 3]]];
+    if (dl.is_depth) pd.depthAttachmentPixelFormat = pd.stencilAttachmentPixelFormat = target.pixelFormat;
+    else pd.colorAttachments[0].pixelFormat = target.pixelFormat;
+    NSError* error = nil;
+    pipeline = [device_ newRenderPipelineStateWithDescriptor:pd error:&error];
+    if (!pipeline) {
+      ++failures_;
+      REXGPU_ERROR("Metal EDRAM transfer pipeline failed: {}", error ? error.localizedDescription.UTF8String : "?");
+      return;
+    }
+    transfer_pipelines_[pipeline_key] = pipeline;
+  }
+  if (!commands_) commands_ = [queue_ commandBuffer];
+  auto pass = [MTLRenderPassDescriptor renderPassDescriptor];
+  if (dl.is_depth) {
+    pass.depthAttachment.texture = pass.stencilAttachment.texture = target;
+    pass.depthAttachment.loadAction = pass.stencilAttachment.loadAction = MTLLoadActionLoad;
+    pass.depthAttachment.storeAction = pass.stencilAttachment.storeAction = MTLStoreActionStore;
+  } else {
+    pass.colorAttachments[0].texture = target;
+    pass.colorAttachments[0].loadAction = MTLLoadActionLoad;
+    pass.colorAttachments[0].storeAction = MTLStoreActionStore;
+  }
+  auto encoder = [commands_ renderCommandEncoderWithDescriptor:pass];
+  encoder.label = @"Xenos EDRAM transfer";
+  [encoder setRenderPipelineState:pipeline];
+  if (dl.is_depth) [encoder setDepthStencilState:transfer_depth_state_];
+  [encoder setScissorRect:MTLScissorRect{0, y0, target.width, y1 - y0}];
+  struct { uint32_t dst_base, dst_pitch, src_base, src_pitch, lo, hi, src_kind, dst_kind; } c{
+      dl.base, dl.pitch_tiles, sl.base, sl.pitch_tiles, lo, hi, source_kind, kind};
+  [encoder setFragmentBytes:&c length:sizeof(c) atIndex:0];
+  [encoder setFragmentTexture:source_texture atIndex:0];
+  if (sl.is_depth) {
+    auto& view = stencil_views_[reinterpret_cast<uintptr_t>((__bridge void*)source_texture)];
+    if (!view) view = [source_texture newTextureViewWithPixelFormat:MTLPixelFormatX32_Stencil8];
+    [encoder setFragmentTexture:view atIndex:1];
+  }
+  [encoder drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+  [encoder endEncoding];
+  ++edram_transfers_;
+  if (DebugFrame())
+    REXGPU_INFO("Metal EDRAM transfer: draw {} base {} pitch {} kind {} -> base {} pitch {} kind {}, tiles {}..{}, rows {}..{}",
+        draws_, sl.base, sl.pitch_tiles, source_kind, dl.base, dl.pitch_tiles, kind, lo, hi, y0, y1);
+}
+
+void MetalDraw::DumpDepth(id<MTLTexture> texture, const std::string& name) {
+  const auto dir = REXCVAR_GET(metal_debug_dir);
+  if (dir.empty() || !texture) return;
+  Submit(true);
+  size_t stride = texture.width * 4;
+  auto buffer = [device_ newBufferWithLength:stride * texture.height options:MTLResourceStorageModeShared];
+  if (!buffer) return;
+  auto commands = [queue_ commandBuffer];
+  auto blit = [commands blitCommandEncoder];
+  [blit copyFromTexture:texture sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 0)
+      sourceSize:MTLSizeMake(texture.width, texture.height, 1) toBuffer:buffer destinationOffset:0
+      destinationBytesPerRow:stride destinationBytesPerImage:stride * texture.height options:MTLBlitOptionDepthFromDepthStencil];
+  [blit endEncoding]; [commands commit]; [commands waitUntilCompleted];
+  const float* depth = static_cast<const float*>(buffer.contents);
+  size_t count = size_t(texture.width) * texture.height, zeros = 0, ones = 0;
+  float lo = 1e30f, hi = -1e30f;
+  for (size_t i = 0; i < count; ++i) {
+    lo = std::min(lo, depth[i]); hi = std::max(hi, depth[i]); zeros += depth[i] == 0.0f; ones += depth[i] == 1.0f;
+  }
+  REXGPU_INFO("Metal depth dump {}: {}x{}, min {} max {}, {:.1f}% zero, {:.1f}% one", name, texture.width, texture.height,
+      lo, hi, 100.0 * zeros / count, 100.0 * ones / count);
+  std::error_code error; std::filesystem::create_directories(dir, error);
+  std::ofstream out(dir + "/" + name + ".pgm", std::ios::binary);
+  out << "P5\n" << texture.width << " " << texture.height << "\n255\n";
+  for (size_t i = 0; i < count; ++i) out.put(char(std::clamp(depth[i], 0.0f, 1.0f) * 255.0f));
+  std::ofstream raw(dir + "/" + name + ".f32", std::ios::binary);
+  raw.write(reinterpret_cast<const char*>(depth), count * sizeof(float));
+  commands_ = [queue_ commandBuffer];
+}
+
+void MetalDraw::DumpTexture(id<MTLTexture> texture, const std::string& name) {
+  const auto dir = REXCVAR_GET(metal_debug_dir);
+  if (dir.empty()) return;
+  Submit();
+  commands_ = [queue_ commandBuffer];
+  auto desc = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA32Float
+      width:texture.width height:texture.height mipmapped:NO];
+  desc.storageMode = MTLStorageModePrivate; desc.usage = MTLTextureUsageShaderWrite;
+  auto readable = [device_ newTextureWithDescriptor:desc];
+  size_t stride = (texture.width * 16 + 255) & ~size_t(255);
+  auto buffer = [device_ newBufferWithLength:stride * texture.height options:MTLResourceStorageModeShared];
+  if (!readable || !buffer) return;
+  auto commands = [queue_ commandBuffer];
+  auto compute = [commands computeCommandEncoder];
+  [compute setComputePipelineState:resolve_color_];
+  [compute setTexture:texture atIndex:0]; [compute setTexture:readable atIndex:1];
+  ResolveConstants constants;
+  constants.width = uint32_t(texture.width); constants.height = uint32_t(texture.height);
+  [compute setBytes:&constants length:sizeof(constants) atIndex:0];
+  [compute setBuffer:snapshot_buffer_ offset:0 atIndex:1];
+  [compute setBuffer:resolve_rejected_ offset:0 atIndex:2];
+  [compute dispatchThreads:MTLSizeMake(texture.width, texture.height, 1) threadsPerThreadgroup:MTLSizeMake(8, 8, 1)];
+  [compute endEncoding];
+  auto blit = [commands blitCommandEncoder];
+  [blit copyFromTexture:readable sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 0)
+      sourceSize:MTLSizeMake(texture.width, texture.height, 1) toBuffer:buffer destinationOffset:0
+      destinationBytesPerRow:stride destinationBytesPerImage:stride * texture.height];
+  [blit endEncoding]; [commands commit]; [commands waitUntilCompleted];
+  if (commands.status != MTLCommandBufferStatusCompleted) return;
+  std::error_code error; std::filesystem::create_directories(dir, error);
+  std::ofstream out(dir + "/" + name + ".ppm", std::ios::binary);
+  out << "P6\n" << texture.width << " " << texture.height << "\n255\n";
+  for (size_t y = 0; y < texture.height; ++y) {
+    const float* row = reinterpret_cast<const float*>(static_cast<const uint8_t*>(buffer.contents) + y * stride);
+    for (size_t x = 0; x < texture.width; ++x) for (size_t c = 0; c < 3; ++c) {
+      float value = row[x * 4 + c];
+      out.put(char(std::isfinite(value) ? std::clamp(value, 0.0f, 1.0f) * 255.0f : 0));
+    }
+  }
+  std::ofstream alpha(dir + "/" + name + "_alpha.pgm", std::ios::binary);
+  alpha << "P5\n" << texture.width << " " << texture.height << "\n255\n";
+  for (size_t y = 0; y < texture.height; ++y) {
+    const float* row = reinterpret_cast<const float*>(static_cast<const uint8_t*>(buffer.contents) + y * stride);
+    for (size_t x = 0; x < texture.width; ++x)
+      alpha.put(char(std::isfinite(row[x * 4 + 3]) ? std::clamp(row[x * 4 + 3], 0.0f, 1.0f) * 255.0f : 0));
+  }
+  // Dumping drained the pending resolve; leave a command buffer for its clears.
+  commands_ = [queue_ commandBuffer];
+}
+
+bool MetalDraw::Present(uint32_t address, id<MTLTexture> destination, const GammaRamp* gamma) {
+  // EndFrame has committed the frame; the front buffer's load and the copy follow it on the queue.
+  Submit(false);
+  // The swap packet installs the front buffer's texture fetch constant in slot 0; it goes through
+  // the same lookup as any texture (the resolve's own texture if it is exactly the front buffer,
+  // guest memory otherwise, e.g. a scene resolved in tiles), with the fetch's component swizzle.
+  auto fetch = regs_.GetTextureFetch(0);
+  if (fetch.type != xenos::FetchConstantType::kTexture || !fetch.base_address) return false;
+  (void)address;
+  MetalTextureBinding binding{0, 0, xenos::FetchOpDimension::k2D, false};
+  id<MTLTexture> source = Texture(binding);
+  if (!source || source.width <= 1) return false;
+  // The front buffer's format picks the ramp (as the Vulkan backend does): PWL for 10-bit, the table otherwise.
+  auto format = GetBaseFormat(fetch.format);
+  bool pwl = format == xenos::TextureFormat::k_2_10_10_10 || format == xenos::TextureFormat::k_2_10_10_10_AS_16_16_16_16;
+  struct { uint32_t size[2]; uint32_t mode; } c{{uint32_t(std::min(source.width, destination.width)),
+      uint32_t(std::min(source.height, destination.height))}, gamma && REXCVAR_GET(metal_gamma_ramp) ? (pwl ? 2u : 1u) : 0u};
+  EndEncoder();
+  if (!commands_) commands_ = [queue_ commandBuffer];
+  auto commands = commands_; commands.label = @"Xenos front buffer";
+  commands_ = nil;
+  auto compute = [commands computeCommandEncoder];
+  [compute setComputePipelineState:present_];
+  [compute setTexture:source atIndex:0]; [compute setTexture:destination atIndex:1];
+  [compute setBytes:&c length:sizeof(c) atIndex:0];
+  static const GammaRamp kIdentity{};
+  [compute setBytes:(gamma ? gamma : &kIdentity) length:sizeof(GammaRamp) atIndex:1];
+  [compute dispatchThreads:MTLSizeMake(c.size[0], c.size[1], 1) threadsPerThreadgroup:MTLSizeMake(8, 8, 1)];
+  [compute endEncoding]; [commands commit];
+  return true;
+}
+}  // namespace rex::graphics::metal
