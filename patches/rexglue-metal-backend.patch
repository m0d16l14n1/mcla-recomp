+REXCVAR_DEFINE_BOOL(metal_shader_storage, true, "GPU/Metal",
+                    "Keep the shaders translated in a run and translate them on worker threads before the next starts")
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+
+void MetalCommandProcessor::InitializeShaderStorage(const std::filesystem::path& cache_root, uint32_t title_id,
+                                                    bool blocking) {
+  CommandProcessor::InitializeShaderStorage(cache_root, title_id, blocking);
+  if (!shader_compiler_ || !REXCVAR_GET(metal_shader_storage)) return;
+  if (shader_storage_) { std::fclose(shader_storage_); shader_storage_ = nullptr; }
+  std::error_code error;
+  auto dir = cache_root / "shaders" / "metal";
+  std::filesystem::create_directories(dir, error);
+  auto path = dir / fmt::format("{:08X}.mcla-metal-shaders", title_id);
+  static constexpr char kMagic[8] = {'M', 'C', 'L', 'A', 'M', 'T', 'S', '1'};
+  // Records: 1 = a shader (type, hash, dword count, its big-endian microcode), 2 = a modification of one.
+  std::unordered_map<uint64_t, std::vector<uint64_t>> modifications;
+  size_t valid_bytes = 0;
+  if (std::FILE* in = std::fopen(path.string().c_str(), "rb")) {
+    char magic[8];
+    if (std::fread(magic, 1, 8, in) == 8 && !std::memcmp(magic, kMagic, 8)) {
+      valid_bytes = 8;
+      for (uint8_t tag; std::fread(&tag, 1, 1, in) == 1;) {
+        if (tag == 1) {
+          uint8_t type; uint64_t hash; uint32_t count;
+          if (std::fread(&type, 1, 1, in) != 1 || std::fread(&hash, 8, 1, in) != 1 || std::fread(&count, 4, 1, in) != 1 ||
+              count > 65536) break;
+          std::vector<uint32_t> code(count);
+          if (std::fread(code.data(), 4, count, in) != count) break;
+          if (!shaders_.count(hash))
+            shaders_.emplace(hash, CreateMetalShader(xenos::ShaderType(type), hash, code.data(), count));
+          stored_shaders_.insert(hash);
+        } else if (tag == 2) {
+          uint64_t entry[2];
+          if (std::fread(entry, 8, 2, in) != 2) break;
+          modifications[entry[0]].push_back(entry[1]);
+        } else {
+          break;
+        }
+        valid_bytes = size_t(std::ftell(in));
+      }
+    }
+    std::fclose(in);
+  }
+  std::vector<std::pair<Shader*, std::vector<uint64_t>>> jobs;
+  size_t count = 0;
+  for (auto& [hash, list] : modifications) {
+    auto shader = shaders_.find(hash);
+    if (shader == shaders_.end()) continue;
+    std::sort(list.begin(), list.end()); list.erase(std::unique(list.begin(), list.end()), list.end());
+    count += list.size();
+    jobs.emplace_back(shader->second.get(), std::move(list));
+  }
+  REXGPU_INFO("Metal shader storage: {} shaders, {} translations ({})", stored_shaders_.size(), count, path.string());
+  shader_compiler_->Warm(jobs);
+  // Append from here (a torn record at the end, from a run that did not finish, is cut off).
+  if (valid_bytes) std::filesystem::resize_file(path, valid_bytes, error);
+  shader_storage_ = std::fopen(path.string().c_str(), valid_bytes ? "ab" : "wb");
+  if (!shader_storage_) return;
+  if (!valid_bytes) std::fwrite(kMagic, 1, 8, shader_storage_);
+  std::fflush(shader_storage_);
+  shader_compiler_->on_new_translation = [this](const Shader& shader, uint64_t modification) {
+    if (!shader_storage_) return;
+    uint64_t hash = shader.ucode_data_hash();
+    if (stored_shaders_.insert(hash).second) {
+      uint8_t tag = 1, type = uint8_t(shader.type());
+      uint32_t count = uint32_t(shader.ucode_dword_count());
+      std::vector<uint32_t> code(shader.ucode_data());
+      for (auto& word : code) word = rex::byte_swap(word);  // back to the guest's order, as LoadShader sees it
+      std::fwrite(&tag, 1, 1, shader_storage_); std::fwrite(&type, 1, 1, shader_storage_);
+      std::fwrite(&hash, 8, 1, shader_storage_); std::fwrite(&count, 4, 1, shader_storage_);
+      std::fwrite(code.data(), 4, count, shader_storage_);
+    }
+    uint8_t tag = 2; uint64_t entry[2] = {hash, modification};
+    std::fwrite(&tag, 1, 1, shader_storage_); std::fwrite(entry, 8, 2, shader_storage_);
+    std::fflush(shader_storage_);
+  };
+  InitializePipelineStorage(dir, title_id);
+}
+
+REXCVAR_DEFINE_BOOL(metal_pipeline_storage, true, "GPU/Metal",
+                    "Keep the pipelines built in a run and build them on Metal's threads from the next start (no "
+                    "stall the first time a place or effect needs one)")
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+
+void MetalCommandProcessor::InitializePipelineStorage(const std::filesystem::path& dir, uint32_t title_id) {
+  if (!draw_ || !REXCVAR_GET(metal_pipeline_storage)) return;
+  if (pipeline_storage_) { std::fclose(pipeline_storage_); pipeline_storage_ = nullptr; }
+  auto path = dir / fmt::format("{:08X}.mcla-metal-pipelines", title_id);
+  // A new magic when the key or the descriptor made from it changes.
+  static constexpr char kMagic[8] = {'M', 'C', 'L', 'A', 'M', 'T', 'P', '1'};
+  // Records: vertex shader hash and modification, pixel shader hash (0: none) and modification, then MetalDraw's
+  // key words 2 to 5.
+  using Record = std::array<uint64_t, 8>;
+  auto record_hash = [](const Record& r) { return XXH3_64bits(r.data(), sizeof(Record)); };
+  std::vector<MetalDraw::PipelineKey> keys;
+  size_t valid_bytes = 0, records = 0;
+  if (std::FILE* in = std::fopen(path.string().c_str(), "rb")) {
+    char magic[8];
+    if (std::fread(magic, 1, 8, in) == 8 && !std::memcmp(magic, kMagic, 8)) {
+      valid_bytes = 8;
+      for (Record r; std::fread(r.data(), sizeof(Record), 1, in) == 1;) {
+        valid_bytes += sizeof(Record);
+        if (!stored_pipelines_.insert(record_hash(r)).second) continue;
+        ++records;
+        auto vs = shaders_.find(r[0]);
+        if (vs == shaders_.end()) continue;
+        const Shader::Translation* vt = vs->second->GetTranslation(r[1]);
+        const Shader::Translation* pt = nullptr;
+        if (r[2]) {
+          auto ps = shaders_.find(r[2]);
+          if (ps == shaders_.end()) continue;
+          pt = ps->second->GetTranslation(r[3]);
+          if (!pt) continue;
+        }
+        if (!vt) continue;
+        keys.push_back({uint64_t(reinterpret_cast<uintptr_t>(vt)), uint64_t(reinterpret_cast<uintptr_t>(pt)),
+                        r[4], r[5], r[6], r[7]});
+      }
+    }
+    std::fclose(in);
+  }
+  REXGPU_INFO("Metal pipeline storage: {} pipelines, {} with their shaders in the shader storage ({})", records,
+              keys.size(), path.string());
+  draw_->InitPipelines4(dir, title_id);
+  draw_->Prebuild(std::move(keys));
+  std::error_code error;
+  if (valid_bytes) std::filesystem::resize_file(path, valid_bytes, error);
+  pipeline_storage_ = std::fopen(path.string().c_str(), valid_bytes ? "ab" : "wb");
+  if (!pipeline_storage_) return;
+  if (!valid_bytes) std::fwrite(kMagic, 1, 8, pipeline_storage_);
+  std::fflush(pipeline_storage_);
+  draw_->on_new_pipeline_ = [this, record_hash](const MetalDraw::PipelineKey& key) {
+    if (!pipeline_storage_) return;
+    auto vt = reinterpret_cast<const Shader::Translation*>(uintptr_t(key[0]));
+    auto pt = reinterpret_cast<const Shader::Translation*>(uintptr_t(key[1]));
+    Record r{vt->shader().ucode_data_hash(), vt->modification(), pt ? pt->shader().ucode_data_hash() : 0,
+             pt ? pt->modification() : 0, key[2], key[3], key[4], key[5]};
+    if (!stored_pipelines_.insert(record_hash(r)).second) return;
+    std::fwrite(r.data(), sizeof(Record), 1, pipeline_storage_);
+    std::fflush(pipeline_storage_);
+  };
+}
+
+Shader* MetalCommandProcessor::LoadShader(xenos::ShaderType shader_type,
+                                          [[maybe_unused]] uint32_t guest_address,
+                                          const uint32_t* host_address, uint32_t dword_count) {
+  const uint64_t hash = XXH3_64bits(host_address, dword_count * sizeof(uint32_t));
+  auto it = shaders_.find(hash);
+  if (it != shaders_.end()) {
+    return it->second.get();
+  }
+  shader_ranges_.emplace_back(guest_address & 0x1FFFFFFF, dword_count);
+  auto shader = CreateMetalShader(shader_type, hash, host_address, dword_count);
+  Shader* shader_ptr = shader.get();
+  shaders_.emplace(hash, std::move(shader));
+  return shader_ptr;
+}
