+
+bool MetalPresenter::CaptureGuestOutput(ui::RawImage& image_out) {
+  @autoreleasepool {
+    uint32_t index;
+    // Retain the mailbox consumer lock until the readback is queued and completed, so a producer
+    // cannot recycle this slot while the capture is reading it.
+    auto lock = ConsumeGuestOutput(index, nullptr, nullptr);
+    if (index >= kGuestOutputMailboxSize || !guest_output_textures_[index]) return false;
+    id<MTLTexture> texture = guest_output_textures_[index];
+    size_t stride = (texture.width * 4 + 255) & ~size_t(255);
+    id<MTLBuffer> buffer = [device_ newBufferWithLength:stride * texture.height options:MTLResourceStorageModeShared];
+    if (!buffer) return false;
+    auto commands = [command_queue_ commandBuffer];
+    auto blit = [commands blitCommandEncoder];
+    [blit copyFromTexture:texture sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 0)
+      sourceSize:MTLSizeMake(texture.width, texture.height, 1) toBuffer:buffer destinationOffset:0
+      destinationBytesPerRow:stride destinationBytesPerImage:stride * texture.height];
+    [blit endEncoding]; [commands commit]; [commands waitUntilCompleted];
+    if (commands.status != MTLCommandBufferStatusCompleted) return false;
+    image_out.width = uint32_t(texture.width); image_out.height = uint32_t(texture.height);
+    image_out.stride = stride; image_out.data.resize(stride * texture.height);
+    std::memcpy(image_out.data.data(), buffer.contents, image_out.data.size());
+    if (texture.pixelFormat == MTLPixelFormatRGB10A2Unorm) {
+      // HDR output: PQ code values back to SDR (or 10-bit SDR to 8-bit), as the other backends' captures.
+      GuestOutputCaptureConverter convert(guest_output_hdr_[index]);
+      for (size_t y = 0; y < texture.height; ++y) {
+        auto* row = reinterpret_cast<uint32_t*>(image_out.data.data() + y * stride);
+        for (size_t x = 0; x < texture.width; ++x) row[x] = convert(row[x]);
+      }
+    }
+    return true;
+  }
+}
+
+ui::Presenter::SurfacePaintConnectResult MetalPresenter::ConnectOrReconnectPaintingToSurfaceFromUIThread(
+    ui::Surface& new_surface, uint32_t new_surface_width, uint32_t new_surface_height,
+    bool was_paintable, bool& is_vsync_implicit_out) {
+  if (new_surface.GetType() != ui::Surface::kTypeIndex_CAMetalLayer) {
+    return SurfacePaintConnectResult::kFailureSurfaceUnusable;
+  }
+  CAMetalLayer* layer =
+      (__bridge CAMetalLayer*)static_cast<ui::CAMetalLayerSurface&>(new_surface).layer();
+  if (!layer) {
+    return SurfacePaintConnectResult::kFailureSurfaceUnusable;
+  }
+  const CGSize drawable_size = CGSizeMake(new_surface_width, new_surface_height);
+  if (was_paintable && layer == layer_ && CGSizeEqualToSize(layer.drawableSize, drawable_size)) {
+    is_vsync_implicit_out = layer.displaySyncEnabled;
+    return SurfacePaintConnectResult::kSuccessUnchanged;
+  }
+  // Not while frame generation's thread is getting drawables from the layer.
+  FgPresentWaitIdle();
+  layer.device = device_;
+  layer.pixelFormat = MTLPixelFormatBGRA8Unorm;
+  layer.wantsExtendedDynamicRangeContent = NO;
+  layer.colorspace = nil;
+  layer.EDRMetadata = nil;
+  layer_hdr_ = false;
+  SetHdrOutputActive(false);
+  // Readable drawables only while metal_present_capture asks for them (writable-only lets Metal compress them).
+  layer.framebufferOnly = REXCVAR_GET(metal_present_capture).empty() ? YES : NO;
+  // The surface's size is in pixels already (SDL's pixel size of the window).
+  layer.drawableSize = drawable_size;
+  layer.maximumDrawableCount = 3;
+  layer_ = layer;
+  is_vsync_implicit_out = layer.displaySyncEnabled;
+  REXGPU_INFO("Metal presenter: painting to a {}x{} CAMetalLayer, display sync {}", new_surface_width,
+              new_surface_height, layer.displaySyncEnabled ? "on" : "off");
+  return SurfacePaintConnectResult::kSuccess;
+}
+
+void MetalPresenter::DisconnectPaintingFromSurfaceFromUIThreadImpl() {
+  FgPresentStop();
+  layer_ = nil;
+  layer_hdr_ = false;
+  SetHdrOutputActive(false);
+}
+
+bool MetalPresenter::HdrWanted() {
+  if (!paint_hdr_pipeline_) return false;
+  const std::string mode = REXCVAR_GET(hdr);
+  if (mode == "on") return true;
+  if (mode != "auto" || !REXCVAR_GET(metal_hdr_auto_edr)) return false;
+  // Whether the display can show EDR at all (its headroom now depends on the brightness), read about once a second.
+  const auto now = std::chrono::steady_clock::now();
+  if (now - edr_checked_ > std::chrono::seconds(1)) {
+    edr_checked_ = now;
+    NSScreen* screen = [NSScreen mainScreen];
+    const double potential = screen ? double(screen.maximumPotentialExtendedDynamicRangeColorComponentValue) : 1.0;
+    if (potential != edr_potential_) {
+      edr_potential_ = potential;
+      REXGPU_INFO("Metal presenter: the display's EDR headroom can reach {:.2f}x SDR white{}", potential,
+                  potential > 1.0 ? "" : " (no EDR: hdr = auto stays SDR)");
+    }
+  }
+  return edr_potential_ > 1.0;
+}
+
+void MetalPresenter::ConfigureLayerHdr(CAMetalLayer* layer, bool hdr) {
+  if (hdr) {
+    layer.pixelFormat = MTLPixelFormatBGR10A2Unorm;
+    CGColorSpaceRef pq = CGColorSpaceCreateWithName(kCGColorSpaceITUR_2100_PQ);
+    layer.colorspace = pq;
+    CGColorSpaceRelease(pq);
+    layer.wantsExtendedDynamicRangeContent = YES;
+  } else {
+    layer.pixelFormat = MTLPixelFormatBGRA8Unorm;
+    layer.wantsExtendedDynamicRangeContent = NO;
+    layer.colorspace = nil;
+    layer.EDRMetadata = nil;
+  }
+  edr_metadata_peak_ = edr_metadata_white_ = 0.0f;
+  layer_hdr_ = hdr;
+  SetHdrOutputActive(hdr);
+}
+
+bool MetalPresenter::RefreshGuestOutputImpl(
+    uint32_t mailbox_index, uint32_t frontbuffer_width, uint32_t frontbuffer_height,
+    std::function<bool(GuestOutputRefreshContext& context)> refresher, bool& is_8bpc_out_ref,
+    GuestOutputHdr& hdr_out_ref) {
+  if (mailbox_index >= kGuestOutputMailboxSize) {
+    return false;
+  }
+  @autoreleasepool {
+    id<MTLTexture> texture = guest_output_textures_[mailbox_index];
+    // HDR output: 10 bits a channel, for PQ code values (or SDR ones, which the paint places at the SDR level).
+    const MTLPixelFormat format = IsHdrOutputActive() ? MTLPixelFormatRGB10A2Unorm : kGuestOutputFormat;
+    if (!texture || texture.width != frontbuffer_width || texture.height != frontbuffer_height ||
+        texture.pixelFormat != format) {
+      MTLTextureDescriptor* desc =
+          [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:format
+                                                             width:frontbuffer_width
+                                                            height:frontbuffer_height
+                                                         mipmapped:NO];
+      desc.usage = MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite | MTLTextureUsageRenderTarget;
+      desc.storageMode = MTLStorageModePrivate;
+      texture = [device_ newTextureWithDescriptor:desc];
+      if (!texture) {
+        REXGPU_ERROR("Metal presenter: no {}x{} guest output texture", frontbuffer_width, frontbuffer_height);
+        return false;
+      }
+      texture.label = [NSString stringWithFormat:@"rexglue guest output %u", mailbox_index];
+      guest_output_textures_[mailbox_index] = texture;
+    }
+    // Frame generation: a texture for the generated frame like this one; in SDR too the guest output's UI layer is
+    // kept apart while it's on (for the compose of generated frames).
+    id<MTLTexture> generated = nil;
+    const bool fg_wanted = frame_generation_wanted();
+    SetFrameGenerationUiSeparation(fg_wanted);
+    if (fg_wanted) {
+      {
+        generated = generated_textures_[mailbox_index];
+        if (!generated || generated.width != texture.width || generated.height != texture.height ||
+            generated.pixelFormat != texture.pixelFormat) {
+          MTLTextureDescriptor* desc = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:texture.pixelFormat
+                                                                                          width:texture.width
+                                                                                         height:texture.height
+                                                                                      mipmapped:NO];
+          desc.usage = MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite;
+          desc.storageMode = MTLStorageModePrivate;
+          generated = [device_ newTextureWithDescriptor:desc];
+          generated.label = [NSString stringWithFormat:@"rexglue generated frame %u", mailbox_index];
+          generated_textures_[mailbox_index] = generated;
+        }
+      }
+    } else {
+      generated_textures_[mailbox_index] = nil;
+    }
+    MetalGuestOutputRefreshContext context(is_8bpc_out_ref, hdr_out_ref, texture, command_queue_, generated);
+    context.SetIs8bpc(format == kGuestOutputFormat);
+    const bool refreshed = refresher(context);
+    guest_output_hdr_[mailbox_index] = hdr_out_ref;
+    generated_[mailbox_index] = refreshed && generated && context.generated_written();
+    refresh_serial_[mailbox_index] = ++next_refresh_serial_;
+    const auto now = std::chrono::steady_clock::now();
+    const double interval = std::chrono::duration<double>(now - last_refresh_).count();
+    if (last_refresh_ != std::chrono::steady_clock::time_point{} && interval < 0.25) {
+      const double average = refresh_interval_.load(std::memory_order_relaxed);
+      refresh_interval_.store(average ? average * 0.8 + interval * 0.2 : interval, std::memory_order_relaxed);
+    }
+    last_refresh_ = now;
+    return refreshed;
+  }
+}
+
+void MetalPresenter::CapturePaint(id<MTLCommandBuffer> command_buffer, id<MTLTexture> texture, float sdr_nits) {
+  const std::string path = REXCVAR_GET(metal_present_capture);
+  if (path.empty() || texture.framebufferOnly) return;
+  const auto now = std::chrono::steady_clock::now();
+  if (now - last_capture_ < std::chrono::seconds(2)) return;
+  last_capture_ = now;
+  REXGPU_INFO("Metal presenter: capturing a {}x{} paint", uint32_t(texture.width), uint32_t(texture.height));
+  const NSUInteger width = texture.width, height = texture.height, stride = width * 4;
+  id<MTLBuffer> buffer = [device_ newBufferWithLength:stride * height options:MTLResourceStorageModeShared];
+  if (!buffer) return;
+  id<MTLBlitCommandEncoder> blit = [command_buffer blitCommandEncoder];
+  [blit copyFromTexture:texture sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 0)
+             sourceSize:MTLSizeMake(width, height, 1) toBuffer:buffer destinationOffset:0
+ destinationBytesPerRow:stride destinationBytesPerImage:stride * height];
+  [blit endEncoding];
+  const bool hdr = texture.pixelFormat == MTLPixelFormatBGR10A2Unorm;
+  [command_buffer addCompletedHandler:^(id<MTLCommandBuffer>) {
+    // BGRA to a binary PPM, written beside and renamed, so a reader never sees half a file.
+    const std::string part = path + ".part";
+    FILE* file = std::fopen(part.c_str(), "wb");
+    if (!file) return;
+    std::fprintf(file, "P6\n%u %u\n255\n", unsigned(width), unsigned(height));
+    const uint8_t* bgra = static_cast<const uint8_t*>(buffer.contents);
+    std::string row(width * 3, '\0');
+    // HDR10 (BGR10A2, PQ): light relative to the SDR level, Rec.709, clipped, as sRGB, so the SDR part compares.
+    float pq_to_relative[1024];
+    if (hdr) {
+      for (uint32_t i = 0; i < 1024; ++i) {
+        const double e = std::pow(i / 1023.0, 1.0 / 78.84375);
+        pq_to_relative[i] = float(std::pow(std::max(e - 0.8359375, 0.0) / (18.8515625 - 18.6875 * e),
+                                           1.0 / 0.1593017578125) * 10000.0 / std::max(sdr_nits, 1.0f));
+      }
+    }
+    auto srgb = [](float v) {
+      v = std::clamp(v, 0.0f, 1.0f);
+      return char(uint8_t(std::lround(255.0 * (v <= 0.0031308f ? 12.92 * v : 1.055 * std::pow(v, 1.0 / 2.4) - 0.055))));
+    };
+    for (NSUInteger y = 0; y < height; ++y) {
+      for (NSUInteger x = 0; x < width; ++x) {
+        const uint8_t* p = bgra + y * stride + x * 4;
+        if (hdr) {
+          uint32_t v; std::memcpy(&v, p, 4);
+          const float r = pq_to_relative[(v >> 20) & 0x3FF], g = pq_to_relative[(v >> 10) & 0x3FF],
+                      b = pq_to_relative[v & 0x3FF];
+          row[x * 3] = srgb(1.660491f * r - 0.587641f * g - 0.072850f * b);
+          row[x * 3 + 1] = srgb(-0.124550f * r + 1.132900f * g - 0.008349f * b);
+          row[x * 3 + 2] = srgb(-0.018151f * r - 0.100579f * g + 1.118730f * b);
+          continue;
+        }
+        row[x * 3] = char(p[2]); row[x * 3 + 1] = char(p[1]); row[x * 3 + 2] = char(p[0]);
+      }
+      std::fwrite(row.data(), 1, row.size(), file);
+    }
+    std::fclose(file);
+    std::rename(part.c_str(), path.c_str());
+  }];
+}
+
+id<MTLCommandBuffer> MetalPresenter::EncodePaint(id<CAMetalDrawable> target, id<MTLTexture> image,
+                                                 const PaintPlacement& placement, bool ui,
+                                                 const HdrOutputState& hdr_state) {
+  id<MTLCommandBuffer> command_buffer = [command_queue_ commandBuffer];
+  command_buffer.label = @"rexglue paint";
+  MTLRenderPassDescriptor* pass = [MTLRenderPassDescriptor renderPassDescriptor];
+  pass.colorAttachments[0].texture = target.texture;
+  pass.colorAttachments[0].loadAction = MTLLoadActionClear;
+  pass.colorAttachments[0].clearColor = MTLClearColorMake(0.0, 0.0, 0.0, 1.0);
+  pass.colorAttachments[0].storeAction = MTLStoreActionStore;
+  id<MTLRenderCommandEncoder> encoder = [command_buffer renderCommandEncoderWithDescriptor:pass];
+  const bool hdr_target = target.texture.pixelFormat == MTLPixelFormatBGR10A2Unorm;
+  if (image && placement.draw) {
+    // Bilinear to the final size and place, whatever effects the configuration asked for.
+    [encoder setViewport:placement.viewport];
+    [encoder setRenderPipelineState:hdr_target ? paint_hdr_pipeline_ : paint_pipeline_];
+    if (hdr_target) [encoder setFragmentBytes:&placement.hdr length:sizeof(placement.hdr) atIndex:0];
+    [encoder setFragmentTexture:image atIndex:0];
+    [encoder setFragmentSamplerState:paint_sampler_ atIndex:0];
+    [encoder drawPrimitives:MTLPrimitiveTypeTriangleStrip vertexStart:0 vertexCount:4];
+  }
+  if (ui) {
+    const uint32_t width = uint32_t(target.texture.width), height = uint32_t(target.texture.height);
+    [encoder setViewport:MTLViewport{0.0, 0.0, double(width), double(height), 0.0, 1.0}];
+    MetalUIDrawContext ui_draw_context(*this, width, height, encoder, hdr_target, hdr_state.sdr_white_nits,
+                                       hdr_state.sdr_pure_gamma_2_2);
+    ExecuteUIDrawersFromUIThread(ui_draw_context);
+  }
+  [encoder endEncoding];
+  return command_buffer;
+}
+
+void MetalPresenter::FgPresentThread() {
+  pthread_setname_np("rexglue frame generation present");
+  std::unique_lock<std::mutex> lock(fg_mutex_);
+  for (;;) {
+    fg_cv_.wait(lock, [this] { return fg_quit_ || fg_job_.has_value(); });
+    if (fg_quit_) return;
+    FgJob job = std::move(*fg_job_);
+    fg_job_.reset();
+    fg_busy_slot_ = job.slot;
+    lock.unlock();
+    @autoreleasepool {
+      // frame_generation_debug 3: the generated frames only (in place of the new frames too).
+      const bool generated_only = REXCVAR_GET(frame_generation_debug) == 3;
+      const HdrOutputState hdr_state = GetHdrOutputState();
+      for (uint32_t i = 0; i < 2; ++i) {
+        id<CAMetalDrawable> drawable = [job.layer nextDrawable];
+        if (!drawable) continue;
+        id<MTLCommandBuffer> command_buffer =
+            EncodePaint(drawable, fg_copies_[job.slot][generated_only ? 0 : i], job.placement, false, hdr_state);
+        if (!i) command_buffer.label = @"rexglue paint (generated frame)";
+        else CapturePaint(command_buffer, drawable.texture, hdr_state.sdr_white_nits);
+        [command_buffer presentDrawable:drawable afterMinimumDuration:job.half];
+        [command_buffer commit];
+      }
+    }
+    lock.lock();
+    fg_busy_slot_ = UINT32_MAX;
+    fg_cv_.notify_all();
+  }
+}
+
+void MetalPresenter::FgPresentWaitIdle() {
+  std::unique_lock<std::mutex> lock(fg_mutex_);
+  fg_cv_.wait(lock, [this] { return !fg_thread_.joinable() || (!fg_job_ && fg_busy_slot_ == UINT32_MAX); });
+}
+
+void MetalPresenter::FgPresentStop() {
+  if (!fg_thread_.joinable()) return;
+  FgPresentWaitIdle();
+  {
+    std::lock_guard<std::mutex> lock(fg_mutex_);
+    fg_quit_ = true;
+  }
+  fg_cv_.notify_all();
+  fg_thread_.join();
+  fg_quit_ = false;
+}
+
+ui::Presenter::PaintResult MetalPresenter::PaintAndPresentImpl(bool execute_ui_drawers) {
+  @autoreleasepool {
+    CAMetalLayer* layer = layer_;
+    if (!layer) {
+      return PaintResult::kNotPresentedConnectionOutdated;
+    }
+    const uint32_t drawable_width = uint32_t(layer.drawableSize.width);
+    const uint32_t drawable_height = uint32_t(layer.drawableSize.height);
+    if (!drawable_width || !drawable_height) {
+      return PaintResult::kNotPresented;
+    }
+    // HDR output follows the setting (and, for auto, the display) during play: the layer switches in place (not
+    // while frame generation's thread is getting its drawables).
+    const bool hdr = HdrWanted();
+    if (hdr != layer_hdr_) {
+      FgPresentWaitIdle();
+      ConfigureLayerHdr(layer, hdr);
+      REXGPU_INFO("Metal presenter: HDR output (HDR10 with EDR) {}", hdr ? "on" : "off");
+    }
+    const HdrOutputState hdr_state = GetHdrOutputState();
+    if (hdr && (hdr_state.peak_nits != edr_metadata_peak_ || hdr_state.paper_white_nits != edr_metadata_white_)) {
+      // Paper white at EDR 1.0 (the display's SDR white); macOS maps the light above it into the headroom there is.
+      FgPresentWaitIdle();
+      edr_metadata_peak_ = hdr_state.peak_nits;
+      edr_metadata_white_ = hdr_state.paper_white_nits;
+      layer.EDRMetadata = [CAEDRMetadata HDR10MetadataWithMinLuminance:0.005f
+                                                           maxLuminance:hdr_state.peak_nits
+                                                     opticalOutputScale:hdr_state.paper_white_nits];
+    }
+
+    // Held while the guest output texture is used: no refresher may write the acquired image meanwhile,
+    // and the command buffer reading it is committed on the same queue before any later write to it.
+    uint32_t mailbox_index;
+    GuestOutputProperties properties;
+    GuestOutputPaintConfig paint_config;
+    std::unique_lock<std::mutex> consumer_lock = ConsumeGuestOutput(mailbox_index, &properties, &paint_config);
+    const bool have_output = mailbox_index < kGuestOutputMailboxSize;
+    id<MTLTexture> guest_output = have_output ? guest_output_textures_[mailbox_index] : nil;
+    PaintPlacement placement;
+    if (guest_output) {
+      const GuestOutputPaintFlow flow = GetGuestOutputPaintFlow(properties, drawable_width, drawable_height,
+                                                                drawable_width, drawable_height, paint_config);
+      if (flow.effect_count) {
+        const std::pair<uint32_t, uint32_t>& size = flow.effect_output_sizes[flow.effect_count - 1];
+        placement.draw = true;
+        placement.viewport = {double(flow.output_x), double(flow.output_y), double(size.first), double(size.second),
+                              0.0, 1.0};
+        placement.hdr = {hdr_state.sdr_white_nits,
+                         properties.hdr.is_pq && guest_output.pixelFormat == MTLPixelFormatRGB10A2Unorm,
+                         hdr_state.sdr_pure_gamma_2_2};
+      }
+    }
+
+    // Frame generation: a new frame with a generated one before it is shown in two halves of the time between the
+    // guest's frames, the generated one first - while that time is at least about two refreshes of the display (a
+    // display that shows the new frames alone has no room for more), not under the presenter's UI (drawn once a
+    // paint), and not for a paint that is late (it skipped frames: the new frame alone, to catch up).
+    const auto now = std::chrono::steady_clock::now();
+    const uint64_t serial = have_output ? refresh_serial_[mailbox_index] : 0;
+    const bool new_frame = serial && serial != painted_refresh_serial_;
+    const bool late = new_frame && painted_refresh_serial_ && serial > painted_refresh_serial_ + 1;
+    if (new_frame) painted_refresh_serial_ = serial;
+    // The display's refresh rate (the presenter's display reader has none on macOS): the main screen's, read
+    // about once a second.
+    if (now - display_hz_checked_ > std::chrono::seconds(1)) {
+      display_hz_checked_ = now;
+      NSScreen* screen = [NSScreen mainScreen];
+      display_hz_ = screen ? double(screen.maximumFramesPerSecond) : 0.0;
+    }
+    double refresh_hz = display_hz_ >= 24.0 ? display_hz_ : double(GetDisplayRefreshHz());
+    if (!(refresh_hz >= 24.0)) refresh_hz = 60.0;
+    const double frame_interval = refresh_interval_.load(std::memory_order_relaxed);
+    bool show_generated = false;
+    if (new_frame && generated_[mailbox_index] && generated_textures_[mailbox_index] && guest_output) {
+      show_generated = !execute_ui_drawers && !late && frame_interval >= 1.6 / refresh_hz;
+      if (!show_generated) {
+        ++fg_held_back_;
+        if (execute_ui_drawers) ++fg_held_ui_;
+        else if (late) ++fg_held_late_;
+        else ++fg_held_rate_;
+      }
+    }
+    if (fg_presented_ || fg_held_back_) {
+      if (now - fg_log_time_ > std::chrono::seconds(10)) {
+        if (fg_log_time_ != std::chrono::steady_clock::time_point{})
+          REXGPU_INFO("Metal frame generation: {} generated frames presented in 10 s, {} held back ({} under the "
+                      "presenter's UI, {} late paints, {} too fast for the display), {} skipped as the present thread "
+                      "was behind ({:.1f} ms between new frames, a {:.0f} Hz display)",
+                      fg_presented_, fg_held_back_, fg_held_ui_, fg_held_late_, fg_held_rate_, fg_dropped_,
+                      frame_interval * 1000.0, refresh_hz);
+        fg_log_time_ = now;
+        fg_presented_ = 0;
+        fg_held_back_ = 0;
+        fg_held_ui_ = 0;
+        fg_held_late_ = 0;
+        fg_held_rate_ = 0;
+        fg_dropped_ = 0;
+      }
+    }
+    if (show_generated) {
+      id<MTLTexture> generated = generated_textures_[mailbox_index];
+      std::unique_lock<std::mutex> lock(fg_mutex_);
+      if (!fg_copies_[0][0] || fg_copies_[0][0].width != guest_output.width ||
+          fg_copies_[0][0].height != guest_output.height || fg_copies_[0][0].pixelFormat != guest_output.pixelFormat) {
+        // New copies once the thread is done with the old ones.
+        fg_cv_.wait(lock, [this] { return !fg_job_ && fg_busy_slot_ == UINT32_MAX; });
+        MTLTextureDescriptor* desc = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:guest_output.pixelFormat
+                                                                                        width:guest_output.width
+                                                                                       height:guest_output.height
+                                                                                    mipmapped:NO];
+        desc.usage = MTLTextureUsageShaderRead;
+        desc.storageMode = MTLStorageModePrivate;
+        for (auto& slot : fg_copies_)
+          for (auto& copy : slot) copy = [device_ newTextureWithDescriptor:desc];
+      }
+      // A slot neither the thread's job nor the one waiting for it (which this one replaces).
+      uint32_t slot = 0;
+      while (slot == fg_busy_slot_ || (fg_job_ && slot == fg_job_->slot)) ++slot;
+      if (fg_job_) ++fg_dropped_;
+      if (!fg_thread_.joinable()) fg_thread_ = std::thread([this] { FgPresentThread(); });
+      lock.unlock();
+      id<MTLCommandBuffer> copy = [command_queue_ commandBuffer];
+      copy.label = @"rexglue frame generation present copies";
+      id<MTLBlitCommandEncoder> blit = [copy blitCommandEncoder];
+      [blit copyFromTexture:generated toTexture:fg_copies_[slot][0]];
+      [blit copyFromTexture:guest_output toTexture:fg_copies_[slot][1]];
+      [blit endEncoding];
+      [copy commit];
+      lock.lock();
+      // Each half shown for at least most of half the time between the guest's frames (vsync rounds it up to
+      // refreshes of the display).
+      fg_job_ = FgJob{layer, slot, placement, frame_interval * 0.5 * 0.9};
+      lock.unlock();
+      fg_cv_.notify_all();
+      ++fg_presented_;
+      if (!fg_logged_presenting_) {
+        fg_logged_presenting_ = true;
+        REXGPU_INFO("Metal frame generation: presenting generated frames ({:.1f} ms between new frames, a {:.0f} Hz "
+                    "display)", frame_interval * 1000.0, refresh_hz);
+      }
+      return PaintResult::kPresented;
+    }
+
+    // A paint of this thread's own: after what the frame generation thread was given.
+    FgPresentWaitIdle();
+    id<CAMetalDrawable> drawable = [layer nextDrawable];
+    if (!drawable) {
+      return PaintResult::kNotPresented;
+    }
+    id<MTLCommandBuffer> command_buffer = EncodePaint(drawable, guest_output, placement, execute_ui_drawers, hdr_state);
+    CapturePaint(command_buffer, drawable.texture, hdr_state.sdr_white_nits);
+    [command_buffer presentDrawable:drawable];
+    [command_buffer commit];
+    return PaintResult::kPresented;
+  }
+}
