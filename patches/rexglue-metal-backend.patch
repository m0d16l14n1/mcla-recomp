+uint32_t MetalResolutionScale() {
+  static const uint32_t scale = REXCVAR_GET(metal_msaa) ? 1u
+      : uint32_t(std::clamp(REXCVAR_GET(resolution_scale), int32_t(1), int32_t(3)));
+  return scale;
+}
