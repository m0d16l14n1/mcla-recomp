+id<MTLLibrary> MetalRtEffectsLibrary(id<MTLDevice> device, std::string& error) {
+  static const char kSource[] = R"(
+#include <metal_stdlib>
+#include <metal_raytracing>
+using namespace metal;
+using namespace metal::raytracing;
+
+// MetalRtAoArgs.
+struct AoArgs {
+  float4x4 clip_to_world, world_to_last_clip;
+  float4 camera, last_camera;
+  uint2 size, half_size;
+  float4 depth_map;   // as MetalRtCheckArgs: clip z = ((d - x) / (y - x) - w) / z
+  float radius, strength, bias, sharpness;
+  uint rays, frame, history, history_valid;
+  uint scenes;
+  float distance;  // AO out to this far from the camera, fading over its last quarter
+  uint checkerboard;  // rays at half the pixels a frame, the others the next
+  uint pad0;
+};
+// The AO's weight at a distance from the camera.
+float ao_fade(constant AoArgs& a, float camera_distance) {
+  return 1.0f - smoothstep(0.75f * a.distance, a.distance, camera_distance);
+}
+
+float clip_z(constant AoArgs& a, float d) {
+  return ((d - a.depth_map.x) / (a.depth_map.y - a.depth_map.x) - a.depth_map.w) / a.depth_map.z;
+}
+// The world position of a full-size pixel's depth (w 0: no depth there).
+float4 world_at(constant AoArgs& a, texture2d_array<float> depth, int2 pixel) {
+  pixel = clamp(pixel, int2(0), int2(a.size) - 1);
+  const float d = depth.read(uint2(pixel), 0).r;
+  if (!(d > 0.0f && d < 1.0f)) return float4(0.0f);
+  const float2 ndc = float2((float(pixel.x) + 0.5f) / float(a.size.x) * 2.0f - 1.0f,
+                            1.0f - (float(pixel.y) + 0.5f) / float(a.size.y) * 2.0f);
+  const float4 w = float4(ndc, clip_z(a, d), 1.0f) * a.clip_to_world;
+  return float4(w.xyz / w.w, 1.0f);
+}
+uint hash(uint x) {
+  x ^= x >> 16; x *= 0x7feb352dU; x ^= x >> 15; x *= 0x846ca68bU; x ^= x >> 16;
+  return x;
+}
+float random(thread uint& state) { state = hash(state); return float(state >> 8) * (1.0f / 16777216.0f); }
+
+// Half size: the unoccluded share (r) and the distance to the camera (g) of the full-size pixel it was traced at
+// (0: sky).
+kernel void rt_ao_trace(constant AoArgs& a [[buffer(0)]], instance_acceleration_structure scene [[buffer(1)]],
+                        instance_acceleration_structure statics [[buffer(2)]],
+                        texture2d_array<float> depth [[texture(0)]], texture2d<float, access::write> out [[texture(1)]],
+                        uint2 tid [[thread_position_in_grid]]) {
+  if (any(tid >= a.half_size)) return;
+  const int2 pixel = int2(tid * 2u);
+  const float4 p = world_at(a, depth, pixel);
+  if (p.w == 0.0f) { out.write(float4(1.0f, 0.0f, 0.0f, 0.0f), tid); return; }
+  // The normal from the depth: of each axis, the neighbour nearer in depth (no normal across an edge).
+  const float4 px0 = world_at(a, depth, pixel - int2(1, 0)), px1 = world_at(a, depth, pixel + int2(1, 0));
+  const float4 py0 = world_at(a, depth, pixel - int2(0, 1)), py1 = world_at(a, depth, pixel + int2(0, 1));
+  float3 dx = (px1.w != 0.0f && (px0.w == 0.0f || distance(px1.xyz, p.xyz) < distance(px0.xyz, p.xyz)))
+                  ? px1.xyz - p.xyz : p.xyz - px0.xyz;
+  float3 dy = (py1.w != 0.0f && (py0.w == 0.0f || distance(py1.xyz, p.xyz) < distance(py0.xyz, p.xyz)))
+                  ? py1.xyz - p.xyz : p.xyz - py0.xyz;
+  float3 n = cross(dy, dx);
+  const float3 to_camera = a.camera.xyz - p.xyz;
+  const float camera_distance = length(to_camera);
+  if (camera_distance >= a.distance) { out.write(float4(1.0f, camera_distance, 0.0f, 0.0f), tid); return; }
+  // Not this frame's half of the checkerboard: no sample (r < 0), the history's or the neighbours' instead.
+  if (a.checkerboard != 0u && ((tid.x + tid.y + a.frame) & 1u) != 0u) {
+    out.write(float4(-1.0f, camera_distance, 0.0f, 0.0f), tid);
+    return;
+  }
+  if (length_squared(n) < 1e-12f) n = to_camera;
+  n = normalize(n);
+  if (dot(n, to_camera) < 0.0f) n = -n;
+  // A basis around the normal; cosine-weighted directions over the hemisphere.
+  const float3 t = normalize(abs(n.y) < 0.99f ? cross(n, float3(0, 1, 0)) : cross(n, float3(1, 0, 0)));
+  const float3 b = cross(n, t);
+  uint state = hash(tid.x * 1973u + tid.y * 9277u + a.frame * 26699u);
+  intersector<instancing, triangle_data> i;
+  i.assume_geometry_type(geometry_type::triangle);
+  i.force_opacity(forced_opacity::opaque);
+  const float3 origin = p.xyz + n * (a.bias + camera_distance * 0.002f);
+  float occlusion = 0.0f;
+  for (uint k = 0; k < a.rays; ++k) {
+    const float u = random(state), v = random(state);
+    const float r = sqrt(u), phi = 6.2831853f * v;
+    const float3 d = normalize(t * (r * cos(phi)) + b * (r * sin(phi)) + n * sqrt(max(0.0f, 1.0f - u)));
+    // The nearer hit of the scene's levels.
+    ray ray_k(origin, d, 0.0f, a.radius);
+    auto hit = i.intersect(ray_k, scene);
+    if (hit.type != intersection_type::none) ray_k.max_distance = hit.distance;
+    if (a.scenes > 1u) {
+      const auto second = i.intersect(ray_k, statics);
+      if (second.type != intersection_type::none) ray_k.max_distance = second.distance;
+    }
+    if (ray_k.max_distance < a.radius) {
+      const float f = ray_k.max_distance / a.radius;
+      occlusion += 1.0f - f * f;
+    }
+  }
+  out.write(float4(1.0f - occlusion / float(max(a.rays, 1u)), camera_distance, 0.0f, 0.0f), tid);
+}
+
+// Half size: rt_ao_trace's blended with the history, the last frames' at the point's place in the last frame
+// (bilinear, of the texels whose distance to the last camera is the point's).
+kernel void rt_ao_temporal(constant AoArgs& a [[buffer(0)]], texture2d_array<float> depth [[texture(0)]],
+                           texture2d<float, access::read> current [[texture(1)]],
+                           texture2d<float, access::read> history [[texture(2)]],
+                           texture2d<float, access::write> out [[texture(3)]], uint2 tid [[thread_position_in_grid]]) {
+  if (any(tid >= a.half_size)) return;
+  const float4 c = current.read(tid);
+  if (c.g == 0.0f) { out.write(float4(1.0f, 0.0f, 0.0f, 0.0f), tid); return; }
+  // A pixel without a sample this frame (the checkerboard's other half) keeps the history's (0 frames: none).
+  const bool sampled = c.r >= 0.0f;
+  float ao = sampled ? c.r : 1.0f, frames = sampled ? 1.0f : 0.0f;
+  const float4 p = world_at(a, depth, int2(tid * 2u));
+  const float4 q = float4(p.xyz, 1.0f) * a.world_to_last_clip;
+  if (a.history_valid != 0u && p.w != 0.0f && q.w > 0.0f) {
+    // The last frame's full-size pixel, then its half-size texel (texel i is pixel 2i's).
+    const float2 pixel = (q.xy / q.w * float2(0.5f, -0.5f) + 0.5f) * float2(a.size);
+    const float2 f = (pixel - 0.5f) * 0.5f;
+    const int2 base = int2(floor(f));
+    const float2 t = f - floor(f);
+    const float expected = distance(p.xyz, a.last_camera.xyz);
+    float sum = 0.0f, count = 0.0f, weights = 0.0f;
+    for (int y = 0; y <= 1; ++y)
+      for (int x = 0; x <= 1; ++x) {
+        const int2 s = base + int2(x, y);
+        if (any(s < 0) || any(s >= int2(a.half_size))) continue;
+        const float4 h = history.read(uint2(s));
+        if (h.g == 0.0f || h.b == 0.0f || abs(h.g - expected) > 0.03f * expected + 0.05f) continue;
+        const float w = (x ? t.x : 1.0f - t.x) * (y ? t.y : 1.0f - t.y);
+        sum += h.r * w;
+        count += h.b * w;
+        weights += w;
+      }
+    if (weights > 0.05f) {
+      const float kept = count / weights;
+      if (sampled) {
+        frames = min(kept + 1.0f, float(max(a.history, 1u)));
+        ao = mix(sum / weights, c.r, 1.0f / frames);
+      } else if (kept > 0.0f) {
+        frames = kept;
+        ao = sum / weights;
+      }
+    }
+  }
+  out.write(float4(ao, c.g, frames, 0.0f), tid);
+}
+
+// Half size: a depth-aware 5x5 blur of rt_ao_trace's AO.
+kernel void rt_ao_blur(constant AoArgs& a [[buffer(0)]], texture2d<float, access::read> in [[texture(0)]],
+                       texture2d<float, access::write> out [[texture(1)]], uint2 tid [[thread_position_in_grid]]) {
+  if (any(tid >= a.half_size)) return;
+  const float4 c = in.read(tid);
+  if (c.g == 0.0f) { out.write(c, tid); return; }
+  float sum = 0.0f, weights = 0.0f;
+  for (int y = -2; y <= 2; ++y)
+    for (int x = -2; x <= 2; ++x) {
+      const int2 q = clamp(int2(tid) + int2(x, y), int2(0), int2(a.half_size) - 1);
+      const float4 s = in.read(uint2(q));
+      if (s.g == 0.0f || s.b == 0.0f) continue;  // the sky, or no sample yet
+      // The ring's falloff steeper the more frames are in (less noise left to take out).
+      const float w = exp(-a.sharpness * abs(s.g - c.g) / c.g) *
+                      exp(-float(x * x + y * y) * (0.15f + 0.05f * c.b));
+      sum += s.r * w;
+      weights += w;
+    }
+  out.write(float4(weights > 0.0f ? sum / weights : (c.b > 0.0f ? c.r : 1.0f), c.g, 0.0f, 0.0f), tid);
+}
+
+// Full size: the scene's colour times the AO, taken from the four nearest half-size texels by depth.
+kernel void rt_ao_apply(constant AoArgs& a [[buffer(0)]], texture2d_array<float> depth [[texture(0)]],
+                        texture2d<float, access::read> ao [[texture(1)]],
+                        texture2d_array<float, access::read> color [[texture(2)]],
+                        texture2d<float, access::write> out [[texture(3)]],
+                        texture2d<float, access::write> factor [[texture(4)]],
+                        uint2 tid [[thread_position_in_grid]]) {
+  if (any(tid >= a.size)) return;
+  const float4 c = color.read(tid, 0);
+  const float4 p = world_at(a, depth, int2(tid));
+  if (p.w == 0.0f) { out.write(c, tid); factor.write(float4(1.0f), tid); return; }
+  const float camera_distance = distance(p.xyz, a.camera.xyz);
+  const int2 base = int2(tid / 2u);
+  float sum = 0.0f, weights = 0.0f;
+  for (int y = 0; y <= 1; ++y)
+    for (int x = 0; x <= 1; ++x) {
+      const int2 q = clamp(base + int2(x, y) + select(int2(-1), int2(0), (tid & 1u) != 0u), int2(0),
+                           int2(a.half_size) - 1);
+      const float4 s = ao.read(uint2(q));
+      if (s.g == 0.0f) continue;
+      const float w = exp(-a.sharpness * abs(s.g - camera_distance) / camera_distance) + 1e-4f;
+      sum += s.r * w;
+      weights += w;
+    }
+  const float strength = a.strength * ao_fade(a, camera_distance);
+  // The multiplier kept too (metal_rt_ao_denoiser: the colour over it is the albedo MetalFX's denoiser gets).
+  const float f = weights > 0.0f ? 1.0f - strength * (1.0f - sum / weights) : 1.0f;
+  out.write(float4(c.rgb * f, c.a), tid);
+  factor.write(float4(f), tid);
+}
+
+// metal_rt_ao_denoiser: MetalFX's denoising scaler's guides, full size. The noisy part of the picture is the AO's
+// multiplier, so the colour divided by it is the albedo (the clean rest; scaled into 0 to 1 where brighter: the
+// excess counts as lighting); the normal from the depth (world space, toward the camera); no specular (black
+// specular albedo); rough.
+kernel void rt_denoise_inputs(constant AoArgs& a [[buffer(0)]], texture2d_array<float> depth [[texture(0)]],
+                              texture2d<float, access::read> color [[texture(1)]],
+                              texture2d<float, access::read> factor [[texture(2)]],
+                              texture2d<float, access::write> albedo [[texture(3)]],
+                              texture2d<float, access::write> specular [[texture(4)]],
+                              texture2d<float, access::write> normal [[texture(5)]],
+                              texture2d<float, access::write> roughness [[texture(6)]],
+                              uint2 tid [[thread_position_in_grid]]) {
+  if (any(tid >= a.size)) return;
+  const float3 c = max(color.read(tid).rgb, float3(0.0f));
+  float3 base = c / max(factor.read(tid).r, 0.05f);
+  base /= max(1.0f, max(base.r, max(base.g, base.b)));
+  albedo.write(float4(base, 1.0f), tid);
+  specular.write(float4(0.0f), tid);
+  roughness.write(float4(1.0f), tid);
+  const int2 pixel = int2(tid);
+  const float4 p = world_at(a, depth, pixel);
+  float3 n = float3(0.0f, 1.0f, 0.0f);
+  if (p.w != 0.0f) {
+    const float4 px0 = world_at(a, depth, pixel - int2(1, 0)), px1 = world_at(a, depth, pixel + int2(1, 0));
+    const float4 py0 = world_at(a, depth, pixel - int2(0, 1)), py1 = world_at(a, depth, pixel + int2(0, 1));
+    const float3 dx = (px1.w != 0.0f && (px0.w == 0.0f || distance(px1.xyz, p.xyz) < distance(px0.xyz, p.xyz)))
+                          ? px1.xyz - p.xyz : p.xyz - px0.xyz;
+    const float3 dy = (py1.w != 0.0f && (py0.w == 0.0f || distance(py1.xyz, p.xyz) < distance(py0.xyz, p.xyz)))
+                          ? py1.xyz - p.xyz : p.xyz - py0.xyz;
+    const float3 m = cross(dy, dx);
+    const float3 to_camera = a.camera.xyz - p.xyz;
+    n = length_squared(m) > 1e-12f ? normalize(m) : normalize(to_camera);
+    if (dot(n, to_camera) < 0.0f) n = -n;
+  }
+  normal.write(float4(n, 0.0f), tid);
+}
+// MetalRtShadowArgs.
+struct ShadowArgs {
+  float4x4 clip_to_world;
+  float4 sun, camera, depth_map, viewport, ndc;
+  uint2 size, origin, samples, tex_ss;
+  uint rs, scenes, mode, counts;
+  float floor_value, distance, reach, pad;
+  uint stretch, pad2;
+  uint2 stretch_num, stretch_den;
+};
+// A mask texel's place in the world: its depth target texel (as the resolve reads it, sample 0), its place in the
+// tile's viewport, the draws' guest clip space and the world. w 0: none.
+static float4 shadow_world(constant ShadowArgs& a, depth2d<float, access::read> depth, int2 q) {
+  const uint rs = max(a.rs, 1u);
+  if (any(q < 0) || any(uint2(q) >= a.size * rs)) return float4(0.0f);
+  const uint2 u = uint2(q);
+  const uint2 at = a.stretch != 0u
+                      ? min(((2u * (a.origin * rs + u) + 1u) * a.stretch_num) / (2u * a.stretch_den), a.stretch_num - 1u)
+                      : (a.origin + (u / rs) * a.samples) / a.tex_ss * rs + u % rs;
+  const float d = depth.read(at);
+  const float2 texel = (float2(at) + 0.5f) / float(rs);
+  const float2 host = float2((texel.x - a.viewport.x) / a.viewport.z * 2.0f - 1.0f,
+                             1.0f - (texel.y - a.viewport.y) / a.viewport.w * 2.0f);
+  // The draws' guest to host transform (the viewport's, Vulkan's y down) with Metal's y flipped (the translator's
+  // system constants): host.y = -(guest.y * scale.y + offset.y).
+  const float2 ndc = (float2(host.x, -host.y) - a.ndc.zw) / a.ndc.xy;
+  const float clip_z = ((d - a.depth_map.x) / (a.depth_map.y - a.depth_map.x) - a.depth_map.w) / a.depth_map.z;
+  const float4 w = float4(ndc, clip_z, 1.0f) * a.clip_to_world;
+  return w.w != 0.0f ? float4(w.xyz / w.w, 1.0f) : float4(0.0f);
+}
+
+// Of two neighbours across p, the step to the nearer one (the same surface, more likely, at an edge).
+static float3 shadow_step(float3 p, float4 before, float4 after) {
+  if (before.w == 0.0f) return after.w != 0.0f ? after.xyz - p : float3(0.0f);
+  if (after.w == 0.0f) return p - before.xyz;
+  return distance_squared(after.xyz, p) < distance_squared(before.xyz, p) ? after.xyz - p : p - before.xyz;
+}
+
+kernel void rt_shadow_mask(constant ShadowArgs& a [[buffer(0)]], instance_acceleration_structure scene [[buffer(1)]],
+                           instance_acceleration_structure statics [[buffer(2)]],
+                           device atomic_uint* counts [[buffer(3)]], depth2d<float, access::read> depth [[texture(0)]],
+                           texture2d<float, access::read_write> mask [[texture(1)]],
+                           uint2 q [[thread_position_in_grid]]) {
+  const uint rs = max(a.rs, 1u);
+  if (any(q >= a.size * rs)) return;
+  const float4 m = mask.read(q);
+  if (m.a < 0.5f) return;  // the sky
+  // The histogram of the darker values (MetalDraw::kRtShadowDark, after the counts here at 8).
+  if (a.counts != 0u && all((q & 7u) == 0u)) {
+    const uint v = uint(m.r * 255.0f + 0.5f);
+    if (v < 48u) atomic_fetch_add_explicit(&counts[8u + v], 1u, memory_order_relaxed);
+  }
+  // The game's sunless texels stay so (its mask darkened at most): no rays for them, but when checking.
+  const bool game_lit = m.r > a.floor_value + 2.5f / 255.0f;
+  if (!game_lit && a.mode == 0u) return;
+  const int2 c = int2(q);
+  const float4 here = shadow_world(a, depth, c);
+  if (here.w == 0.0f) return;
+  const float3 p = here.xyz;
+  const float camera_distance = distance(p, a.camera.xyz);
+  if (camera_distance > a.reach) return;
+  // The surface's normal from its neighbours' depth (toward the camera). The game's mask is its cascades' shadows
+  // alone: a surface turned from the sun is lit there (its lighting darkens it, softly); the rays would find it
+  // behind itself. So only what faces the sun is traced.
+  // Stretched (upscaling's render size to the output's), the neighbours a depth texel away, not a mask texel (the
+  // same depth, no step).
+  const int2 o = a.stretch != 0u ? int2(max((a.stretch_den + a.stretch_num - 1u) / a.stretch_num, uint2(1u))) : int2(1);
+  const float3 dx = shadow_step(p, shadow_world(a, depth, c - int2(o.x, 0)), shadow_world(a, depth, c + int2(o.x, 0)));
+  const float3 dy = shadow_step(p, shadow_world(a, depth, c - int2(0, o.y)), shadow_world(a, depth, c + int2(0, o.y)));
+  float3 n = cross(dx, dy);
+  const float n_length = length(n);
+  if (n_length < 1e-12f) return;
+  n /= n_length;
+  if (dot(n, a.camera.xyz - p) < 0.0f) n = -n;
+  const float facing = dot(n, a.sun.xyz);
+  if (facing < 0.2f) return;  // grazing: the normal from depth too rough to tell
+  // Off the surface along its normal and toward the sun, more with distance (the depth's precision) and with the
+  // sun's slope.
+  const float bias = (0.04f + 0.002f * camera_distance) * (1.0f + 2.0f * (1.0f - facing));
+  // And hits nearer than that again left out (the surface itself, rough with distance, not a shadow).
+  ray r(p + n * bias + a.sun.xyz * bias, a.sun.xyz, bias, a.distance);
+  intersector<instancing, triangle_data> i;
+  i.assume_geometry_type(geometry_type::triangle);
+  i.force_opacity(forced_opacity::opaque);
+  i.accept_any_intersection(true);
+  bool blocked = i.intersect(r, scene).type != intersection_type::none;
+  if (!blocked && a.scenes > 1u) blocked = i.intersect(r, statics).type != intersection_type::none;
+  const float lit = blocked ? 0.0f : 1.0f;
+  if (a.counts != 0u)
+    atomic_fetch_add_explicit(&counts[(game_lit ? 0u : 2u) + (blocked ? 1u : 0u)], 1u, memory_order_relaxed);
+  // Debug: 1 the rays' verdict alone; 2 dark only where the rays add a shadow the game lacks;
+  // 3 lit only where the rays find sun the game shadowed.
+  const float full = 71.0f / 255.0f;
+  float3 color;
+  if (a.mode == 1u) color = float3(a.floor_value + (full - a.floor_value) * lit);
+  else if (a.mode == 2u) color = float3(game_lit && blocked ? a.floor_value : full);
+  else if (a.mode == 3u) color = float3(!game_lit && !blocked ? full : a.floor_value);
+  else if (blocked) color = float3(a.floor_value);
+  else return;
+  mask.write(float4(color, m.a), q);
+}
+)";
+  NSError* ns_error = nil;
+  id<MTLLibrary> library = [device newLibraryWithSource:@(kSource) options:nil error:&ns_error];
+  if (!library) error = ns_error ? [ns_error.localizedDescription UTF8String] : "no library";
+  return library;
+}
+
+bool MetalRt4::Init(id<MTLDevice> device, const Options& options, std::string& log) {
+  if (!device.supportsRaytracing) {
+    log = "ray tracing: not supported by this GPU";
+    return false;
+  }
+  device_ = device;
+  options_ = options;
+  log = "ray tracing: acceleration structures ready (" + std::to_string(options.build_budget) +
+        " triangles built a frame at most, " + std::to_string(options.memory_budget >> 20) + " MB of meshes)";
+  return true;
+}
+
+bool MetalRt4::HasMesh(uint64_t key) {
+  auto found = meshes_.find(key);
+  if (found == meshes_.end()) return false;
+  found->second.used_frame = frame_;
+  return true;
+}
+
+void MetalRt4::AddMesh(uint64_t key, MTL4BufferRange vertices, uint32_t vertex_stride, MTL4BufferRange indices,
+                       uint32_t triangle_count) {
+  if (!device_ || !triangle_count || meshes_.count(key)) return;
+  Mesh& m = meshes_[key];
+  m.used_frame = frame_;
+  m.triangles = triangle_count;
+  waiting_.push_back({key, vertices, indices, vertex_stride, triangle_count});
+}
+
+bool MetalRt4::AddInstance(uint64_t id, uint64_t key, const float transform[12], uint8_t mask, uint32_t user_id) {
+  auto [it, added] = placements_.try_emplace(id);
+  Placement& p = it->second;
+  if (added) {
+    p.key = key;
+    std::memcpy(p.transform.data(), transform, sizeof(float) * 12);
+    p.mask = mask;
+    p.user_id = user_id;
+    p.first_seen = frame_;
+  } else if (p.last_seen == frame_) {
+    ++stats_.duplicates;
+    return false;
+  }
+  p.last_seen = frame_;
+  frame_ids_.push_back(id);
+  return true;
+}
+
+id<MTLBuffer> MetalRt4::Scratch(size_t size) {
+  // One scratch buffer: the meshes' builds each take a part of it, the TLAS build (after them) all of it. A larger
+  // one replaces it; the old one lives until the GPU is done with it (the commands that used it hold it).
+  if (!scratch_ || scratch_.length < size)
+    scratch_ = [device_ newBufferWithLength:std::max<size_t>(size, size_t(1) << 20)
+                                    options:MTLResourceStorageModePrivate];
+  return scratch_;
+}
+
+id<MTLAccelerationStructure> MetalRt4::Build(GpuCommands& commands, GpuEncoder& compute,
+                                             const float* view_projection) {
+  BuildMeshes(compute);
+  return BuildScene(commands, compute, view_projection);
+}
+
+void MetalRt4::SetMeshBounds(uint64_t key, const float lo[3], const float hi[3]) {
+  auto found = meshes_.find(key);
+  if (found == meshes_.end()) return;
+  Mesh& m = found->second;
+  std::memcpy(m.lo, lo, sizeof(m.lo));
+  std::memcpy(m.hi, hi, sizeof(m.hi));
+  m.bounded = true;
+}
+
+void MetalRt4::BuildMeshes(GpuEncoder& compute) {
+  if (!device_) return;
+  // This frame's new meshes, in order, within the budget (a mesh larger than the budget still goes, alone); the
+  // rest are forgotten (their memory is the frame's) and come again.
+  uint32_t built_triangles = 0;
+  for (const Waiting& w : waiting_) {
+    auto found = meshes_.find(w.key);
+    if (found == meshes_.end()) continue;
+    if (built_triangles && built_triangles + w.triangles > options_.build_budget) {
+      meshes_.erase(found);
+      ++stats_.over_budget;
+      continue;
+    }
+    Mesh& m = found->second;
+    auto geometry = [MTL4AccelerationStructureTriangleGeometryDescriptor new];
+    geometry.vertexBuffer = w.vertices;
+    geometry.vertexFormat = MTLAttributeFormatFloat3;
+    geometry.vertexStride = w.vertex_stride;
+    geometry.indexBuffer = w.indices;
+    geometry.indexType = MTLIndexTypeUInt32;
+    geometry.triangleCount = w.triangles;
+    geometry.opaque = YES;
+    auto desc = [MTL4PrimitiveAccelerationStructureDescriptor new];
+    desc.geometryDescriptors = @[ geometry ];
+    // Built once and traced for many frames: the default (best traced), unless fast_build.
+    desc.usage = options_.fast_build ? MTLAccelerationStructureUsagePreferFastBuild : MTLAccelerationStructureUsageNone;
+    const MTLAccelerationStructureSizes sizes = [device_ accelerationStructureSizesWithDescriptor:desc];
+    m.blas = [device_ newAccelerationStructureWithSize:sizes.accelerationStructureSize];
+    if (!m.blas) {
+      meshes_.erase(found);
+      continue;
+    }
+    m.bytes = sizes.accelerationStructureSize;
+    mesh_bytes_ += m.bytes;
+    builds_.push_back({m.blas, desc, 0, sizes.buildScratchBufferSize});
+    built_triangles += w.triangles;
+    ++stats_.built;
+  }
+  stats_.built_triangles += built_triangles;
+  waiting_.clear();
+  RecordBuilds(compute);
+}
+
+bool MetalRt4::Describe(uint64_t key, const std::array<float, 12>& transform, uint8_t mask, uint32_t user_id,
+                        std::vector<id<MTLAccelerationStructure>>& blases) {
+  auto found = meshes_.find(key);
+  if (found == meshes_.end() || !found->second.blas) {
+    ++stats_.skipped_instances;
+    return false;
+  }
+  found->second.used_frame = frame_;
+  MTLIndirectAccelerationStructureInstanceDescriptor d{};
+  for (int c = 0; c < 4; ++c)
+    d.transformationMatrix.columns[c] = MTLPackedFloat3Make(transform[c * 3], transform[c * 3 + 1],
+                                                             transform[c * 3 + 2]);
+  d.options = MTLAccelerationStructureInstanceOptionOpaque;
+  d.mask = mask;
+  d.userID = user_id;
+  d.accelerationStructureID = found->second.blas.gpuResourceID;
+  descriptors_.push_back(d);
+  blases.push_back(found->second.blas);
+  return true;
+}
+
+id<MTLAccelerationStructure> MetalRt4::PrepareLevel(Level& level, GpuCommands& commands) {
+  const NSUInteger count = std::min<NSUInteger>(descriptors_.size(), options_.max_instances);
+  if (!count) return nil;
+  level.ring = (level.ring + 1) % uint32_t(level.structures.size());
+  const size_t descriptor_size = sizeof(MTLIndirectAccelerationStructureInstanceDescriptor);
+  __strong id<MTLBuffer>& buffer = level.descriptors[level.ring];
+  if (!buffer || buffer.length < count * descriptor_size)
+    buffer = [device_ newBufferWithLength:std::max<NSUInteger>(count, 1024) * descriptor_size * 2
+                                  options:MTLResourceStorageModeShared | MTLResourceCPUCacheModeWriteCombined];
+  std::memcpy(buffer.contents, descriptors_.data(), count * descriptor_size);
+  auto desc = [MTL4InstanceAccelerationStructureDescriptor new];
+  desc.instanceDescriptorBuffer = MTL4BufferRange{buffer.gpuAddress, count * descriptor_size};
+  desc.instanceDescriptorStride = descriptor_size;
+  desc.instanceCount = count;
+  desc.instanceDescriptorType = MTLAccelerationStructureInstanceDescriptorTypeIndirect;
+  // Built for speed (one built for tracing made the rays no faster in a race).
+  desc.usage = MTLAccelerationStructureUsagePreferFastBuild;
+  const MTLAccelerationStructureSizes sizes = [device_ accelerationStructureSizesWithDescriptor:desc];
+  __strong id<MTLAccelerationStructure>& structure = level.structures[level.ring];
+  if (!structure || level.capacity[level.ring] < sizes.accelerationStructureSize) {
+    structure = [device_ newAccelerationStructureWithSize:sizes.accelerationStructureSize];
+    level.capacity[level.ring] = structure ? sizes.accelerationStructureSize : 0;
+  }
+  if (!structure) return nil;
+  commands.Use(buffer);
+  builds_.push_back({structure, desc, 0, sizes.buildScratchBufferSize});
+  return structure;
+}
+
+void MetalRt4::RecordBuilds(GpuEncoder& compute) {
+  if (builds_.empty()) return;
+  // Each build its own part of the scratch buffer: they touch nothing in common (their own structure and scratch;
+  // the inputs only read), so they run together, one group that waits for what came before as a whole.
+  NSUInteger used = 0;
+  for (PendingBuild& b : builds_) {
+    b.scratch_offset = used;
+    used += (b.scratch_size + 255) & ~NSUInteger(255);
+  }
+  id<MTLBuffer> scratch = Scratch(used);
+  compute.BeginConcurrent();
+  for (const PendingBuild& b : builds_)
+    compute.BuildAccelerationStructure(b.structure, b.descriptor, scratch, b.scratch_offset, b.scratch_size);
+  compute.EndConcurrent();
+  builds_.clear();
+}
+
+void MetalRt4::BuildStatic(GpuCommands& commands, bool force) {
+  // Placements gone from view for keep_frames go, and those seen in one frame only (what moves) once past.
+  bool changed = force;
+  for (auto it = placements_.begin(); it != placements_.end();) {
+    const Placement& p = it->second;
+    const bool repeated = p.last_seen > p.first_seen;
+    if (frame_ - p.last_seen > (repeated ? options_.keep_frames : 1u)) {
+      changed |= p.in_static;
+      it = placements_.erase(it);
+      continue;
+    }
+    changed |= repeated && !p.in_static;
+    ++it;
+  }
+  if (!changed) return;
+  descriptors_.clear();
+  std::vector<id<MTLAccelerationStructure>> blases;
+  for (auto& [id, p] : placements_) {
+    p.in_static = p.last_seen > p.first_seen && descriptors_.size() < options_.max_instances &&
+                  Describe(p.key, p.transform, p.mask, p.user_id, blases);
+  }
+  static_frame_ = frame_;
+  static_dirty_ = false;
+  // The BLASes it names, resident for the build.
+  for (id<MTLAccelerationStructure> blas : blases) commands.Use(blas);
+  static_ = PrepareLevel(static_level_, commands);
+  static_blases_ = std::move(blases);
+  if (!static_) {
+    static_blases_.clear();
+    for (auto& [id, p] : placements_) p.in_static = false;
+  }
+  ++stats_.static_builds;
+}
+
+
+id<MTLAccelerationStructure> MetalRt4::BuildScene(GpuCommands& commands, GpuEncoder& compute,
+                                                  const float* view_projection) {
+  current_ = nil;
+  frame_blases_.clear();
+  if (!device_) return nil;
+  if (options_.static_level) {
+    // The frustum's sides and the camera's plane (clip x and y within w, w above 0): of p' = p M, clip coordinate
+    // c is p dotted with M's column c. For EndFrame's look at what is gone.
+    auto column = [&](int c, int k) { return view_projection[k * 4 + c]; };
+    for (int k = 0; k < 4; ++k) {
+      planes_[0][k] = column(3, k) + column(0, k);
+      planes_[1][k] = column(3, k) - column(0, k);
+      planes_[2][k] = column(3, k) + column(1, k);
+      planes_[3][k] = column(3, k) - column(1, k);
+      planes_[4][k] = column(3, k);
+    }
+    planes_frame_ = frame_;
+    // Once a frame (the first Build): the static TLAS again when due. Later Builds of the frame (the frame's
+    // TLAS again with what was drawn since) leave it.
+    if (built_frame_ != frame_ &&
+        (!static_ || frame_ - static_frame_ >= (static_dirty_ ? 4u : options_.static_frames)))
+      BuildStatic(commands, static_dirty_);
+    built_frame_ = frame_;
+  }
+  // The frame's level: this frame's placements not in the static one.
+  descriptors_.clear();
+  for (uint64_t id : frame_ids_) {
+    auto found = placements_.find(id);
+    if (found == placements_.end() || found->second.in_static) continue;
+    const Placement& p = found->second;
+    Describe(p.key, p.transform, p.mask, p.user_id, frame_blases_);
+  }
+  frame_instances_ = descriptors_.size();
+  if (static_) {
+    commands.Use(static_);
+    for (id<MTLAccelerationStructure> blas : static_blases_) commands.Use(blas);
+  }
+  for (id<MTLAccelerationStructure> blas : frame_blases_) commands.Use(blas);
+  current_ = PrepareLevel(top_level_, commands);
+  // The static TLAS (when rebuilt) and the frame's together.
+  RecordBuilds(compute);
+  return current_;
+}
+
+uint32_t MetalRt4::Scenes(std::array<id<MTLAccelerationStructure>, 2>& scenes) const {
+  uint32_t count = 0;
+  if (current_) scenes[count++] = current_;
+  if (static_) scenes[count++] = static_;
+  return count;
+}
+
+void MetalRt4::Use(GpuCommands& commands) {
+  if (current_) commands.Use(current_);
+  if (static_) {
+    commands.Use(static_);
+    for (id<MTLAccelerationStructure> blas : static_blases_) commands.Use(blas);
+  }
+  for (id<MTLAccelerationStructure> blas : frame_blases_) commands.Use(blas);
+}
+
+void MetalRt4::DropGone() {
+  const auto& planes = planes_;
+  // Placements of meshes new this frame at a transform (what moves).
+  std::unordered_map<uint64_t, std::vector<std::array<float, 3>>> moving;
+  for (uint64_t id : frame_ids_) {
+    const Placement& p = placements_[id];
+    if (p.first_seen == frame_) moving[p.key].push_back({p.transform[9], p.transform[10], p.transform[11]});
+  }
+  // The static placements not drawn this frame: gone if in view (else the game would have drawn them: it swapped
+  // a level of detail, or the thing moved) or moved away (a placement of the same mesh new within 30 m).
+  for (auto it = placements_.begin(); it != placements_.end();) {
+    Placement& p = it->second;
+    if (!p.in_static || p.last_seen == frame_) {
+      ++it;
+      continue;
+    }
+    bool gone = false;
+    if (!p.boxed) {
+      auto mesh = meshes_.find(p.key);
+      if (mesh != meshes_.end() && mesh->second.bounded) {
+        // The world bounds: the translation, plus each basis column times the mesh's extent along it.
+        const Mesh& m = mesh->second;
+        for (int r = 0; r < 3; ++r) {
+          p.lo[r] = p.hi[r] = p.transform[9 + r];
+          for (int c = 0; c < 3; ++c) {
+            const float a = p.transform[c * 3 + r] * m.lo[c], b = p.transform[c * 3 + r] * m.hi[c];
+            p.lo[r] += std::min(a, b);
+            p.hi[r] += std::max(a, b);
+          }
+        }
+        p.boxed = true;
+      }
+    }
+    if (p.boxed) {
+      bool in_view = true;
+      for (const auto& plane : planes) {
+        // The box's corner farthest along the plane's normal: outside if even that one is.
+        float d = plane[3];
+        for (int k = 0; k < 3; ++k) d += plane[k] * (plane[k] > 0.0f ? p.hi[k] : p.lo[k]);
+        in_view &= d > 0.0f;
+      }
+      if (in_view) {
+        gone = true;
+        ++stats_.undrawn;
+      }
+    }
+    if (!gone) {
+      auto found = moving.find(p.key);
+      if (found != moving.end())
+        for (const auto& t : found->second) {
+          const float dx = t[0] - p.transform[9], dy = t[1] - p.transform[10], dz = t[2] - p.transform[11];
+          gone |= dx * dx + dy * dy + dz * dz < 900.0f;
+        }
+      stats_.moved += gone;
+    }
+    if (gone) {
+      static_dirty_ = true;
+      it = placements_.erase(it);
+    } else {
+      ++it;
+    }
+  }
+}
+
+void MetalRt4::EndFrame() {
+  // A frame without Build (no scene): its meshes and instances go (their memory was the frame's).
+  for (const Waiting& w : waiting_) {
+    auto found = meshes_.find(w.key);
+    if (found != meshes_.end() && !found->second.blas) meshes_.erase(found);
+  }
+  waiting_.clear();
+  // What the frame's Builds left out of view of its last camera, before the frame's placements are forgotten.
+  if (options_.static_level && planes_frame_ == frame_) DropGone();
+  if (built_frame_ == frame_ || planes_frame_ == frame_) {
+    stats_.instances += frame_instances_;
+    if (static_) stats_.static_instances += static_blases_.size();
+  }
+  frame_instances_ = 0;
+  frame_ids_.clear();
+  ++frame_;
+  if (frame_ % 30) return;
+  // Unused for idle_frames, or over the memory budget (least recently used first). A BLAS a command buffer still
+  // uses lives on in it.
+  std::vector<std::pair<uint64_t, uint64_t>> by_age;
+  for (auto it = meshes_.begin(); it != meshes_.end();) {
+    if (frame_ - it->second.used_frame > options_.idle_frames) {
+      mesh_bytes_ -= it->second.bytes;
+      ++stats_.evicted;
+      it = meshes_.erase(it);
+      continue;
+    }
+    if (mesh_bytes_ > options_.memory_budget) by_age.push_back({it->second.used_frame, it->first});
+    ++it;
+  }
+  if (mesh_bytes_ > options_.memory_budget) {
+    std::sort(by_age.begin(), by_age.end());
+    for (auto& [used, key] : by_age) {
+      if (mesh_bytes_ <= options_.memory_budget || used == frame_ - 1) break;
+      auto found = meshes_.find(key);
+      mesh_bytes_ -= found->second.bytes;
+      meshes_.erase(found);
+      ++stats_.evicted;
+    }
+  }
+}
+
+MetalRt4::Stats MetalRt4::TakeStats() {
+  Stats s = stats_;
+  s.meshes = meshes_.size();
+  s.mesh_bytes = mesh_bytes_;
+  stats_ = {};
+  return s;
+}
