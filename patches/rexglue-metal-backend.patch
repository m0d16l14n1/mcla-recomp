+bool MetalDraw::Draw(Shader* vs, Shader* ps) {
+  @autoreleasepool {
+    if (!vs) return true;
+    auto mode = regs_.Get<reg::RB_MODECONTROL>().edram_mode;
+    bool polygonal = draw_util::IsPrimitivePolygonal(regs_);
+    if (!draw_util::IsRasterizationPotentiallyDone(regs_, polygonal)) return true;
+    uint32_t pitch = regs_.Get<reg::RB_SURFACE_INFO>().surface_pitch;
+    if (!pitch) return true;
+    shaders_.translator().EnsureAnalyzed(*vs);
+    if (mode != xenos::EdramMode::kColorDepth) ps = nullptr;
+    if (ps) { shaders_.translator().EnsureAnalyzed(*ps);
+      if (!draw_util::IsPixelShaderNeededWithRasterization(*ps, regs_)) ps = nullptr; }
+    // Memexport needs a coherent writeback path (M2).
+    if (vs->memexport_eM_written() || (ps && ps->memexport_eM_written())) return true;
+    primitives_->NextDraw();
+    PrimitiveProcessor::ProcessingResult primitive{};
+    if (!primitives_->Process(primitive)) { ++failures_; return false; }
+    if (primitive.IsTessellated() || !primitive.host_draw_vertex_count) return true;
+    if (REXCVAR_GET(metal_snapshot_vertices) && !SnapshotDraw(*vs, primitive)) { ++failures_; return false; }
+    uint64_t vm, pm;
+    shaders_.translator().GetDrawModifications(regs_, *vs, ps, vm, pm, primitive.host_vertex_shader_type);
+    shaders_.Request(*vs, vm); if (ps) shaders_.Request(*ps, pm);
+    shaders_.Wait();
+    auto vt = vs->GetOrCreateTranslation(vm);
+    auto pt = ps ? ps->GetOrCreateTranslation(pm) : nullptr;
+    id<MTLLibrary> vl = shaders_.GetLibrary(vt), pl = pt ? shaders_.GetLibrary(pt) : nil;
+    if (!vl || (ps && !pl)) { ++failures_; return false; }
+    auto dc = draw_util::GetNormalizedDepthControl(regs_);
+    uint32_t mask = draw_util::GetNormalizedColorMask(regs_, ps ? ps->writes_color_targets() : 0);
+    auto msaa = regs_.Get<reg::RB_SURFACE_INFO>().msaa_samples;
+    uint32_t ssx = msaa >= xenos::MsaaSamples::k4X ? 2 : 1, ssy = msaa >= xenos::MsaaSamples::k2X ? 2 : 1;
+    draw_util::ViewportInfo viewport{};
+    draw_util::GetHostViewportInfo(regs_, ssx, ssy, false, 16384, 16384, true, dc, false, true,
+                                   ps && ps->writes_depth(), viewport);
+    draw_util::Scissor scissor{}; draw_util::GetScissor(regs_, scissor);
+    scissor.offset[0] *= ssx; scissor.extent[0] *= ssx; scissor.offset[1] *= ssy; scissor.extent[1] *= ssy;
+    if (!scissor.extent[0] || !scissor.extent[1] || !viewport.xy_extent[0] || !viewport.xy_extent[1]) return true;
+    const uint32_t width = pitch * ssx;
+    std::array<id<MTLTexture>, 5> next{};
+    std::string key; Key(key, reinterpret_cast<uintptr_t>(vt)); Key(key, reinterpret_cast<uintptr_t>(pt));
+    Key(key, mask);
+    auto pd = [MTLRenderPipelineDescriptor new];
+    pd.vertexFunction = [vl newFunctionWithName:vl.functionNames.firstObject];
+    if (pl) pd.fragmentFunction = [pl newFunctionWithName:pl.functionNames.firstObject];
+    for (uint32_t i = 0; i < 4; ++i) {
+      MTLPixelFormat format = MTLPixelFormatInvalid;
+      if ((mask >> (4 * i)) & 15) {
+        auto color = regs_.Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[i]);
+        format = ColorFormat(color.color_format);
+        if (format == MTLPixelFormatInvalid) { ++failures_; return false; }
+        next[i] = Target(color.GetBaseTiles(edram_tiles_), format, width,
+                         xenos::IsColorRenderTargetFormat64bpp(color.color_format));
+        if (!next[i]) return false;
+      }
+      Key(key, format);
+      auto bc = regs_.Get<reg::RB_BLENDCONTROL>(reg::RB_BLENDCONTROL::rt_register_indices[i]);
+      Key(key, bc.value);
+      auto a = pd.colorAttachments[i]; a.pixelFormat = format;
+      uint32_t wm = (mask >> (4 * i)) & 15;
+      a.writeMask = MTLColorWriteMask(((wm & 1) ? MTLColorWriteMaskRed : 0) |
+        ((wm & 2) ? MTLColorWriteMaskGreen : 0) | ((wm & 4) ? MTLColorWriteMaskBlue : 0) |
+        ((wm & 8) ? MTLColorWriteMaskAlpha : 0));
+      a.blendingEnabled = format != MTLPixelFormatInvalid &&
+                         (bc.value & 0x1FFF1FFF) != 0x00010001;
+      a.sourceRGBBlendFactor = BlendFactor(bc.color_srcblend); a.destinationRGBBlendFactor = BlendFactor(bc.color_destblend);
+      a.sourceAlphaBlendFactor = BlendFactor(bc.alpha_srcblend); a.destinationAlphaBlendFactor = BlendFactor(bc.alpha_destblend);
+      a.rgbBlendOperation = BlendOp(bc.color_comb_fcn); a.alphaBlendOperation = BlendOp(bc.alpha_comb_fcn);
+    }
+    bool depth = dc.z_enable || dc.stencil_enable;
+    Key(key, depth);
+    if (depth) {
+      next[4] = Target(regs_.Get<reg::RB_DEPTH_INFO>().GetBaseTiles(edram_tiles_), MTLPixelFormatDepth32Float_Stencil8, width, false);
+      if (!next[4]) return false;
+      pd.depthAttachmentPixelFormat = pd.stencilAttachmentPixelFormat = MTLPixelFormatDepth32Float_Stencil8;
+    }
+    if (!mask && !depth) return true;
+    id<MTLRenderPipelineState> pipeline;
+    auto pi = pipelines_.find(key);
+    if (pi != pipelines_.end()) pipeline = pi->second;
+    else {
+      NSError* error = nil; pipeline = [device_ newRenderPipelineStateWithDescriptor:pd error:&error];
+      pipelines_[key] = pipeline;
+      if (!pipeline) { ++failures_; REXGPU_ERROR("Metal pipeline failed: {}", error.localizedDescription.UTF8String); }
+    }
+    if (!pipeline) return false;
+    // Texture loads are compute work and cannot run inside a render pass: do them first (a load
+    // needed while a pass is open ends it).
+    for (auto* t : {vt, pt}) if (t) for (auto& b : shaders_.translator().bindings(t).textures) Texture(b);
+    if (!commands_) { commands_ = [queue_ commandBuffer]; commands_.label = @"Xenos M1 draws"; }
+    if (!encoder_ || next != attachments_) {
+      EndEncoder(); attachments_ = next;
+      auto pass = [MTLRenderPassDescriptor renderPassDescriptor];
+      for (uint32_t i = 0; i < 4; ++i) if (next[i]) {
+        pass.colorAttachments[i].texture = next[i]; pass.colorAttachments[i].loadAction = MTLLoadActionLoad;
+        pass.colorAttachments[i].storeAction = MTLStoreActionStore;
+      }
+      if (depth) {
+        pass.depthAttachment.texture = pass.stencilAttachment.texture = next[4];
+        pass.depthAttachment.loadAction = pass.stencilAttachment.loadAction = MTLLoadActionLoad;
+        pass.depthAttachment.storeAction = pass.stencilAttachment.storeAction = MTLStoreActionStore;
+      }
+      encoder_ = [commands_ renderCommandEncoderWithDescriptor:pass];
+      if (DebugFrame()) {
+        auto si = regs_.Get<reg::RB_SURFACE_INFO>();
+        std::string rts;
+        for (uint32_t i = 0; i < 4; ++i) if (next[i]) {
+          auto color = regs_.Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[i]);
+          rts += fmt::format(" rt{} base {} fmt {} {}x{}", i, color.GetBaseTiles(edram_tiles_),
+                             uint32_t(color.color_format), next[i].width, next[i].height);
+        }
+        if (depth) rts += fmt::format(" depth base {} fmt {} zfunc {} zwrite {} stencil {}",
+            regs_.Get<reg::RB_DEPTH_INFO>().GetBaseTiles(edram_tiles_), uint32_t(regs_.Get<reg::RB_DEPTH_INFO>().depth_format),
+            uint32_t(dc.zfunc), uint32_t(dc.z_write_enable), uint32_t(dc.stencil_enable));
+        REXGPU_INFO("Metal pass debug: draw {} pitch {} msaa {} viewport {},{} {}x{} z {}..{} scissor {},{} {}x{} window_offset {:08X}:{}",
+            draws_, pitch, uint32_t(si.msaa_samples), viewport.xy_offset[0], viewport.xy_offset[1],
+            viewport.xy_extent[0], viewport.xy_extent[1], viewport.z_min, viewport.z_max,
+            scissor.offset[0], scissor.offset[1], scissor.extent[0], scissor.extent[1],
+            regs_[XE_GPU_REG_PA_SC_WINDOW_OFFSET], rts);
+      }
+    }
+    [encoder_ setRenderPipelineState:pipeline];
+    std::string dk; Key(dk, dc.value);
+    auto sf = regs_.Get<reg::RB_STENCILREFMASK>();
+    auto sb = regs_.Get<reg::RB_STENCILREFMASK>(XE_GPU_REG_RB_STENCILREFMASK_BF);
+    Key(dk, sf.value); Key(dk, sb.value);
+    auto ds = depth_states_.find(dk);
+    id<MTLDepthStencilState> state;
+    if (ds != depth_states_.end()) state = ds->second;
+    else {
+      auto desc = [MTLDepthStencilDescriptor new];
+      desc.depthCompareFunction = dc.z_enable ? MTLCompareFunction(dc.zfunc) : MTLCompareFunctionAlways;
+      desc.depthWriteEnabled = dc.z_enable && dc.z_write_enable;
+      if (dc.stencil_enable) {
+        auto front = [MTLStencilDescriptor new]; auto back = [MTLStencilDescriptor new];
+        front.stencilCompareFunction = MTLCompareFunction(dc.stencilfunc);
+        front.stencilFailureOperation = StencilOp(uint32_t(dc.stencilfail));
+        front.depthFailureOperation = StencilOp(uint32_t(dc.stencilzfail));
+        front.depthStencilPassOperation = StencilOp(uint32_t(dc.stencilzpass));
+        front.readMask = sf.stencilmask; front.writeMask = sf.stencilwritemask;
+        back.stencilCompareFunction = MTLCompareFunction(dc.stencilfunc_bf);
+        back.stencilFailureOperation = StencilOp(uint32_t(dc.stencilfail_bf));
+        back.depthFailureOperation = StencilOp(uint32_t(dc.stencilzfail_bf));
+        back.depthStencilPassOperation = StencilOp(uint32_t(dc.stencilzpass_bf));
+        back.readMask = sb.stencilmask; back.writeMask = sb.stencilwritemask;
+        desc.frontFaceStencil = front; desc.backFaceStencil = dc.backface_enable ? back : front;
+      }
+      state = [device_ newDepthStencilStateWithDescriptor:desc]; depth_states_[dk] = state;
+    }
+    [encoder_ setDepthStencilState:state];
+    [encoder_ setStencilFrontReferenceValue:sf.stencilref backReferenceValue:dc.backface_enable ? sb.stencilref : sf.stencilref];
+    [encoder_ setViewport:MTLViewport{double(viewport.xy_offset[0]), double(viewport.xy_offset[1]),
+        double(viewport.xy_extent[0]), double(viewport.xy_extent[1]), viewport.z_min, viewport.z_max}];
+    uint32_t height = UINT32_MAX;
+    for (auto t : next) if (t) height = std::min(height, uint32_t(t.height));
+    uint32_t sx = std::min(scissor.offset[0], width), sy = std::min(scissor.offset[1], height);
+    [encoder_ setScissorRect:MTLScissorRect{sx, sy, std::min(scissor.extent[0], width - sx), std::min(scissor.extent[1], height - sy)}];
+    auto raster = regs_.Get<reg::PA_SU_SC_MODE_CNTL>();
+    [encoder_ setFrontFacingWinding:raster.face ? MTLWindingClockwise : MTLWindingCounterClockwise];
+    [encoder_ setCullMode:!polygonal ? MTLCullModeNone : raster.cull_front ? MTLCullModeFront : raster.cull_back ? MTLCullModeBack : MTLCullModeNone];
+    [encoder_ setBlendColorRed:regs_.Get<float>(XE_GPU_REG_RB_BLEND_RED) green:regs_.Get<float>(XE_GPU_REG_RB_BLEND_GREEN)
+                        blue:regs_.Get<float>(XE_GPU_REG_RB_BLEND_BLUE) alpha:regs_.Get<float>(XE_GPU_REG_RB_BLEND_ALPHA)];
+    auto system = BuildMetalSystemConstants(regs_, primitive, viewport);
+    debug_draw_log_ = DebugFrame() && primitive.host_draw_vertex_count <= 6;
+    Bind(*vs, vt, true, system); if (ps) Bind(*ps, pt, false, system);
+    MTLPrimitiveType topology;
+    switch (primitive.host_primitive_type) {
+      case xenos::PrimitiveType::kPointList: topology = MTLPrimitiveTypePoint; break;
+      case xenos::PrimitiveType::kLineList: topology = MTLPrimitiveTypeLine; break;
+      case xenos::PrimitiveType::kLineStrip: topology = MTLPrimitiveTypeLineStrip; break;
+      case xenos::PrimitiveType::kTriangleList: topology = MTLPrimitiveTypeTriangle; break;
+      case xenos::PrimitiveType::kTriangleStrip: topology = MTLPrimitiveTypeTriangleStrip; break;
+      default: ++failures_; return false;
+    }
+    if (primitive.index_buffer_type == PrimitiveProcessor::kNone) {
+      [encoder_ drawPrimitives:topology vertexStart:0 vertexCount:primitive.host_draw_vertex_count];
+    } else {
+      id<MTLBuffer> buffer; size_t offset;
+      if (primitive.index_buffer_type == PrimitiveProcessor::kGuestDMA) { buffer = REXCVAR_GET(metal_snapshot_vertices) ? snapshot_buffer_ : memory_buffer_; offset = primitive.guest_index_base; }
+      else { auto b = primitives_->Buffer(primitive); buffer = b.first; offset = b.second; }
+      [encoder_ drawIndexedPrimitives:topology indexCount:primitive.host_draw_vertex_count
+          indexType:primitive.host_index_format == xenos::IndexFormat::kInt16 ? MTLIndexTypeUInt16 : MTLIndexTypeUInt32
+          indexBuffer:buffer indexBufferOffset:offset];
+    }
+    if (DebugFrame() && (draws_ % 64) == 0) {
+      auto fetch = regs_.GetTextureFetch(0); auto vf = regs_.GetVertexFetch(0);
+      REXGPU_INFO("Metal draw debug: VS {:016X} PS {:016X}, prim {} index {} count {}, RT {:08X} depth {:08X}, vfetch {:08X} size {}, tex {:08X} fmt {} swizzle {:03X} signs {:02X}",
+        vs->ucode_data_hash(), ps ? ps->ucode_data_hash() : 0, uint32_t(primitive.host_vertex_shader_type),
+        uint32_t(primitive.index_buffer_type), primitive.host_draw_vertex_count,
+        regs_[XE_GPU_REG_RB_COLOR_INFO], dc.value, uint32_t(vf.address << 2), uint32_t(vf.size),
+        uint32_t(fetch.base_address << 12), uint32_t(fetch.format), uint32_t(fetch.swizzle), uint32_t((fetch.dword_0 >> 2) & 255));
+    }
+    ++draws_;
+    return true;
+  }
+}
+
+uint32_t MetalDraw::Snapshot(uint32_t address, uint32_t size) {
+  if (!size) return 0;
+  const void* source = memory_.TranslatePhysical<const void*>(address);
+  // A range copied earlier in the frame is reused if its data is the same. (Tried 2026-11-01: the write
+  // watches' page validity instead of the hash, 23 FPS against 28 to 30 in free roam: watching every
+  // vertex range costs more than hashing it.)
+  uint64_t hash = XXH3_64bits(source, size);
+  std::string key; Key(key, address); Key(key, size);
+  auto found = snapshots_.find(key);
+  if (found != snapshots_.end() && found->second.second == hash) return found->second.first;
+  uint32_t offset = uint32_t(snapshot_used_);
+  std::memcpy(static_cast<uint8_t*>(snapshot_buffer_.contents) + offset, source, size);
+  snapshot_used_ += (size + 255) & ~size_t(255);
+  snapshots_[key] = {offset, hash};
+  return offset;
+}
+
+bool MetalDraw::SnapshotDraw(Shader& vertex, PrimitiveProcessor::ProcessingResult& primitive) {
+  std::memcpy(draw_fetch_.data(), &regs_[XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0], sizeof(draw_fetch_));
+  const auto& map = vertex.constant_register_map();
+  size_t required = 0;
+  struct Range { uint32_t fetch, address, size; };
+  std::vector<Range> ranges;
+  for (uint32_t i = 0; i < 96; ++i) {
+    if (!(map.vertex_fetch_bitmap[i / 32] & (1u << (i % 32)))) continue;
+    auto fetch = regs_.GetVertexFetch(i);
+    uint32_t address = (fetch.address << 2) & 0x1FFFFFFF;
+    uint32_t size = std::min(uint32_t(fetch.size) * 4, SharedMemory::kBufferSize - address);
+    ranges.push_back({i, address, size}); required += (size + 255) & ~size_t(255);
+  }
+  uint32_t index_bytes = 0;
+  if (primitive.index_buffer_type == PrimitiveProcessor::kGuestDMA ||
+      primitive.index_buffer_type == PrimitiveProcessor::kHostBuiltinForDMA) {
+    index_bytes = primitive.guest_draw_vertex_count *
+        (regs_.Get<reg::VGT_DRAW_INITIATOR>().index_size == xenos::IndexFormat::kInt16 ? 2 : 4);
+    if (uint64_t(primitive.guest_index_base) + index_bytes > SharedMemory::kBufferSize) return false;
+    required += (index_bytes + 255) & ~size_t(255);
+  }
+  if (required > snapshot_buffer_.length) return false;
+  if (snapshot_used_ + required > snapshot_buffer_.length) Submit();
+  for (auto range : ranges) {
+    uint32_t offset = Snapshot(range.address, range.size);
+    draw_fetch_[range.fetch * 2] = (draw_fetch_[range.fetch * 2] & 3) | offset;
+  }
+  if (index_bytes) primitive.guest_index_base = Snapshot(primitive.guest_index_base, index_bytes);
+  return true;
+}
+
+void MetalDraw::Bind(Shader& shader, Shader::Translation* translation, bool vertex, const std::vector<uint8_t>& system) {
+  auto buffer = [&](id<MTLBuffer> b, uint32_t slot) {
+    if (vertex) [encoder_ setVertexBuffer:b offset:0 atIndex:slot];
+    else [encoder_ setFragmentBuffer:b offset:0 atIndex:slot];
+  };
+  // Inline constants (Metal copies up to 4 KB with the command); a buffer only if larger.
+  auto bytes = [&](const void* data, size_t size, uint32_t slot) {
+    if (size > 4096) { buffer(Upload(data, size), slot); return; }
+    if (vertex) [encoder_ setVertexBytes:data length:size atIndex:slot];
+    else [encoder_ setFragmentBytes:data length:size atIndex:slot];
+  };
+  bytes(system.data(), system.size(), 0);
+  std::array<uint32_t, 1024> floats{}; size_t count = 0;
+  uint32_t base = vertex ? XE_GPU_REG_SHADER_CONSTANT_000_X : XE_GPU_REG_SHADER_CONSTANT_256_X;
+  const auto& map = shader.constant_register_map();
+  for (uint32_t i = 0; i < 256; ++i) if ((map.float_bitmap[i / 64] >> (i % 64)) & 1) {
+    std::memcpy(floats.data() + count * 4, &regs_[base + i * 4], 16); ++count;
+  }
+  bytes(floats.data(), std::max(count, size_t(1)) * 16, vertex ? 1 : 2);
+  bytes(&regs_[XE_GPU_REG_SHADER_CONSTANT_BOOL_000_031], 40 * 4, 3);
+  bytes(vertex && REXCVAR_GET(metal_snapshot_vertices) ? draw_fetch_.data() : &regs_[XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0], 32 * 6 * 4, 4);
+  buffer(REXCVAR_GET(metal_snapshot_vertices) ? snapshot_buffer_ : memory_buffer_, 5);
+  const auto& bindings = shaders_.translator().bindings(translation);
+  for (auto& t : bindings.textures) {
+    auto texture = Texture(t);
+    if (DebugFrame() && debug_draw_log_) {
+      auto f = regs_.GetTextureFetch(t.fetch_constant);
+      uint32_t a = (f.base_address << 12) & 0x1FFFFFFF;
+      auto r = resolved_.find(a);
+      REXGPU_INFO("Metal texture debug: draw {} {} slot {} fetch {} addr {:08X} fmt {} {}x{} tiled {} -> {}x{} {} ({})",
+          draws_, vertex ? "VS" : "PS", t.index, t.fetch_constant, a, uint32_t(f.format),
+          uint32_t(f.size_2d.width) + 1, uint32_t(f.size_2d.height) + 1, uint32_t(f.tiled),
+          texture.width, texture.height, uint32_t(texture.pixelFormat),
+          r != resolved_.end() ? fmt::format("resolve {}x{} fmt {}", r->second.width, r->second.height, r->second.format) : std::string("memory"));
+    }
+    if (vertex) [encoder_ setVertexTexture:texture atIndex:t.index];
+    else [encoder_ setFragmentTexture:texture atIndex:t.index];
+  }
+  for (auto& s : bindings.samplers) {
+    auto sampler = Sampler(s);
+    if (vertex) [encoder_ setVertexSamplerState:sampler atIndex:s.index];
+    else [encoder_ setFragmentSamplerState:sampler atIndex:s.index];
+  }
+}
+
+id<MTLTexture> MetalDraw::Texture(const MetalTextureBinding& binding) {
+  auto fetch = regs_.GetTextureFetch(binding.fetch_constant);
+  // The texture's identity is its memory and layout only; the sampler fields and the swizzle vary between
+  // passes that read the same texture, which is then loaded once and viewed with each swizzle.
+  std::string key;
+  Key(key, fetch.dword_0 & 0xFFC00003u); Key(key, fetch.dword_1); Key(key, fetch.dword_2); Key(key, fetch.dword_5);
+  Key(key, binding.dimension); Key(key, binding.is_signed);
+  bool cube = binding.dimension == xenos::FetchOpDimension::kCube;
+  auto cached = textures_.find(key);
+  if (cached != textures_.end() && texture_checked_frame_[key] == frame_) return View(cached->second, fetch.swizzle, cube);
+  bool volume = binding.dimension == xenos::FetchOpDimension::k3DOrStacked;
+  uint32_t address = (fetch.base_address << 12) & 0x1FFFFFFF;
+  uint64_t content_hash = 0;
+  uint32_t range = 0;
+  const ResolvedTexture* resolved = nullptr;
+  if (fetch.type == xenos::FetchConstantType::kTexture && fetch.dimension != xenos::DataDimension::k3D) {
+    uint32_t w, h, layers, base, mip, lo, hi;
+    texture_util::GetSubresourcesFromFetchConstant(fetch, &w, &h, &layers, &base, &mip, &lo, &hi);
+    auto layout = texture_util::GetGuestTextureLayout(fetch.dimension, fetch.pitch, w + 1, h + 1, layers + 1,
+        fetch.tiled, GetBaseFormat(fetch.format), fetch.packed_mips, base != 0, 0);
+    range = layout.base.level_data_extent_bytes;
+    // A resolve's texture stands in only for exactly what it wrote: a scene drawn in tiles is
+    // resolved piece by piece to one surface, and memory is often reused for other resolves.
+    auto r = resolved_.find(address);
+    if (r != resolved_.end() && !cube && !volume && r->second.width == w + 1 && r->second.height == h + 1 &&
+        r->second.format == uint32_t(GetBaseFormat(fetch.format)))
+      resolved = &r->second;
+    else if (base && uint64_t(address) + range <= SharedMemory::kBufferSize)
+      content_hash = XXH3_64bits(memory_.TranslatePhysical<const void*>(address), range);
+  }
+  texture_checked_frame_[key] = frame_;
+  texture_ranges_[key] = {address, resolved ? resolved->length : range};
+  if (cached != textures_.end() && texture_hashes_[key] == content_hash) return View(cached->second, fetch.swizzle, cube);
+  if (DebugFrame())
+    REXGPU_INFO("Metal texture load debug: addr {:08X} fmt {} {}x{} range {} - {}", address, uint32_t(fetch.format),
+        uint32_t(fetch.size_2d.width) + 1, uint32_t(fetch.size_2d.height) + 1, range,
+        cached == textures_.end() ? (texture_hashes_.contains(key) ? "dropped by a resolve" : "new") : "content changed");
+  texture_hashes_[key] = content_hash;
+  id<MTLTexture> texture = nil;
+  if (resolved) {
+    auto source = resolved->texture;
+    texture = [source newTextureViewWithPixelFormat:source.pixelFormat textureType:MTLTextureType2DArray
+        levels:NSMakeRange(0, 1) slices:NSMakeRange(0, 1)];
+  } else if (fetch.type == xenos::FetchConstantType::kTexture && !volume) {
+    auto format = GetBaseFormat(fetch.format);
+    MTLPixelFormat metal_format = MTLPixelFormatInvalid;
+    using F = xenos::TextureFormat;
+    switch (format) {
+      case F::k_8: case F::k_8_A: case F::k_8_B: metal_format = binding.is_signed ? MTLPixelFormatR8Snorm : MTLPixelFormatR8Unorm; break;
+      case F::k_8_8: metal_format = binding.is_signed ? MTLPixelFormatRG8Snorm : MTLPixelFormatRG8Unorm; break;
+      case F::k_8_8_8_8: metal_format = binding.is_signed ? MTLPixelFormatRGBA8Snorm : MTLPixelFormatRGBA8Unorm; break;
+      case F::k_16: metal_format = binding.is_signed ? MTLPixelFormatR16Snorm : MTLPixelFormatR16Unorm; break;
+      case F::k_16_16: metal_format = binding.is_signed ? MTLPixelFormatRG16Snorm : MTLPixelFormatRG16Unorm; break;
+      case F::k_16_16_16_16: metal_format = binding.is_signed ? MTLPixelFormatRGBA16Snorm : MTLPixelFormatRGBA16Unorm; break;
+      case F::k_16_FLOAT: metal_format = MTLPixelFormatR16Float; break;
+      case F::k_16_16_FLOAT: metal_format = MTLPixelFormatRG16Float; break;
+      case F::k_16_16_16_16_FLOAT: metal_format = MTLPixelFormatRGBA16Float; break;
+      case F::k_32_FLOAT: metal_format = MTLPixelFormatR32Float; break;
+      case F::k_32_32_FLOAT: metal_format = MTLPixelFormatRG32Float; break;
+      case F::k_32_32_32_32_FLOAT: metal_format = MTLPixelFormatRGBA32Float; break;
+      case F::k_2_10_10_10: metal_format = MTLPixelFormatRGB10A2Unorm; break;
+      case F::k_24_8: case F::k_24_8_FLOAT: metal_format = MTLPixelFormatR32Float; break;
+      case F::k_DXT1: metal_format = MTLPixelFormatBC1_RGBA; break;
+      case F::k_DXT2_3: metal_format = MTLPixelFormatBC2_RGBA; break;
+      case F::k_DXT4_5: metal_format = MTLPixelFormatBC3_RGBA; break;
+      case F::k_DXN: metal_format = binding.is_signed ? MTLPixelFormatBC5_RGSnorm : MTLPixelFormatBC5_RGUnorm; break;
+      default: if (unsupported_formats_.insert(uint32_t(format)).second)
+        REXGPU_WARN("Metal M1: unsupported texture format {}", uint32_t(format)); break;
+    }
+    uint32_t w, h, layers, base_page, mip_page, mip_min, mip_max;
+    texture_util::GetSubresourcesFromFetchConstant(fetch, &w, &h, &layers, &base_page, &mip_page, &mip_min, &mip_max);
+    ++w; ++h; ++layers;
+    if (metal_format != MTLPixelFormatInvalid && base_page && w <= 8192 && h <= 8192 && (!cube || w == h)) {
+      auto desc = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:metal_format width:w height:h mipmapped:NO];
+      desc.textureType = cube ? MTLTextureTypeCube : MTLTextureType2DArray;
+      desc.arrayLength = cube ? 1 : layers;
+      desc.storageMode = MTLStorageModePrivate; desc.usage = MTLTextureUsageShaderRead | MTLTextureUsagePixelFormatView;
+      texture = [device_ newTextureWithDescriptor:desc];
+      if (texture) {
+        // Untiled on the GPU straight from guest memory (the no-copy buffer), ordered after the
+        // resolves already encoded, then blitted: any format, compressed ones by blocks.
+        auto info = FormatInfo::Get(format);
+        uint32_t bpb = info->bytes_per_block(), bw = (w + info->block_width - 1) / info->block_width;
+        uint32_t bh = (h + info->block_height - 1) / info->block_height;
+        auto layout = texture_util::GetGuestTextureLayout(fetch.dimension, fetch.pitch, w, h, layers,
+            fetch.tiled, format, fetch.packed_mips, true, 0);
+        uint32_t ox = 0, oy = 0, oz = 0;
+        if (fetch.packed_mips) texture_util::GetPackedMipOffset(w, h, 1, format, 0, ox, oy, oz);
+        size_t image = size_t(bw) * bh * bpb;
+        id<MTLBuffer> staging = [device_ newBufferWithLength:image * layers options:MTLResourceStorageModePrivate];
+        if (!staging || !memory_buffer_) {
+          texture = nil;
+        } else {
+          struct {
+            uint32_t src_base, slice_stride, row_pitch_bytes, pitch_blocks, log_bpp, ox, oy, tiled, xor_mask, bw, bh, convert;
+          } c{(base_page << 12) & 0x1FFFFFFF, layout.base.array_slice_stride_bytes, layout.base.row_pitch_bytes,
+              layout.base.row_pitch_bytes / bpb, rex::log2_floor(bpb), ox, oy, fetch.tiled ? 1u : 0u,
+              fetch.endianness == xenos::Endian::k8in16 ? 1u : fetch.endianness == xenos::Endian::k8in32 ? 3u :
+                  fetch.endianness == xenos::Endian::k16in32 ? 2u : 0u,
+              bw, bh, format == F::k_24_8 ? 1u : format == F::k_24_8_FLOAT ? 2u : 0u};
+          EndEncoder();
+          if (!commands_) { commands_ = [queue_ commandBuffer]; commands_.label = @"Xenos M1 draws"; }
+          auto compute = [commands_ computeCommandEncoder];
+          [compute setComputePipelineState:load_texture_];
+          [compute setBuffer:memory_buffer_ offset:0 atIndex:0]; [compute setBuffer:staging offset:0 atIndex:1];
+          [compute setBytes:&c length:sizeof(c) atIndex:2];
+          [compute dispatchThreads:MTLSizeMake(bw, bh, layers) threadsPerThreadgroup:MTLSizeMake(8, 8, 1)];
+          [compute endEncoding];
+          auto blit = [commands_ blitCommandEncoder];
+          for (uint32_t layer = 0; layer < layers; ++layer)
+            [blit copyFromBuffer:staging sourceOffset:layer * image sourceBytesPerRow:bw * bpb sourceBytesPerImage:image
+                sourceSize:MTLSizeMake(w, h, 1) toTexture:texture destinationSlice:layer destinationLevel:0
+                destinationOrigin:MTLOriginMake(0, 0, 0)];
+          [blit endEncoding];
+          ++texture_loads_;
+        }
+      }
+    }
+  }
+  if (!texture) {
+    // Valid zero fallback for unsupported formats/dimensions, including the unused signed binding.
+    auto desc = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm width:1 height:1 mipmapped:NO];
+    desc.textureType = cube ? MTLTextureTypeCube : volume ? MTLTextureType3D : MTLTextureType2DArray;
+    desc.storageMode = MTLStorageModeShared; desc.usage = MTLTextureUsageShaderRead | MTLTextureUsagePixelFormatView;
+    texture = [device_ newTextureWithDescriptor:desc];
+    uint32_t zero = 0;
+    for (uint32_t i = 0; i < (cube ? 6u : 1u); ++i)
+      [texture replaceRegion:MTLRegionMake3D(0, 0, 0, 1, 1, 1) mipmapLevel:0 slice:i withBytes:&zero bytesPerRow:4 bytesPerImage:4];
+  }
+  if (cached != textures_.end()) DropViews(cached->second);
+  textures_[key] = texture; return View(texture, fetch.swizzle, cube);
+}
+
+id<MTLTexture> MetalDraw::View(id<MTLTexture> texture, uint32_t swizzle_bits, bool cube) {
+  if (!texture) return nil;
+  std::string key; Key(key, reinterpret_cast<uintptr_t>((__bridge void*)texture)); Key(key, swizzle_bits);
+  auto found = views_.find(key);
+  if (found != views_.end()) return found->second;
+  static const MTLTextureSwizzle swizzle[] = {MTLTextureSwizzleRed, MTLTextureSwizzleGreen, MTLTextureSwizzleBlue,
+    MTLTextureSwizzleAlpha, MTLTextureSwizzleZero, MTLTextureSwizzleOne, MTLTextureSwizzleZero, MTLTextureSwizzleZero};
+  MTLTextureSwizzleChannels channels = MTLTextureSwizzleChannelsMake(swizzle[swizzle_bits & 7],
+    swizzle[(swizzle_bits >> 3) & 7], swizzle[(swizzle_bits >> 6) & 7], swizzle[(swizzle_bits >> 9) & 7]);
+  id<MTLTexture> view = [texture newTextureViewWithPixelFormat:texture.pixelFormat textureType:texture.textureType
+    levels:NSMakeRange(0, texture.mipmapLevelCount) slices:NSMakeRange(0, cube ? 6 : texture.arrayLength) swizzle:channels];
+  views_[key] = view;
+  return view;
+}
+
+id<MTLSamplerState> MetalDraw::Sampler(const MetalSamplerBinding& b) {
+  auto fetch = regs_.GetTextureFetch(b.fetch_constant);
+  auto mag = b.mag_filter == xenos::TextureFilter::kUseFetchConst ? fetch.mag_filter : b.mag_filter;
+  auto min = b.min_filter == xenos::TextureFilter::kUseFetchConst ? fetch.min_filter : b.min_filter;
+  std::string key; Key(key, mag); Key(key, min); Key(key, uint32_t(fetch.clamp_x));
+  Key(key, uint32_t(fetch.clamp_y)); Key(key, uint32_t(fetch.clamp_z));
+  auto found = samplers_.find(key); if (found != samplers_.end()) return found->second;
+  auto d = [MTLSamplerDescriptor new];
+  d.magFilter = mag == xenos::TextureFilter::kLinear ? MTLSamplerMinMagFilterLinear : MTLSamplerMinMagFilterNearest;
+  d.minFilter = min == xenos::TextureFilter::kLinear ? MTLSamplerMinMagFilterLinear : MTLSamplerMinMagFilterNearest;
+  auto clamp = [](xenos::ClampMode c) { return uint32_t(c) == 0 ? MTLSamplerAddressModeRepeat :
+    uint32_t(c) == 1 ? MTLSamplerAddressModeMirrorRepeat : MTLSamplerAddressModeClampToEdge; };
+  d.sAddressMode = clamp(fetch.clamp_x); d.tAddressMode = clamp(fetch.clamp_y); d.rAddressMode = clamp(fetch.clamp_z);
+  id<MTLSamplerState> state = [device_ newSamplerStateWithDescriptor:d]; samplers_[key] = state; return state;
+}
+
+bool MetalDraw::Resolve() {
+  @autoreleasepool {
+    draw_util::ResolveInfo info;
+    if (!draw_util::GetResolveInfo(regs_, memory_, 1, 1, edram_tiles_, true, true, info)) return false;
+    EndEncoder();
+    if (!commands_) commands_ = [queue_ commandBuffer];
+    bool depth = info.IsCopyingDepth();
+    auto ei = depth ? info.depth_edram_info : info.color_edram_info;
+    uint32_t original = depth ? info.depth_original_base : info.color_original_base;
+    uint32_t ssx = ei.msaa_samples >= xenos::MsaaSamples::k4X ? 2 : 1, ssy = ei.msaa_samples >= xenos::MsaaSamples::k2X ? 2 : 1;
+    uint32_t pitch = regs_.Get<reg::RB_SURFACE_INFO>().surface_pitch * ssx;
+    MTLPixelFormat format = depth ? MTLPixelFormatDepth32Float_Stencil8 : ColorFormat(xenos::ColorRenderTargetFormat(ei.format));
+    id<MTLTexture> source = nil;
+    std::string identity; Key(identity, original); Key(identity, format); Key(identity, pitch);
+    auto current = targets_.find(identity);
+    if (current != targets_.end()) source = current->second;
+    uint32_t width = info.coordinate_info.width_div_8 * 8, height = info.height_div_8 * 8;
+    if (source && width && height && info.copy_dest_extent_length) {
+      uint32_t delta = (ei.GetBaseTiles() - original) & (edram_tiles_ - 1);
+      uint32_t sx = (delta % std::max(1u, uint32_t(ei.pitch_tiles))) * (ei.format_is_64bpp ? 40 : 80) +
+                    info.coordinate_info.edram_offset_x_div_8 * 8 * ssx;
+      uint32_t sy = (delta / std::max(1u, uint32_t(ei.pitch_tiles))) * 16 + info.coordinate_info.edram_offset_y_div_8 * 8 * ssy;
+      if (sx < source.width && sy < source.height) {
+        width = std::min(width, (uint32_t(source.width) - sx) / ssx); height = std::min(height, (uint32_t(source.height) - sy) / ssy);
+      }
+      if (sx < source.width && sy < source.height && width && height) {
+        MTLPixelFormat dest_format = MTLPixelFormatRGBA8Unorm;
+        if (depth) dest_format = MTLPixelFormatR32Float;
+        else switch (uint32_t(info.copy_dest_info.copy_dest_format)) {
+          case 2: case 8: case 9: dest_format = MTLPixelFormatR8Unorm; break;
+          case 10: dest_format = MTLPixelFormatRG8Unorm; break;
+          case 7: case 54: dest_format = MTLPixelFormatRGB10A2Unorm; break;
+          case 24: dest_format = MTLPixelFormatR16Unorm; break;
+          case 25: dest_format = MTLPixelFormatRG16Unorm; break;
+          case 26: dest_format = MTLPixelFormatRGBA16Unorm; break;
+          case 30: dest_format = MTLPixelFormatR16Float; break;
+          case 31: dest_format = MTLPixelFormatRG16Float; break;
+          case 32: dest_format = MTLPixelFormatRGBA16Float; break;
+          case 36: dest_format = MTLPixelFormatR32Float; break;
+          case 37: dest_format = MTLPixelFormatRG32Float; break;
+          case 38: dest_format = MTLPixelFormatRGBA32Float; break;
+        }
+        auto desc = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:dest_format width:width height:height mipmapped:NO];
+        desc.storageMode = MTLStorageModePrivate; desc.usage = MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite | MTLTextureUsagePixelFormatView;
+        id<MTLTexture> destination = [device_ newTextureWithDescriptor:desc];
+        if (!destination) return false;
+        bool depth_float = info.depth_edram_info.format == uint32_t(xenos::DepthRenderTargetFormat::kD24FS8);
+        ResolveConstants constants{sx, sy, width, height, info.copy_dest_coordinate_info.offset_x_div_8 * 8u,
+          info.copy_dest_coordinate_info.offset_y_div_8 * 8u, info.copy_dest_coordinate_info.pitch_aligned_div_32 * 32u,
+          info.copy_dest_base, uint32_t(info.copy_dest_info.copy_dest_format), uint32_t(info.copy_dest_info.copy_dest_endian),
+          info.copy_dest_info.copy_dest_swap, memory_buffer_ ? 1u : 0u,
+          !depth ? std::ldexp(1.0f, info.copy_dest_info.copy_dest_exp_bias) : depth_float ? 2.0f : 1.0f, 0, ssx, ssy,
+          // One sample (depth always: averaging depth is meaningless) or the average of all.
+          depth || xenos::IsSingleCopySampleSelected(info.rb_copy_control.copy_sample_select)
+              ? (depth ? 0u : uint32_t(info.rb_copy_control.copy_sample_select)) : 4u};
+        // Depth resolves write the EDRAM depth format (xenos.h: no format conversion for depth).
+        if (depth) constants.format = depth_float ? uint32_t(xenos::TextureFormat::k_24_8_FLOAT) : uint32_t(xenos::TextureFormat::k_24_8);
+        auto compute = [commands_ computeCommandEncoder];
+        [compute setComputePipelineState:depth ? resolve_depth_ : resolve_color_];
+        [compute setTexture:source atIndex:0]; [compute setTexture:destination atIndex:1];
+        [compute setBytes:&constants length:sizeof(constants) atIndex:0];
+        [compute setBuffer:memory_buffer_ ? memory_buffer_ : snapshot_buffer_ offset:0 atIndex:1];
+        [compute dispatchThreads:MTLSizeMake(width, height, 1) threadsPerThreadgroup:MTLSizeMake(8, 8, 1)];
+        [compute endEncoding];
+        uint32_t address = info.copy_dest_base & 0x1FFFFFFF;
+        InvalidateRange(info.copy_dest_extent_start & 0x1FFFFFFF, info.copy_dest_extent_length);
+        if (!constants.dx && !constants.dy)
+          resolved_[address] = {destination, info.copy_dest_extent_start & 0x1FFFFFFF, info.copy_dest_extent_length,
+                                width, height, depth ? constants.format : uint32_t(info.copy_dest_info.copy_dest_format)};
+        ++resolves_;
+        if (!resolve_verified_ && memory_buffer_ && frame_ >= 650 && dest_format == MTLPixelFormatRGBA8Unorm)
+          VerifyResolve(destination, info);
+        if (DebugFrame()) {
+          REXGPU_INFO("Metal resolve debug {}: base {} -> {:08X}, format {} -> {}, source {}x{} origin {},{} size {}x{}, exponent {}, swap {}",
+            resolves_, original, address, uint32_t(ei.format), uint32_t(info.copy_dest_info.copy_dest_format),
+            source.width, source.height, sx, sy, width, height, int(info.copy_dest_info.copy_dest_exp_bias), uint32_t(info.copy_dest_info.copy_dest_swap));
+          DumpTexture(destination, fmt::format("resolve_{}_{:08X}", resolves_, address));
+        }
+      }
+    }
+    if (!depth && info.IsClearingDepth()) {
+      for (auto& [key, target] : targets_) {
+        uint32_t base; std::memcpy(&base, key.data(), sizeof(base));
+        if (base != info.depth_original_base || target.pixelFormat != MTLPixelFormatDepth32Float_Stencil8 ||
+            target.width != regs_.Get<reg::RB_SURFACE_INFO>().surface_pitch *
+                (info.depth_edram_info.msaa_samples >= xenos::MsaaSamples::k4X ? 2 : 1)) continue;
+        auto pass = [MTLRenderPassDescriptor renderPassDescriptor];
+        pass.depthAttachment.texture = pass.stencilAttachment.texture = target;
+        pass.depthAttachment.loadAction = pass.stencilAttachment.loadAction = MTLLoadActionClear;
+        pass.depthAttachment.storeAction = pass.stencilAttachment.storeAction = MTLStoreActionStore;
+        pass.depthAttachment.clearDepth = (info.depth_edram_info.format == uint32_t(xenos::DepthRenderTargetFormat::kD24FS8)
+            ? xenos::Float20e4To32(info.rb_depth_clear >> 8) * 0.5 : double(info.rb_depth_clear >> 8) / 16777215.0);
+        pass.stencilAttachment.clearStencil = info.rb_depth_clear & 255;
+        [[commands_ renderCommandEncoderWithDescriptor:pass] endEncoding];
+      }
+    }
+    // Clear the same host allocation after copying it; load actions apply at the next encoder boundary.
+    if (source && ((depth && info.IsClearingDepth()) || (!depth && info.IsClearingColor()))) {
+      auto pass = [MTLRenderPassDescriptor renderPassDescriptor];
+      if (depth) {
+        pass.depthAttachment.texture = pass.stencilAttachment.texture = source;
+        pass.depthAttachment.loadAction = pass.stencilAttachment.loadAction = MTLLoadActionClear;
+        pass.depthAttachment.storeAction = pass.stencilAttachment.storeAction = MTLStoreActionStore;
+        pass.depthAttachment.clearDepth = (info.depth_edram_info.format == uint32_t(xenos::DepthRenderTargetFormat::kD24FS8)
+            ? xenos::Float20e4To32(info.rb_depth_clear >> 8) * 0.5 : double(info.rb_depth_clear >> 8) / 16777215.0);
+        pass.stencilAttachment.clearStencil = info.rb_depth_clear & 255;
+      } else {
+        pass.colorAttachments[0].texture = source; pass.colorAttachments[0].loadAction = MTLLoadActionClear;
+        pass.colorAttachments[0].storeAction = MTLStoreActionStore;
+        uint32_t c = info.rb_color_clear;
+        pass.colorAttachments[0].clearColor = MTLClearColorMake((c & 255) / 255.0, ((c >> 8) & 255) / 255.0,
+            ((c >> 16) & 255) / 255.0, (c >> 24) / 255.0);
+      }
+      [[commands_ renderCommandEncoderWithDescriptor:pass] endEncoding];
+    }
+    if (DebugFrame())
+      REXGPU_INFO("Metal resolve clear debug: draw {} {} base color {} depth {}, clear color {} ({:08X}) depth {} ({:08X}), source {}",
+          draws_, depth ? "depth" : "color", info.color_original_base, info.depth_original_base,
+          info.IsClearingColor(), info.rb_color_clear, info.IsClearingDepth(), info.rb_depth_clear, source ? "found" : "missing");
+    return true;
+  }
+}
+
+void MetalDraw::VerifyResolve(id<MTLTexture> texture, const draw_util::ResolveInfo& info) {
+  Submit();
+  // Preserve the caller's pending resolve clears even if allocation or readback fails.
+  commands_ = [queue_ commandBuffer];
+  size_t stride = (texture.width * 4 + 255) & ~size_t(255);
+  auto buffer = [device_ newBufferWithLength:stride * texture.height options:MTLResourceStorageModeShared];
+  if (!buffer) return;
+  auto commands = [queue_ commandBuffer]; auto blit = [commands blitCommandEncoder];
+  [blit copyFromTexture:texture sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 0)
+    sourceSize:MTLSizeMake(texture.width, texture.height, 1) toBuffer:buffer destinationOffset:0
+    destinationBytesPerRow:stride destinationBytesPerImage:stride * texture.height];
+  [blit endEncoding]; [commands commit]; [commands waitUntilCompleted];
+  if (commands.status != MTLCommandBufferStatusCompleted) return;
+  uint32_t mismatch = 0, checked = 0, nonzero = 0;
+  uint32_t endian = uint32_t(info.copy_dest_info.copy_dest_endian);
+  uint32_t xor_mask = endian == 1 ? 1 : endian == 2 ? 3 : endian == 3 ? 2 : endian == 4 ? 7 : endian == 5 ? 15 : 0;
+  auto* physical = memory_.physical_membase();
+  for (uint32_t y = 0; y < texture.height; y += std::max(1u, uint32_t(texture.height) / 16))
+    for (uint32_t x = 0; x < texture.width; x += std::max(1u, uint32_t(texture.width) / 16)) {
+      uint32_t address = info.copy_dest_base + texture_util::GetTiledOffset2D(
+          x + info.copy_dest_coordinate_info.offset_x_div_8 * 8,
+          y + info.copy_dest_coordinate_info.offset_y_div_8 * 8,
+          info.copy_dest_coordinate_info.pitch_aligned_div_32 * 32, 2);
+      auto* expected = static_cast<const uint8_t*>(buffer.contents) + y * stride + x * 4;
+      for (uint32_t c = 0; c < 4; ++c) {
+        uint32_t a = (address + c) ^ xor_mask;
+        if (a >= SharedMemory::kBufferSize) { ++mismatch; continue; }
+        ++checked; mismatch += physical[a] != expected[c]; nonzero += expected[c] != 0;
+      }
+    }
+  resolve_verified_ = true;
+  REXGPU_INFO("Metal resolve CPU visibility: {} bytes checked ({} nonzero), {} mismatches", checked, nonzero, mismatch);
+  if (mismatch) ++failures_;
+}
+
+void MetalDraw::DumpTexture(id<MTLTexture> texture, const std::string& name) {
+  const auto dir = REXCVAR_GET(metal_debug_dir);
+  if (dir.empty()) return;
+  Submit();
+  commands_ = [queue_ commandBuffer];
+  auto desc = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA32Float
+      width:texture.width height:texture.height mipmapped:NO];
+  desc.storageMode = MTLStorageModePrivate; desc.usage = MTLTextureUsageShaderWrite;
+  auto readable = [device_ newTextureWithDescriptor:desc];
+  size_t stride = (texture.width * 16 + 255) & ~size_t(255);
+  auto buffer = [device_ newBufferWithLength:stride * texture.height options:MTLResourceStorageModeShared];
+  if (!readable || !buffer) return;
+  auto commands = [queue_ commandBuffer];
+  auto compute = [commands computeCommandEncoder];
+  [compute setComputePipelineState:resolve_color_];
+  [compute setTexture:texture atIndex:0]; [compute setTexture:readable atIndex:1];
+  ResolveConstants constants;
+  constants.width = uint32_t(texture.width); constants.height = uint32_t(texture.height);
+  [compute setBytes:&constants length:sizeof(constants) atIndex:0];
+  [compute setBuffer:snapshot_buffer_ offset:0 atIndex:1];
+  [compute dispatchThreads:MTLSizeMake(texture.width, texture.height, 1) threadsPerThreadgroup:MTLSizeMake(8, 8, 1)];
+  [compute endEncoding];
+  auto blit = [commands blitCommandEncoder];
+  [blit copyFromTexture:readable sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 0)
+      sourceSize:MTLSizeMake(texture.width, texture.height, 1) toBuffer:buffer destinationOffset:0
+      destinationBytesPerRow:stride destinationBytesPerImage:stride * texture.height];
+  [blit endEncoding]; [commands commit]; [commands waitUntilCompleted];
+  if (commands.status != MTLCommandBufferStatusCompleted) return;
+  std::error_code error; std::filesystem::create_directories(dir, error);
+  std::ofstream out(dir + "/" + name + ".ppm", std::ios::binary);
+  out << "P6\n" << texture.width << " " << texture.height << "\n255\n";
+  for (size_t y = 0; y < texture.height; ++y) {
+    const float* row = reinterpret_cast<const float*>(static_cast<const uint8_t*>(buffer.contents) + y * stride);
+    for (size_t x = 0; x < texture.width; ++x) for (size_t c = 0; c < 3; ++c) {
+      float value = row[x * 4 + c];
+      out.put(char(std::isfinite(value) ? std::clamp(value, 0.0f, 1.0f) * 255.0f : 0));
+    }
+  }
+  // Dumping drained the pending resolve; leave a command buffer for its clears.
+  commands_ = [queue_ commandBuffer];
+}
+
+bool MetalDraw::Present(uint32_t address, id<MTLTexture> destination) {
+  // EndFrame has committed the frame; the front buffer's load and the copy follow it on the queue.
+  Submit(false);
+  // The swap packet installs the front buffer's texture fetch constant in slot 0; it goes through
+  // the same lookup as any texture (the resolve's own texture if it is exactly the front buffer,
+  // guest memory otherwise, e.g. a scene resolved in tiles), with the fetch's component swizzle.
+  auto fetch = regs_.GetTextureFetch(0);
+  if (fetch.type != xenos::FetchConstantType::kTexture || !fetch.base_address) return false;
+  (void)address;
+  MetalTextureBinding binding{0, 0, xenos::FetchOpDimension::k2D, false};
+  id<MTLTexture> source = Texture(binding);
+  if (!source || source.width <= 1) return false;
+  uint32_t size[2] = {uint32_t(std::min(source.width, destination.width)), uint32_t(std::min(source.height, destination.height))};
+  EndEncoder();
+  if (!commands_) commands_ = [queue_ commandBuffer];
+  auto commands = commands_; commands.label = @"Xenos front buffer";
+  commands_ = nil;
+  auto compute = [commands computeCommandEncoder];
+  [compute setComputePipelineState:present_];
+  [compute setTexture:source atIndex:0]; [compute setTexture:destination atIndex:1];
+  [compute setBytes:size length:sizeof(size) atIndex:0];
+  [compute dispatchThreads:MTLSizeMake(size[0], size[1], 1) threadsPerThreadgroup:MTLSizeMake(8, 8, 1)];
+  [compute endEncoding]; [commands commit];
+  return true;
+}
+}  // namespace rex::graphics::metal
