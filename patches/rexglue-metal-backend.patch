+/** Pipelines through MTL4Compiler: flexible pipelines, archives, compiler tasks. BSD-3-Clause, see LICENSE. */
+#include "metal_pipelines4.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <system_error>
+
+namespace rex::graphics::metal {
+
+namespace {
+
+uint64_t MicrosecondsSince(std::chrono::steady_clock::time_point start) {
+  return uint64_t(
+      std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - start).count());
+}
+
+// FNV-1a: stable from run to run (the archive names depend on it).
+uint64_t Fnv(const void* data, size_t size, uint64_t hash = 0xCBF29CE484222325ull) {
+  auto bytes = static_cast<const uint8_t*>(data);
+  for (size_t i = 0; i < size; ++i) hash = (hash ^ bytes[i]) * 0x100000001B3ull;
+  return hash;
+}
+
+// A flexible build this long compiled (an archive hit is ~0.1 ms, a compile of a game shader tens of ms or more).
+constexpr uint64_t kCompiledUs = 20000;
+
+bool EndsWith(const std::string& s, const char* suffix) {
+  const size_t n = std::strlen(suffix);
+  return s.size() >= n && s.compare(s.size() - n, n, suffix) == 0;
+}
+
+API_AVAILABLE(macos(26.0))
+MTL4LibraryFunctionDescriptor* Function(id<MTLLibrary> library, NSString* name) {
+  auto function = [MTL4LibraryFunctionDescriptor new];
+  function.library = library;
+  function.name = name;
+  return function;
+}
+
+}  // namespace
+
+PipelineTargets PipelineTargets::From(MTLRenderPipelineDescriptor* desc) {
+  PipelineTargets targets;
+  for (uint32_t i = 0; i < 4; ++i) {
+    MTLRenderPipelineColorAttachmentDescriptor* a = desc.colorAttachments[i];
+    auto& c = targets.colors[i];
+    c.format = a.pixelFormat;
+    c.write_mask = a.writeMask;
+    c.blending = a.blendingEnabled;
+    c.src_rgb = a.sourceRGBBlendFactor; c.dst_rgb = a.destinationRGBBlendFactor;
+    c.src_alpha = a.sourceAlphaBlendFactor; c.dst_alpha = a.destinationAlphaBlendFactor;
+    c.rgb_op = a.rgbBlendOperation; c.alpha_op = a.alphaBlendOperation;
+  }
+  return targets;
+}
+
+MetalPipelines4::~MetalPipelines4() {
+  // The tasks' blocks call back into this object.
+  std::unique_lock<std::mutex> lock(mutex_);
+  for (const auto& key : queue_) bases_[key].queued = false;
+  queue_.clear();
+  idle_.wait(lock, [this] { return tasks_ == 0; });
+}
+
+bool MetalPipelines4::Init(id<MTLDevice> device, const std::filesystem::path& dir, const std::string& name,
+                           uint64_t identity, uint32_t max_in_flight, std::string& log) {
+  device_ = device;
+  max_in_flight_ = std::max(1u, max_in_flight);
+  NSError* error = nil;
+  auto compiler_desc = [MTL4CompilerDescriptor new];
+  compiler_desc.label = @"pipelines";
+  if (!dir.empty()) {
+    auto serializer_desc = [MTL4PipelineDataSetSerializerDescriptor new];
+    serializer_desc.configuration = MTL4PipelineDataSetSerializerConfigurationCaptureBinaries;
+    serializer_ = [device newPipelineDataSetSerializerWithDescriptor:serializer_desc];
+    compiler_desc.pipelineDataSetSerializer = serializer_;
+  }
+  id<MTL4Compiler> compiler = [device newCompilerWithDescriptor:compiler_desc error:&error];
+  if (!compiler) {
+    serializer_ = nil;
+    log = std::string("Metal 4 pipelines: no compiler (") + (error ? error.localizedDescription.UTF8String : "?") +
+          "), Metal 3 pipelines";
+    return false;
+  }
+  compiler_ = compiler;
+  auto options = [MTL4CompilerTaskOptions new];
+  options_ = options;
+  if (dir.empty()) {
+    log = "Metal 4 pipelines: compiler ready, no archives";
+    return true;
+  }
+
+  // The OS build (the Metal framework's and the GPU compiler's versions are in an archive's lookup key: after an
+  // update every lookup would miss), the GPU, and what the caller's shaders depend on.
+  const std::string os = NSProcessInfo.processInfo.operatingSystemVersionString.UTF8String;
+  const std::string gpu = device.name.UTF8String;
+  uint64_t hash = Fnv(os.data(), os.size());
+  hash = Fnv(gpu.data(), gpu.size(), hash);
+  hash = Fnv(&identity, sizeof(identity), hash);
+  char stem[64];
+  std::snprintf(stem, sizeof(stem), "-%016llX", static_cast<unsigned long long>(hash));
+  stem_ = name + stem;
+  dir_ = dir;
+
+  std::error_code ec;
+  std::filesystem::create_directories(dir_, ec);
+  std::vector<std::pair<uint32_t, std::filesystem::path>> found;
+  uint32_t removed = 0;
+  for (const auto& entry : std::filesystem::directory_iterator(dir_, ec)) {
+    const std::string file = entry.path().filename().string();
+    if (file.rfind(name + "-", 0) != 0) continue;
+    if (EndsWith(file, ".mtl4archive.tmp")) {  // a Save that didn't finish
+      std::filesystem::remove(entry.path(), ec);
+      continue;
+    }
+    if (EndsWith(file, ".mtl4index") || EndsWith(file, ".mtl4index.tmp")) {
+      // Another identity's index, or a write that didn't finish (this identity's is read below).
+      if (file != IndexPath().filename().string()) std::filesystem::remove(entry.path(), ec);
+      continue;
+    }
+    if (!EndsWith(file, ".mtl4archive")) continue;
+    if (file.rfind(stem_ + "-", 0) != 0) {  // another OS build, GPU or shader identity: it would only miss
+      std::filesystem::remove(entry.path(), ec);
+      ++removed;
+      continue;
+    }
+    const std::string number = file.substr(stem_.size() + 1, file.size() - stem_.size() - 1 - 12);
+    char* end = nullptr;
+    const unsigned long generation = std::strtoul(number.c_str(), &end, 10);
+    if (number.empty() || *end) continue;
+    found.emplace_back(uint32_t(generation), entry.path());
+  }
+  std::sort(found.begin(), found.end());
+  NSMutableArray<id<MTL4Archive>>* lookup = [NSMutableArray array];
+  uint32_t unreadable = 0;
+  for (const auto& [generation, path] : found) {
+    next_generation_ = std::max(next_generation_, generation + 1);
+    error = nil;
+    id<MTL4Archive> archive =
+        [device newArchiveWithURL:[NSURL fileURLWithPath:[NSString stringWithUTF8String:path.c_str()]] error:&error];
+    if (!archive) {
+      std::filesystem::remove(path, ec);
+      ++unreadable;
+      continue;
+    }
+    [lookup addObject:archive];
+    archives_.push_back(archive);
+    loaded_.push_back(path);
+    loaded_generations_.push_back(generation);
+  }
+  // Not under Metal's shader validation (MTL_SHADER_VALIDATION): its compiler turns the archives into its own
+  // kind for every pipeline and throws (an NSArray given nil, macOS 27.2); the pipelines are compiled instead.
+  const char* shader_validation = std::getenv("MTL_SHADER_VALIDATION");
+  if (lookup.count && !(shader_validation && *shader_validation && *shader_validation != '0'))
+    options.lookupArchives = lookup;
+  ReadIndex();
+  log = "Metal 4 pipelines: " + std::to_string(archives_.size()) + " archives (" + stem_ + ")";
+  if (indexed_) log += ", " + std::to_string(index_.size()) + " pipelines indexed";
+  if (removed) log += ", " + std::to_string(removed) + " of another OS, GPU or shader build removed";
+  if (unreadable) log += ", " + std::to_string(unreadable) + " unreadable removed";
+  return true;
+}
+
+id MetalPipelines4::FlexibleDescriptor(const Base& base, uint32_t samples) const {
+  if (@available(macOS 26.0, *)) {
+    auto desc = [MTL4RenderPipelineDescriptor new];
+    desc.vertexFunctionDescriptor = Function(base.vl, base.vl.functionNames.firstObject);
+    // Without a pixel shader rasterization stays on (depth-only draws): Metal 4 allows it, as Metal 3 did.
+    if (base.pl) desc.fragmentFunctionDescriptor = Function(base.pl, base.pl.functionNames.firstObject);
+    desc.rasterSampleCount = samples;
+    for (uint32_t i = 0; i < 4; ++i) {
+      MTL4RenderPipelineColorAttachmentDescriptor* a = desc.colorAttachments[i];
+      a.pixelFormat = MTLPixelFormatUnspecialized;
+      a.writeMask = MTLColorWriteMaskUnspecialized;
+      a.blendingState = MTL4BlendStateUnspecialized;
+      a.sourceRGBBlendFactor = a.destinationRGBBlendFactor = MTLBlendFactorUnspecialized;
+      a.sourceAlphaBlendFactor = a.destinationAlphaBlendFactor = MTLBlendFactorUnspecialized;
+      a.rgbBlendOperation = a.alphaBlendOperation = MTLBlendOperationUnspecialized;
+    }
+    return desc;
+  }
+  return nil;
+}
+
+id MetalPipelines4::SpecialisationDescriptor(const PipelineTargets& targets) {
+  if (@available(macOS 26.0, *)) {
+    // Every property the flexible pipeline left open is given (an attachment left out would take the defaults).
+    auto desc = [MTL4RenderPipelineDescriptor new];
+    for (uint32_t i = 0; i < 4; ++i) {
+      const auto& c = targets.colors[i];
+      MTL4RenderPipelineColorAttachmentDescriptor* a = desc.colorAttachments[i];
+      a.pixelFormat = c.format;
+      a.writeMask = c.write_mask;
+      a.blendingState = c.blending ? MTL4BlendStateEnabled : MTL4BlendStateDisabled;
+      a.sourceRGBBlendFactor = c.src_rgb; a.destinationRGBBlendFactor = c.dst_rgb;
+      a.sourceAlphaBlendFactor = c.src_alpha; a.destinationAlphaBlendFactor = c.dst_alpha;
+      a.rgbBlendOperation = c.rgb_op; a.alphaBlendOperation = c.alpha_op;
+    }
+    return desc;
+  }
+  return nil;
+}
+
+id MetalPipelines4::FullDescriptor(id<MTLLibrary> vl, id<MTLLibrary> pl, uint32_t samples,
+                                   const PipelineTargets& targets) {
+  if (@available(macOS 26.0, *)) {
+    auto desc = [MTL4RenderPipelineDescriptor new];
+    desc.vertexFunctionDescriptor = Function(vl, vl.functionNames.firstObject);
+    if (pl) desc.fragmentFunctionDescriptor = Function(pl, pl.functionNames.firstObject);
+    desc.rasterSampleCount = samples;
+    for (uint32_t i = 0; i < 4; ++i) {
+      const auto& c = targets.colors[i];
+      MTL4RenderPipelineColorAttachmentDescriptor* a = desc.colorAttachments[i];
+      a.pixelFormat = c.format;
+      a.writeMask = c.write_mask;
+      a.blendingState = c.blending ? MTL4BlendStateEnabled : MTL4BlendStateDisabled;
+      a.sourceRGBBlendFactor = c.src_rgb; a.destinationRGBBlendFactor = c.dst_rgb;
+      a.sourceAlphaBlendFactor = c.src_alpha; a.destinationAlphaBlendFactor = c.dst_alpha;
+      a.rgbBlendOperation = c.rgb_op; a.alphaBlendOperation = c.alpha_op;
+    }
+    return desc;
+  }
+  return nil;
+}
+
+id<MTLRenderPipelineState> MetalPipelines4::BuildFull(id desc, NSError** error) {
+  id<MTLRenderPipelineState> pipeline = nil;
+  const auto start = std::chrono::steady_clock::now();
+  if (@available(macOS 26.0, *)) {
+    // A synchronous call: a compiler task beside the serializer faults (Pump).
+    pipeline = [(id<MTL4Compiler>)compiler_ newRenderPipelineStateWithDescriptor:desc compilerTaskOptions:options_
+                                                                          error:error];
+  }
+  const uint64_t us = MicrosecondsSince(start);
+  std::lock_guard<std::mutex> lock(mutex_);
+  touched_ = true;
+  if (pipeline) {
+    ++stats_.full_built;
+    stats_.full_us += us;
+    if (us < 2000) ++stats_.full_fast;
+    if (us >= kCompiledUs) unindexed_ = true;
+  } else {
+    ++stats_.full_failed;
+  }
+  return pipeline;
+}
+
+void MetalPipelines4::Render(id<MTLLibrary> vl, id<MTLLibrary> pl, uint32_t samples, const PipelineTargets& targets,
+                             bool urgent, RenderDone done, uint64_t identity) {
+  std::unique_lock<std::mutex> lock(mutex_);
+  Note(Entry(identity, samples, nullptr));
+  Note(Entry(identity, samples, &targets));
+  if (!flexible_) {
+    // Whole pipelines: the callers limit how many build at once (the prebuild thread two, a draw its own).
+    ++tasks_;
+    lock.unlock();
+    id desc = FullDescriptor(vl, pl, samples, targets);
+    dispatch_async(dispatch_get_global_queue(urgent ? QOS_CLASS_USER_INTERACTIVE : QOS_CLASS_USER_INITIATED, 0), ^{
+      NSError* error = nil;
+      id<MTLRenderPipelineState> pipeline = BuildFull(desc, &error);
+      done(pipeline, error);
+      Ended();
+    });
+    return;
+  }
+  const BaseKey key{(__bridge void*)vl, (__bridge void*)pl, samples};
+  Base& base = bases_[key];
+  if (base.pipeline) {
+    id<MTLRenderPipelineState> pipeline = base.pipeline;
+    lock.unlock();
+    Specialise(pipeline, targets, done);
+    return;
+  }
+  if (base.failed) {
+    NSError* error = base.error;
+    lock.unlock();
+    done(nil, error);
+    return;
+  }
+  if (!base.vl) { base.vl = vl; base.pl = pl; }
+  base.waiting.push_back({targets, done});
+  if (!base.building) {
+    if (!base.queued) {
+      base.queued = true;
+      if (urgent) queue_.push_front(key); else queue_.push_back(key);
+    } else if (urgent) {
+      // A prebuild a draw now waits for: to the front.
+      auto it = std::find(queue_.begin(), queue_.end(), key);
+      if (it != queue_.end() && it != queue_.begin()) { queue_.erase(it); queue_.push_front(key); }
+    }
+  }
+  Pump(lock);
+}
+
+void MetalPipelines4::Pump(std::unique_lock<std::mutex>& lock) {
+  // Started outside the lock: a task may finish (and call Built) before the call returns.
+  std::vector<std::pair<BaseKey, id>> starts;
+  while (in_flight_ < max_in_flight_ && !queue_.empty()) {
+    const BaseKey key = queue_.front();
+    queue_.pop_front();
+    Base& base = bases_[key];
+    base.queued = false;
+    base.building = true;
+    ++in_flight_;
+    ++tasks_;
+    starts.emplace_back(key, FlexibleDescriptor(base, key.samples));
+  }
+  lock.unlock();
+  if (@available(macOS 26.0, *)) {
+    id<MTL4Compiler> compiler = compiler_;
+    MTL4CompilerTaskOptions* options = options_;
+    for (auto& [key, desc] : starts) {
+      const BaseKey copy = key;
+      const auto start = std::chrono::steady_clock::now();
+      if (!serializer_) {
+        [compiler newRenderPipelineStateWithDescriptor:desc
+                                   compilerTaskOptions:options
+                                     completionHandler:^(id<MTLRenderPipelineState> pipeline, NSError* error) {
+                                       Built(copy, pipeline, error, MicrosecondsSince(start));
+                                     }];
+        continue;
+      }
+      // With the serializer attached, a compiler task that compiles (not served from an archive or Apple's cache)
+      // faults inside Metal (MTLHashKey::getHashTools from MTLCompilerFunctionRequest::serializedRequest, macOS
+      // 27.2, every time, one task alone included); the synchronous call doesn't, from any number of threads.
+      id held = desc;
+      dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+        NSError* error = nil;
+        id<MTLRenderPipelineState> pipeline =
+            [compiler newRenderPipelineStateWithDescriptor:held compilerTaskOptions:options error:&error];
+        Built(copy, pipeline, error, MicrosecondsSince(start));
+      });
+    }
+  }
+}
+
+void MetalPipelines4::Built(const BaseKey& key, id<MTLRenderPipelineState> pipeline, NSError* error, uint64_t us) {
+  std::unique_lock<std::mutex> lock(mutex_);
+  Base& base = bases_[key];
+  base.building = false;
+  --in_flight_;
+  if (pipeline) {
+    base.pipeline = pipeline;
+    ++stats_.flexible_built;
+    stats_.flexible_us += us;
+    if (us < 2000) ++stats_.flexible_fast;  // from an archive or Apple's shader cache
+    // Compiled, so not in the archives whatever the index says (the MSL changed under the same identity): saved.
+    if (us >= kCompiledUs) unindexed_ = true;
+  } else {
+    base.failed = true;
+    base.error = error;
+    ++stats_.flexible_failed;
+  }
+  touched_ = true;
+  std::vector<Waiter> waiting = std::move(base.waiting);
+  base.waiting.clear();
+  Pump(lock);
+  for (auto& waiter : waiting) {
+    if (pipeline) Specialise(pipeline, waiter.targets, waiter.done);
+    else waiter.done(nil, error);
+  }
+  Ended();
+}
+
+void MetalPipelines4::Ended() {
+  std::lock_guard<std::mutex> lock(mutex_);
+  --tasks_;
+  idle_.notify_all();
+}
+
+void MetalPipelines4::Specialise(id<MTLRenderPipelineState> base, const PipelineTargets& targets, RenderDone done) {
+  if (@available(macOS 26.0, *)) {
+    { std::lock_guard<std::mutex> lock(mutex_); ++tasks_; }
+    const auto start = std::chrono::steady_clock::now();
+    id<MTL4Compiler> compiler = compiler_;
+    id desc = SpecialisationDescriptor(targets);
+    auto finished = ^(id<MTLRenderPipelineState> pipeline, NSError* error) {
+      {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (pipeline) ++stats_.specialised; else ++stats_.specialise_failed;
+        stats_.specialise_us += MicrosecondsSince(start);
+      }
+      done(pipeline, error);
+      Ended();
+    };
+    if (!serializer_) {
+      [compiler newRenderPipelineStateBySpecializationWithDescriptor:desc pipeline:base completionHandler:finished];
+      return;
+    }
+    // As in Pump: no compiler tasks beside the serializer.
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+      NSError* error = nil;
+      id<MTLRenderPipelineState> pipeline =
+          [compiler newRenderPipelineStateBySpecializationWithDescriptor:desc pipeline:base error:&error];
+      finished(pipeline, error);
+    });
+  }
+}
+
+id<MTLRenderPipelineState> MetalPipelines4::SpecialiseNow(id<MTLRenderPipelineState> base,
+                                                          const PipelineTargets& targets, NSError** error) {
+  if (@available(macOS 26.0, *)) {
+    const auto start = std::chrono::steady_clock::now();
+    id<MTLRenderPipelineState> pipeline =
+        [(id<MTL4Compiler>)compiler_ newRenderPipelineStateBySpecializationWithDescriptor:SpecialisationDescriptor(targets)
+                                                                                 pipeline:base
+                                                                                    error:error];
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (pipeline) ++stats_.specialised; else ++stats_.specialise_failed;
+    stats_.specialise_us += MicrosecondsSince(start);
+    return pipeline;
+  }
+  return nil;
+}
+
+id<MTLRenderPipelineState> MetalPipelines4::RenderNow(id<MTLLibrary> vl, id<MTLLibrary> pl, uint32_t samples,
+                                                      const PipelineTargets& targets, NSError** error,
+                                                      uint64_t identity) {
+  std::unique_lock<std::mutex> lock(mutex_);
+  Note(Entry(identity, samples, nullptr));
+  Note(Entry(identity, samples, &targets));
+  if (!flexible_) {
+    lock.unlock();
+    return BuildFull(FullDescriptor(vl, pl, samples, targets), error);
+  }
+  const BaseKey key{(__bridge void*)vl, (__bridge void*)pl, samples};
+  Base& base = bases_[key];
+  if (!base.vl) { base.vl = vl; base.pl = pl; }
+  while (!base.pipeline && !base.failed) {
+    if (base.building) {  // a task has it: Built wakes us through Ended
+      idle_.wait(lock);
+      continue;
+    }
+    if (base.queued) {
+      queue_.erase(std::find(queue_.begin(), queue_.end(), key));
+      base.queued = false;
+    }
+    base.building = true;
+    id desc = FlexibleDescriptor(base, samples);
+    lock.unlock();
+    NSError* build_error = nil;
+    id<MTLRenderPipelineState> pipeline = nil;
+    const auto start = std::chrono::steady_clock::now();
+    if (@available(macOS 26.0, *)) {
+      pipeline = [(id<MTL4Compiler>)compiler_ newRenderPipelineStateWithDescriptor:desc
+                                                               compilerTaskOptions:options_
+                                                                             error:&build_error];
+    }
+    const uint64_t us = MicrosecondsSince(start);
+    lock.lock();
+    base.building = false;
+    if (pipeline) {
+      base.pipeline = pipeline;
+      ++stats_.flexible_built;
+      stats_.flexible_us += us;
+      if (us < 2000) ++stats_.flexible_fast;
+      if (us >= kCompiledUs) unindexed_ = true;
+    } else {
+      base.failed = true;
+      base.error = build_error;
+      ++stats_.flexible_failed;
+    }
+    touched_ = true;
+    std::vector<Waiter> waiting = std::move(base.waiting);
+    base.waiting.clear();
+    lock.unlock();
+    for (auto& waiter : waiting) {
+      if (pipeline) Specialise(pipeline, waiter.targets, waiter.done);
+      else waiter.done(nil, build_error);
+    }
+    lock.lock();
+    idle_.notify_all();
+  }
+  if (base.failed) {
+    if (error) *error = base.error;
+    return nil;
+  }
+  id<MTLRenderPipelineState> flexible = base.pipeline;
+  lock.unlock();
+  return SpecialiseNow(flexible, targets, error);
+}
+
+id<MTLRenderPipelineState> MetalPipelines4::Render(MTL4RenderPipelineDescriptor* desc, NSError** error) {
+  id<MTLRenderPipelineState> pipeline =
+      [(id<MTL4Compiler>)compiler_ newRenderPipelineStateWithDescriptor:desc compilerTaskOptions:options_ error:error];
+  std::lock_guard<std::mutex> lock(mutex_);
+  if (pipeline) ++stats_.fixed_built; else ++stats_.fixed_failed;
+  touched_ = true;
+  if (@available(macOS 26.0, *)) {
+    // Fixed pipelines by their label, functions and targets (the backend names them; two alike count as one).
+    uint64_t h = Fnv("render", 6);
+    auto add = [&h](NSString* text) {
+      const char* u = text ? text.UTF8String : "";
+      h = Fnv(u, std::strlen(u) + 1, h);
+    };
+    auto name = [](MTL4FunctionDescriptor* f) -> NSString* {
+      return [f isKindOfClass:MTL4LibraryFunctionDescriptor.class] ? ((MTL4LibraryFunctionDescriptor*)f).name : nil;
+    };
+    add(desc.label); add(name(desc.vertexFunctionDescriptor)); add(name(desc.fragmentFunctionDescriptor));
+    for (uint32_t i = 0; i < 8; ++i) {
+      MTL4RenderPipelineColorAttachmentDescriptor* a = desc.colorAttachments[i];
+      const uint64_t v[3] = {uint64_t(a.pixelFormat), uint64_t(a.writeMask), uint64_t(a.blendingState)};
+      h = Fnv(v, sizeof(v), h);
+    }
+    const uint64_t samples = desc.rasterSampleCount;
+    Note(Fnv(&samples, sizeof(samples), h) | 1);
+  }
+  return pipeline;
+}
+
+id<MTLComputePipelineState> MetalPipelines4::Compute(id<MTLLibrary> library, NSString* function, NSError** error) {
+  if (@available(macOS 26.0, *)) {
+    auto desc = [MTL4ComputePipelineDescriptor new];
+    desc.computeFunctionDescriptor = Function(library, function);
+    id<MTLComputePipelineState> pipeline =
+        [(id<MTL4Compiler>)compiler_ newComputePipelineStateWithDescriptor:desc compilerTaskOptions:options_ error:error];
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (pipeline) ++stats_.fixed_built; else ++stats_.fixed_failed;
+    touched_ = true;
+    const char* label = library.label ? library.label.UTF8String : "";
+    const char* entry = function ? function.UTF8String : "";
+    uint64_t h = Fnv("compute", 7);
+    h = Fnv(label, std::strlen(label) + 1, h);
+    Note(Fnv(entry, std::strlen(entry) + 1, h) | 1);
+    return pipeline;
+  }
+  return nil;
+}
+
+MTL4RenderPipelineDescriptor* MetalPipelines4::Convert(MTLRenderPipelineDescriptor* m3, id<MTLLibrary> vl,
+                                                        NSString* vs, id<MTLLibrary> pl, NSString* ps) {
+  auto desc = [MTL4RenderPipelineDescriptor new];
+  desc.label = m3.label;
+  desc.vertexFunctionDescriptor = Function(vl, vs);
+  if (pl && ps) desc.fragmentFunctionDescriptor = Function(pl, ps);
+  desc.vertexDescriptor = m3.vertexDescriptor;
+  desc.rasterSampleCount = m3.rasterSampleCount;
+  desc.alphaToCoverageState = m3.alphaToCoverageEnabled ? MTL4AlphaToCoverageStateEnabled : MTL4AlphaToCoverageStateDisabled;
+  desc.alphaToOneState = m3.alphaToOneEnabled ? MTL4AlphaToOneStateEnabled : MTL4AlphaToOneStateDisabled;
+  desc.rasterizationEnabled = m3.rasterizationEnabled;
+  desc.inputPrimitiveTopology = m3.inputPrimitiveTopology;
+  desc.maxVertexAmplificationCount = m3.maxVertexAmplificationCount;
+  for (uint32_t i = 0; i < 8; ++i) {
+    MTLRenderPipelineColorAttachmentDescriptor* from = m3.colorAttachments[i];
+    MTL4RenderPipelineColorAttachmentDescriptor* to = desc.colorAttachments[i];
+    to.pixelFormat = from.pixelFormat;
+    to.writeMask = from.writeMask;
+    to.blendingState = from.blendingEnabled ? MTL4BlendStateEnabled : MTL4BlendStateDisabled;
+    to.sourceRGBBlendFactor = from.sourceRGBBlendFactor; to.destinationRGBBlendFactor = from.destinationRGBBlendFactor;
+    to.sourceAlphaBlendFactor = from.sourceAlphaBlendFactor;
+    to.destinationAlphaBlendFactor = from.destinationAlphaBlendFactor;
+    to.rgbBlendOperation = from.rgbBlendOperation; to.alphaBlendOperation = from.alphaBlendOperation;
+  }
+  return desc;
+}
+
+std::filesystem::path MetalPipelines4::Generation(uint32_t generation) const {
+  return dir_ / (stem_ + "-" + std::to_string(generation) + ".mtl4archive");
+}
+
+std::filesystem::path MetalPipelines4::IndexPath() const { return dir_ / (stem_ + ".mtl4index"); }
+
+uint64_t MetalPipelines4::Entry(uint64_t identity, uint32_t samples, const PipelineTargets* targets) {
+  if (!identity) return 0;
+  uint64_t h = Fnv(&identity, sizeof(identity));
+  h = Fnv(&samples, sizeof(samples), h);
+  // The flexible pipeline is the entry without targets; each specialisation adds its targets, field by field.
+  if (targets) {
+    for (const auto& c : targets->colors) {
+      const uint64_t v[9] = {uint64_t(c.format), uint64_t(c.write_mask), uint64_t(c.blending), uint64_t(c.src_rgb),
+                             uint64_t(c.dst_rgb), uint64_t(c.src_alpha), uint64_t(c.dst_alpha), uint64_t(c.rgb_op),
+                             uint64_t(c.alpha_op)};
+      h = Fnv(v, sizeof(v), h);
+    }
+  }
+  return h | 1;
+}
+
+void MetalPipelines4::Note(uint64_t entry) {
+  if (!serializer_) return;
+  if (entry) seen_.insert(entry);
+  if (!entry || !index_.count(entry)) unindexed_ = true;
+}
+
+// The index file: "MTL4IDX1", the generations it describes (u32 count, u32 each), the entries (u64 count, u64 each).
+void MetalPipelines4::ReadIndex() {
+  std::ifstream in(IndexPath(), std::ios::binary);
+  char magic[8] = {};
+  uint32_t count = 0;
+  if (!in.read(magic, 8) || std::memcmp(magic, "MTL4IDX1", 8) || !in.read(reinterpret_cast<char*>(&count), 4) ||
+      count > 1u << 16)
+    return;
+  std::vector<uint32_t> generations(count);
+  uint64_t entries = 0;
+  if (!in.read(reinterpret_cast<char*>(generations.data()), std::streamsize(count) * 4) ||
+      !in.read(reinterpret_cast<char*>(&entries), 8) || entries > 1u << 24)
+    return;
+  std::vector<uint64_t> list(entries);
+  if (!in.read(reinterpret_cast<char*>(list.data()), std::streamsize(entries) * 8)) return;
+  // Only an index of exactly the generations loaded says what they hold.
+  std::vector<uint32_t> loaded = loaded_generations_;
+  std::sort(loaded.begin(), loaded.end());
+  std::sort(generations.begin(), generations.end());
+  if (generations != loaded || loaded.empty()) return;
+  index_.insert(list.begin(), list.end());
+  indexed_ = true;
+}
+
+bool MetalPipelines4::WriteIndex(std::string& error) {
+  std::vector<uint32_t> generations = loaded_generations_;
+  generations.insert(generations.end(), written_generations_.begin(), written_generations_.end());
+  const auto path = IndexPath();
+  const auto temporary = path.string() + ".tmp";
+  {
+    std::ofstream out(temporary, std::ios::binary | std::ios::trunc);
+    const uint32_t count = uint32_t(generations.size());
+    const uint64_t entries = index_.size();
+    out.write("MTL4IDX1", 8);
+    out.write(reinterpret_cast<const char*>(&count), 4);
+    out.write(reinterpret_cast<const char*>(generations.data()), std::streamsize(count) * 4);
+    out.write(reinterpret_cast<const char*>(&entries), 8);
+    for (uint64_t entry : index_) out.write(reinterpret_cast<const char*>(&entry), 8);
+    if (!out.flush()) {
+      error = "cannot write the archive's index";
+      return false;
+    }
+  }
+  std::error_code ec;
+  std::filesystem::rename(temporary, path, ec);
+  if (ec) {
+    std::filesystem::remove(temporary, ec);
+    error = "cannot rename the archive's index: " + ec.message();
+    return false;
+  }
+  return true;
+}
+
+bool MetalPipelines4::Save(bool compact, uint32_t wait_ms, std::string& error, bool* written_out) {
+  if (written_out) *written_out = false;
+  if (!serializer_) return true;
+  // Held through the write: no task starts meanwhile (a draw that needs a new pipeline waits for it).
+  std::unique_lock<std::mutex> lock(mutex_);
+  // Everything this run asked for is in the generations on disk: they stay as they are (what the serializer
+  // captured again stays in it, for a Save that has something new; that one compacts if this one would have).
+  if (indexed_ && !unindexed_) {
+    compact_pending_ = compact_pending_ || compact;
+    return true;
+  }
+  compact = compact || compact_pending_;
+  if (!idle_.wait_for(lock, std::chrono::milliseconds(wait_ms), [this] { return tasks_ == 0; })) {
+    error = "compiler tasks still running";
+    return false;
+  }
+  bool written = false;
+  if (touched_) {
+    if (@available(macOS 26.0, *)) {
+      const auto path = Generation(next_generation_);
+      const auto temporary = path.string() + ".tmp";
+      NSError* ns_error = nil;
+      // Written beside the others and renamed, so an interrupted write never leaves a broken generation.
+      if ([(id<MTL4PipelineDataSetSerializer>)serializer_
+              serializeAsArchiveAndFlushToURL:[NSURL fileURLWithPath:[NSString stringWithUTF8String:temporary.c_str()]]
+                                        error:&ns_error]) {
+        std::error_code ec;
+        std::filesystem::rename(temporary, path, ec);
+        if (ec) {
+          std::filesystem::remove(temporary, ec);
+          error = "cannot rename the archive: " + ec.message();
+          return false;
+        }
+        written_generations_.push_back(next_generation_++);
+        written = true;
+      } else if (ns_error && ns_error.code != 0 &&
+                 [ns_error.localizedDescription rangeOfString:@"Nothing to serialize"].location == NSNotFound) {
+        error = ns_error.localizedDescription.UTF8String;
+        return false;
+      }
+      touched_ = false;
+    }
+  }
+  // Compacting: what this run touched is in its own generations now. Not when it wrote none (it touched nothing:
+  // removing the loaded ones would lose them).
+  wrote_ = wrote_ || written;
+  bool compacted = false;
+  if (compact && wrote_) {
+    std::error_code ec;
+    for (const auto& path : loaded_) std::filesystem::remove(path, ec);
+    loaded_.clear();
+    loaded_generations_.clear();
+    compacted = true;
+    compact_pending_ = false;
+  }
+  if (written_out) *written_out = written;
+  if (!written && !compacted) return true;
+  // The index: everything asked for so far, all of it in this run's generations now (the tasks are done and none
+  // starts while the lock is held; a pipeline served from an archive is captured again), and, unless compacted,
+  // what the index of the generations loaded said.
+  if (compacted) index_.clear();
+  index_.insert(seen_.begin(), seen_.end());
+  indexed_ = true;
+  unindexed_ = false;
+  return WriteIndex(error);
+}
+
+MetalPipelines4::Stats MetalPipelines4::TakeStats() {
+  std::lock_guard<std::mutex> lock(mutex_);
+  Stats stats = stats_;
+  stats_ = Stats{};
+  stats.queued = queue_.size();
+  stats.in_flight = in_flight_;
+  return stats;
+}
