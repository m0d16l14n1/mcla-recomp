+  // start -> length, entry; by length class, so a write scans back only as far as its class's longest range
+  // (one index scanned back by the longest texture ever seen was a fifth of every resolve).
+  static constexpr size_t kRangeClasses = 4;
+  static size_t RangeClass(uint32_t length) {
+    return length <= (64u << 10) ? 0 : length <= (512u << 10) ? 1 : length <= (4u << 20) ? 2 : 3;
