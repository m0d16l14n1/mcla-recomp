+/**
+ * @file        graphics/metal/metal_shader_translator.cpp
+ * @brief       Guest microcode to MSL (see metal_shader_translator.h)
+ *
+ * Added by the mcla-recomp macOS fork (patches/rexglue-metal-backend.patch).
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include "metal_shader_translator.h"
+
+#include <cstring>
+#include <exception>
+#include <vector>
+
+#include <spirv_msl.hpp>
+
+#include <rex/graphics/pipeline/shader/spirv_translator.h>
+#include <rex/cvar.h>
+REXCVAR_DEFINE_BOOL(metal_texture_signs, true, "GPU/Metal", "Apply texture signedness/gamma (disable only for diagnosis)");
+#include <rex/graphics/register_file.h>
+#include <rex/graphics/pipeline/shader/spirv.h>
+
+namespace rex::graphics::metal {
+
+namespace {
+
+// What Metal on Apple Silicon offers the translator, as MoltenVK reports it for the same GPUs (on an Apple M5:
+// no cull distance; the host render target path, so no fragment shader interlock).
+SpirvShaderTranslator::Features MetalTranslatorFeatures() {
+  SpirvShaderTranslator::Features features(false);
+  features.spirv_version = spv::Spv_1_5;
+  features.max_storage_buffer_range = 1u << 30;
+  features.full_draw_index_uint32 = true;
+  features.vertex_pipeline_stores_and_atomics = true;
+  features.fragment_stores_and_atomics = true;
+  features.clip_distance = true;
+  features.cull_distance = false;
+  features.image_view_format_swizzle = true;
+  features.demote_to_helper_invocation = true;
+  // On (2026-11-01): off, the colour grading turns purple at the spawn point (no speed gained). With it the
+  // translator writes a sample mask, so SPIRV-Cross reads the sample ID and pixel shaders run once per sample:
+  // costly only on multisample targets (metal_msaa).
+  features.sample_rate_shading = true;
+  return features;
+}
+
+}  // namespace
+
+MetalShaderTranslator::MetalShaderTranslator(uint32_t edram_tile_count)
+    : translator_(std::make_unique<SpirvShaderTranslator>(MetalTranslatorFeatures(), false, false, false, 1,
+                                                          1, edram_tile_count)) {}
+
+MetalShaderTranslator::~MetalShaderTranslator() = default;
+
+void MetalShaderTranslator::EnsureAnalyzed(Shader& shader) {
+  if (!shader.is_ucode_analyzed()) {
+    shader.AnalyzeUcode(ucode_disasm_buffer_);
+  }
+}
+
+void MetalShaderTranslator::GetDrawModifications(const RegisterFile& regs, const Shader& vertex_shader,
+                                                 const Shader* pixel_shader, uint64_t& vertex_modification_out,
+                                                 uint64_t& pixel_modification_out,
+                                                 Shader::HostVertexShaderType host_type) const {
+  // As VulkanCommandProcessor::IssueDraw and VulkanPipelineCache::GetCurrent*ShaderModification, without the
+  // parts that need the primitive processor (host vertex shader types) and the render target cache.
+  uint32_t ps_param_gen_pos = UINT32_MAX;
+  const uint32_t interpolator_mask =
+      pixel_shader ? (vertex_shader.writes_interpolators() &
+                      pixel_shader->GetInterpolatorInputMask(regs.Get<reg::SQ_PROGRAM_CNTL>(),
+                                                             regs.Get<reg::SQ_CONTEXT_MISC>(),
+                                                             ps_param_gen_pos))
+                   : 0;
+  SpirvShaderTranslator::Modification vertex_modification(translator_->GetDefaultVertexShaderModification(
+      vertex_shader.GetDynamicAddressableRegisterCount(regs.Get<reg::SQ_PROGRAM_CNTL>().vs_num_reg), host_type));
+  vertex_modification.vertex.interpolator_mask = interpolator_mask;
+  vertex_modification.vertex.output_point_parameters =
+      host_type == Shader::HostVertexShaderType::kPointListAsTriangleStrip && ps_param_gen_pos < xenos::kMaxInterpolators;
+  vertex_modification_out = vertex_modification.value;
+  pixel_modification_out = 0;
+  if (pixel_shader) {
+    SpirvShaderTranslator::Modification pixel_modification(translator_->GetDefaultPixelShaderModification(
+        pixel_shader->GetDynamicAddressableRegisterCount(regs.Get<reg::SQ_PROGRAM_CNTL>().ps_num_reg)));
+    pixel_modification.pixel.interpolator_mask = interpolator_mask;
+    if (ps_param_gen_pos < xenos::kMaxInterpolators) {
+      pixel_modification.pixel.param_gen_enable = 1;
+      pixel_modification.pixel.param_gen_interpolator = ps_param_gen_pos;
+      pixel_modification.pixel.param_gen_point =
+          uint32_t(regs.Get<reg::VGT_DRAW_INITIATOR>().prim_type == xenos::PrimitiveType::kPointList);
+    }
+    pixel_modification_out = pixel_modification.value;
+  }
+}
+
+MetalShaderTranslator::Result MetalShaderTranslator::Translate(Shader& shader, uint64_t modification,
+                                                               Shader::Translation*& translation_out,
+                                                               std::string& msl_out, std::string& error_out) {
+  EnsureAnalyzed(shader);
+  bool is_new = false;
+  translation_out = shader.GetOrCreateTranslation(modification, &is_new);
+  if (!is_new) {
+    return Result::kExisting;
+  }
+  if (!translator_->TranslateAnalyzedShader(*translation_out) || !translation_out->is_valid()) {
+    return Result::kTranslateFailed;
+  }
+  const std::vector<uint8_t>& binary = translation_out->translated_binary();
+  std::vector<uint32_t> words(binary.size() / sizeof(uint32_t));
+  std::memcpy(words.data(), binary.data(), words.size() * sizeof(uint32_t));
+  try {
+    SPIRV_CROSS_NAMESPACE::CompilerMSL compiler(std::move(words));
+    SPIRV_CROSS_NAMESPACE::CompilerMSL::Options options = compiler.get_msl_options();
+    options.platform = SPIRV_CROSS_NAMESPACE::CompilerMSL::Options::macOS;
+    options.set_msl_version(3, 0);
+    compiler.set_msl_options(options);
+    auto stage = shader.type() == xenos::ShaderType::kVertex ? spv::ExecutionModelVertex : spv::ExecutionModelFragment;
+    for (uint32_t i = 0; i < 5; ++i) {
+      SPIRV_CROSS_NAMESPACE::MSLResourceBinding b{};
+      b.stage = stage; b.desc_set = 1; b.binding = i; b.msl_buffer = i;
+      compiler.add_msl_resource_binding(b);
+    }
+    SPIRV_CROSS_NAMESPACE::MSLResourceBinding shared{};
+    shared.stage = stage; shared.desc_set = 0; shared.binding = 0; shared.msl_buffer = 5;
+    compiler.add_msl_resource_binding(shared);
+    auto& info = bindings_[translation_out];
+    const auto& spirv_shader = static_cast<const SpirvShader&>(shader);
+    const auto& textures = spirv_shader.GetTextureBindingsAfterTranslation();
+    const auto& samplers = spirv_shader.GetSamplerBindingsAfterTranslation();
+    uint32_t set = shader.type() == xenos::ShaderType::kVertex ? 2 : 3;
+    for (uint32_t i = 0; i < textures.size(); ++i) {
+      SPIRV_CROSS_NAMESPACE::MSLResourceBinding b{};
+      b.stage = stage; b.desc_set = set; b.binding = i; b.msl_texture = i;
+      compiler.add_msl_resource_binding(b);
+      info.textures.push_back({i, textures[i].fetch_constant, textures[i].dimension, bool(textures[i].is_signed)});
+    }
+    for (uint32_t i = 0; i < samplers.size(); ++i) {
+      SPIRV_CROSS_NAMESPACE::MSLResourceBinding b{};
+      b.stage = stage; b.desc_set = set; b.binding = uint32_t(textures.size()) + i; b.msl_sampler = i;
+      compiler.add_msl_resource_binding(b);
+      info.samplers.push_back({i, samplers[i].fetch_constant, samplers[i].mag_filter,
+          samplers[i].min_filter, samplers[i].mip_filter, samplers[i].aniso_filter});
+    }
+    msl_out = compiler.compile();
+  } catch (const std::exception& e) {
+    error_out = e.what();
+    return Result::kMslFailed;
+  }
+  return Result::kNew;
+}
+
+std::unique_ptr<Shader> CreateMetalShader(xenos::ShaderType type, uint64_t hash,
+                                        const uint32_t* code, uint32_t count) {
+  return std::make_unique<SpirvShader>(type, hash, code, count);
+}
+
+std::string MetalSpirvComputeToMsl(const uint32_t* words, size_t word_count,
+                                   const std::vector<MetalSpirvTextureSlot>& slots, std::string& error_out) {
+  try {
+    SPIRV_CROSS_NAMESPACE::CompilerMSL compiler(words, word_count);
+    SPIRV_CROSS_NAMESPACE::CompilerMSL::Options options = compiler.get_msl_options();
+    options.platform = SPIRV_CROSS_NAMESPACE::CompilerMSL::Options::macOS;
+    options.set_msl_version(3, 0);
+    options.texture_buffer_native = true;
+    compiler.set_msl_options(options);
+    for (const MetalSpirvTextureSlot& slot : slots) {
+      SPIRV_CROSS_NAMESPACE::MSLResourceBinding b{};
+      b.stage = spv::ExecutionModelGLCompute; b.desc_set = slot.set; b.binding = slot.binding;
+      b.msl_texture = slot.texture;
+      compiler.add_msl_resource_binding(b);
+    }
+    SPIRV_CROSS_NAMESPACE::MSLResourceBinding push{};
+    push.stage = spv::ExecutionModelGLCompute; push.desc_set = SPIRV_CROSS_NAMESPACE::kPushConstDescSet;
+    push.binding = SPIRV_CROSS_NAMESPACE::kPushConstBinding; push.msl_buffer = 0;
+    compiler.add_msl_resource_binding(push);
+    return compiler.compile();
+  } catch (const std::exception& e) {
+    error_out = e.what();
+    return {};
+  }
+}
+
+void MetalTextureSwizzledSigns(const RegisterFile& regs, uint32_t* signs) {
+  for (uint32_t i = 0; i < 8; ++i) signs[i] = 0;
+  for (uint32_t i = 0; REXCVAR_GET(metal_texture_signs) && i < 32; ++i) {
+    auto fetch = regs.GetTextureFetch(i);
+    uint32_t s = (fetch.dword_0 >> 2) & 255, swizzled = 0;
+    for (uint32_t channel = 0; channel < 4; ++channel) {
+      uint32_t source = (fetch.swizzle >> (channel * 3)) & 7;
+      if (source < 4) swizzled |= ((s >> (source * 2)) & 3) << (channel * 2);
+    }
+    signs[i / 4] |= swizzled << ((i % 4) * 8);
+  }
+}
+
+void BuildMetalSystemConstants(const RegisterFile& regs, const PrimitiveProcessor::ProcessingResult& p,
+    const draw_util::ViewportInfo& v, std::vector<uint8_t>& out, const uint32_t* texture_signs,
+    float ps_param_gen_scale) {
+  using T = SpirvShaderTranslator;
+  T::SystemConstants c{};
+  auto vte = regs.Get<reg::PA_CL_VTE_CNTL>();
+  if (vte.vtx_xy_fmt) c.flags |= T::kSysFlag_XYDividedByW;
+  if (vte.vtx_z_fmt) c.flags |= T::kSysFlag_ZDividedByW;
+  if (vte.vtx_w0_fmt) c.flags |= T::kSysFlag_WNotReciprocal;
+  if (draw_util::IsPrimitivePolygonal(regs)) c.flags |= T::kSysFlag_PrimitivePolygonal;
+  if (draw_util::IsPrimitiveLine(regs)) c.flags |= T::kSysFlag_PrimitiveLine;
+  c.flags |= uint32_t(regs.Get<reg::RB_SURFACE_INFO>().msaa_samples) << T::kSysFlag_MsaaSamples_Shift;
+  // A pixel shader's own depth output is scaled from guest [0, 1] to the host's [0, 0.5] float24
+  // range (GetHostViewportInfo full_float24_in_0_to_1) only with this flag, as on Vulkan
+  // (rexglue-vulkan-odepth-scale.patch). Without it the game's wheel shadow-volume pass, which
+  // writes depth, compares twice the depth and passes behind the car's body: the wheels' object
+  // IDs land in the stencil there, and the motion blur smears streaks over the plate and bumper.
+  if (regs.Get<reg::RB_DEPTH_INFO>().depth_format == xenos::DepthRenderTargetFormat::kD24FS8)
+    c.flags |= T::kSysFlag_DepthFloat24;
+  auto cc = regs.Get<reg::RB_COLORCONTROL>();
+  c.flags |= uint32_t(cc.alpha_test_enable ? cc.alpha_func : xenos::CompareFunction::kAlways)
+             << T::kSysFlag_AlphaPassIfLess_Shift;
+  c.vertex_index_endian = p.host_shader_index_endian;
+  if (p.index_buffer_type == PrimitiveProcessor::kHostBuiltinForDMA) {
+    c.flags |= T::kSysFlag_ComputeOrPrimitiveVertexIndexLoad;
+    auto draw = regs.Get<reg::VGT_DRAW_INITIATOR>();
+    if (draw.index_size == xenos::IndexFormat::kInt32) c.flags |= T::kSysFlag_ComputeOrPrimitiveVertexIndexLoad32Bit;
+    c.vertex_index_load_address = p.guest_index_base;
+    c.vertex_index_endian = regs.Get<reg::VGT_DMA_SIZE>().swap_mode;
+    if (draw.index_size == xenos::IndexFormat::kInt16)
+      c.vertex_index_endian = (c.vertex_index_endian == xenos::Endian::k8in16 ||
+          c.vertex_index_endian == xenos::Endian::k8in32) ? xenos::Endian::k8in16 : xenos::Endian::kNone;
+  }
+  c.vertex_base_index = regs.Get<int32_t>(XE_GPU_REG_VGT_INDX_OFFSET);
+  c.vertex_index_min = regs[XE_GPU_REG_VGT_MIN_VTX_INDX];
+  c.vertex_index_max = regs[XE_GPU_REG_VGT_MAX_VTX_INDX];
+  c.line_loop_closing_index = p.line_loop_closing_index;
+  std::memcpy(c.ndc_scale, v.ndc_scale, sizeof(c.ndc_scale));
+  std::memcpy(c.ndc_offset, v.ndc_offset, sizeof(c.ndc_offset));
+  // SPIR-V uses Vulkan's downwards viewport. Metal's viewport flips Y.
+  c.ndc_scale[1] = -c.ndc_scale[1]; c.ndc_offset[1] = -c.ndc_offset[1];
+  c.alpha_test_reference = regs.Get<float>(XE_GPU_REG_RB_ALPHA_REF);
+  c.ps_param_gen_scale = ps_param_gen_scale;
+  static_assert(sizeof(c.texture_swizzled_signs) == 8 * sizeof(uint32_t));
+  if (texture_signs) std::memcpy(c.texture_swizzled_signs, texture_signs, sizeof(c.texture_swizzled_signs));
+  else MetalTextureSwizzledSigns(regs, c.texture_swizzled_signs);
+  auto point = regs.Get<reg::PA_SU_POINT_SIZE>();
+  auto minmax = regs.Get<reg::PA_SU_POINT_MINMAX>();
+  c.point_vertex_diameter_min = minmax.min_size * 0.125f;
+  c.point_vertex_diameter_max = minmax.max_size * 0.125f;
+  c.point_constant_diameter[0] = point.width * 0.125f;
+  c.point_constant_diameter[1] = point.height * 0.125f;
+  c.point_screen_diameter_to_ndc_radius[0] = 1.0f / std::max(v.xy_extent[0], 1u);
+  c.point_screen_diameter_to_ndc_radius[1] = -1.0f / std::max(v.xy_extent[1], 1u);
+  for (uint32_t i = 0; i < 4; ++i) {
+    auto color = regs.Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[i]);
+    c.color_exp_bias[i] = std::ldexp(1.0f, color.color_exp_bias);
+    if (color.color_format == xenos::ColorRenderTargetFormat::k_8_8_8_8_GAMMA)
+      c.flags |= T::kSysFlag_ConvertColor0ToGamma << i;
+    // MIN / MAX blending with the SrcAlpha source factor (rexglue-minmax-blend-factor.patch): the
+    // Xenos applies the factor in those equations, Metal's blender ignores it. The game draws the
+    // light glows of the cars' environment map with max(source x SrcAlpha, destination); without
+    // this every glow is a solid square, and the paint, the lamps' lenses and the bumpers mirror it.
+    auto blend = regs.Get<reg::RB_BLENDCONTROL>(reg::RB_BLENDCONTROL::rt_register_indices[i]);
+    if ((blend.color_comb_fcn == xenos::BlendOp::kMin || blend.color_comb_fcn == xenos::BlendOp::kMax) &&
+        blend.color_srcblend == xenos::BlendFactor::kSrcAlpha && blend.color_destblend == xenos::BlendFactor::kOne)
+      c.flags |= T::kSysFlag_MinMaxColor0TimesSrcAlpha << i;
+    if ((blend.alpha_comb_fcn == xenos::BlendOp::kMin || blend.alpha_comb_fcn == xenos::BlendOp::kMax) &&
+        blend.alpha_srcblend == xenos::BlendFactor::kSrcAlpha && blend.alpha_destblend == xenos::BlendFactor::kOne)
+      c.flags |= T::kSysFlag_MinMaxAlpha0TimesSrcAlpha << i;
+  }
+  out.resize((sizeof(c) + 15) & ~size_t(15)); std::memcpy(out.data(), &c, sizeof(c));
+}
+
+}  // namespace rex::graphics::metal
