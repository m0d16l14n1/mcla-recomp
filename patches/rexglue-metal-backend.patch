+bool MetalCommandProcessor::SetupContext() {
+  // metal_cp_qos: the command processor thread's QoS class, set on the thread itself.
+  if (int32_t qos = REXCVAR_GET(metal_cp_qos)) {
+    qos_class_t cls = qos == 1 ? QOS_CLASS_BACKGROUND : qos == 2 ? QOS_CLASS_UTILITY : qos == 3 ? QOS_CLASS_USER_INITIATED
+                    : QOS_CLASS_USER_INTERACTIVE;
+    int result = pthread_set_qos_class_self_np(cls, 0);
+    REXGPU_INFO("Metal: command processor thread QoS {} ({})", qos, result);
+  }
+  if (!CommandProcessor::SetupContext()) {
+    REXGPU_ERROR("Metal: the base command processor context could not be set up");
+    return false;
+  }
+  MetalProvider* provider = metal_graphics_system_->metal_provider();
+  if (!provider) {
+    REXGPU_ERROR("Metal: no provider");
+    return false;
+  }
+  device_ = provider->device();
+  command_queue_ = provider->command_queue();
+  // The other backends set this from their render target caches; M1 has the console's EDRAM.
+  if (!graphics_system_->edram_tile_count()) graphics_system_->set_edram_tile_count(xenos::kEdramTileCountConsole);
+  shader_compiler_ = std::make_unique<MetalShaderCompiler>(device_, graphics_system_->edram_tile_count());
+  if (REXCVAR_GET(metal_shared_memory_zero_copy)) {
+    CreateZeroCopySharedMemory();
+  }
+  draw_ = std::make_unique<MetalDraw>(device_, command_queue_, shared_memory_buffer_, *memory_,
+      *register_file_, *shader_compiler_, graphics_system_->edram_tile_count());
+  if (!draw_->Initialize()) return false;
+  // HDR output: the UI layer's underlay copy and clear, once a draw's render targets are known.
+  draw_->hdr_targets_ready_ = [this] { HdrRenderTargetsReady(); };
+  // The scene's draws jittered for temporal AA (Vulkan's convention: the SPIR-V NDC is +y down, and the Metal
+  // system constants flip it with the rest).
+  // With upscaling, the scene's draws then squeezed into the render-size corner (the jitter decides that at the
+  // scene's first draw, so it comes first, with the full-size extent).
+  draw_->taa_draw_ = [this](draw_util::ViewportInfo& viewport, draw_util::Scissor& scissor, float& param_gen_scale) {
+    // Rectangle lists are never jittered, and the scene's first one (a 4x MSAA clear of the EDRAM, which the
+    // Vulkan backend turns into a clear without a draw) must not decide whether the frame is squeezed.
+    auto prim_type = register_file_->Get<reg::VGT_DRAW_INITIATOR>().prim_type;
+    if (prim_type != xenos::PrimitiveType::kRectangleList)
+      TaaJitterNdcOffset(prim_type, false, viewport.xy_extent, viewport.ndc_offset);
+    if (taa_frame_.up_state == 1) {
+      TaaSqueeze(viewport.xy_offset, viewport.xy_extent, scissor.offset, scissor.extent);
+      param_gen_scale = TaaPsParamGenScale();
+    }
+    // Textures a level sharper per halving of the render size, as on Vulkan and D3D12 (the squeezed draws only).
+    draw_->taa_lod_bias_ = REXCVAR_GET(metal_taa_lod_bias) ? TaaLodBias() : 0;
+  };
+  draw_->taa_resolve_stretch_ = [this](uint32_t pitch_px, uint32_t samples, uint32_t format, bool depth,
+                                       uint32_t num[2], uint32_t den[2]) {
+    if (!TaaSqueezingScene()) return false;
+    TaaResolveInfo info;
+    info.pitch_px = pitch_px; info.msaa_samples = samples; info.format = format; info.is_depth = depth;
+    info.direct_source = true; info.copy_ok = samples == 1;  // the resolve kernels stretch single-sampled sources
+    TaaStretch stretch;
+    TaaResolveStretch(info, stretch);
+    if (!stretch.active) return false;
+    num[0] = stretch.num[0]; num[1] = stretch.num[1]; den[0] = stretch.den[0]; den[1] = stretch.den[1];
+    return true;
+  };
+  REXGPU_INFO("Metal backend: native drawing (in development; MSAA is drawn as supersampling)");
+  stats_since_ms_ = chrono::Clock::QueryHostUptimeMillis();
+  return true;
+}
+
+void MetalCommandProcessor::ShutdownContext() {
+  if (command_queue_) {
+    @autoreleasepool {
+      id<MTLCommandBuffer> drain = [command_queue_ commandBuffer];
+      [drain commit];
+      [drain waitUntilCompleted];
+    }
+  }
+  if (shader_storage_) { std::fclose(shader_storage_); shader_storage_ = nullptr; }
+  if (shader_compiler_) shader_compiler_->on_new_translation = nullptr;
+  draw_.reset();
+  shader_compiler_.reset();
+  shared_memory_buffer_ = nil;
+  shaders_.clear();
+  command_queue_ = nil;
+  device_ = nil;
+  CommandProcessor::ShutdownContext();
+}
