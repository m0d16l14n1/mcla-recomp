+/**
+ * @file        graphics/metal/metal_internal.h
+ * @brief       The Metal backend's classes (Objective-C++ only)
+ *
+ * Added by the mcla-recomp macOS fork (patches/rexglue-metal-backend.patch). Milestone M0 (docs/metal-backend.md
+ * in the fork): a provider and a presenter that draws the guest output into the window's CAMetalLayer, and a
+ * command processor that runs the guest's command stream without drawing (draws and resolves are counted and
+ * skipped), so that the game runs on Metal end to end while the drawing parts are ported.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+#include <cstdio>
+#include <filesystem>
+#include <unordered_set>
+
+#if !defined(__OBJC__)
+#error "metal_internal.h is for the Objective-C++ sources of the Metal backend"
+#endif
+
+#import <Metal/Metal.h>
+#import <QuartzCore/CAMetalLayer.h>
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <memory>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+#include <rex/graphics/command_processor.h>
+#include <rex/graphics/graphics_system.h>
+#include <rex/graphics/pipeline/shader/shader.h>
+#include <rex/ui/graphics_provider.h>
+#include <rex/ui/presenter.h>
+
+namespace rex::graphics::metal {
+
+class MetalShaderCompiler;
+class MetalDraw;
+
+class MetalProvider final : public ui::GraphicsProvider {
+ public:
+  static std::unique_ptr<MetalProvider> Create();
+
+  std::unique_ptr<ui::Presenter> CreatePresenter(
+      ui::Presenter::HostGpuLossCallback host_gpu_loss_callback =
+          ui::Presenter::FatalErrorHostGpuLossCallback) override;
+  // None yet: without it the app runs without the ImGui overlays.
+  std::unique_ptr<ui::ImmediateDrawer> CreateImmediateDrawer() override { return nullptr; }
+
+  id<MTLDevice> device() const { return device_; }
+  // One queue for the guest's work and for presenting it: Metal runs a queue's command buffers in the order
+  // they are committed, so the guest output written for a swap is complete when a later paint reads it.
+  id<MTLCommandQueue> command_queue() const { return command_queue_; }
+
+ private:
+  MetalProvider() = default;
+
+  id<MTLDevice> device_ = nil;
+  id<MTLCommandQueue> command_queue_ = nil;
+};
+
+// What a guest output refresher gets: the texture to write the frame into, and the queue to do it on.
+class MetalGuestOutputRefreshContext final : public ui::Presenter::GuestOutputRefreshContext {
+ public:
+  MetalGuestOutputRefreshContext(bool& is_8bpc_out_ref, ui::Presenter::GuestOutputHdr& hdr_out_ref,
+                                 id<MTLTexture> texture, id<MTLCommandQueue> command_queue)
+      : GuestOutputRefreshContext(is_8bpc_out_ref, hdr_out_ref),
+        texture_(texture),
+        command_queue_(command_queue) {}
+
+  id<MTLTexture> texture() const { return texture_; }
+  id<MTLCommandQueue> command_queue() const { return command_queue_; }
+
+ private:
+  id<MTLTexture> texture_;
+  id<MTLCommandQueue> command_queue_;
+};
+
+class MetalPresenter final : public ui::Presenter {
+ public:
+  static std::unique_ptr<MetalPresenter> Create(HostGpuLossCallback host_gpu_loss_callback,
+                                                id<MTLDevice> device, id<MTLCommandQueue> command_queue);
+  ~MetalPresenter() override;
+
+  ui::Surface::TypeFlags GetSupportedSurfaceTypes() const override;
+  bool CaptureGuestOutput(ui::RawImage& image_out) override;
+
+  // The guest output is RGBA8, with the guest's own gamma (as the display would get it).
+  static constexpr MTLPixelFormat kGuestOutputFormat = MTLPixelFormatRGBA8Unorm;
+
+ protected:
+  SurfacePaintConnectResult ConnectOrReconnectPaintingToSurfaceFromUIThread(
+      ui::Surface& new_surface, uint32_t new_surface_width, uint32_t new_surface_height,
+      bool was_paintable, bool& is_vsync_implicit_out) override;
+  void DisconnectPaintingFromSurfaceFromUIThreadImpl() override;
+  bool RefreshGuestOutputImpl(uint32_t mailbox_index, uint32_t frontbuffer_width,
+                              uint32_t frontbuffer_height,
+                              std::function<bool(GuestOutputRefreshContext& context)> refresher,
+                              bool& is_8bpc_out_ref, GuestOutputHdr& hdr_out_ref) override;
+  PaintResult PaintAndPresentImpl(bool execute_ui_drawers) override;
+
+ private:
+  MetalPresenter(HostGpuLossCallback host_gpu_loss_callback, id<MTLDevice> device,
+                 id<MTLCommandQueue> command_queue)
+      : Presenter(host_gpu_loss_callback), device_(device), command_queue_(command_queue) {}
+  bool Initialize();
+
+  id<MTLDevice> device_;
+  id<MTLCommandQueue> command_queue_;
+  id<MTLRenderPipelineState> paint_pipeline_ = nil;
+  id<MTLSamplerState> paint_sampler_ = nil;
+  CAMetalLayer* layer_ = nil;
+  std::array<id<MTLTexture>, kGuestOutputMailboxSize> guest_output_textures_{};
+};
+
+class MetalGraphicsSystem final : public GraphicsSystem {
+ public:
+  MetalGraphicsSystem() = default;
+  ~MetalGraphicsSystem() override = default;
+
+  std::string name() const override { return "Metal"; }
+  MetalProvider* metal_provider() const { return static_cast<MetalProvider*>(provider()); }
+
+ protected:
+  void CreateProvider(bool with_presentation) override;
+
+ private:
+  std::unique_ptr<CommandProcessor> CreateCommandProcessor() override;
+};
+
+class MetalCommandProcessor final : public CommandProcessor {
+ public:
+  MetalCommandProcessor(MetalGraphicsSystem* graphics_system, system::KernelState* kernel_state);
+  ~MetalCommandProcessor() override;
+
+  void IssueSwap(uint32_t frontbuffer_ptr, uint32_t frontbuffer_width,
+                 uint32_t frontbuffer_height) override;
+
+ protected:
+  bool SetupContext() override;
+  void ShutdownContext() override;
+
+  Shader* LoadShader(xenos::ShaderType shader_type, uint32_t guest_address,
+                     const uint32_t* host_address, uint32_t dword_count) override;
+  bool IssueDraw(xenos::PrimitiveType prim_type, uint32_t index_count,
+                 IndexBufferInfo* index_buffer_info, bool major_mode_explicit) override;
+  bool IssueCopy() override;
+  void WriteFenceValue(uint32_t address, uint32_t value) override;
+  // The Metal shader storage: the microcode and modifications of every shader translated before, warmed up
+  // (translated and compiled on worker threads) before the title starts.
+  void InitializeShaderStorage(const std::filesystem::path& cache_root, uint32_t title_id, bool blocking) override;
+
+ private:
+  // Starts the translation and compile of the draw's shaders (M1: coverage of the shader path).
+  void RequestDrawShaders();
+  // The guest's physical memory as a Metal buffer without a copy (unified memory), and a check that the GPU
+  // reads what the CPU sees (metal_shared_memory_zero_copy).
+  void CreateZeroCopySharedMemory();
+  void CheckZeroCopySharedMemory();
+  void MaybeLogStats();
+
+  MetalGraphicsSystem* metal_graphics_system_;
+  std::unique_ptr<MetalShaderCompiler> shader_compiler_;
+  std::unique_ptr<MetalDraw> draw_;
+  id<MTLBuffer> shared_memory_buffer_ = nil;
+  bool shared_memory_checked_ = false;
+  // Where the loaded shaders' microcode is: ranges of guest memory that stay the same while the game runs
+  // (physical address, dwords), for the check.
+  std::vector<std::pair<uint32_t, uint32_t>> shader_ranges_;
+  id<MTLDevice> device_ = nil;
+  id<MTLCommandQueue> command_queue_ = nil;
+  // The guest's shaders, by the hash of their microcode (the base class keeps pointers to them).
+  std::unordered_map<uint64_t, std::unique_ptr<Shader>> shaders_;
+  std::FILE* shader_storage_ = nullptr;
+  std::unordered_set<uint64_t> stored_shaders_;
+
+  uint64_t swaps_ = 0;
+  uint64_t stats_draws_ = 0;
+  uint64_t stats_copies_ = 0;
+  uint64_t stats_swaps_ = 0;
+  uint64_t stats_since_ms_ = 0;
+};
+
+}  // namespace rex::graphics::metal
diff --git a/src/graphics/metal/metal_presenter.mm b/src/graphics/metal/metal_presenter.mm
