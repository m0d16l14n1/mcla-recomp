+/**
+ * @file        graphics/metal/metal_command_processor.mm
+ * @brief       The Metal backend's graphics system and command processor
+ *
+ * Added by the mcla-recomp macOS fork (patches/rexglue-metal-backend.patch). Milestone M0: the guest's command
+ * stream runs through the common CommandProcessor (registers, waits, events, interrupts, shader loads), draws
+ * and resolves are counted and skipped, and each swap fills the guest output through the presenter's mailbox
+ * with a placeholder, so that the game runs on Metal from start to finish. Drawing comes in the next milestones.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <chrono>
+#include "metal_internal.h"
+#include "metal_backend.h"
+#include "metal_shaders.h"
+#include "metal_draw.h"
+#include <pthread.h>
+#include <sys/qos.h>
+
+#include <xxhash.h>
+
+#include <cstring>
+#include <algorithm>
+#include <rex/types.h>
+
+#include <rex/chrono/clock.h>
+#include <rex/cvar.h>
+#include <rex/memory/utils.h>
+#include <rex/graphics/shared_memory.h>
+#include <rex/system/xmemory.h>
+#include <rex/graphics/registers.h>
+#include <rex/logging.h>
+
+REXCVAR_DECLARE(bool, gpu_regwrite_bulk);
+REXCVAR_DECLARE(bool, metal_gamma_ramp);
+REXCVAR_DEFINE_INT32(metal_cp_qos, 4, "GPU/Metal",
+    "The command processor thread's QoS (0 unchanged, 1 background, 2 utility, 3 user initiated, 4 user interactive). "
+    "It paces the frame: at the default QoS it shares the performance cores with everything else and moves to "
+    "the efficiency cores under load (user interactive: about 10% more frames on a busy M4)")
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+REXCVAR_DEFINE_BOOL(metal_taa_upscale, true, "GPU/Metal",
+                    "MetalFX upscaling with temporal_aa_upscale above 1 (the game's FSR upscaling setting): the scene drawn "
+                    "into the render-size corner of its targets and stretched back by its resolves");
+REXCVAR_DEFINE_INT32(metal_slow_frame_ms, 50, "GPU/Metal",
+    "Log a frame whose swap came this many ms or more after the last one, with what the command thread did in it "
+    "(CPU time, waits for the GPU, shaders and pipelines made, texture loads) and how long it waited for the game; "
+    "0: off. At most 20 a 10 s")
+    .range(0, 10000);
+REXCVAR_DEFINE_BOOL(metal_resolves, true, "GPU/Metal", "Resolves (diagnostic: false skips them)");
+REXCVAR_DEFINE_BOOL(metal_taa_lod_bias, true, "GPU/Metal",
+    "With MetalFX upscaling, the scene's textures are sampled with a negative LOD bias (log2 of the upscale: one "
+    "level sharper at Performance), as the Vulkan and D3D12 backends do for FSR (macOS 26; false: no bias)");
+REXCVAR_DEFINE_DOUBLE(metal_motion_blur_fps, 60.0, "GPU/Metal",
+    "MCLA's motion blur as long as at this frame rate at most: the game blurs by one frame's motion, so at 30 FPS "
+    "(or 29 with frame generation) twice as long as at 60. 0: the game's own length")
+    .range(0.0, 240.0);
+REXCVAR_DEFINE_INT32(metal_resolve_spin_us, 0, "GPU/Metal", "Diagnostic: the command processor spins this long at every resolve");
+REXCVAR_DEFINE_INT32(metal_fence_spin_us, 0, "GPU/Metal", "Diagnostic: the command processor spins this long before every fence write");
+REXCVAR_DEFINE_INT32(metal_draw_spin_us, 0, "GPU/Metal", "Diagnostic: the command processor spins this long at every draw");
+namespace { void SpinMicroseconds(int32_t us) {
+  auto until = std::chrono::steady_clock::now() + std::chrono::microseconds(us);
+  while (std::chrono::steady_clock::now() < until) {}
+} }
+REXCVAR_DEFINE_BOOL(metal_draw, true, "GPU/Metal", "Draw and resolve (diagnostic: false runs the game with no GPU work, as M0)");
+REXCVAR_DEFINE_BOOL(metal_memory_untracked, false, "GPU/Metal",
+    "The guest memory buffer without Metal's hazard tracking: its writers and readers (resolves, texture loads, "
+    "fence writes) ordered by a fence of the backend's own instead");
+REXCVAR_DEFINE_BOOL(metal_occlusion_queries, true, "GPU/Metal",
+    "The game's occlusion queries counted by the GPU (MCLA: the sun's glare fades behind buildings); false: the "
+    "fake count (query_occlusion_fake_sample_count), as before");
+
+REXCVAR_DEFINE_BOOL(metal_shared_memory_zero_copy, true, "GPU/Metal",
+                    "Make the guest's physical memory (512 MB) a Metal buffer without copying it (Apple "
+                    "Silicon's unified memory), and check once that the GPU reads what the CPU sees. Restart")
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+
