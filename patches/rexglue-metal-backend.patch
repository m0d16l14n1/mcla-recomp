+  // EDRAM ownership: targets are host textures by base, format and pitch, while Xenos has one EDRAM
+  // (a depth clear can paint the color target sharing its tiles). Every pass logs the tiles it wrote;
+  // a target bound or resolved takes over, as raw bits, what others wrote there since its last use.
+  static constexpr uint32_t kNoTransfer = ~0u;
+  struct TargetLayout {
+    uint32_t base, pitch_tiles; bool is_64bpp, is_depth; id<MTLTexture> texture;
+    std::vector<uint32_t> have;  // the tile versions this target holds
+    // The tiles other targets may have written since this one last took them over (all of them at first):
+    // checks for draws in an open pass look only there, not at every tile the draw's rows cover.
+    uint32_t stale_lo = 0, stale_hi = UINT32_MAX;
+    uint32_t clean_lo = 0, clean_hi = 0;  // the last tiles checked or taken over and not written by others since
+    uint32_t ssx = 1, ssy = 1;  // EDRAM samples a texel holds across and down (a metal_msaa multisample texture)
+  };
+  std::unordered_map<uintptr_t, TargetLayout> target_layouts_;
+  // Per EDRAM tile: a version bumped by every pass writing it, the writer and its format kind.
+  std::vector<uint32_t> tile_version_, tile_kind_;
+  std::vector<uintptr_t> tile_owner_;
+  uint32_t edram_version_ = 0;
+  std::array<std::pair<uint32_t, uint32_t>, 5> pass_ranges_{};  // tiles the current pass already claimed
+  uint64_t edram_transfers_ = 0, pipelines_created_ = 0, pipeline_us_ = 0;
+  std::unordered_map<uint32_t, id<MTLRenderPipelineState>> transfer_pipelines_;
+  // Transfers a draw's pass needs, queued by SyncTarget and drawn first in that pass (metal_transfers_in_pass).
+  struct PendingTransfer { const TargetLayout* source; uint32_t source_kind; id<MTLTexture> target; uint32_t kind, lo, hi, y0, y1; };
+  std::vector<PendingTransfer> pending_transfers_;
+  bool defer_transfers_ = false;
+  uint32_t pass_width_ = 0;
+  uint64_t edram_transfers_in_pass_ = 0;
+  std::unordered_map<uint64_t, id<MTLRenderPipelineState>> in_pass_transfer_pipelines_;
+  id<MTLDepthStencilState> transfer_color_depth_state_ = nil;
+  void EncodeTransfer(const PendingTransfer& t);
+  void EncodeTransfersInPass();
+  std::unordered_map<uint32_t, id<MTLRenderPipelineState>> clear_pipelines_;
+  // Resolve clears waiting for the next pass on their target (metal_clears_in_pass): drawn first in it, or
+  // its load action when they cover it; on their own before anything reads the target.
+  struct PendingClear { id<MTLTexture> target; bool depth; std::array<float, 4> color; double depth_value;
+                        uint32_t stencil, x, y0, width, y1; };
+  std::vector<PendingClear> pending_clears_;
+  std::unordered_map<uint64_t, id<MTLRenderPipelineState>> in_pass_clear_pipelines_;
+  uint64_t clears_in_pass_ = 0, clears_as_load_ = 0;
+  void EncodeClear(const PendingClear& c);
+  void FlushClears(id<MTLTexture> target);  // nil: all
+  void EncodeClearsInPass(MTLRenderPassDescriptor* pass);
+  void ClearRect(id<MTLTexture> target, bool depth, std::array<float, 4> color, double depth_value, uint32_t stencil,
+                 uint32_t x, uint32_t y0, uint32_t width, uint32_t y1);
+  id<MTLLibrary> helper_library_ = nil;
+  id taa_scaler_ = nil;  // id<MTLFXTemporalScaler>
+  uint32_t taa_width_ = 0, taa_height_ = 0, taa_render_width_ = 0, taa_render_height_ = 0;
+  id<MTLTexture> taa_color_ = nil;  // upscaling: the render-size colour gathered from the stretched scene
+  id<MTLTexture> taa_motion_ = nil, taa_depth_ = nil, taa_output_ = nil;
+  id<MTLComputePipelineState> taa_vectors_pipeline_ = nil;
+  id<MTLRenderPipelineState> taa_depth_pipeline_ = nil;
+  id<MTLDepthStencilState> taa_depth_state_ = nil;
+  bool taa_failed_ = false;
+  id<MTLDepthStencilState> transfer_depth_state_ = nil;
+  uint32_t ColorKind(xenos::ColorRenderTargetFormat format) const;
+  uint32_t DepthKind() const;
+  // The EDRAM tiles of rows [y0, y1) (samples) of a target, within EDRAM.
+  bool TileRange(const TargetLayout& layout, uint32_t height, uint32_t y0, uint32_t y1, uint32_t& lo, uint32_t& hi) const;
+  // Takes over, as raw bits, what other targets wrote to these rows since this target last had them.
+  bool NeedsSync(id<MTLTexture> target, uint32_t y0, uint32_t y1);
+  static void TrimStale(TargetLayout& l, uint32_t lo, uint32_t hi);
+  static void AddClean(TargetLayout& l, uint32_t lo, uint32_t hi);
+  void SyncTarget(id<MTLTexture> target, uint32_t kind, uint32_t y0, uint32_t y1);
+  // A write to these rows; claimed keeps the tiles a pass already claimed (nullptr: a one-off write).
+  void MarkWritten(id<MTLTexture> target, uint32_t kind, uint32_t y0, uint32_t y1, std::pair<uint32_t, uint32_t>* claimed);
+  void Transfer(const TargetLayout& source, uint32_t source_kind, id<MTLTexture> target, uint32_t kind, uint32_t lo, uint32_t hi);
+};
+}
