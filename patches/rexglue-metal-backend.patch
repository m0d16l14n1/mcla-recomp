@@ -0,0 +1,180 @@
+/** Pipelines through MTL4Compiler: flexible pipelines, archives, compiler tasks. BSD-3-Clause, see LICENSE. */
+#pragma once
+#import <Metal/Metal.h>
+
+#include <array>
+#include <condition_variable>
+#include <cstdint>
+#include <deque>
+#include <filesystem>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include <utility>
+#include <vector>
+
+namespace rex::graphics::metal {
+
+// The colour targets a draw's pipeline writes: what a flexible pipeline is specialised for. The rest of
+// MetalDraw's pipeline key (the two translations and the sample count) picks the flexible pipeline; the depth
+// format isn't part of a Metal 4 pipeline at all (the pass gives it).
+struct PipelineTargets {
+  struct Color {
+    MTLPixelFormat format = MTLPixelFormatInvalid;
+    MTLColorWriteMask write_mask = MTLColorWriteMaskAll;
+    bool blending = false;
+    MTLBlendFactor src_rgb = MTLBlendFactorOne, dst_rgb = MTLBlendFactorZero;
+    MTLBlendFactor src_alpha = MTLBlendFactorOne, dst_alpha = MTLBlendFactorZero;
+    MTLBlendOperation rgb_op = MTLBlendOperationAdd, alpha_op = MTLBlendOperationAdd;
+  };
+  std::array<Color, 4> colors;
+  // A Metal 3 descriptor's colour attachments 0 to 3 (MetalDraw::PipelineDescriptor's).
+  static PipelineTargets From(MTLRenderPipelineDescriptor* desc);
+};
+
+// The backend's pipelines on Metal 4 (macOS 26). One MTL4Compiler with a pipeline data set serializer, and the
+// archives of earlier runs as its lookup archives:
+//
+// - The draws' pipelines are flexible: one per vertex library, pixel library (or none) and sample count, with the
+//   colour formats, write masks and blending unspecialised, built once by a compiler task, then specialised for
+//   each set of targets (no shader compile: 0.02 to 3 ms against tens to hundreds for a full build). At most
+//   `max_in_flight` flexible builds run at a time (the prebuild thread's limit: the compiler takes whole cores), a
+//   draw's own before the storage's prebuild; specialisations aren't limited.
+// - Fixed pipelines (resolves, transfers, clears, TAA, the presenter's) are built from a descriptor, waited for.
+// - Archives: <dir>/<name>-<identity>-<generation>.mtl4archive, the identity a hash of the OS build, the GPU and
+//   the caller's shader identity (anything that changes the MSL or its compile options), so an update rebuilds
+//   rather than misses on every lookup. Each Save writes what was built or looked up since the last one (a flush
+//   empties the serializer, and a pipeline served from an archive is captured again) to a new generation;
+//   Save(compact) also removes the generations loaded at Init, so a run that touches all of them leaves one or
+//   two files. A sidecar index (<name>-<identity>.mtl4index) lists what the generations on disk hold, by the
+//   callers' identities: a Save when this run asked for nothing beyond it writes nothing (a warm run doesn't rewrite
+//   the archive). Metal 3's binary archives couldn't be re-serialised once loaded and faulted on pipelines served
+//   from Apple's shader cache (LibertyRecomp, 2026-10); here nothing loaded is ever serialised again.
+class MetalPipelines4 {
+ public:
+  using RenderDone = void (^)(id<MTLRenderPipelineState> pipeline, NSError* error);
+
+  struct Stats {
+    uint64_t flexible_built = 0, flexible_failed = 0, flexible_fast = 0, flexible_us = 0;
+    uint64_t specialised = 0, specialise_failed = 0, specialise_us = 0;
+    uint64_t fixed_built = 0, fixed_failed = 0;
+    uint64_t full_built = 0, full_failed = 0, full_fast = 0, full_us = 0;
+    uint64_t queued = 0, in_flight = 0;  // now, not since the last call
+  };
+
+  MetalPipelines4() = default;
+  ~MetalPipelines4();
+  MetalPipelines4(const MetalPipelines4&) = delete;
+  MetalPipelines4& operator=(const MetalPipelines4&) = delete;
+
+  // False (with the reason in `log`): no Metal 4 compiler; the caller stays on the device's Metal 3 calls. An empty
+  // dir: no archives. `log` gets a line for the log either way.
+  bool Init(id<MTLDevice> device, const std::filesystem::path& dir, const std::string& name, uint64_t identity,
+            uint32_t max_in_flight, std::string& log) API_AVAILABLE(macos(26.0));
+  bool ready() const { return compiler_ != nil; }
+  // false: each draw pipeline built whole for its targets (through the archives), not specialised from a flexible
+  // one. A specialised pipeline cost 2 to 3 ms of CPU and 0.8 ms of GPU a frame in a race (bench
+  // 20261103-213431, M5): its draws encode more. Before the first Render.
+  void set_flexible(bool flexible) { flexible_ = flexible; }
+  id<MTL4Compiler> compiler() const API_AVAILABLE(macos(26.0)) { return compiler_; }
+
+  // A draw's pipeline: the flexible one for (vl, pl, samples), built through a compiler task the first time,
+  // specialised for `targets`. `done` runs once, on a Metal thread (or on this one when the flexible pipeline
+  // failed before). urgent: a draw waits for it (ahead of the queued prebuilds). The libraries hold one function
+  // each (the translator's main0). identity: the same for the same pair of shaders from run to run (not 0; 0: not
+  // known, and the next Save writes). Any thread.
+  void Render(id<MTLLibrary> vl, id<MTLLibrary> pl, uint32_t samples, const PipelineTargets& targets, bool urgent,
+              RenderDone done, uint64_t identity = 0);
+  // The same, waited for (metal_async_compile off).
+  id<MTLRenderPipelineState> RenderNow(id<MTLLibrary> vl, id<MTLLibrary> pl, uint32_t samples,
+                                       const PipelineTargets& targets, NSError** error, uint64_t identity = 0);
+
+  // A fixed pipeline, waited for, through the archives.
+  id<MTLRenderPipelineState> Render(MTL4RenderPipelineDescriptor* desc, NSError** error) API_AVAILABLE(macos(26.0));
+  id<MTLComputePipelineState> Compute(id<MTLLibrary> library, NSString* function, NSError** error);
+  // A Metal 3 descriptor's state in Metal 4 form, with its functions named (an MTLFunction doesn't say which
+  // library it came from). The depth and stencil formats are dropped: a Metal 4 pipeline takes them from the pass.
+  static MTL4RenderPipelineDescriptor* Convert(MTLRenderPipelineDescriptor* desc, id<MTLLibrary> vl, NSString* vs,
+                                               id<MTLLibrary> pl, NSString* ps) API_AVAILABLE(macos(26.0));
+
+  // Writes what was built or looked up since the last Save to a new archive generation (nothing to write: true).
+  // Waits for the compiler tasks in flight first, up to `wait_ms` (false if they're still running). compact: the
+  // generations loaded at Init are removed after the write; only once this run has built or looked up everything
+  // they held (the pipeline storage's prebuild finished), since what this run didn't touch isn't written.
+  // Nothing is written while everything this run asked for is in the index of the generations loaded (a compact
+  // Save skipped then compacts at the next Save that writes). written: whether a generation was written.
+  bool Save(bool compact, uint32_t wait_ms, std::string& error, bool* written = nullptr);
+
+  Stats TakeStats();
+
+ private:
+  struct BaseKey {
+    void* vl;
+    void* pl;
+    uint32_t samples;
+    bool operator==(const BaseKey& o) const { return vl == o.vl && pl == o.pl && samples == o.samples; }
+  };
+  struct BaseKeyHash {
+    size_t operator()(const BaseKey& k) const {
+      return std::hash<void*>()(k.vl) ^ (std::hash<void*>()(k.pl) * 31) ^ (size_t(k.samples) << 56);
+    }
+  };
+  struct Waiter {
+    PipelineTargets targets;
+    RenderDone done;
+  };
+  // One flexible pipeline: queued, building, built or failed.
+  struct Base {
+    id<MTLLibrary> vl = nil, pl = nil;
+    id<MTLRenderPipelineState> pipeline = nil;
+    NSError* error = nil;
+    bool queued = false, building = false, failed = false;
+    std::vector<Waiter> waiting;
+  };
+
+  void Pump(std::unique_lock<std::mutex>& lock);
+  void Built(const BaseKey& key, id<MTLRenderPipelineState> pipeline, NSError* error, uint64_t us);
+  void Specialise(id<MTLRenderPipelineState> base, const PipelineTargets& targets, RenderDone done);
+  id<MTLRenderPipelineState> SpecialiseNow(id<MTLRenderPipelineState> base, const PipelineTargets& targets,
+                                           NSError** error);
+  id FlexibleDescriptor(const Base& base, uint32_t samples) const;  // MTL4RenderPipelineDescriptor
+  static id FullDescriptor(id<MTLLibrary> vl, id<MTLLibrary> pl, uint32_t samples, const PipelineTargets& targets);
+  id<MTLRenderPipelineState> BuildFull(id desc, NSError** error);
+  bool flexible_ = true;
+  static id SpecialisationDescriptor(const PipelineTargets& targets);
+  std::filesystem::path Generation(uint32_t generation) const;
+  std::filesystem::path IndexPath() const;
+  // The index: entries are hashes of what was asked for (a flexible pipeline, a specialisation, a fixed pipeline).
+  // Note records one asked for this run (locked); 0 is never known.
+  void Note(uint64_t entry);
+  static uint64_t Entry(uint64_t identity, uint32_t samples, const PipelineTargets* targets);
+  void ReadIndex();
+  bool WriteIndex(std::string& error);
+  void Ended();  // a task finished: wakes Save
+
+  id<MTLDevice> device_ = nil;
+  id compiler_ = nil, serializer_ = nil, options_ = nil;  // MTL4Compiler, MTL4PipelineDataSetSerializer, MTL4CompilerTaskOptions
+  std::vector<id> archives_;                              // MTL4Archive, held for the run
+  std::vector<std::filesystem::path> loaded_;             // their files (Save(compact) removes them)
+  std::vector<uint32_t> loaded_generations_, written_generations_;  // on disk: loaded (until compacted), this run's
+  std::filesystem::path dir_;
+  std::string stem_;  // <name>-<identity>
+  uint32_t next_generation_ = 0, max_in_flight_ = 2;
+
+  std::mutex mutex_;
+  std::condition_variable idle_;
+  std::unordered_map<BaseKey, Base, BaseKeyHash> bases_;
+  std::deque<BaseKey> queue_;
+  uint32_t in_flight_ = 0;     // flexible builds
+  uint32_t tasks_ = 0;         // every compiler task (flexible builds and specialisations)
+  bool touched_ = false;       // built or looked up something since the last Save
+  bool wrote_ = false;         // a Save of this run wrote a generation
+  // The index of the generations on disk (`indexed_`: it matched the ones loaded), what this run asked for, and
+  // whether any of that isn't in the index.
+  std::unordered_set<uint64_t> index_, seen_;
+  bool indexed_ = false, unindexed_ = false, compact_pending_ = false;
+  Stats stats_;
+};
+
