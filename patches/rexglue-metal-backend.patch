new file mode 100644
--- /dev/null
+++ b/src/graphics/metal/metal_views4.h
@@ -0,0 +1,77 @@
+/** Texture views as MTLTextureViewPool slots (Metal 4). BSD-3-Clause, see LICENSE. */
+#pragma once
+#import <Metal/Metal.h>
+
+#include <cstdint>
+#include <string>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+namespace rex::graphics::metal {
+
+// The backend's texture views on Metal 4 (macOS 26): a view is a slot of one MTLTextureViewPool, bound through an
+// argument table by its MTLResourceID, with no MTLTexture object of its own, so nothing for the residency set or
+// the lifetime tracker but the texture it views (the binding makes that resident, GpuEncoder::SetTextureView).
+//
+// - Views are found by the texture and a key the caller picks (MetalDraw: the swizzle bits and the cube flag), and
+//   made from a descriptor the first time. A slot holds a strong reference to its texture until Drop, as the view
+//   objects of MetalDraw::views_ did through their parent.
+// - A handle is the slot and its generation. Drop retires a texture's views at once (their handles stop being Live,
+//   their keys never match again) but keeps the slots out of use until the GPU is past `free_after` (Reclaim): a
+//   command buffer still on the GPU may read the slot through an argument table.
+// - Key(handle) is the binding identity for the argument table shadows (GpuRecording::textures, MetalDraw's
+//   bound_textures_), which key on object pointers: bit 63 set, so it never equals a pointer.
+// - Object(handle) makes a real view object once, for APIs that take an MTLTexture (MetalFX, the presenter).
+// - A full pool makes Make return 0: the caller falls back to a view object.
+//
+// One thread (the command thread).
+class API_AVAILABLE(macos(26.0)) MetalViews4 {
+ public:
+  using Handle = uint64_t;  // 0: none; else generation << 32 | slot
+
+  bool Init(id<MTLDevice> device, uint32_t count, std::string& log);
+  bool enabled() const { return pool_ != nil; }
+
+  Handle Find(id<MTLTexture> texture, uint32_t key) const {
+    auto found = by_texture_.find(reinterpret_cast<uintptr_t>((__bridge void*)texture));
+    if (found == by_texture_.end()) return 0;
+    for (auto& [k, h] : found->second)
+      if (k == key) return h;
+    return 0;
+  }
+  Handle Make(id<MTLTexture> texture, uint32_t key, MTLTextureViewDescriptor* desc);
+
+  bool Live(Handle h) const {
+    const uint32_t slot = uint32_t(h);
+    return h && slot < slots_.size() && slots_[slot].generation == uint32_t(h >> 32);
+  }
+  MTLResourceID Id(Handle h) const { return slots_[uint32_t(h)].id; }
+  static uint64_t Key(Handle h) { return h | (uint64_t(1) << 63); }
+  id<MTLTexture> Texture(Handle h) const { return slots_[uint32_t(h)].texture; }
+  id<MTLTexture> Object(Handle h);
+
+  // The texture's views are retired; their slots are free once Reclaim sees `free_after` completed.
+  void Drop(id<MTLTexture> texture, uint64_t free_after);
+  void Reclaim(uint64_t completed);
+
+  struct Stats { uint64_t live = 0, retiring = 0, made = 0, full = 0, objects = 0; };
+  Stats stats() const;
+
+ private:
+  struct Slot {
+    id<MTLTexture> texture = nil;   // strong until Drop
+    id<MTLTexture> object = nil;    // Object()'s, if asked for
+    MTLTextureViewDescriptor* desc = nil;
+    MTLResourceID id{};
+    uint32_t generation = 1;
+  };
+  id<MTLTextureViewPool> pool_ = nil;
+  std::vector<Slot> slots_;
+  std::vector<uint32_t> free_;
+  std::vector<std::pair<uint64_t, uint32_t>> retiring_;  // (free_after, slot), in Drop order
+  std::unordered_map<uintptr_t, std::vector<std::pair<uint32_t, Handle>>> by_texture_;
+  uint64_t made_ = 0, full_ = 0, objects_ = 0;
+};
+
+}  // namespace rex::graphics::metal
diff --git a/src/graphics/metal/metal_views4.mm b/src/graphics/metal/metal_views4.mm
new file mode 100644
--- /dev/null
+++ b/src/graphics/metal/metal_views4.mm
@@ -0,0 +1,97 @@
+/** Texture views as MTLTextureViewPool slots (Metal 4). BSD-3-Clause, see LICENSE. */
+#include "metal_views4.h"
+
+#include <algorithm>
+#include <cstdio>
+
+namespace rex::graphics::metal {
+
+bool MetalViews4::Init(id<MTLDevice> device, uint32_t count, std::string& log) {
+  auto desc = [MTLResourceViewPoolDescriptor new];
+  desc.resourceViewCount = count;
+  desc.label = @"texture views";
+  NSError* error = nil;
+  id<MTLTextureViewPool> pool = [device newTextureViewPoolWithDescriptor:desc error:&error];
+  if (!pool) {
+    log = std::string("Metal 4 texture view pool: none: ") +
+          (error ? error.localizedDescription.UTF8String : "unknown error");
+    return false;
+  }
+  pool_ = pool;
+  slots_.resize(count);
+  free_.reserve(count);
+  // Popped from the back: slot 0 first.
+  for (uint32_t i = count; i-- > 0;) free_.push_back(i);
+  char text[96];
+  std::snprintf(text, sizeof(text), "Metal 4 texture view pool: %u views", count);
+  log = text;
+  return true;
+}
+
+MetalViews4::Handle MetalViews4::Make(id<MTLTexture> texture, uint32_t key, MTLTextureViewDescriptor* desc) {
+  if (!pool_ || !texture || free_.empty()) {
+    if (pool_ && texture) ++full_;
+    return 0;
+  }
+  const uint32_t slot = free_.back();
+  Slot& s = slots_[slot];
+  s.id = [pool_ setTextureView:texture descriptor:desc atIndex:slot];
+  if (!s.id._impl) return 0;  // refused (a descriptor the texture can't be viewed as): no slot used
+  free_.pop_back();
+  s.texture = texture;
+  s.desc = desc;
+  s.object = nil;
+  const Handle h = (uint64_t(s.generation) << 32) | slot;
+  by_texture_[reinterpret_cast<uintptr_t>((__bridge void*)texture)].emplace_back(key, h);
+  ++made_;
+  return h;
+}
+
+id<MTLTexture> MetalViews4::Object(Handle h) {
+  if (!Live(h)) return nil;
+  Slot& s = slots_[uint32_t(h)];
+  if (!s.object) {
+    s.object = [s.texture newTextureViewWithDescriptor:s.desc];
+    ++objects_;
+  }
+  return s.object;
+}
+
+void MetalViews4::Drop(id<MTLTexture> texture, uint64_t free_after) {
+  auto found = by_texture_.find(reinterpret_cast<uintptr_t>((__bridge void*)texture));
+  if (found == by_texture_.end()) return;
+  for (auto& [key, h] : found->second) {
+    Slot& s = slots_[uint32_t(h)];
+    // Handles of it stop being Live now; the texture goes as soon as nothing else holds it (a command buffer
+    // that bound the view made the texture itself resident and keeps it until it is done).
+    ++s.generation;
+    if (!s.generation) s.generation = 1;
+    s.texture = nil;
+    s.object = nil;
+    s.desc = nil;
+    retiring_.emplace_back(free_after, uint32_t(h));
+  }
+  by_texture_.erase(found);
+}
+
+void MetalViews4::Reclaim(uint64_t completed) {
+  // Drop order is serial order (free_after never decreases), so the done ones are a prefix.
+  size_t done = 0;
+  while (done < retiring_.size() && retiring_[done].first <= completed) {
+    free_.push_back(retiring_[done].second);
+    ++done;
+  }
+  if (done) retiring_.erase(retiring_.begin(), retiring_.begin() + ptrdiff_t(done));
+}
+
+MetalViews4::Stats MetalViews4::stats() const {
+  Stats st;
+  st.live = slots_.size() - free_.size() - retiring_.size();
+  st.retiring = retiring_.size();
+  st.made = made_;
+  st.full = full_;
+  st.objects = objects_;
+  return st;
+}
+
+}  // namespace rex::graphics::metal
