+  uint4 unorm8 = uint4(rint(saturate(value) * 255.0f));
+  uint4 unorm16 = uint4(rint(saturate(value) * 65535.0f));
+  switch (c.format) {
+    case 2: case 8: case 9: packed.x = unorm8.x; log_bpp = 0; break;
+    case 10: packed.x = unorm8.x | (unorm8.y << 8); log_bpp = 1; break;
+    case 6: case 14: case 50: packed.x = unorm8.x | (unorm8.y << 8) | (unorm8.z << 16) | (unorm8.w << 24); break;
+    case 7: case 54: { uint4 u = uint4(rint(saturate(value) * float4(1023, 1023, 1023, 3)));
+      packed.x = u.x | (u.y << 10) | (u.z << 20) | (u.w << 30); break; }
+    case 24: packed.x = unorm16.x; log_bpp = 1; break;
+    case 25: packed.x = unorm16.x | (unorm16.y << 16); break;
+    case 26: packed.xy = uint2(unorm16.x | (unorm16.y << 16), unorm16.z | (unorm16.w << 16)); log_bpp = 3; break;
+    case 30: packed.x = as_type<ushort>(half(value.x)); log_bpp = 1; break;
+    case 31: packed.x = as_type<uint>(half2(value.xy)); break;
+    case 32: packed.xy = as_type<uint2>(half4(value)); log_bpp = 3; break;
+    case 36: packed.x = as_type<uint>(value.x); break;
+    case 37: packed.xy = as_type<uint2>(value.xy); log_bpp = 3; break;
+    case 38: packed = as_type<uint4>(value); log_bpp = 4; break;
+    default: return;
+  }
+  store_raw(packed, log_bpp, p, c, memory, rejected);
+}
+// xenos::Float32To20e4 with rounding to nearest even.
+uint float32_to_20e4(float f) {
+  if (!(f > 0.0f)) return 0;
+  uint u = as_type<uint>(f);
+  if (u >= 0x3FFFFFF8u) return 0xFFFFFFu;
+  if (u < 0x38800000u) u = (0x800000u | (u & 0x7FFFFFu)) >> min(113u - (u >> 23), 24u);
+  else u += 0xC8000000u;
+  u += 3 + ((u >> 3) & 1);
+  return (u >> 3) & 0xFFFFFFu;
+}
+kernel void resolve_color(texture2d<float, access::read> source [[texture(0)]],
+    texture2d<float, access::write> destination [[texture(1)]],
+    constant ResolveConstants& c [[buffer(0)]], device uchar* memory [[buffer(1)]],
+    device atomic_uint* rejected [[buffer(2)]], uint2 q [[thread_position_in_grid]]) {
+  uint rs = max(c.rs, 1u);
+  if (any(q >= c.size * rs)) return;
+  uint2 p = q / rs, sub = q % rs;
+  uint2 base = c.origin + p * c.samples;
+  float4 value;
+  if (c.stretch) {
+    value = source.read(stretched(c.origin * rs + q, c));
+  } else if (c.sample_select < 4) {
+    value = source.read((base + sample_offset(c.sample_select, c.samples)) / c.tex_ss * rs + sub);
+  } else {
+    value = float4(0);
+    for (uint y = 0; y < c.samples.y; ++y) for (uint x = 0; x < c.samples.x; ++x)
+      value += source.read((base + uint2(x, y)) / c.tex_ss * rs + sub);
+    value /= float(c.samples.x * c.samples.y);
+  }
+  value *= c.scale;
+  if (c.swap) value = value.bgra;
+  destination.write(value, q);
+  if (all(sub == 0u)) store_guest(value, p, c, memory, rejected);
+}
+kernel void resolve_depth(depth2d<float, access::read> source [[texture(0)]],
+    texture2d<float, access::write> destination [[texture(1)]],
+    texture2d<uint, access::read> stencil [[texture(2)]],
+    constant ResolveConstants& c [[buffer(0)]], device uchar* memory [[buffer(1)]],
+    device atomic_uint* rejected [[buffer(2)]], uint2 q [[thread_position_in_grid]]) {
+  uint rs = max(c.rs, 1u);
+  if (any(q >= c.size * rs)) return;
+  uint2 p = q / rs, sub = q % rs;
+  uint2 at = c.stretch ? stretched(c.origin * rs + q, c)
+                       : (c.origin + p * c.samples + sample_offset(c.sample_select, c.samples)) / c.tex_ss * rs + sub;
+  float depth = source.read(at) * c.scale;
+  destination.write(float4(depth), q);
+  // Depth resolves write the EDRAM depth format whatever the destination format says: 24-bit
+  // depth over 8-bit stencil (the stencil read through an X32_Stencil8 view of the target).
+  if (!c.write_memory || any(sub != 0u)) return;
+  uint d24 = c.format == 23 ? float32_to_20e4(depth) : uint(rint(saturate(depth) * 16777215.0f));
+  store_raw(uint4((d24 << 8) | (stencil.read(at).r & 0xFFu), 0, 0, 0), 2, p, c, memory, rejected);
+}
+kernel void resolve_color_ms(texture2d_ms<float, access::read> source [[texture(0)]],
+    texture2d<float, access::write> destination [[texture(1)]],
+    constant ResolveConstants& c [[buffer(0)]], device uchar* memory [[buffer(1)]],
+    device atomic_uint* rejected [[buffer(2)]], uint2 p [[thread_position_in_grid]]) {
+  if (any(p >= c.size)) return;
+  uint2 base = c.origin + p * c.samples;
+  float4 value;
+  if (c.sample_select < 4) {
+    uint2 at = base + sample_offset(c.sample_select, c.samples);
+    value = source.read(at / c.samples, host_sample(at % c.samples, c.samples));
+  } else {
+    value = float4(0);
+    uint n = c.samples.x * c.samples.y;
+    for (uint i = 0; i < n; ++i) value += source.read(base / c.samples, i);
+    value /= float(n);
+  }
+  value *= c.scale;
+  if (c.swap) value = value.bgra;
+  destination.write(value, p);
+  store_guest(value, p, c, memory, rejected);
+}
+kernel void resolve_depth_ms(depth2d_ms<float, access::read> source [[texture(0)]],
+    texture2d<float, access::write> destination [[texture(1)]],
+    texture2d_ms<uint, access::read> stencil [[texture(2)]],
+    constant ResolveConstants& c [[buffer(0)]], device uchar* memory [[buffer(1)]],
+    device atomic_uint* rejected [[buffer(2)]], uint2 p [[thread_position_in_grid]]) {
+  if (any(p >= c.size)) return;
+  uint2 at = c.origin + p * c.samples + sample_offset(c.sample_select, c.samples);
+  uint2 pixel = at / c.samples; uint index = host_sample(at % c.samples, c.samples);
+  float depth = source.read(pixel, index) * c.scale;
+  destination.write(float4(depth), p);
+  if (!c.write_memory) return;
+  uint d24 = c.format == 23 ? float32_to_20e4(depth) : uint(rint(saturate(depth) * 16777215.0f));
+  store_raw(uint4((d24 << 8) | (stencil.read(pixel, index).r & 0xFFu), 0, 0, 0), 2, p, c, memory, rejected);
+}
+// Guest texture memory to linear blocks, for a blit into the texture (any format, compressed too).
+struct LoadConstants {
+  uint src_base, slice_stride, row_pitch_bytes, pitch_blocks, log_bpp, ox, oy, tiled, xor_mask, bw, bh, convert;
+  uint scale;  // out blocks across and down for each: a composite's rows from memory beside resolution-scaled resolves
+};
+float float20e4_to_32(uint f24) {
+  f24 &= 0xFFFFFFu;
+  if (!f24) return 0.0f;
+  uint mantissa = f24 & 0xFFFFFu, exponent = f24 >> 20;
+  if (!exponent) {
+    uint lz = clz(mantissa) - (32 - 21);
+    exponent = uint(1 - int(lz)); mantissa = (mantissa << lz) & 0xFFFFFu;
+  }
+  return as_type<float>(((exponent + 112) << 23) | (mantissa << 3));
+}
+kernel void load_texture(device const uchar* memory [[buffer(0)]], device uchar* out [[buffer(1)]],
+    constant LoadConstants& c [[buffer(2)]], uint3 o [[thread_position_in_grid]]) {
+  uint scale = max(c.scale, 1u), out_w = c.bw * scale, out_h = c.bh * scale;
+  if (o.x >= out_w || o.y >= out_h) return;
+  uint3 p = uint3(o.xy / scale, o.z);
+  uint bpb = 1u << c.log_bpp;
+  uint offset = c.tiled ? tiled_offset(uint2(p.x + c.ox, p.y + c.oy), c.pitch_blocks, c.log_bpp)
+                        : (p.y + c.oy) * c.row_pitch_bytes + (p.x + c.ox) * bpb;
+  uint src = c.src_base + p.z * c.slice_stride + offset;
+  uint dst = ((o.z * out_h + o.y) * out_w + o.x) * (c.convert >= 3 ? 4u : bpb);
+  bool inside = src + bpb <= 0x20000000u;
+  if (c.convert >= 3) {
+    // 16-bit packed, red in the low bits: 3 k_1_5_5_5, 4 k_5_6_5, 5 k_6_5_5, 6 k_4_4_4_4. Formats
+    // without alpha repeat blue there, like the Vulkan backend's RGBB swizzle.
+    uint v = inside ? (uint(memory[src ^ c.xor_mask]) | (uint(memory[(src + 1) ^ c.xor_mask]) << 8)) : 0u;
+    float4 f;
+    if (c.convert == 3) f = float4(v & 31u, (v >> 5) & 31u, (v >> 10) & 31u, 0) / 31.0f, f.w = float(v >> 15);
+    else if (c.convert == 4) f = float4(float(v & 31u) / 31.0f, float((v >> 5) & 63u) / 63.0f, float(v >> 11) / 31.0f, 0);
+    else if (c.convert == 5) f = float4(float(v & 31u) / 31.0f, float((v >> 5) & 31u) / 31.0f, float(v >> 10) / 63.0f, 0);
+    else f = float4(v & 15u, (v >> 4) & 15u, (v >> 8) & 15u, v >> 12) / 15.0f;
+    if (c.convert == 4 || c.convert == 5) f.w = f.z;
+    uint4 u = uint4(rint(saturate(f) * 255.0f));
+    for (uint i = 0; i < 4; ++i) out[dst + i] = uchar(u[i]);
+    return;
+  }
+  if (c.convert) {
+    // k_24_8 and k_24_8_FLOAT as R32Float depth, like a depth resolve's own texture.
+    uint v = 0;
+    for (uint i = 0; i < 4; ++i) v |= uint(inside ? memory[(src + i) ^ c.xor_mask] : 0) << (i * 8);
+    uint d24 = v >> 8;
+    float depth = c.convert == 1 ? float(d24 + (d24 >> 23)) * (1.0f / 16777216.0f) : float20e4_to_32(d24);
+    uint bits = as_type<uint>(depth);
+    for (uint i = 0; i < 4; ++i) out[dst + i] = uchar(bits >> (i * 8));
+    return;
+  }
+  if (bpb >= 4) {
+    // Whole words: byte i of the texel is memory byte (src + i) ^ xor_mask, so word k comes from word
+    // k ^ (xor_mask >> 2), permuted inside by xor_mask & 3 (byte loads and stores were 4 to 8 times
+    // the memory transactions).
+    device const uint* words = reinterpret_cast<device const uint*>(memory);
+    device uint* out_words = reinterpret_cast<device uint*>(out);
+    uint word_xor = c.xor_mask >> 2, byte_xor = c.xor_mask & 3u;
+    for (uint k = 0; k < (bpb >> 2); ++k) {
+      uint w = inside ? words[((src >> 2) + k) ^ word_xor] : 0u;
+      if (byte_xor == 1u) w = ((w & 0x00FF00FFu) << 8) | ((w >> 8) & 0x00FF00FFu);
+      else if (byte_xor == 2u) w = (w << 16) | (w >> 16);
+      else if (byte_xor == 3u) w = (w << 24) | ((w & 0xFF00u) << 8) | ((w >> 8) & 0xFF00u) | (w >> 24);
+      out_words[(dst >> 2) + k] = w;
+    }
+    return;
+  }
+  for (uint i = 0; i < bpb; ++i) out[dst + i] = inside ? memory[(src + i) ^ c.xor_mask] : uchar(0);
+}
+struct PresentConstants { uint2 size; uint mode, factor; };  // mode 0: as is, 1: 256-entry table, 2: PWL; factor: output pixels a source one
+struct GammaRamp { uint table[256]; uint pwl[128 * 3]; };
+// DC_LUT_30_COLOR: blue in bits 0:9, green 10:19, red 20:29.
+float ramp_table(constant GammaRamp& g, float v, uint shift) {
+  return float((g.table[uint(saturate(v) * 255.0f + 0.5f)] >> shift) & 1023u) / 1023.0f;
+}
+// DC_LUT_PWL_DATA: 128 segments of 8 steps over the 10-bit input, base and delta in the high 10 of 16 bits.
+float ramp_pwl(constant GammaRamp& g, float v, uint channel) {
+  uint x = uint(saturate(v) * 1023.0f + 0.5f);
+  uint d = g.pwl[(x >> 3) * 3 + channel];
+  float value = float(d & 0xFFFFu) + float((x & 7u) * (d >> 16)) * 0.125f;
+  return saturate(value * 1.52737048e-05f);
+}
+kernel void present_color(texture2d_array<float, access::read> source [[texture(0)]],
+    texture2d<float, access::write> destination [[texture(1)]],
+    constant PresentConstants& c [[buffer(0)]], constant GammaRamp& g [[buffer(1)]],
+    uint2 p [[thread_position_in_grid]]) {
+  if (any(p >= c.size)) return;
+  float4 color = source.read(p / max(c.factor, 1u), 0);
+  if (c.mode == 1) color.rgb = float3(ramp_table(g, color.r, 20), ramp_table(g, color.g, 10), ramp_table(g, color.b, 0));
+  else if (c.mode == 2) color.rgb = float3(ramp_pwl(g, color.r, 0), ramp_pwl(g, color.g, 1), ramp_pwl(g, color.b, 2));
+  destination.write(color, p);
+}
+
+// EDRAM ownership transfers: a target takes over the tiles another one (another format, pitch, or
+// depth against color) wrote since, as the same raw dwords, like Xenos EDRAM. A tile row is 80 dwords:
+// 80 samples of a 32bpp format or 40 of a 64bpp one (sample x in dwords 2x, its red and green or its
+// first half, and 2x + 1).
+// Kinds: 0 k_8_8_8_8, 1 k_2_10_10_10, 2 k_2_10_10_10_FLOAT (7e3), 3 k_16_16, 4 k_16_16_FLOAT,
+// 5 k_32_FLOAT, 6 D24S8, 7 D24FS8 (the host keeps half of the guest's 20e4 depth); 64bpp:
+// 8 k_16_16_16_16, 9 k_16_16_16_16_FLOAT, 10 k_32_32_FLOAT.
+struct TransferConstants {
+  uint dst_base, dst_pitch, src_base, src_pitch;  // tiles; a tile is 80x16 samples (32bpp)
+  uint lo, hi;  // the EDRAM tiles taken over
+  uint src_kind, dst_kind;
+  uint2 dst_ss, src_ss;  // samples a texel of each holds (1x1 for a single-sample texture; metal_msaa)
+  uint dst_dw, src_dw;  // dwords a sample (2 for 64bpp)
+  uint scale, padding;  // the resolution scale: texels across and down for each 1x texel (single-sample targets)
+};
+// Resolve clears: a scissored full-screen triangle over only the resolved rectangle.
+struct ClearConstants { float4 color; float depth; };
+fragment float4 clear_color_fs(constant ClearConstants& c [[buffer(0)]]) { return c.color; }
+struct ClearDepthOut { float depth [[depth(any)]]; };
+fragment ClearDepthOut clear_depth_fs(constant ClearConstants& c [[buffer(0)]]) { ClearDepthOut o; o.depth = c.depth; return o; }
+vertex float4 transfer_vs(uint id [[vertex_id]]) {
+  return float4(float2((id << 1) & 2, id & 2) * 2.0f - 1.0f, 0.0f, 1.0f);
+}
+float f7e3_to_32(uint v) {
+  uint m = v & 0x7Fu, e = (v >> 7) & 7u;
+  return e ? ldexp(1.0f + float(m) / 128.0f, int(e) - 3) : ldexp(float(m) / 128.0f, -2);
+}
+uint f32_to_7e3(float f) {
+  f = clamp(f, 0.0f, 31.875f);
+  if (f < 0.25f) return uint(rint(f * 512.0f));
+  int e = clamp(int(floor(log2(f))) + 3, 1, 7);
+  uint m = uint(rint((f / exp2(float(e - 3)) - 1.0f) * 128.0f));
+  if (m >= 128u) { m = 0; ++e; }
+  return e > 7 ? 0x3FFu : ((uint(e) << 7) | m);
+}
+uint snorm16x2(float2 v) { int2 i = int2(rint(clamp(v, -1.0f, 1.0f) * 32767.0f)); return (uint(i.x) & 0xFFFFu) | (uint(i.y) << 16); }
+float2 snorm16x2(uint b) { return max(float2(int(b << 16) >> 16, int(b) >> 16) / 32767.0f, -1.0f); }
+uint pack_color32(float4 v, uint kind) {
+  switch (kind) {
+    case 0: { uint4 u = uint4(rint(saturate(v) * 255.0f)); return u.x | (u.y << 8) | (u.z << 16) | (u.w << 24); }
+    case 1: { uint4 u = uint4(rint(saturate(v) * float4(1023, 1023, 1023, 3))); return u.x | (u.y << 10) | (u.z << 20) | (u.w << 30); }
+    case 2: return f32_to_7e3(v.x) | (f32_to_7e3(v.y) << 10) | (f32_to_7e3(v.z) << 20) | (uint(rint(saturate(v.w) * 3.0f)) << 30);
+    case 3: return snorm16x2(v.xy);
+    case 4: return as_type<uint>(half2(v.xy));
+    default: return as_type<uint>(v.x);
+  }
+}
+uint2 pack_color(float4 v, uint kind) {
+  switch (kind) {
+    case 8: return uint2(snorm16x2(v.xy), snorm16x2(v.zw));
+    case 9: return as_type<uint2>(half4(v));
+    case 10: return as_type<uint2>(v.xy);
+    default: return uint2(pack_color32(v, kind), 0u);
+  }
+}
+float4 unpack_color32(uint b, uint kind) {
+  switch (kind) {
+    case 0: return float4(b & 255u, (b >> 8) & 255u, (b >> 16) & 255u, b >> 24) / 255.0f;
+    case 1: return float4(float(b & 1023u) / 1023.0f, float((b >> 10) & 1023u) / 1023.0f, float((b >> 20) & 1023u) / 1023.0f, float(b >> 30) / 3.0f);
+    case 2: return float4(f7e3_to_32(b & 1023u), f7e3_to_32((b >> 10) & 1023u), f7e3_to_32((b >> 20) & 1023u), float(b >> 30) / 3.0f);
+    case 3: return float4(snorm16x2(b), 0.0f, 1.0f);
+    case 4: return float4(float2(as_type<half2>(b)), 0.0f, 1.0f);
+    default: return float4(as_type<float>(b), 0.0f, 0.0f, 1.0f);
+  }
+}
+float4 unpack_color(uint2 b, uint kind) {
+  switch (kind) {
+    case 8: return float4(snorm16x2(b.x), snorm16x2(b.y));
+    case 9: return float4(as_type<half4>(b));
+    case 10: return float4(as_type<float2>(b), 0.0f, 1.0f);
+    default: return unpack_color32(b.x, kind);
+  }
+}
+uint pack_depth(float depth, uint stencil, uint kind) {
+  uint d24 = kind == 7 ? float32_to_20e4(depth * 2.0f) : uint(rint(saturate(depth) * 16777215.0f));
+  return (d24 << 8) | (stencil & 0xFFu);
+}
+// Where dword k of this destination sample (both in EDRAM sample space) is in the source, through the EDRAM tile
+// both cover: the source sample s and its dword sk.
+bool transfer_source(uint2 d, uint k, constant TransferConstants& c, uint2 source_size, thread uint2& s, thread uint& sk) {
+  uint x = d.x * c.dst_dw + k;
+  uint column = x / 80u;
+  if (column >= c.dst_pitch) return false;
+  uint tile = c.dst_base + (d.y >> 4) * c.dst_pitch + column;
+  if (tile < c.lo || tile >= c.hi || tile < c.src_base) return false;
+  uint rel = tile - c.src_base;
+  uint sx = (rel % c.src_pitch) * 80u + x % 80u;
+  s = uint2(sx / c.src_dw, (rel / c.src_pitch) * 16u + (d.y & 15u));
+  sk = sx % c.src_dw;
+  return all(s < source_size);
+}
+struct TransferDepthOut { float depth [[depth(any)]]; uint stencil [[stencil]]; };
+TransferDepthOut unpack_depth(uint b, uint kind) {
+  TransferDepthOut out;
+  uint d24 = b >> 8;
+  out.depth = kind == 7 ? float20e4_to_32(d24) * 0.5f : float(d24) / 16777215.0f;
+  out.stencil = b & 0xFFu;
+  return out;
+}
+// Reading a source at a sample-space position, single-sample or multisample. With a resolution scale a
+// single-sample texel at 1x is scale x scale texels: the one at `sub` in it (the destination's own sub-texel).
+float4 read_color(texture2d<float, access::read> t, uint2 s, uint2 ss, uint2 sub, uint scale) { return t.read(s / ss * scale + sub); }
+float4 read_color(texture2d_ms<float, access::read> t, uint2 s, uint2 ss, uint2, uint) { return t.read(s / ss, host_sample(s % ss, ss)); }
+float read_depth(depth2d<float, access::read> t, uint2 s, uint2 ss, uint2 sub, uint scale) { return t.read(s / ss * scale + sub); }
+float read_depth(depth2d_ms<float, access::read> t, uint2 s, uint2 ss, uint2, uint) { return t.read(s / ss, host_sample(s % ss, ss)); }
+uint read_stencil(texture2d<uint, access::read> t, uint2 s, uint2 ss, uint2 sub, uint scale) { return t.read(s / ss * scale + sub).r; }
+uint read_stencil(texture2d_ms<uint, access::read> t, uint2 s, uint2 ss, uint2, uint) { return t.read(s / ss, host_sample(s % ss, ss)).r; }
+uint2 sample_size(texture2d<float, access::read> t, uint2 ss, uint scale) { return uint2(t.get_width(), t.get_height()) / scale * ss; }
+uint2 sample_size(depth2d<float, access::read> t, uint2 ss, uint scale) { return uint2(t.get_width(), t.get_height()) / scale * ss; }
+uint2 sample_size(texture2d_ms<float, access::read> t, uint2 ss, uint) { return uint2(t.get_width(), t.get_height()) * ss; }
+uint2 sample_size(depth2d_ms<float, access::read> t, uint2 ss, uint) { return uint2(t.get_width(), t.get_height()) * ss; }
+// A single-sample texture's texel may hold several samples (metal_4x_as_1x: 2x2): it is drawn as its first.
+// Variants: _sm a multisample source, _dm a multisample destination (run per sample).
+#define SRC_COLOR_P texture2d<float, access::read>
+#define SRC_COLOR_M texture2d_ms<float, access::read>
+#define SRC_DEPTH_P depth2d<float, access::read>
+#define SRC_DEPTH_M depth2d_ms<float, access::read>
+#define SRC_STENCIL_P texture2d<uint, access::read>
+#define SRC_STENCIL_M texture2d_ms<uint, access::read>
+#define DST_ARGS_P
+#define DST_ARGS_M , uint sid [[sample_id]]
+#define DST_COORD_P (uint2(position.xy) / c.scale * c.dst_ss)
+#define DST_COORD_M (uint2(position.xy) * c.dst_ss + guest_sub(sid, c.dst_ss))
+#define DST_SUB_P (uint2(position.xy) % c.scale)
+#define DST_SUB_M uint2(0u)
+// The destination sample's dwords (b) from a color or a depth source; discarded where the source has none.
+#define TRANSFER_DWORDS(D, PACK) \
+  uint2 d = DST_COORD_##D, sub = DST_SUB_##D, s, s1; uint sk, sk1; \
+  if (!transfer_source(d, 0u, c, sample_size(source, c.src_ss, c.scale), s, sk)) discard_fragment(); \
+  uint2 p = PACK(s), b = uint2(p[sk], 0u); \
+  if (c.dst_dw > 1u && transfer_source(d, 1u, c, sample_size(source, c.src_ss, c.scale), s1, sk1)) { \
+    if (any(s1 != s)) p = PACK(s1); \
+    b.y = p[sk1]; \
+  }
+#define PACK_COLOR(at) pack_color(read_color(source, at, c.src_ss, sub, c.scale), c.src_kind)
+#define PACK_DEPTH(at) uint2(pack_depth(read_depth(source, at, c.src_ss, sub, c.scale), \
+    read_stencil(stencil, at, c.src_ss, sub, c.scale), c.src_kind), 0u)
+#define TRANSFERS(SUFFIX, S, D) \
+fragment float4 transfer_color_from_color##SUFFIX(float4 position [[position]], constant TransferConstants& c [[buffer(0)]], \
+    SRC_COLOR_##S source [[texture(0)]] DST_ARGS_##D) { \
+  TRANSFER_DWORDS(D, PACK_COLOR) \
+  return unpack_color(b, c.dst_kind); \
+} \
+fragment float4 transfer_color_from_depth##SUFFIX(float4 position [[position]], constant TransferConstants& c [[buffer(0)]], \
+    SRC_DEPTH_##S source [[texture(0)]], SRC_STENCIL_##S stencil [[texture(1)]] DST_ARGS_##D) { \
+  TRANSFER_DWORDS(D, PACK_DEPTH) \
+  return unpack_color(b, c.dst_kind); \
+} \
+fragment TransferDepthOut transfer_depth_from_color##SUFFIX(float4 position [[position]], constant TransferConstants& c [[buffer(0)]], \
+    SRC_COLOR_##S source [[texture(0)]] DST_ARGS_##D) { \
+  TRANSFER_DWORDS(D, PACK_COLOR) \
+  return unpack_depth(b.x, c.dst_kind); \
+} \
+fragment TransferDepthOut transfer_depth_from_depth##SUFFIX(float4 position [[position]], constant TransferConstants& c [[buffer(0)]], \
+    SRC_DEPTH_##S source [[texture(0)]], SRC_STENCIL_##S stencil [[texture(1)]] DST_ARGS_##D) { \
+  TRANSFER_DWORDS(D, PACK_DEPTH) \
+  return unpack_depth(b.x, c.dst_kind); \
+}
+TRANSFERS(, P, P)
+TRANSFERS(_sm, M, P)
+TRANSFERS(_dm, P, M)
+TRANSFERS(_sm_dm, M, M)
+// The same into color attachment N of a draw's own pass (EDRAM transfers drawn first in the pass that
+// needs them, instead of a pass of their own that loads and stores the target once more).
+#define TRANSFER_INTO_COLOR(N, SUFFIX, S, D) \
+fragment TransferColorOut##N transfer_color_from_color_##N##SUFFIX(float4 position [[position]], \
+    constant TransferConstants& c [[buffer(0)]], SRC_COLOR_##S source [[texture(0)]] DST_ARGS_##D) { \
+  TRANSFER_DWORDS(D, PACK_COLOR) \
+  TransferColorOut##N o; o.color = unpack_color(b, c.dst_kind); return o; \
+} \
+fragment TransferColorOut##N transfer_color_from_depth_##N##SUFFIX(float4 position [[position]], \
+    constant TransferConstants& c [[buffer(0)]], SRC_DEPTH_##S source [[texture(0)]], \
+    SRC_STENCIL_##S stencil [[texture(1)]] DST_ARGS_##D) { \
+  TRANSFER_DWORDS(D, PACK_DEPTH) \
+  TransferColorOut##N o; o.color = unpack_color(b, c.dst_kind); return o; \
+}
+#define TRANSFER_OUT(N) struct TransferColorOut##N { float4 color [[color(N)]]; };
+#define TRANSFERS_INTO_COLOR(N) TRANSFER_OUT(N) TRANSFER_INTO_COLOR(N, , P, P) TRANSFER_INTO_COLOR(N, _sm, M, P) \
+    TRANSFER_INTO_COLOR(N, _dm, P, M) TRANSFER_INTO_COLOR(N, _sm_dm, M, M)
+TRANSFERS_INTO_COLOR(0)
+TRANSFERS_INTO_COLOR(1)
+TRANSFERS_INTO_COLOR(2)
+TRANSFERS_INTO_COLOR(3)
+// Resolve clears drawn first in the next pass on their target, into its color attachment N.
+#define CLEAR_INTO_COLOR(N) \
+struct ClearColorOut##N { float4 color [[color(N)]]; }; \
+fragment ClearColorOut##N clear_color_fs_##N(constant ClearConstants& c [[buffer(0)]]) { \
+  ClearColorOut##N o; o.color = c.color; return o; \
+}
+CLEAR_INTO_COLOR(0)
+CLEAR_INTO_COLOR(1)
+CLEAR_INTO_COLOR(2)
+CLEAR_INTO_COLOR(3)
+// Temporal anti-aliasing (MetalFX, at Midnight Club's motion blur draw): motion vectors from the game's own
+// reprojection (taa_motion_vectors_mcla.cs.xesl of rexglue-temporal-aa.patch, the same maths): per pixel, the
+// unjittered centre and the depth (1 near, 0 far) make the clip position, which the matrix of the pixel's
+// vehicle ID (the stencil >> 2) takes to the previous frame's guest pixels. Previous minus current, in pixels.
+// With upscaling (taa_upscale_gather_mcla.cs.xesl of rexglue-fsr-upscaling.patch) the scene was drawn into the
+// render-size corner and resolved stretched to the output size: render pixel i is output pixel
+// (2 * output * i + render - 1) / (2 * render), the first to show it, where the depth, the stencil and (when
+// asked) the colour are taken from. At the native size that is pixel i itself.
+// map: output w, h, render w, h; stencil.x: output pixels across a stencil texel (resolution_scale: the stencil view
+// comes from guest memory, at 1x).
+struct TaaMvConstants { float4 previous[96]; float4 size; float4 jitter; uint4 map; uint4 stencil; };
+uint2 taa_source(uint2 i, uint4 map) { return min((i * map.xy * 2u + map.zw - 1u) / (map.zw * 2u), map.xy - 1u); }
+kernel void taa_motion_vectors(constant TaaMvConstants& c [[buffer(0)]],
+    texture2d_array<float, access::read> depth [[texture(0)]], texture2d_array<float, access::read> stencil [[texture(1)]],
+    texture2d<float, access::write> dest [[texture(2)]], texture2d_array<float, access::read> scene [[texture(3)]],
+    texture2d<float, access::write> color [[texture(4)]], uint2 p [[thread_position_in_grid]]) {
+  if (p.x >= uint(c.size.x) || p.y >= uint(c.size.y)) return;
+  uint2 source = taa_source(p, c.map);
+  if (c.jitter.w != 0.0f) color.write(scene.read(source, 0), p);
+  float d = depth.read(source, 0).x;
+  float s = stencil.read(source / max(c.stencil.x, 1u), 0)[uint(c.jitter.z)];
+  uint id = uint(s * 255.0f + 0.5f) >> 2u;
+  if (id >= 24u) id = 0u;
+  float2 position = float2(p) + 0.5f - c.jitter.xy;
+  float2 uv = position / c.size.xy;
+  float4 clip = float4(uv.x * 2.0f - 1.0f, 1.0f - uv.y * 2.0f, 1.0f - d, 1.0f);
+  uint row = id * 4u;
+  float4 previous = clip.x * c.previous[row] + clip.y * c.previous[row + 1u] + clip.z * c.previous[row + 2u] +
+                    clip.w * c.previous[row + 3u];
+  float2 motion = float2(0.0f);
+  if (abs(previous.w) > 1.0e-20f) {
+    motion = previous.xy / previous.w * c.size.zw - position;
+    if ((as_type<uint>(motion.x) & 0x7FFFFFFFu) > 0x7F800000u || (as_type<uint>(motion.y) & 0x7FFFFFFFu) > 0x7F800000u)
+      motion = float2(0.0f);
+    motion = clamp(motion, -c.size.xy, c.size.xy);
+  }
+  dest.write(float4(motion, 0.0f, 0.0f), p);
+}
+// The depth for MetalFX, which takes a depth format (at the render size, from the same pixels as the vectors).
+struct TaaDepthOut { float depth [[depth(any)]]; };
+fragment TaaDepthOut taa_depth_fs(float4 position [[position]], texture2d_array<float, access::read> source [[texture(0)]],
+    constant uint4& map [[buffer(0)]]) {
+  TaaDepthOut o; o.depth = source.read(taa_source(uint2(position.xy), map), 0).x; return o;
+}
+)MSL";
+}
diff --git a/src/graphics/metal/metal_rt4.h b/src/graphics/metal/metal_rt4.h
new file mode 100644
--- /dev/null
+++ b/src/graphics/metal/metal_rt4.h
@@ -0,0 +1,234 @@
+/** Ray tracing on Metal 4: the scene's acceleration structures. BSD-3-Clause, see LICENSE. */
+#pragma once
+#import <Metal/Metal.h>
+
+#include <array>
+#include <cstdint>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace rex::graphics::metal {
+
+class GpuCommands;
+class GpuEncoder;
+
+// A draw's triangles for a BLAS: `ids` its distinct vertex indices (what its vertex shader gets as the vertex index,
+// in first-use order), `triangles` three positions into `ids` each. Triangle lists and strips (a strip restarts at
+// the all-ones index; its degenerate triangles are left out); `indices` null for a non-indexed draw (0..count-1),
+// else `count` indices of 2 or 4 bytes. False for another topology, or no triangle.
+bool MetalRtTriangles(MTLPrimitiveType topology, const void* indices, uint32_t index_size, uint32_t count,
+                      std::vector<uint32_t>& ids, std::vector<uint32_t>& triangles);
+
+// The check of the acceleration structures against the frame's depth (metal_rt_check): `rt_depth_check`, a thread
+// a sampled pixel, traces from the camera toward the point the depth puts there and counts into five uints: no
+// depth (sky or clear), no hit, a hit at the depth (within 2% + 0.1), a hit in front of it, a hit behind it.
+// Buffer 0 MetalRtCheckArgs, 1 and 3 the scene's levels, 2 the counts; texture 0 the depth (guest z/w, 0..1).
+struct MetalRtCheckArgs {
+  float clip_to_world[16];  // for row vectors: M column by column (as MetalRtCaptureArgs)
+  float camera[4];          // the camera's world position
+  uint32_t size[2], step[2];  // the depth texture's size; one pixel checked every step
+  float depth_map[4];         // z_min, z_max, scale, offset: depth = z_min + (z_max - z_min) (z/w scale + offset)
+  uint32_t scenes, pad[3];    // MetalRt4::Scenes's count (buffer 3 the second)
+};
+id<MTLComputePipelineState> MetalRtCheckPipeline(id<MTLDevice> device, std::string& error);
+
+// Ray-traced ambient occlusion (metal_rt_ao), four kernels of MetalRtEffectsLibrary over the frame's depth (as
+// MetalRtCheckArgs reads it), at half size but the last:
+// - rt_ao_trace: `rays` rays a pixel, a pattern that changes every frame (buffer 0 MetalRtAoArgs, 1 and 2 the
+//   scene's levels;
+//   texture 0 the depth, 1 out: RG16Float, the unoccluded share and the distance to the camera, 0 for the sky);
+//   With `checkerboard`, half the pixels a frame (the other half -1: no sample);
+// - rt_ao_temporal: blended with the last frames' (texture 0 the depth, 1 rt_ao_trace's, 2 the history, 3 out:
+//   RGBA16Float, the AO, the distance, the frames blended), the history reprojected by the last frame's camera
+//   and dropped where its distance doesn't match (disocclusion, a cut);
+// - rt_ao_blur: a depth-aware 5x5 blur (texture 0 in, 1 out), less the more frames are in;
+// - rt_ao_apply, full size: texture 0 the depth, 1 the AO, 2 the scene's colour, 3 out: the colour times the AO.
+struct MetalRtAoArgs {
+  float clip_to_world[16];
+  float world_to_last_clip[16];  // the last frame's view-projection (as clip_to_world, column by column)
+  float camera[4], last_camera[4];
+  uint32_t size[2], half_size[2];
+  float depth_map[4];
+  float radius, strength, bias, sharpness;
+  uint32_t rays, frame, history, history_valid;  // history: frames blended at most
+  uint32_t scenes;                               // MetalRt4::Scenes's count (buffer 2 the second)
+  float distance;                                // AO out to this far from the camera (fading over the last quarter)
+  uint32_t checkerboard;                         // rays at half the pixels a frame (alternating), the history the rest
+  uint32_t pad;
+};
+// Ray-traced sun shadows (metal_rt_shadows), `rt_shadow_mask` of MetalRtEffectsLibrary: the game's screen-space
+// sun mask (a tile's, resolved at phase 0x4000: 8_8_8_8, 16/255 where the sun doesn't reach, more where it does)
+// darkened where a ray toward the sun meets the scene: floor + (mask - floor) * visibility, so the game's own
+// shadows stay and ours add to them. A thread a mask texel: buffer 0 MetalRtShadowArgs, 1 and 2 the scene's
+// TLASes, 3 counts (four uints: the game's mask lit or not by the ray's verdict, MetalRtShadowArgs::counts);
+// texture 0 the tile's depth target (host depth), 1 the mask (read and written).
+struct MetalRtShadowArgs {
+  float clip_to_world[16];
+  float sun[4];           // toward the sun (world)
+  float camera[4];
+  float depth_map[4];     // host depth: z_min, z_max, ndc scale, ndc offset (as MetalRtCheckArgs's)
+  float viewport[4];      // the tile's host viewport (target texels): x, y offset, width, height
+  float ndc[4];           // its NDC scale x, y and offset x, y (guest NDC to host)
+  uint32_t size[2];       // the mask's texels
+  uint32_t origin[2], samples[2], tex_ss[2];  // depth texel of a mask texel: (origin + p samples) / tex_ss * rs
+  uint32_t rs, scenes, mode, counts;  // mode 0: darken the mask, 1: show the rays' verdict only; counts: count
+  float floor_value, distance, reach, pad;  // the mask's sunless value; the rays' length; shadows this far out
+  // Upscaling: the resolve read the squeezed scene stretched (MetalResolve's stretched(): host pixel q of the
+  // target at ((2q + 1) num) / (2 den), at most num - 1); the depth texel is that one.
+  uint32_t stretch, pad2;
+  uint32_t stretch_num[2], stretch_den[2];
+};
+id<MTLLibrary> MetalRtEffectsLibrary(id<MTLDevice> device, std::string& error);
+
+// The frame's geometry for ray queries (macOS 26, a device with ray tracing): a bottom-level acceleration
+// structure (BLAS) per mesh, cached across frames, and instances in two TLASes a ray query traces one after the
+// other (Scenes; the nearer hit counts):
+// - the static one: every placement (a mesh at a transform) seen in two frames or more, kept while out of view for
+//   `keep_frames` after it was last seen (off-screen occluders: the game draws only what is in view), rebuilt every
+//   `static_frames` frames when it changed, and sooner (four frames) when one of its placements is gone: not drawn
+//   though in view (its bounds in the frustum: the game swapped a level of detail, or it moved), or moved away (a
+//   placement of the same mesh new this frame within 30 m, as a car that stood still drives off);
+// - the frame's, rebuilt every frame: this frame's placements not in the static one (new ones, and what moves).
+// A TLAS build costs about 0.5 ms however few its instances (2,000: 0.7 to 0.9 ms in a race on the M5). Not one
+// TLAS holding the other (multi-level instancing): rays through three levels were 3 to 5 times slower in a race.
+// Rebuilding a city's worth of triangles every frame is out (1 M triangles: 13 to 18 ms).
+//
+// - Meshes are the caller's: a key that stays the same while the triangles do (guest memory ranges, the draw's
+//   shape), and positions in the space the instances' transforms take from (object space, or world space with an
+//   identity transform). Their build is recorded at the next Build, at most `build_budget` triangles a frame;
+//   meshes over the budget are dropped (their memory is the frame's), and added again by the caller a later frame.
+// - Meshes unused for `idle_frames` frames are dropped, the least recently used first when over `memory_budget`
+//   (the static level holds its BLASes while it names them).
+// - Lifetimes: everything Build records is kept until the GPU is done (GpuCommands::Use); a command buffer that
+//   traces against the TLAS uses Use() first, which makes the levels and their BLASes resident for it.
+//
+// One thread (the GPU command thread).
+class API_AVAILABLE(macos(26.0)) MetalRt4 {
+ public:
+  struct Options {
+    uint32_t build_budget = 200000;        // triangles built a frame
+    uint64_t memory_budget = 512ull << 20; // BLAS bytes kept
+    uint32_t idle_frames = 300;            // frames a mesh stays unused before it goes
+    uint32_t max_instances = 8192;         // a level's
+    bool fast_build = false;               // meshes built for speed (PreferFastBuild) over tracing
+    bool static_level = true;              // false: one TLAS of this frame's placements
+    uint32_t static_frames = 15;           // frames between the static level's rebuilds (when it changed)
+    uint32_t keep_frames = 150;            // frames a placement stays in the static level once out of view
+  };
+  struct Stats {
+    uint64_t meshes = 0, mesh_bytes = 0, built = 0, built_triangles = 0, evicted = 0;
+    uint64_t instances = 0;          // the frame's TLAS's, frames summed
+    uint64_t static_instances = 0;   // the static TLAS's, frames summed
+    uint64_t static_builds = 0, moved = 0;  // static TLAS rebuilds; its placements dropped for moving away
+    uint64_t undrawn = 0;            // its placements dropped for being in view and not drawn
+    uint64_t duplicates = 0;         // placements added twice in a frame
+    uint64_t over_budget = 0;        // meshes left for a later frame
+    uint64_t skipped_instances = 0;  // their mesh not built yet
+  };
+
+  bool Init(id<MTLDevice> device, const Options& options, std::string& log);
+  bool ready() const { return device_ != nil; }
+
+  // Whether the mesh is built or added this frame; marks it used this frame.
+  bool HasMesh(uint64_t key);
+  // A mesh, built at the next Build: positions (float3, `vertex_stride` bytes apart) and `triangle_count` triangles
+  // of uint32 indices, in GPU memory that holds them until the GPU is done with that Build (the caller's: written
+  // by the GPU before Build, such as by a capture dispatch on the same encoder, is fine).
+  void AddMesh(uint64_t key, MTL4BufferRange vertices, uint32_t vertex_stride, MTL4BufferRange indices,
+               uint32_t triangle_count);
+  // A mesh's bounds in its space (from its capture, a few frames after AddMesh): what lets a placement out of view
+  // be told from one the game no longer draws.
+  void SetMeshBounds(uint64_t key, const float lo[3], const float hi[3]);
+  // This frame's placement of a mesh: `id` the same while the mesh and transform are (a hash of both), a 4x3
+  // column-major object-to-world transform (columns 0-2 the basis, 3 the translation), the mask ray queries filter
+  // on, and a user id (the shaders' instance_id). False: added already this frame.
+  bool AddInstance(uint64_t id, uint64_t key, const float transform[12], uint8_t mask, uint32_t user_id);
+
+  // Records the waiting BLAS builds (within the budget) and this frame's TLASes on the command buffer's compute
+  // encoder; returns the frame's TLAS (nil: no instance of its own). Call after the AddInstances to trace with; a
+  // frame may Build again (twice at most) with what was added since: the static TLAS is rebuilt (when due) at the
+  // frame's first Build only, the frame's TLAS each time (of all the frame's placements).
+  id<MTLAccelerationStructure> Build(GpuCommands& commands, GpuEncoder& compute, const float* view_projection);
+  // Build's two steps: the new meshes' BLASes, then the levels.
+  void BuildMeshes(GpuEncoder& compute);
+  // `view_projection`: the camera's (row vectors, p' = p M; M row by row), for what is in view.
+  id<MTLAccelerationStructure> BuildScene(GpuCommands& commands, GpuEncoder& compute, const float* view_projection);
+  // The TLASes to trace, the frame's first: their count (0: nothing to trace).
+  uint32_t Scenes(std::array<id<MTLAccelerationStructure>, 2>& scenes) const;
+  // Makes the TLASes and the BLASes they hold resident for `commands` (a command buffer tracing).
+  void Use(GpuCommands& commands);
+  // The frame's end: unused meshes go.
+  void EndFrame();
+  Stats TakeStats();
+
+ private:
+  struct Mesh {
+    id<MTLAccelerationStructure> blas = nil;
+    float lo[3], hi[3];
+    bool bounded = false;  // lo and hi set
+    uint32_t triangles = 0;
+    uint64_t bytes = 0;
+    uint64_t used_frame = 0;
+  };
+  id<MTLBuffer> Scratch(size_t size);
+  struct PendingBuild {
+    id<MTLAccelerationStructure> structure;
+    MTL4AccelerationStructureDescriptor* descriptor;
+    NSUInteger scratch_offset, scratch_size;
+  };
+  std::vector<PendingBuild> builds_;  // to record together (RecordBuilds)
+  void RecordBuilds(GpuEncoder& compute);
+
+  // A level: six of each (built up to twice a frame, and the GPU may still trace the last two frames').
+  struct Level {
+    std::array<id<MTLAccelerationStructure>, 6> structures{};
+    std::array<id<MTLBuffer>, 6> descriptors{};
+    std::array<NSUInteger, 6> capacity{};
+    uint32_t ring = 0;
+  };
+  // `level`'s next structure, of `descriptors_` (its instances), its build added to builds_; nil if none or out of
+  // memory.
+  id<MTLAccelerationStructure> PrepareLevel(Level& level, GpuCommands& commands);
+  // The static TLAS again (prepared), if its placements changed (or `force`).
+  void BuildStatic(GpuCommands& commands, bool force);
+  bool Describe(uint64_t key, const std::array<float, 12>& transform, uint8_t mask, uint32_t user_id,
+                std::vector<id<MTLAccelerationStructure>>& blases);
+
+  id<MTLDevice> device_ = nil;
+  Options options_;
+  std::unordered_map<uint64_t, Mesh> meshes_;
+  struct Waiting { uint64_t key; MTL4BufferRange vertices, indices; uint32_t vertex_stride, triangles; };
+  std::vector<Waiting> waiting_;  // this frame's meshes to build, in AddMesh order
+  struct Placement {
+    uint64_t key;
+    std::array<float, 12> transform;
+    uint8_t mask;
+    uint32_t user_id;
+    uint64_t first_seen, last_seen;  // frame_
+    bool in_static = false;
+    bool boxed = false;  // lo and hi set: the world bounds (from the mesh's)
+    float lo[3], hi[3];
+  };
+  std::unordered_map<uint64_t, Placement> placements_;  // by id
+  std::vector<uint64_t> frame_ids_;                     // this frame's placements
+  std::vector<MTLIndirectAccelerationStructureInstanceDescriptor> descriptors_;  // a level's, being built
+  Level static_level_, top_level_;
+  id<MTLAccelerationStructure> static_ = nil;              // the static level (nil: none)
+  std::vector<id<MTLAccelerationStructure>> static_blases_;  // its BLASes (held)
+  uint64_t static_frame_ = 0;                               // frame_ it was built
+  bool static_dirty_ = false;                               // a placement of it moved away
+  uint64_t built_frame_ = ~0ull;                            // frame_ of the last Build
+  // The last Build's frustum (EndFrame's look at what is gone: DropGone), and the frame it was of.
+  float planes_[5][4] = {};
+  uint64_t planes_frame_ = ~0ull;
+  size_t frame_instances_ = 0;                              // the frame's TLAS's, its last Build
+  void DropGone();
+  std::vector<id<MTLAccelerationStructure>> frame_blases_;  // the top level's
+  id<MTLAccelerationStructure> current_ = nil;
+  id<MTLBuffer> scratch_ = nil;
+  uint64_t frame_ = 0, mesh_bytes_ = 0;
+  Stats stats_;
+};
