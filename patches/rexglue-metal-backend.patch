+    }
+    [rec_->tables[s] setSamplerState:sampler ? sampler.gpuResourceID : MTLResourceID{} atIndex:index];
+    return;
+  }
+  if (kind_ != Kind::kRender) [COMPUTE3 setSamplerState:sampler atIndex:index];
+  else if (stage == GpuStage::kVertex) [RENDER3 setVertexSamplerState:sampler atIndex:index];
+  else [RENDER3 setFragmentSamplerState:sampler atIndex:index];
