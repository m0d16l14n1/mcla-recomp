+/**
+ * @file        graphics/metal/metal_shader_translator.h
+ * @brief       Guest microcode to MSL: the SDK's SPIR-V translator, then SPIRV-Cross (plain C++)
+ *
+ * Added by the mcla-recomp macOS fork (patches/rexglue-metal-backend.patch). The same translator as the Vulkan
+ * backend, and the same SPIR-V to MSL step MoltenVK performs (the SDK's SPIRV-Cross is MoltenVK's), so that what
+ * draws correctly through MoltenVK translates the same way here. Plain C++ behind this header: the translator's
+ * headers bring Vulkan's C++ bindings, which do not compile as Objective-C++.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+#include <rex/graphics/primitive_processor.h>
+#include <rex/graphics/util/draw.h>
+
+#include <rex/graphics/pipeline/shader/shader.h>
+#include <rex/graphics/registers.h>
+#include <rex/string/buffer.h>
+
+namespace rex::graphics {
+class RegisterFile;
+class SpirvShaderTranslator;
+}  // namespace rex::graphics
+
+namespace rex::graphics::metal {
+
+struct MetalTextureBinding {
+  uint32_t index, fetch_constant;
+  xenos::FetchOpDimension dimension;
+  bool is_signed;
+};
+struct MetalSamplerBinding {
+  uint32_t index, fetch_constant;
+  xenos::TextureFilter mag_filter, min_filter, mip_filter;
+  xenos::AnisoFilter aniso_filter;
+};
+struct MetalShaderBindings {
+  std::vector<MetalTextureBinding> textures;
+  std::vector<MetalSamplerBinding> samplers;
+};
+std::unique_ptr<Shader> CreateMetalShader(xenos::ShaderType type, uint64_t hash,
+                                        const uint32_t* code, uint32_t count);
+// Buffer slots 0..4 are system, VS float, PS float, bool/loop, fetch. Slot 5 is physical memory.
+std::vector<uint8_t> BuildMetalSystemConstants(const RegisterFile& regs,
+    const PrimitiveProcessor::ProcessingResult& primitive, const draw_util::ViewportInfo& viewport);
+
+class MetalShaderTranslator {
+ public:
+  explicit MetalShaderTranslator(uint32_t edram_tile_count);
+  ~MetalShaderTranslator();
+
+  // The microcode analysis that the modifications depend on.
+  void EnsureAnalyzed(Shader& shader);
+
+  // The modifications of the current draw, as the Vulkan backend chooses them (interpolators both stages use,
+  // the pixel shader's parameter generation). The shaders must be analyzed. pixel_shader may be null.
+  void GetDrawModifications(const RegisterFile& regs, const Shader& vertex_shader, const Shader* pixel_shader,
+                            uint64_t& vertex_modification_out, uint64_t& pixel_modification_out,
+                            Shader::HostVertexShaderType host_type = Shader::HostVertexShaderType::kVertex) const;
+
+  enum class Result {
+    kExisting,         // translated before (the translation is returned)
+    kNew,              // translated now: msl_out holds the MSL
+    kTranslateFailed,  // the SPIR-V translator failed
+    kMslFailed,        // SPIRV-Cross refused the SPIR-V: error_out says why
+  };
+  Result Translate(Shader& shader, uint64_t modification, Shader::Translation*& translation_out,
+                   std::string& msl_out, std::string& error_out);
+  const MetalShaderBindings& bindings(const Shader::Translation* t) const { return bindings_.at(t); }
+
+ private:
+  std::unordered_map<const Shader::Translation*, MetalShaderBindings> bindings_;
+  std::unique_ptr<SpirvShaderTranslator> translator_;
+  string::StringBuffer ucode_disasm_buffer_;
+};
+
+}  // namespace rex::graphics::metal
diff --git a/src/graphics/metal/metal_shaders.h b/src/graphics/metal/metal_shaders.h
new file mode 100644
--- /dev/null
+++ b/src/graphics/metal/metal_shaders.h
@@ -0,0 +1,70 @@
+/**
+ * @file        graphics/metal/metal_shaders.h
+ * @brief       Guest shaders to Metal libraries: MetalShaderTranslator's MSL through Metal's compiler
+ *
+ * Added by the mcla-recomp macOS fork (patches/rexglue-metal-backend.patch). Objective-C++ only.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#if !defined(__OBJC__)
+#error "metal_shaders.h is for the Objective-C++ sources of the Metal backend"
+#endif
+
+#import <Metal/Metal.h>
+
+#include <atomic>
+#include <cstdint>
+#include <mutex>
+#include <condition_variable>
+#include <string>
+#include <unordered_map>
+
+#include "metal_shader_translator.h"
+
+namespace rex::graphics::metal {
+
+class MetalShaderCompiler {
+ public:
+  struct Stats {
+    std::atomic<uint32_t> translated{0};        // guest microcode to SPIR-V to MSL
+    std::atomic<uint32_t> translate_failed{0};  // the SPIR-V translator failed
+    std::atomic<uint32_t> msl_failed{0};        // SPIRV-Cross refused the SPIR-V
+    std::atomic<uint32_t> compiled{0};          // Metal compiled the MSL
+    std::atomic<uint32_t> compile_failed{0};
+    std::atomic<uint32_t> pending{0};           // Metal compiles not finished yet
+    std::atomic<uint64_t> translate_us{0};      // microcode to MSL, summed
+    std::atomic<uint64_t> compile_us{0};        // Metal compile time, summed (on Metal's threads)
+  };
+
+  MetalShaderCompiler(id<MTLDevice> device, uint32_t edram_tile_count);
+  ~MetalShaderCompiler();
+  void Wait();
+
+  MetalShaderTranslator& translator() { return translator_; }
+
+  // Translates this modification of the shader once and starts its Metal compile. Command processor thread.
+  void Request(Shader& shader, uint64_t modification);
+
+  // The compiled library of a translation, nil while compiling or after a failure. Any thread.
+  id<MTLLibrary> GetLibrary(const Shader::Translation* translation) const;
+
+  const Stats& stats() const { return stats_; }
+
+ private:
+  void Dump(const Shader& shader, uint64_t modification, const std::string& msl, const char* error) const;
+
+  id<MTLDevice> device_;
+  MetalShaderTranslator translator_;
+  MTLCompileOptions* compile_options_;
+  Stats stats_;
+
+  mutable std::mutex libraries_mutex_;
+  std::condition_variable libraries_ready_;
+  std::unordered_map<const Shader::Translation*, id<MTLLibrary>> libraries_;
+};
+
+}  // namespace rex::graphics::metal
diff --git a/src/graphics/metal/metal_shaders.mm b/src/graphics/metal/metal_shaders.mm
new file mode 100644
--- /dev/null
+++ b/src/graphics/metal/metal_shaders.mm
@@ -0,0 +1,139 @@
+/**
+ * @file        graphics/metal/metal_shaders.mm
+ * @brief       Guest shaders to Metal (see metal_shaders.h)
+ *
+ * Added by the mcla-recomp macOS fork (patches/rexglue-metal-backend.patch).
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include "metal_shaders.h"
+
+#include <chrono>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <vector>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+REXCVAR_DEFINE_STRING(metal_shader_dump_dir, "", "GPU/Metal",
+                      "Development: a folder to write the MSL of the guest shaders Metal could not compile "
+                      "(with the compiler's message), or of all of them with metal_shader_dump_all");
+REXCVAR_DEFINE_BOOL(metal_shader_dump_all, false, "GPU/Metal",
+                    "Development: with metal_shader_dump_dir, write the MSL of every guest shader");
+
+namespace rex::graphics::metal {
+
+namespace {
+
+uint64_t MicrosecondsSince(std::chrono::steady_clock::time_point start) {
+  return uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
+                      std::chrono::steady_clock::now() - start)
+                      .count());
+}
+
+}  // namespace
+
+MetalShaderCompiler::MetalShaderCompiler(id<MTLDevice> device, uint32_t edram_tile_count)
+    : device_(device), translator_(edram_tile_count) {
+  compile_options_ = [[MTLCompileOptions alloc] init];
+  compile_options_.languageVersion = MTLLanguageVersion3_0;
+  // The guest's float behaviour (no reassociation, NaN and infinity kept) over speed.
+  if (@available(macOS 15.0, *)) {
+    compile_options_.mathMode = MTLMathModeSafe;
+  } else {
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+    compile_options_.fastMathEnabled = NO;
+#pragma clang diagnostic pop
+  }
+}
+
+MetalShaderCompiler::~MetalShaderCompiler() { Wait(); }
+void MetalShaderCompiler::Wait() {
+  std::unique_lock<std::mutex> lock(libraries_mutex_);
+  libraries_ready_.wait(lock, [this] { return stats_.pending.load() == 0; });
+}
+
+void MetalShaderCompiler::Request(Shader& shader, uint64_t modification) {
+  Shader::Translation* translation = nullptr;
+  std::string msl, error;
+  const auto translate_start = std::chrono::steady_clock::now();
+  const MetalShaderTranslator::Result result =
+      translator_.Translate(shader, modification, translation, msl, error);
+  switch (result) {
+    case MetalShaderTranslator::Result::kExisting:
+      return;
+    case MetalShaderTranslator::Result::kTranslateFailed:
+      ++stats_.translate_failed;
+      REXGPU_WARN("Metal: shader {:016X} (modification {:016X}) did not translate to SPIR-V",
+                  shader.ucode_data_hash(), modification);
+      return;
+    case MetalShaderTranslator::Result::kMslFailed:
+      ++stats_.msl_failed;
+      REXGPU_WARN("Metal: SPIRV-Cross refused shader {:016X} (modification {:016X}): {}", shader.ucode_data_hash(),
+                  modification, error);
+      return;
+    case MetalShaderTranslator::Result::kNew:
+      break;
+  }
+  ++stats_.translated;
+  stats_.translate_us += MicrosecondsSince(translate_start);
+  if (REXCVAR_GET(metal_shader_dump_all)) {
+    Dump(shader, modification, msl, nullptr);
+  }
+
+  ++stats_.pending;
+  const auto compile_start = std::chrono::steady_clock::now();
+  const uint64_t hash = shader.ucode_data_hash();
+  const Shader* shader_ptr = &shader;
+  // The handler runs on a Metal thread; it copies what it needs (the MSL for a dump, the translation pointer as
+  // the key: translations live as long as their shader, which the command processor keeps).
+  std::string msl_copy = msl;
+  [device_ newLibraryWithSource:[NSString stringWithUTF8String:msl.c_str()]
+                        options:compile_options_
+              completionHandler:^(id<MTLLibrary> library, NSError* error) {
+                stats_.compile_us += MicrosecondsSince(compile_start);
+
+                if (!library) {
+                  ++stats_.compile_failed;
+                  const char* message = error ? [error.localizedDescription UTF8String] : "?";
+                  REXGPU_WARN("Metal: shader {:016X} (modification {:016X}) did not compile: {}", hash,
+                              modification, std::string(message).substr(0, 300));
+                  Dump(*shader_ptr, modification, msl_copy, message);
+                  { std::lock_guard<std::mutex> lock(libraries_mutex_); --stats_.pending; libraries_ready_.notify_all(); }
+                  return;
+                }
+                ++stats_.compiled;
+                { std::lock_guard<std::mutex> lock(libraries_mutex_);
+                  libraries_[translation] = library; --stats_.pending; libraries_ready_.notify_all(); }
+              }];
+}
+
+id<MTLLibrary> MetalShaderCompiler::GetLibrary(const Shader::Translation* translation) const {
+  std::lock_guard<std::mutex> lock(libraries_mutex_);
+  auto it = libraries_.find(translation);
+  return it != libraries_.end() ? it->second : nil;
+}
+
+void MetalShaderCompiler::Dump(const Shader& shader, uint64_t modification, const std::string& msl,
+                               const char* error) const {
+  const std::string dir = REXCVAR_GET(metal_shader_dump_dir);
+  if (dir.empty()) {
+    return;
+  }
+  std::error_code ec;
+  std::filesystem::create_directories(dir, ec);
+  const std::string stem = fmt::format("{}/{}_{:016X}_{:016X}", dir,
+                                       shader.type() == xenos::ShaderType::kVertex ? "vs" : "ps",
+                                       shader.ucode_data_hash(), modification);
+  std::ofstream(stem + ".metal") << msl;
+  if (error) {
+    std::ofstream(stem + ".error.txt") << error;
+  }
+}
+
+}  // namespace rex::graphics::metal
