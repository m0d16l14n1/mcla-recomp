+// HDR output's compute shaders, the Vulkan backend's SPIR-V (made from the SDK's XeSL), as MSL at first use.
+namespace hdr_spirv {
+#include "../shaders/vulkan_spirv/hdr_refresh_cs.h"
+#include "../shaders/vulkan_spirv/hdr_refresh_fg_cs.h"
+#include "../shaders/vulkan_spirv/hdr_scene_mcla_cs.h"
