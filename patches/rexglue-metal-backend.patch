+bool MetalRtTriangles(MTLPrimitiveType topology, const void* indices, uint32_t index_size, uint32_t count,
+                      std::vector<uint32_t>& ids, std::vector<uint32_t>& triangles) {
+  ids.clear();
+  triangles.clear();
+  if (topology != MTLPrimitiveTypeTriangle && topology != MTLPrimitiveTypeTriangleStrip) return false;
+  const uint32_t restart = index_size == 2 ? 0xFFFFu : 0xFFFFFFFFu;
+  auto index = [&](uint32_t i) -> uint32_t {
+    if (!indices) return i;
+    if (index_size == 2) return static_cast<const uint16_t*>(indices)[i];
+    return static_cast<const uint32_t*>(indices)[i];
+  };
+  std::unordered_map<uint32_t, uint32_t> slot_of;
+  slot_of.reserve(count);
+  auto slot = [&](uint32_t id) {
+    auto [it, added] = slot_of.try_emplace(id, uint32_t(ids.size()));
+    if (added) ids.push_back(id);
+    return it->second;
+  };
+  auto add = [&](uint32_t a, uint32_t b, uint32_t c) {
+    if (a == b || b == c || a == c) return;  // degenerate (a strip's joins)
+    triangles.push_back(slot(a));
+    triangles.push_back(slot(b));
+    triangles.push_back(slot(c));
+  };
+  if (topology == MTLPrimitiveTypeTriangle) {
+    for (uint32_t i = 0; i + 2 < count; i += 3) add(index(i), index(i + 1), index(i + 2));
+  } else {
+    // Winding doesn't matter (the rays see both sides), so every triangle of a strip goes as it comes.
+    uint32_t run = 0;  // the strip's indices since its start or last restart
+    uint32_t a = 0, b = 0;
+    for (uint32_t i = 0; i < count; ++i) {
+      const uint32_t c = index(i);
+      if (indices && c == restart) {
+        run = 0;
+        continue;
+      }
+      if (run >= 2) add(a, b, c);
+      a = b;
+      b = c;
+      ++run;
+    }
+  }
+  return !triangles.empty();
+}
+
+id<MTLComputePipelineState> MetalRtCheckPipeline(id<MTLDevice> device, std::string& error) {
+  static const char kSource[] = R"(
+#include <metal_stdlib>
+#include <metal_raytracing>
+using namespace metal;
+using namespace metal::raytracing;
+struct Args { float4x4 clip_to_world; float4 camera; uint2 size; uint2 step; float4 depth_map; uint scenes, pad0, pad1, pad2; };
+kernel void rt_depth_check(constant Args& a [[buffer(0)]], instance_acceleration_structure scene [[buffer(1)]],
+                           device atomic_uint* counts [[buffer(2)]],
+                           instance_acceleration_structure statics [[buffer(3)]],
+                           texture2d_array<float> depth [[texture(0)]],
+                           uint2 tid [[thread_position_in_grid]]) {
+  const uint2 pixel = tid * a.step;
+  if (any(pixel >= a.size)) return;
+  const float z = depth.read(pixel, 0).r;
+  if (!(z > 0.0f && z < 1.0f)) {
+    atomic_fetch_add_explicit(&counts[0], 1u, memory_order_relaxed);
+    return;
+  }
+  const float clip_z = ((z - a.depth_map.x) / (a.depth_map.y - a.depth_map.x) - a.depth_map.w) / a.depth_map.z;
+  const float2 ndc = float2((float(pixel.x) + 0.5f) / float(a.size.x) * 2.0f - 1.0f,
+                            1.0f - (float(pixel.y) + 0.5f) / float(a.size.y) * 2.0f);
+  const float4 w = float4(ndc, clip_z, 1.0f) * a.clip_to_world;
+  const float3 to = w.xyz / w.w - a.camera.xyz;
+  const float distance = length(to);
+  ray r(a.camera.xyz, to / distance, 0.01f, distance * 1.5f + 1.0f);
+  intersector<instancing, triangle_data> i;
+  i.assume_geometry_type(geometry_type::triangle);
+  i.force_opacity(forced_opacity::opaque);
+  // The nearer hit of the scene's levels.
+  float nearest = INFINITY;
+  auto hit = i.intersect(r, scene);
+  if (hit.type != intersection_type::none) nearest = r.max_distance = hit.distance;
+  if (a.scenes > 1u) {
+    hit = i.intersect(r, statics);
+    if (hit.type != intersection_type::none) nearest = hit.distance;
+  }
+  uint bucket = 1;
+  if (isfinite(nearest))
+    bucket = abs(nearest - distance) <= 0.02f * distance + 0.1f ? 2 : nearest < distance ? 3 : 4;
+  atomic_fetch_add_explicit(&counts[bucket], 1u, memory_order_relaxed);
+}
+)";
+  NSError* ns_error = nil;
+  id<MTLLibrary> library = [device newLibraryWithSource:@(kSource) options:nil error:&ns_error];
+  id<MTLFunction> function = [library newFunctionWithName:@"rt_depth_check"];
+  id<MTLComputePipelineState> pipeline = function ? [device newComputePipelineStateWithFunction:function
+                                                                                          error:&ns_error] : nil;
+  if (!pipeline) error = ns_error ? [ns_error.localizedDescription UTF8String] : "no rt_depth_check";
+  return pipeline;
+}
