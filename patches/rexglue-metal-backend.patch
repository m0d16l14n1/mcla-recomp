@@ -0,0 +1,177 @@
+/**
+ * @file        graphics/metal/metal_shaders.mm
+ * @brief       Guest shaders to Metal (see metal_shaders.h)
+ *
+ * Added by the mcla-recomp macOS fork (patches/rexglue-metal-backend.patch).
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include "metal_shaders.h"
+
+#include <chrono>
+#include <thread>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <vector>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+REXCVAR_DEFINE_STRING(metal_shader_dump_dir, "", "GPU/Metal",
+                      "Development: a folder to write the MSL of the guest shaders Metal could not compile "
+                      "(with the compiler's message), or of all of them with metal_shader_dump_all");
+REXCVAR_DEFINE_BOOL(metal_shader_dump_all, false, "GPU/Metal",
+                    "Development: with metal_shader_dump_dir, write the MSL of every guest shader");
+
+namespace rex::graphics::metal {
+
+namespace {
+
+uint64_t MicrosecondsSince(std::chrono::steady_clock::time_point start) {
+  return uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
+                      std::chrono::steady_clock::now() - start)
+                      .count());
+}
+
+}  // namespace
+
+MetalShaderCompiler::MetalShaderCompiler(id<MTLDevice> device, uint32_t edram_tile_count)
+    : device_(device), translator_(edram_tile_count), edram_tile_count_(edram_tile_count) {
+  compile_options_ = [[MTLCompileOptions alloc] init];
+  compile_options_.languageVersion = MTLLanguageVersion3_0;
+  // The guest's float behaviour (no reassociation, NaN and infinity kept) over speed.
+  if (@available(macOS 15.0, *)) {
+    compile_options_.mathMode = MTLMathModeSafe;
+  } else {
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+    compile_options_.fastMathEnabled = NO;
+#pragma clang diagnostic pop
+  }
+}
+
+MetalShaderCompiler::~MetalShaderCompiler() { Wait(); }
+void MetalShaderCompiler::Wait() {
+  std::unique_lock<std::mutex> lock(libraries_mutex_);
+  libraries_ready_.wait(lock, [this] { return stats_.pending.load() == 0; });
+}
+
+void MetalShaderCompiler::Request(Shader& shader, uint64_t modification) {
+  Shader::Translation* translation = nullptr;
+  std::string msl, error;
+  const auto translate_start = std::chrono::steady_clock::now();
+  const MetalShaderTranslator::Result result =
+      translator_.Translate(shader, modification, translation, msl, error);
+  switch (result) {
+    case MetalShaderTranslator::Result::kExisting:
+      return;
+    case MetalShaderTranslator::Result::kTranslateFailed:
+      ++stats_.translate_failed;
+      REXGPU_WARN("Metal: shader {:016X} (modification {:016X}) did not translate to SPIR-V",
+                  shader.ucode_data_hash(), modification);
+      return;
+    case MetalShaderTranslator::Result::kMslFailed:
+      ++stats_.msl_failed;
+      REXGPU_WARN("Metal: SPIRV-Cross refused shader {:016X} (modification {:016X}): {}", shader.ucode_data_hash(),
+                  modification, error);
+      return;
+    case MetalShaderTranslator::Result::kNew:
+      break;
+  }
+  ++stats_.translated;
+  stats_.translate_us += MicrosecondsSince(translate_start);
+  if (REXCVAR_GET(metal_shader_dump_all)) {
+    Dump(shader, modification, msl, nullptr);
+  }
+
+  if (on_new_translation) on_new_translation(shader, modification);
+  Compile(shader, modification, translation, msl);
+}
+
+void MetalShaderCompiler::Compile(const Shader& shader, uint64_t modification, Shader::Translation* translation,
+                                  const std::string& msl) {
+  ++stats_.pending;
+  const auto compile_start = std::chrono::steady_clock::now();
+  const uint64_t hash = shader.ucode_data_hash();
+  const Shader* shader_ptr = &shader;
+  // The handler runs on a Metal thread; it copies what it needs (the MSL for a dump, the translation pointer as
+  // the key: translations live as long as their shader, which the command processor keeps).
+  std::string msl_copy = msl;
+  [device_ newLibraryWithSource:[NSString stringWithUTF8String:msl.c_str()]
+                        options:compile_options_
+              completionHandler:^(id<MTLLibrary> library, NSError* error) {
+                stats_.compile_us += MicrosecondsSince(compile_start);
+
+                if (!library) {
+                  ++stats_.compile_failed;
+                  const char* message = error ? [error.localizedDescription UTF8String] : "?";
+                  REXGPU_WARN("Metal: shader {:016X} (modification {:016X}) did not compile: {}", hash,
+                              modification, std::string(message).substr(0, 300));
+                  Dump(*shader_ptr, modification, msl_copy, message);
+                  { std::lock_guard<std::mutex> lock(libraries_mutex_); --stats_.pending; libraries_ready_.notify_all(); }
+                  return;
+                }
+                ++stats_.compiled;
+                { std::lock_guard<std::mutex> lock(libraries_mutex_);
+                  libraries_[translation] = library; --stats_.pending; libraries_ready_.notify_all(); }
+              }];
+}
+
+void MetalShaderCompiler::Warm(const std::vector<std::pair<Shader*, std::vector<uint64_t>>>& jobs) {
+  if (jobs.empty()) return;
+  const auto start = std::chrono::steady_clock::now();
+  uint32_t threads = std::max(1u, std::min<uint32_t>(uint32_t(jobs.size()), std::thread::hardware_concurrency() - 1));
+  std::vector<std::unique_ptr<MetalShaderTranslator>> translators;
+  for (uint32_t i = 0; i < threads; ++i) translators.push_back(std::make_unique<MetalShaderTranslator>(edram_tile_count_));
+  std::atomic<size_t> next{0};
+  std::atomic<uint32_t> translated{0};
+  std::vector<std::thread> workers;
+  for (uint32_t i = 0; i < threads; ++i) {
+    workers.emplace_back([&, i] {
+      MetalShaderTranslator& translator = *translators[i];
+      for (size_t job; (job = next.fetch_add(1)) < jobs.size();) {
+        Shader& shader = *jobs[job].first;
+        for (uint64_t modification : jobs[job].second) {
+          Shader::Translation* translation = nullptr;
+          std::string msl, error;
+          if (translator.Translate(shader, modification, translation, msl, error) != MetalShaderTranslator::Result::kNew)
+            continue;
+          ++translated; ++stats_.translated;
+          Compile(shader, modification, translation, msl);
+        }
+      }
+    });
+  }
+  for (auto& worker : workers) worker.join();
+  for (auto& translator : translators) translator_.AdoptBindings(*translator);
+  REXGPU_INFO("Metal shader warm-up: {} translations of {} shaders on {} threads in {} ms (Metal compiles go on)",
+              translated.load(), jobs.size(), threads, MicrosecondsSince(start) / 1000);
+}
+
+id<MTLLibrary> MetalShaderCompiler::GetLibrary(const Shader::Translation* translation) const {
+  std::lock_guard<std::mutex> lock(libraries_mutex_);
+  auto it = libraries_.find(translation);
+  return it != libraries_.end() ? it->second : nil;
+}
+
+void MetalShaderCompiler::Dump(const Shader& shader, uint64_t modification, const std::string& msl,
+                               const char* error) const {
+  const std::string dir = REXCVAR_GET(metal_shader_dump_dir);
+  if (dir.empty()) {
+    return;
+  }
+  std::error_code ec;
+  std::filesystem::create_directories(dir, ec);
+  const std::string stem = fmt::format("{}/{}_{:016X}_{:016X}", dir,
+                                       shader.type() == xenos::ShaderType::kVertex ? "vs" : "ps",
+                                       shader.ucode_data_hash(), modification);
+  std::ofstream(stem + ".metal") << msl;
+  if (error) {
+    std::ofstream(stem + ".error.txt") << error;
+  }
+}
+
+}  // namespace rex::graphics::metal
