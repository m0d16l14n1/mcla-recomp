+void MetalCommandProcessor::WriteRegister(uint32_t index, uint32_t value) {
+  CommandProcessor::WriteRegister(index, value);
+  if (draw_ && index - uint32_t(XE_GPU_REG_SHADER_CONSTANT_000_X) <=
+                   uint32_t(XE_GPU_REG_SHADER_CONSTANT_LOOP_31 - XE_GPU_REG_SHADER_CONSTANT_000_X))
+    draw_->ConstantsWritten(index, index + 1);
+}
+
+void MetalCommandProcessor::WriteRegistersFromMem(uint32_t start_index, uint32_t* base, uint32_t num_registers) {
+  if (!REXCVAR_GET(gpu_regwrite_bulk)) {
+    CommandProcessor::WriteRegistersFromMem(start_index, base, num_registers);  // through WriteRegister
+    return;
+  }
+  // Ordinary registers are copied in bulk; the few with side effects go one by one through WriteRegister.
+  uint32_t index = start_index;
+  const uint32_t end = start_index + num_registers;
+  while (index < end) {
+    if (index >= RegisterFile::kRegisterCount) {
+      CommandProcessor::WriteRegistersFromMem(index, base, end - index);
+      return;
+    }
+    uint32_t segment_end;
+    if (IsSpecialRegister(index)) {
+      segment_end = index + 1;
+      WriteRegister(index, memory::load_and_swap<uint32_t>(base));
+    } else {
+      segment_end = std::min(end, uint32_t(RegisterFile::kRegisterCount));
+      for (uint32_t special : {uint32_t(XE_GPU_REG_SCRATCH_REG0), uint32_t(XE_GPU_REG_COHER_STATUS_HOST),
+                               uint32_t(XE_GPU_REG_DC_LUT_RW_INDEX)})
+        if (special > index) segment_end = std::min(segment_end, special);
+      memory::copy_and_swap(register_file_->values + index, base, segment_end - index);
+      if (draw_) draw_->ConstantsWritten(index, segment_end);
+    }
+    base += segment_end - index;
+    index = segment_end;
+  }
+}
+
+void MetalCommandProcessor::WriteFenceValue(uint32_t address, uint32_t value) {
+  if (int32_t us = REXCVAR_GET(metal_fence_spin_us)) SpinMicroseconds(us);
+  // The guest's fence: written by the GPU after everything encoded before it, as the game may reuse the
+  // memory of a resolve (or rewrite a texture the GPU reads) once it sees the fence. Stored by the command
+  // processor at once, a resolve the GPU ran later overwrote what the game had put there since: the car
+  // fell through the city, 2026-11-01.
+  if (draw_ && draw_->WriteFence(address, value)) return;
+  CommandProcessor::WriteFenceValue(address, value);
+}
