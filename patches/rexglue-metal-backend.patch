@@ -0,0 +1,271 @@
+/** Metal resolve compute kernels. BSD-3-Clause, see LICENSE. */
+#pragma once
+namespace rex::graphics::metal {
+// The tiling expression is the shared texture_util::GetTiledOffset2D algorithm (Xenia, BSD-3-Clause).
+static const char* kMetalResolveSource = R"MSL(
+#include <metal_stdlib>
+using namespace metal;
+struct ResolveConstants {
+  uint2 origin, size, dest_offset;
+  uint pitch, address, format, endian, swap, write_memory;
+  float scale;
+  uint2 samples;  // EDRAM samples a pixel covers: 1x1, 1x2 (MSAA 2x) or 2x2 (4x).
+  uint sample_select;  // 0 to 3: that sample; 4: the average.
+  uint extent_start, extent_end;  // the guest memory the resolve may write (its copy_dest_extent)
+};
+uint2 sample_offset(uint i, uint2 samples) {
+  return samples.x == 2 ? uint2(i & 1, i >> 1) : uint2(0, min(i, samples.y - 1));
+}
+uint tiled_offset(uint2 p, uint pitch, uint log_bpp) {
+  uint macro = ((p.x >> 5) + (p.y >> 5) * ((pitch + 31) >> 5)) << (log_bpp + 7);
+  uint micro = ((p.x & 7) + ((p.y & 14) << 2)) << log_bpp;
+  uint offset = macro + ((micro & ~15u) << 1) + (micro & 15) + ((p.y & 1) << 4);
+  return ((offset & ~511u) << 3) + ((p.y & 16) << 7) + ((offset & 448) << 2) +
+         (((((p.y & 8) >> 2) + (p.x >> 3)) & 3) << 6) + (offset & 63);
+}
+void store_raw(uint4 packed, uint log_bpp, uint2 p, constant ResolveConstants& c, device uchar* memory,
+    device atomic_uint* rejected) {
+  uint address = c.address + tiled_offset(p + c.dest_offset, c.pitch, log_bpp);
+  uint xor_mask = c.endian == 1 ? 1 : c.endian == 2 ? 3 : c.endian == 3 ? 2 : c.endian == 4 ? 7 : c.endian == 5 ? 15 : 0;
+  for (uint b = 0; b < (1u << log_bpp); ++b) {
+    uint a = (address + b) ^ xor_mask;
+    // Never outside what the guest gave the resolve: memory around it is the CPU's.
+    if (a >= c.extent_start && a < c.extent_end) memory[a] = uchar(packed[b >> 2] >> ((b & 3) * 8));
+    else atomic_fetch_add_explicit(rejected, 1u, memory_order_relaxed);
+  }
+}
+void store_guest(float4 value, uint2 p, constant ResolveConstants& c, device uchar* memory,
+    device atomic_uint* rejected) {
+  if (!c.write_memory) return;
+  uint4 packed = uint4(0); uint log_bpp = 2;
+  uint4 unorm8 = uint4(rint(saturate(value) * 255.0f));
+  uint4 unorm16 = uint4(rint(saturate(value) * 65535.0f));
+  switch (c.format) {
+    case 2: case 8: case 9: packed.x = unorm8.x; log_bpp = 0; break;
+    case 10: packed.x = unorm8.x | (unorm8.y << 8); log_bpp = 1; break;
+    case 6: case 14: case 50: packed.x = unorm8.x | (unorm8.y << 8) | (unorm8.z << 16) | (unorm8.w << 24); break;
+    case 7: case 54: { uint4 u = uint4(rint(saturate(value) * float4(1023, 1023, 1023, 3)));
+      packed.x = u.x | (u.y << 10) | (u.z << 20) | (u.w << 30); break; }
+    case 24: packed.x = unorm16.x; log_bpp = 1; break;
+    case 25: packed.x = unorm16.x | (unorm16.y << 16); break;
+    case 26: packed.xy = uint2(unorm16.x | (unorm16.y << 16), unorm16.z | (unorm16.w << 16)); log_bpp = 3; break;
+    case 30: packed.x = as_type<ushort>(half(value.x)); log_bpp = 1; break;
+    case 31: packed.x = as_type<uint>(half2(value.xy)); break;
+    case 32: packed.xy = as_type<uint2>(half4(value)); log_bpp = 3; break;
+    case 36: packed.x = as_type<uint>(value.x); break;
+    case 37: packed.xy = as_type<uint2>(value.xy); log_bpp = 3; break;
+    case 38: packed = as_type<uint4>(value); log_bpp = 4; break;
+    default: return;
+  }
+  store_raw(packed, log_bpp, p, c, memory, rejected);
+}
+// xenos::Float32To20e4 with rounding to nearest even.
+uint float32_to_20e4(float f) {
+  if (!(f > 0.0f)) return 0;
+  uint u = as_type<uint>(f);
+  if (u >= 0x3FFFFFF8u) return 0xFFFFFFu;
+  if (u < 0x38800000u) u = (0x800000u | (u & 0x7FFFFFu)) >> min(113u - (u >> 23), 24u);
+  else u += 0xC8000000u;
+  u += 3 + ((u >> 3) & 1);
+  return (u >> 3) & 0xFFFFFFu;
+}
+kernel void resolve_color(texture2d<float, access::read> source [[texture(0)]],
+    texture2d<float, access::write> destination [[texture(1)]],
+    constant ResolveConstants& c [[buffer(0)]], device uchar* memory [[buffer(1)]],
+    device atomic_uint* rejected [[buffer(2)]], uint2 p [[thread_position_in_grid]]) {
+  if (any(p >= c.size)) return;
+  uint2 base = c.origin + p * c.samples;
+  float4 value;
+  if (c.sample_select < 4) {
+    value = source.read(base + sample_offset(c.sample_select, c.samples));
+  } else {
+    value = float4(0);
+    for (uint y = 0; y < c.samples.y; ++y) for (uint x = 0; x < c.samples.x; ++x) value += source.read(base + uint2(x, y));
+    value /= float(c.samples.x * c.samples.y);
+  }
+  value *= c.scale;
+  if (c.swap) value = value.bgra;
+  destination.write(value, p);
+  store_guest(value, p, c, memory, rejected);
+}
+kernel void resolve_depth(depth2d<float, access::read> source [[texture(0)]],
+    texture2d<float, access::write> destination [[texture(1)]],
+    texture2d<uint, access::read> stencil [[texture(2)]],
+    constant ResolveConstants& c [[buffer(0)]], device uchar* memory [[buffer(1)]],
+    device atomic_uint* rejected [[buffer(2)]], uint2 p [[thread_position_in_grid]]) {
+  if (any(p >= c.size)) return;
+  uint2 at = c.origin + p * c.samples + sample_offset(c.sample_select, c.samples);
+  float depth = source.read(at) * c.scale;
+  destination.write(float4(depth), p);
+  // Depth resolves write the EDRAM depth format whatever the destination format says: 24-bit
+  // depth over 8-bit stencil (the stencil read through an X32_Stencil8 view of the target).
+  if (!c.write_memory) return;
+  uint d24 = c.format == 23 ? float32_to_20e4(depth) : uint(rint(saturate(depth) * 16777215.0f));
+  store_raw(uint4((d24 << 8) | (stencil.read(at).r & 0xFFu), 0, 0, 0), 2, p, c, memory, rejected);
+}
+// Guest texture memory to linear blocks, for a blit into the texture (any format, compressed too).
+struct LoadConstants {
+  uint src_base, slice_stride, row_pitch_bytes, pitch_blocks, log_bpp, ox, oy, tiled, xor_mask, bw, bh, convert;
+};
+float float20e4_to_32(uint f24) {
+  f24 &= 0xFFFFFFu;
+  if (!f24) return 0.0f;
+  uint mantissa = f24 & 0xFFFFFu, exponent = f24 >> 20;
+  if (!exponent) {
+    uint lz = clz(mantissa) - (32 - 21);
+    exponent = uint(1 - int(lz)); mantissa = (mantissa << lz) & 0xFFFFFu;
+  }
+  return as_type<float>(((exponent + 112) << 23) | (mantissa << 3));
+}
+kernel void load_texture(device const uchar* memory [[buffer(0)]], device uchar* out [[buffer(1)]],
+    constant LoadConstants& c [[buffer(2)]], uint3 p [[thread_position_in_grid]]) {
+  if (p.x >= c.bw || p.y >= c.bh) return;
+  uint bpb = 1u << c.log_bpp;
+  uint offset = c.tiled ? tiled_offset(uint2(p.x + c.ox, p.y + c.oy), c.pitch_blocks, c.log_bpp)
+                        : (p.y + c.oy) * c.row_pitch_bytes + (p.x + c.ox) * bpb;
+  uint src = c.src_base + p.z * c.slice_stride + offset;
+  uint dst = ((p.z * c.bh + p.y) * c.bw + p.x) * (c.convert >= 3 ? 4u : bpb);
+  bool inside = src + bpb <= 0x20000000u;
+  if (c.convert >= 3) {
+    // 16-bit packed, red in the low bits: 3 k_1_5_5_5, 4 k_5_6_5, 5 k_6_5_5, 6 k_4_4_4_4. Formats
+    // without alpha repeat blue there, like the Vulkan backend's RGBB swizzle.
+    uint v = inside ? (uint(memory[src ^ c.xor_mask]) | (uint(memory[(src + 1) ^ c.xor_mask]) << 8)) : 0u;
+    float4 f;
+    if (c.convert == 3) f = float4(v & 31u, (v >> 5) & 31u, (v >> 10) & 31u, 0) / 31.0f, f.w = float(v >> 15);
+    else if (c.convert == 4) f = float4(float(v & 31u) / 31.0f, float((v >> 5) & 63u) / 63.0f, float(v >> 11) / 31.0f, 0);
+    else if (c.convert == 5) f = float4(float(v & 31u) / 31.0f, float((v >> 5) & 31u) / 31.0f, float(v >> 10) / 63.0f, 0);
+    else f = float4(v & 15u, (v >> 4) & 15u, (v >> 8) & 15u, v >> 12) / 15.0f;
+    if (c.convert == 4 || c.convert == 5) f.w = f.z;
+    uint4 u = uint4(rint(saturate(f) * 255.0f));
+    for (uint i = 0; i < 4; ++i) out[dst + i] = uchar(u[i]);
+    return;
+  }
+  if (c.convert) {
+    // k_24_8 and k_24_8_FLOAT as R32Float depth, like a depth resolve's own texture.
+    uint v = 0;
+    for (uint i = 0; i < 4; ++i) v |= uint(inside ? memory[(src + i) ^ c.xor_mask] : 0) << (i * 8);
+    uint d24 = v >> 8;
+    float depth = c.convert == 1 ? float(d24 + (d24 >> 23)) * (1.0f / 16777216.0f) : float20e4_to_32(d24);
+    uint bits = as_type<uint>(depth);
+    for (uint i = 0; i < 4; ++i) out[dst + i] = uchar(bits >> (i * 8));
+    return;
+  }
+  for (uint i = 0; i < bpb; ++i) out[dst + i] = inside ? memory[(src + i) ^ c.xor_mask] : uchar(0);
+}
+struct PresentConstants { uint2 size; uint mode; };  // mode 0: as is, 1: 256-entry table, 2: PWL
+struct GammaRamp { uint table[256]; uint pwl[128 * 3]; };
+// DC_LUT_30_COLOR: blue in bits 0:9, green 10:19, red 20:29.
+float ramp_table(constant GammaRamp& g, float v, uint shift) {
+  return float((g.table[uint(saturate(v) * 255.0f + 0.5f)] >> shift) & 1023u) / 1023.0f;
+}
+// DC_LUT_PWL_DATA: 128 segments of 8 steps over the 10-bit input, base and delta in the high 10 of 16 bits.
+float ramp_pwl(constant GammaRamp& g, float v, uint channel) {
+  uint x = uint(saturate(v) * 1023.0f + 0.5f);
+  uint d = g.pwl[(x >> 3) * 3 + channel];
+  float value = float(d & 0xFFFFu) + float((x & 7u) * (d >> 16)) * 0.125f;
+  return saturate(value * 1.52737048e-05f);
+}
+kernel void present_color(texture2d_array<float, access::read> source [[texture(0)]],
+    texture2d<float, access::write> destination [[texture(1)]],
+    constant PresentConstants& c [[buffer(0)]], constant GammaRamp& g [[buffer(1)]],
+    uint2 p [[thread_position_in_grid]]) {
+  if (any(p >= c.size)) return;
+  float4 color = source.read(p, 0);
+  if (c.mode == 1) color.rgb = float3(ramp_table(g, color.r, 20), ramp_table(g, color.g, 10), ramp_table(g, color.b, 0));
+  else if (c.mode == 2) color.rgb = float3(ramp_pwl(g, color.r, 0), ramp_pwl(g, color.g, 1), ramp_pwl(g, color.b, 2));
+  destination.write(color, p);
+}
+
+// EDRAM ownership transfers: a target takes over the tiles another one (another format, pitch, or
+// depth against color) wrote since, as the same raw 32 bits per sample, like Xenos EDRAM.
+// Kinds: 0 k_8_8_8_8, 1 k_2_10_10_10, 2 k_2_10_10_10_FLOAT (7e3), 3 k_16_16, 4 k_16_16_FLOAT,
+// 5 k_32_FLOAT, 6 D24S8, 7 D24FS8 (the host keeps half of the guest's 20e4 depth).
+struct TransferConstants {
+  uint dst_base, dst_pitch, src_base, src_pitch;  // tiles; a tile is 80x16 samples (32bpp)
+  uint lo, hi;  // the EDRAM tiles taken over
+  uint src_kind, dst_kind;
+};
+vertex float4 transfer_vs(uint id [[vertex_id]]) {
+  return float4(float2((id << 1) & 2, id & 2) * 2.0f - 1.0f, 0.0f, 1.0f);
+}
+float f7e3_to_32(uint v) {
+  uint m = v & 0x7Fu, e = (v >> 7) & 7u;
+  return e ? ldexp(1.0f + float(m) / 128.0f, int(e) - 3) : ldexp(float(m) / 128.0f, -2);
+}
+uint f32_to_7e3(float f) {
+  f = clamp(f, 0.0f, 31.875f);
+  if (f < 0.25f) return uint(rint(f * 512.0f));
+  int e = clamp(int(floor(log2(f))) + 3, 1, 7);
+  uint m = uint(rint((f / exp2(float(e - 3)) - 1.0f) * 128.0f));
+  if (m >= 128u) { m = 0; ++e; }
+  return e > 7 ? 0x3FFu : ((uint(e) << 7) | m);
+}
+uint pack_color(float4 v, uint kind) {
+  switch (kind) {
+    case 0: { uint4 u = uint4(rint(saturate(v) * 255.0f)); return u.x | (u.y << 8) | (u.z << 16) | (u.w << 24); }
+    case 1: { uint4 u = uint4(rint(saturate(v) * float4(1023, 1023, 1023, 3))); return u.x | (u.y << 10) | (u.z << 20) | (u.w << 30); }
+    case 2: return f32_to_7e3(v.x) | (f32_to_7e3(v.y) << 10) | (f32_to_7e3(v.z) << 20) | (uint(rint(saturate(v.w) * 3.0f)) << 30);
+    case 3: { int2 i = int2(rint(clamp(v.xy, -1.0f, 1.0f) * 32767.0f)); return (uint(i.x) & 0xFFFFu) | (uint(i.y) << 16); }
+    case 4: return as_type<uint>(half2(v.xy));
+    default: return as_type<uint>(v.x);
+  }
+}
+float4 unpack_color(uint b, uint kind) {
+  switch (kind) {
+    case 0: return float4(b & 255u, (b >> 8) & 255u, (b >> 16) & 255u, b >> 24) / 255.0f;
+    case 1: return float4(float(b & 1023u) / 1023.0f, float((b >> 10) & 1023u) / 1023.0f, float((b >> 20) & 1023u) / 1023.0f, float(b >> 30) / 3.0f);
+    case 2: return float4(f7e3_to_32(b & 1023u), f7e3_to_32((b >> 10) & 1023u), f7e3_to_32((b >> 20) & 1023u), float(b >> 30) / 3.0f);
+    case 3: return float4(max(float2(int(b << 16) >> 16, int(b) >> 16) / 32767.0f, -1.0f), 0.0f, 1.0f);
+    case 4: return float4(float2(as_type<half2>(b)), 0.0f, 1.0f);
+    default: return float4(as_type<float>(b), 0.0f, 0.0f, 1.0f);
+  }
+}
+uint pack_depth(float depth, uint stencil, uint kind) {
+  uint d24 = kind == 7 ? float32_to_20e4(depth * 2.0f) : uint(rint(saturate(depth) * 16777215.0f));
+  return (d24 << 8) | (stencil & 0xFFu);
+}
+// The source sample for this destination sample, through the EDRAM tile both cover.
+bool transfer_source(float4 position, constant TransferConstants& c, uint2 source_size, thread uint2& s) {
+  uint2 d = uint2(position.xy);
+  uint column = d.x / 80u;
+  if (column >= c.dst_pitch) return false;
+  uint tile = c.dst_base + (d.y >> 4) * c.dst_pitch + column;
+  if (tile < c.lo || tile >= c.hi || tile < c.src_base) return false;
+  uint rel = tile - c.src_base;
+  s = uint2((rel % c.src_pitch) * 80u + d.x % 80u, (rel / c.src_pitch) * 16u + (d.y & 15u));
+  return all(s < source_size);
+}
+struct TransferDepthOut { float depth [[depth(any)]]; uint stencil [[stencil]]; };
+TransferDepthOut unpack_depth(uint b, uint kind) {
+  TransferDepthOut out;
+  uint d24 = b >> 8;
+  out.depth = kind == 7 ? float20e4_to_32(d24) * 0.5f : float(d24) / 16777215.0f;
+  out.stencil = b & 0xFFu;
+  return out;
+}
+fragment float4 transfer_color_from_color(float4 position [[position]], constant TransferConstants& c [[buffer(0)]],
+    texture2d<float, access::read> source [[texture(0)]]) {
+  uint2 s;
+  if (!transfer_source(position, c, uint2(source.get_width(), source.get_height()), s)) discard_fragment();
+  return unpack_color(pack_color(source.read(s), c.src_kind), c.dst_kind);
+}
+fragment float4 transfer_color_from_depth(float4 position [[position]], constant TransferConstants& c [[buffer(0)]],
+    depth2d<float, access::read> source [[texture(0)]], texture2d<uint, access::read> stencil [[texture(1)]]) {
+  uint2 s;
+  if (!transfer_source(position, c, uint2(source.get_width(), source.get_height()), s)) discard_fragment();
+  return unpack_color(pack_depth(source.read(s), stencil.read(s).r, c.src_kind), c.dst_kind);
+}
+fragment TransferDepthOut transfer_depth_from_color(float4 position [[position]], constant TransferConstants& c [[buffer(0)]],
+    texture2d<float, access::read> source [[texture(0)]]) {
+  uint2 s;
+  if (!transfer_source(position, c, uint2(source.get_width(), source.get_height()), s)) discard_fragment();
+  return unpack_depth(pack_color(source.read(s), c.src_kind), c.dst_kind);
+}
+fragment TransferDepthOut transfer_depth_from_depth(float4 position [[position]], constant TransferConstants& c [[buffer(0)]],
+    depth2d<float, access::read> source [[texture(0)]], texture2d<uint, access::read> stencil [[texture(1)]]) {
+  uint2 s;
+  if (!transfer_source(position, c, uint2(source.get_width(), source.get_height()), s)) discard_fragment();
+  return unpack_depth(pack_depth(source.read(s), stencil.read(s).r, c.src_kind), c.dst_kind);
+}
+)MSL";
+}
