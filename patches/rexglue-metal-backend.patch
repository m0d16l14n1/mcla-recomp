@@ -0,0 +1,286 @@
+/**
+ * @file        graphics/metal/metal_presenter.mm
+ * @brief       The Metal backend's provider and presenter
+ *
+ * Added by the mcla-recomp macOS fork (patches/rexglue-metal-backend.patch). The presenter draws the newest
+ * guest output image into the window's CAMetalLayer (the surface the SDK makes on macOS), letterboxed and
+ * bilinearly scaled, on the provider's one command queue. The presenter effects of the other backends (FSR, CAS,
+ * dither, HDR), the UI overlays and captures are not done yet.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include "metal_internal.h"
+#include <cstring>
+
+#include <rex/logging.h>
+#include <rex/ui/surface_mac.h>
+
+namespace rex::graphics::metal {
+
+namespace {
+
+// A quad over the viewport (the guest output's rectangle in the drawable), sampling the guest output.
+constexpr const char kPaintShaderSource[] = R"(
+#include <metal_stdlib>
+using namespace metal;
+
+struct PaintVertexOut {
+  float4 position [[position]];
+  float2 uv;
+};
+
+vertex PaintVertexOut paint_vs(uint vertex_id [[vertex_id]]) {
+  float2 uv = float2(float(vertex_id & 1u), float(vertex_id >> 1u));
+  PaintVertexOut out;
+  out.position = float4(uv * float2(2.0, -2.0) + float2(-1.0, 1.0), 0.0, 1.0);
+  out.uv = uv;
+  return out;
+}
+
+fragment float4 paint_ps(PaintVertexOut in [[stage_in]], texture2d<float> guest_output [[texture(0)]],
+                         sampler guest_output_sampler [[sampler(0)]]) {
+  return float4(guest_output.sample(guest_output_sampler, in.uv).rgb, 1.0);
+}
+)";
+
+}  // namespace
+
+bool IsMetalAvailable() {
+  @autoreleasepool {
+    return MTLCreateSystemDefaultDevice() != nil;
+  }
+}
+
+std::unique_ptr<MetalProvider> MetalProvider::Create() {
+  std::unique_ptr<MetalProvider> provider(new MetalProvider());
+  provider->device_ = MTLCreateSystemDefaultDevice();
+  if (!provider->device_) {
+    REXGPU_ERROR("Metal: no Metal device");
+    return nullptr;
+  }
+  provider->command_queue_ = [provider->device_ newCommandQueue];
+  if (!provider->command_queue_) {
+    REXGPU_ERROR("Metal: could not create a command queue");
+    return nullptr;
+  }
+  provider->command_queue_.label = @"rexglue guest";
+  REXGPU_INFO("Metal device '{}': unified memory {}, recommended working set {} MB, Apple GPU family 9 {}",
+              [provider->device_.name UTF8String], provider->device_.hasUnifiedMemory ? "yes" : "no",
+              provider->device_.recommendedMaxWorkingSetSize >> 20,
+              [provider->device_ supportsFamily:MTLGPUFamilyApple9] ? "yes" : "no");
+  return provider;
+}
+
+std::unique_ptr<ui::Presenter> MetalProvider::CreatePresenter(
+    ui::Presenter::HostGpuLossCallback host_gpu_loss_callback) {
+  return MetalPresenter::Create(host_gpu_loss_callback, device_, command_queue_);
+}
+
+std::unique_ptr<MetalPresenter> MetalPresenter::Create(HostGpuLossCallback host_gpu_loss_callback,
+                                                       id<MTLDevice> device,
+                                                       id<MTLCommandQueue> command_queue) {
+  std::unique_ptr<MetalPresenter> presenter(
+      new MetalPresenter(host_gpu_loss_callback, device, command_queue));
+  if (!presenter->Initialize()) {
+    return nullptr;
+  }
+  return presenter;
+}
+
+MetalPresenter::~MetalPresenter() {
+  // Nothing on the queue may still read the guest output textures or the layer's drawables.
+  @autoreleasepool {
+    id<MTLCommandBuffer> drain = [command_queue_ commandBuffer];
+    [drain commit];
+    [drain waitUntilCompleted];
+  }
+}
+
+bool MetalPresenter::Initialize() {
+  if (!InitializeCommonSurfaceIndependent()) {
+    return false;
+  }
+  NSError* error = nil;
+  id<MTLLibrary> library =
+      [device_ newLibraryWithSource:[NSString stringWithUTF8String:kPaintShaderSource] options:nil error:&error];
+  if (!library) {
+    REXGPU_ERROR("Metal presenter: the paint shaders did not compile: {}",
+                 error ? [error.localizedDescription UTF8String] : "?");
+    return false;
+  }
+  MTLRenderPipelineDescriptor* pipeline_desc = [[MTLRenderPipelineDescriptor alloc] init];
+  pipeline_desc.label = @"rexglue guest output paint";
+  pipeline_desc.vertexFunction = [library newFunctionWithName:@"paint_vs"];
+  pipeline_desc.fragmentFunction = [library newFunctionWithName:@"paint_ps"];
+  pipeline_desc.colorAttachments[0].pixelFormat = MTLPixelFormatBGRA8Unorm;
+  paint_pipeline_ = [device_ newRenderPipelineStateWithDescriptor:pipeline_desc error:&error];
+  if (!paint_pipeline_) {
+    REXGPU_ERROR("Metal presenter: no paint pipeline: {}",
+                 error ? [error.localizedDescription UTF8String] : "?");
+    return false;
+  }
+  MTLSamplerDescriptor* sampler_desc = [[MTLSamplerDescriptor alloc] init];
+  sampler_desc.minFilter = MTLSamplerMinMagFilterLinear;
+  sampler_desc.magFilter = MTLSamplerMinMagFilterLinear;
+  sampler_desc.sAddressMode = MTLSamplerAddressModeClampToEdge;
+  sampler_desc.tAddressMode = MTLSamplerAddressModeClampToEdge;
+  paint_sampler_ = [device_ newSamplerStateWithDescriptor:sampler_desc];
+  return paint_sampler_ != nil;
+}
+
+ui::Surface::TypeFlags MetalPresenter::GetSupportedSurfaceTypes() const {
+  return ui::Surface::kTypeFlag_CAMetalLayer;
+}
+
+bool MetalPresenter::CaptureGuestOutput(ui::RawImage& image_out) {
+  @autoreleasepool {
+    uint32_t index;
+    // Retain the mailbox consumer lock until the readback is queued and completed, so a producer
+    // cannot recycle this slot while the capture is reading it.
+    auto lock = ConsumeGuestOutput(index, nullptr, nullptr);
+    if (index >= kGuestOutputMailboxSize || !guest_output_textures_[index]) return false;
+    id<MTLTexture> texture = guest_output_textures_[index];
+    size_t stride = (texture.width * 4 + 255) & ~size_t(255);
+    id<MTLBuffer> buffer = [device_ newBufferWithLength:stride * texture.height options:MTLResourceStorageModeShared];
+    if (!buffer) return false;
+    auto commands = [command_queue_ commandBuffer];
+    auto blit = [commands blitCommandEncoder];
+    [blit copyFromTexture:texture sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 0)
+      sourceSize:MTLSizeMake(texture.width, texture.height, 1) toBuffer:buffer destinationOffset:0
+      destinationBytesPerRow:stride destinationBytesPerImage:stride * texture.height];
+    [blit endEncoding]; [commands commit]; [commands waitUntilCompleted];
+    if (commands.status != MTLCommandBufferStatusCompleted) return false;
+    image_out.width = uint32_t(texture.width); image_out.height = uint32_t(texture.height);
+    image_out.stride = stride; image_out.data.resize(stride * texture.height);
+    std::memcpy(image_out.data.data(), buffer.contents, image_out.data.size());
+    return true;
+  }
+}
+
+ui::Presenter::SurfacePaintConnectResult MetalPresenter::ConnectOrReconnectPaintingToSurfaceFromUIThread(
+    ui::Surface& new_surface, uint32_t new_surface_width, uint32_t new_surface_height,
+    bool was_paintable, bool& is_vsync_implicit_out) {
+  if (new_surface.GetType() != ui::Surface::kTypeIndex_CAMetalLayer) {
+    return SurfacePaintConnectResult::kFailureSurfaceUnusable;
+  }
+  CAMetalLayer* layer =
+      (__bridge CAMetalLayer*)static_cast<ui::CAMetalLayerSurface&>(new_surface).layer();
+  if (!layer) {
+    return SurfacePaintConnectResult::kFailureSurfaceUnusable;
+  }
+  const CGSize drawable_size = CGSizeMake(new_surface_width, new_surface_height);
+  if (was_paintable && layer == layer_ && CGSizeEqualToSize(layer.drawableSize, drawable_size)) {
+    is_vsync_implicit_out = layer.displaySyncEnabled;
+    return SurfacePaintConnectResult::kSuccessUnchanged;
+  }
+  layer.device = device_;
+  layer.pixelFormat = MTLPixelFormatBGRA8Unorm;
+  layer.framebufferOnly = YES;
+  // The surface's size is in pixels already (SDL's pixel size of the window).
+  layer.drawableSize = drawable_size;
+  layer.maximumDrawableCount = 3;
+  layer_ = layer;
+  is_vsync_implicit_out = layer.displaySyncEnabled;
+  REXGPU_INFO("Metal presenter: painting to a {}x{} CAMetalLayer, display sync {}", new_surface_width,
+              new_surface_height, layer.displaySyncEnabled ? "on" : "off");
+  return SurfacePaintConnectResult::kSuccess;
+}
+
+void MetalPresenter::DisconnectPaintingFromSurfaceFromUIThreadImpl() {
+  layer_ = nil;
+}
+
+bool MetalPresenter::RefreshGuestOutputImpl(
+    uint32_t mailbox_index, uint32_t frontbuffer_width, uint32_t frontbuffer_height,
+    std::function<bool(GuestOutputRefreshContext& context)> refresher, bool& is_8bpc_out_ref,
+    GuestOutputHdr& hdr_out_ref) {
+  if (mailbox_index >= kGuestOutputMailboxSize) {
+    return false;
+  }
+  @autoreleasepool {
+    id<MTLTexture> texture = guest_output_textures_[mailbox_index];
+    if (!texture || texture.width != frontbuffer_width || texture.height != frontbuffer_height) {
+      MTLTextureDescriptor* desc =
+          [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:kGuestOutputFormat
+                                                             width:frontbuffer_width
+                                                            height:frontbuffer_height
+                                                         mipmapped:NO];
+      desc.usage = MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite | MTLTextureUsageRenderTarget;
+      desc.storageMode = MTLStorageModePrivate;
+      texture = [device_ newTextureWithDescriptor:desc];
+      if (!texture) {
+        REXGPU_ERROR("Metal presenter: no {}x{} guest output texture", frontbuffer_width, frontbuffer_height);
+        return false;
+      }
+      texture.label = [NSString stringWithFormat:@"rexglue guest output %u", mailbox_index];
+      guest_output_textures_[mailbox_index] = texture;
+    }
+    MetalGuestOutputRefreshContext context(is_8bpc_out_ref, hdr_out_ref, texture, command_queue_);
+    context.SetIs8bpc(true);
+    return refresher(context);
+  }
+}
+
+ui::Presenter::PaintResult MetalPresenter::PaintAndPresentImpl([[maybe_unused]] bool execute_ui_drawers) {
+  @autoreleasepool {
+    CAMetalLayer* layer = layer_;
+    if (!layer) {
+      return PaintResult::kNotPresentedConnectionOutdated;
+    }
+    const uint32_t drawable_width = uint32_t(layer.drawableSize.width);
+    const uint32_t drawable_height = uint32_t(layer.drawableSize.height);
+    if (!drawable_width || !drawable_height) {
+      return PaintResult::kNotPresented;
+    }
+    id<CAMetalDrawable> drawable = [layer nextDrawable];
+    if (!drawable) {
+      return PaintResult::kNotPresented;
+    }
+
+    id<MTLCommandBuffer> command_buffer = [command_queue_ commandBuffer];
+    command_buffer.label = @"rexglue paint";
+    MTLRenderPassDescriptor* pass = [MTLRenderPassDescriptor renderPassDescriptor];
+    pass.colorAttachments[0].texture = drawable.texture;
+    pass.colorAttachments[0].loadAction = MTLLoadActionClear;
+    pass.colorAttachments[0].clearColor = MTLClearColorMake(0.0, 0.0, 0.0, 1.0);
+    pass.colorAttachments[0].storeAction = MTLStoreActionStore;
+    id<MTLRenderCommandEncoder> encoder = [command_buffer renderCommandEncoderWithDescriptor:pass];
+
+    {
+      // Held while the guest output texture is used: no refresher may write the acquired image meanwhile,
+      // and the command buffer reading it is committed on the same queue before any later write to it.
+      uint32_t mailbox_index;
+      GuestOutputProperties properties;
+      GuestOutputPaintConfig paint_config;
+      std::unique_lock<std::mutex> consumer_lock =
+          ConsumeGuestOutput(mailbox_index, &properties, &paint_config);
+      id<MTLTexture> guest_output = mailbox_index < kGuestOutputMailboxSize
+                                        ? guest_output_textures_[mailbox_index]
+                                        : nil;
+      if (guest_output) {
+        const GuestOutputPaintFlow flow =
+            GetGuestOutputPaintFlow(properties, drawable_width, drawable_height, drawable_width,
+                                    drawable_height, paint_config);
+        if (flow.effect_count) {
+          // Bilinear to the final size and place, whatever effects the configuration asked for.
+          const std::pair<uint32_t, uint32_t>& size = flow.effect_output_sizes[flow.effect_count - 1];
+          MTLViewport viewport = {double(flow.output_x), double(flow.output_y), double(size.first),
+                                  double(size.second), 0.0, 1.0};
+          [encoder setViewport:viewport];
+          [encoder setRenderPipelineState:paint_pipeline_];
+          [encoder setFragmentTexture:guest_output atIndex:0];
+          [encoder setFragmentSamplerState:paint_sampler_ atIndex:0];
+          [encoder drawPrimitives:MTLPrimitiveTypeTriangleStrip vertexStart:0 vertexCount:4];
+        }
+      }
+      [encoder endEncoding];
+      [command_buffer presentDrawable:drawable];
+      [command_buffer commit];
+    }
+    return PaintResult::kPresented;
+  }
+}
