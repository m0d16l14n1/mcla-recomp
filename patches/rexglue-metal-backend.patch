+MetalDraw::MetalDraw(id<MTLDevice> device, id<MTLCommandQueue> queue, id<MTLBuffer> memory_buffer,
+    memory::Memory& memory, RegisterFile& regs, MetalShaderCompiler& shaders, uint32_t edram_tiles)
+    : device_(device), queue_(queue), memory_buffer_(memory_buffer), memory_(memory), regs_(regs),
+      shaders_(shaders), edram_tiles_(edram_tiles) {}
+MetalDraw::~MetalDraw() { Submit(); primitives_.reset(); shared_.reset(); }
+bool MetalDraw::Initialize() {
+  for (auto& buffer : snapshot_buffers_) {
+    buffer = [device_ newBufferWithLength:64 * 1024 * 1024 options:MTLResourceStorageModeShared];
+    if (!buffer) return false;
+    buffer.label = @"Xenos draw-time vertex and index snapshots";
+  }
+  snapshot_buffer_ = snapshot_buffers_[0];
+  NSError* error = nil;
+  auto library = [device_ newLibraryWithSource:[NSString stringWithUTF8String:kMetalResolveSource] options:nil error:&error];
+  if (library) {
+    resolve_color_ = [device_ newComputePipelineStateWithFunction:[library newFunctionWithName:@"resolve_color"] error:&error];
+    resolve_depth_ = [device_ newComputePipelineStateWithFunction:[library newFunctionWithName:@"resolve_depth"] error:&error];
+    present_ = [device_ newComputePipelineStateWithFunction:[library newFunctionWithName:@"present_color"] error:&error];
+    load_texture_ = [device_ newComputePipelineStateWithFunction:[library newFunctionWithName:@"load_texture"] error:&error];
+  }
+  if (!resolve_color_ || !resolve_depth_ || !present_ || !load_texture_) {
+    REXGPU_ERROR("Metal resolve shader failed: {}", error.localizedDescription.UTF8String); return false;
+  }
+  shared_ = std::make_unique<UnifiedMemory>(memory_);
+  primitives_ = std::make_unique<MetalPrimitiveProcessor>(device_, regs_, memory_, *shared_);
+  return primitives_->Initialize();
+}
+void MetalDraw::EndEncoder() { if (encoder_) { [encoder_ endEncoding]; encoder_ = nil; } attachments_ = {}; }
+void MetalDraw::Submit(bool wait) {
+  EndEncoder();
+  if (commands_) {
+    auto errors = gpu_errors_; auto gpu_us = gpu_us_;
+    [commands_ addCompletedHandler:^(id<MTLCommandBuffer> done) {
+      if (done.GPUEndTime > done.GPUStartTime) gpu_us->fetch_add(uint64_t((done.GPUEndTime - done.GPUStartTime) * 1e6));
+      if (done.status == MTLCommandBufferStatusError && errors->fetch_add(1) < 16)
+        REXGPU_ERROR("Metal draw command buffer failed: {}", done.error.localizedDescription.UTF8String);
+    }];
+    [commands_ commit];
+    last_committed_ = commands_; commands_ = nil;
+  }
+  // Command buffers keep what they use alive; the uploads list only has to outlive the encoding.
+  uploads_.clear();
+  if (wait) {
+    // One queue: its last command buffer completes after the ones before it.
+    if (last_committed_) [last_committed_ waitUntilCompleted];
+    snapshots_.clear(); snapshot_used_ = 0;
+  }
+}
+bool MetalDraw::DebugFrame() const {
+  return frame_ == REXCVAR_GET(metal_debug_frame) || frame_ == capture_frame_;
+}
+void MetalDraw::EndFrame() {
+  // The frame goes to the GPU without waiting for it; the next one is encoded meanwhile, into the other
+  // snapshot buffer, once the frame before last (its previous user) is done.
+  Submit(false);
+  frame_done_[slot_] = last_committed_;
+  slot_ ^= 1;
+  snapshot_buffer_ = snapshot_buffers_[slot_];
+  if (frame_done_[slot_]) {
+    auto wait_start = std::chrono::steady_clock::now();
+    [frame_done_[slot_] waitUntilCompleted]; frame_done_[slot_] = nil;
+    wait_us_ += uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - wait_start).count());
+  }
+  if (++stats_frames_ == 150) {
+    double wall = std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() - stats_start_).count();
+    REXGPU_INFO("Metal frame time: {:.1f} ms a frame, GPU busy {:.1f} ms, CPU waiting for the GPU {:.1f} ms; {} texture loads",
+        wall / 1000.0 / 150, gpu_us_->exchange(0) / 1000.0 / 150, wait_us_ / 1000.0 / 150, texture_loads_);
+    stats_frames_ = 0; wait_us_ = 0; texture_loads_ = 0; stats_start_ = std::chrono::steady_clock::now();
+  }
+  snapshots_.clear(); snapshot_used_ = 0;
+  ++frame_;
+  if (REXCVAR_GET(metal_debug_capture)) {
+    capture_frame_ = frame_;
+    rex::cvar::SetFlagByName("metal_debug_capture", "false");
+    REXGPU_INFO("Metal debug capture: frame {}", frame_);
+  }
+  if (textures_.size() > 4096) {
+    textures_.clear(); texture_hashes_.clear(); texture_checked_frame_.clear(); texture_ranges_.clear(); views_.clear();
+  }
+}
+void MetalDraw::DropViews(id<MTLTexture> texture) {
+  if (!texture) return;
+  std::string prefix; Key(prefix, reinterpret_cast<uintptr_t>((__bridge void*)texture));
+  for (auto it = views_.begin(); it != views_.end();)
+    it = it->first.compare(0, prefix.size(), prefix) == 0 ? views_.erase(it) : std::next(it);
+}
+void MetalDraw::InvalidateRange(uint32_t start, uint32_t length) {
+  if (!length) return;
+  uint64_t end = uint64_t(start) + length;
+  for (auto it = resolved_.begin(); it != resolved_.end();) {
+    if (it->second.start < end && uint64_t(it->second.start) + it->second.length > start) it = resolved_.erase(it);
+    else ++it;
+  }
+  for (auto it = texture_ranges_.begin(); it != texture_ranges_.end();) {
+    if (it->second.first < end && uint64_t(it->second.first) + it->second.second > start) {
+      if (auto t = textures_.find(it->first); t != textures_.end()) { DropViews(t->second); textures_.erase(t); }
+      texture_hashes_.erase(it->first); texture_checked_frame_.erase(it->first);
+      it = texture_ranges_.erase(it);
+    } else ++it;
+  }
+}
+id<MTLBuffer> MetalDraw::Upload(const void* data, size_t size) {
+  id<MTLBuffer> buffer = [device_ newBufferWithBytes:data length:size options:MTLResourceStorageModeShared];
+  if (buffer) uploads_.push_back(buffer);
+  return buffer;
+}
+id<MTLTexture> MetalDraw::Target(uint32_t base, MTLPixelFormat format, uint32_t width, bool is_64bpp) {
+  // EDRAM is kept in samples (MSAA 2x as 1x2, 4x as 2x2), so that the views of the same tiles
+  // with another sample count and pitch (a 4x clear at half the pitch of a 2x scene) meet in one
+  // texture. Its height is what is left of EDRAM after the base, so it does not depend on the draw.
+  std::string key; Key(key, base); Key(key, format); Key(key, width);
+  auto found = targets_.find(key);
+  if (found != targets_.end()) return found->second;
+  uint32_t pitch_tiles = std::max(1u, (width + (is_64bpp ? 39 : 79)) / (is_64bpp ? 40 : 80));
+  uint32_t height = std::min(8192u, (edram_tiles_ - std::min(base, edram_tiles_ - 1) + pitch_tiles - 1) / pitch_tiles * 16);
+  auto desc = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:format width:width height:height mipmapped:NO];
+  desc.storageMode = MTLStorageModePrivate;
+  desc.usage = MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead | MTLTextureUsagePixelFormatView;
+  id<MTLTexture> result = [device_ newTextureWithDescriptor:desc];
+  if (result) {
+    result.label = [NSString stringWithFormat:@"Xenos RT base %u", base];
+    targets_[key] = result;
+    EndEncoder();
+    if (!commands_) commands_ = [queue_ commandBuffer];
+    auto pass = [MTLRenderPassDescriptor renderPassDescriptor];
+    if (format == MTLPixelFormatDepth32Float_Stencil8) {
+      pass.depthAttachment.texture = pass.stencilAttachment.texture = result;
+      pass.depthAttachment.loadAction = pass.stencilAttachment.loadAction = MTLLoadActionClear;
+      pass.depthAttachment.storeAction = pass.stencilAttachment.storeAction = MTLStoreActionStore;
+      // The initial EDRAM contents are zero. This title uses reversed depth (GreaterEqual),
+      // so a conventional host far-depth clear of 1 rejects its UI and geometry.
+      pass.depthAttachment.clearDepth = 0.0;
+    } else {
+      pass.colorAttachments[0].texture = result;
+      pass.colorAttachments[0].loadAction = MTLLoadActionClear;
+      pass.colorAttachments[0].storeAction = MTLStoreActionStore;
+    }
+    [[commands_ renderCommandEncoderWithDescriptor:pass] endEncoding];
+  }
+  return result;
+}
