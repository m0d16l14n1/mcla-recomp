+/**
+ * @file        graphics/metal/metal_backend.h
+ * @brief       Entry point of the Metal backend for the plugin (plain C++)
+ *
+ * Added by the mcla-recomp macOS fork (patches/rexglue-metal-backend.patch). The backend's classes use
+ * Objective-C++ and stay in the .mm files and metal_internal.h; plugin_main.cpp only needs this.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <memory>
+
+namespace rex::graphics {
+class GraphicsSystem;
+}  // namespace rex::graphics
+
+namespace rex::graphics::metal {
+
+// Whether the system has a Metal device.
+bool IsMetalAvailable();
+std::unique_ptr<GraphicsSystem> CreateMetalGraphicsSystem();
+
+}  // namespace rex::graphics::metal
diff --git a/src/graphics/metal/metal_command_processor.mm b/src/graphics/metal/metal_command_processor.mm
new file mode 100644
--- /dev/null
+++ b/src/graphics/metal/metal_command_processor.mm
@@ -0,0 +1,286 @@
+/**
+ * @file        graphics/metal/metal_command_processor.mm
+ * @brief       The Metal backend's graphics system and command processor
+ *
+ * Added by the mcla-recomp macOS fork (patches/rexglue-metal-backend.patch). Milestone M0: the guest's command
+ * stream runs through the common CommandProcessor (registers, waits, events, interrupts, shader loads), draws
+ * and resolves are counted and skipped, and each swap fills the guest output through the presenter's mailbox
+ * with a placeholder, so that the game runs on Metal from start to finish. Drawing comes in the next milestones.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include "metal_internal.h"
+#include "metal_backend.h"
+#include "metal_shaders.h"
+#include "metal_draw.h"
+
+#include <xxhash.h>
+
+#include <cstring>
+
+#include <rex/chrono/clock.h>
+#include <rex/cvar.h>
+#include <rex/graphics/shared_memory.h>
+#include <rex/system/xmemory.h>
+#include <rex/graphics/registers.h>
+#include <rex/logging.h>
+
+REXCVAR_DEFINE_BOOL(metal_shared_memory_zero_copy, true, "GPU/Metal",
+                    "Make the guest's physical memory (512 MB) a Metal buffer without copying it (Apple "
+                    "Silicon's unified memory), and check once that the GPU reads what the CPU sees. Restart");
+
+namespace rex::graphics::metal {
+
+std::unique_ptr<GraphicsSystem> CreateMetalGraphicsSystem() {
+  return std::make_unique<MetalGraphicsSystem>();
+}
+
+void MetalGraphicsSystem::CreateProvider([[maybe_unused]] bool with_presentation) {
+  provider_ = MetalProvider::Create();
+}
+
+std::unique_ptr<CommandProcessor> MetalGraphicsSystem::CreateCommandProcessor() {
+  return std::make_unique<MetalCommandProcessor>(this, kernel_state_);
+}
+
+MetalCommandProcessor::MetalCommandProcessor(MetalGraphicsSystem* graphics_system,
+                                             system::KernelState* kernel_state)
+    : CommandProcessor(graphics_system, kernel_state), metal_graphics_system_(graphics_system) {}
+
+MetalCommandProcessor::~MetalCommandProcessor() = default;
+
+bool MetalCommandProcessor::SetupContext() {
+  if (!CommandProcessor::SetupContext()) {
+    REXGPU_ERROR("Metal: the base command processor context could not be set up");
+    return false;
+  }
+  MetalProvider* provider = metal_graphics_system_->metal_provider();
+  if (!provider) {
+    REXGPU_ERROR("Metal: no provider");
+    return false;
+  }
+  device_ = provider->device();
+  command_queue_ = provider->command_queue();
+  // The other backends set this from their render target caches; M1 has the console's EDRAM.
+  if (!graphics_system_->edram_tile_count()) graphics_system_->set_edram_tile_count(xenos::kEdramTileCountConsole);
+  shader_compiler_ = std::make_unique<MetalShaderCompiler>(device_, graphics_system_->edram_tile_count());
+  if (REXCVAR_GET(metal_shared_memory_zero_copy)) {
+    CreateZeroCopySharedMemory();
+  }
+  draw_ = std::make_unique<MetalDraw>(device_, command_queue_, shared_memory_buffer_, *memory_,
+      *register_file_, *shader_compiler_, graphics_system_->edram_tile_count());
+  if (!draw_->Initialize()) return false;
+  REXGPU_WARN("Metal M1: experimental native drawing enabled (no MSAA or EDRAM ownership transfers yet)");
+  stats_since_ms_ = chrono::Clock::QueryHostUptimeMillis();
+  return true;
+}
+
+void MetalCommandProcessor::ShutdownContext() {
+  if (command_queue_) {
+    @autoreleasepool {
+      id<MTLCommandBuffer> drain = [command_queue_ commandBuffer];
+      [drain commit];
+      [drain waitUntilCompleted];
+    }
+  }
+  draw_.reset();
+  shader_compiler_.reset();
+  shared_memory_buffer_ = nil;
+  shaders_.clear();
+  command_queue_ = nil;
+  device_ = nil;
+  CommandProcessor::ShutdownContext();
+}
+
+Shader* MetalCommandProcessor::LoadShader(xenos::ShaderType shader_type,
+                                          [[maybe_unused]] uint32_t guest_address,
+                                          const uint32_t* host_address, uint32_t dword_count) {
+  const uint64_t hash = XXH3_64bits(host_address, dword_count * sizeof(uint32_t));
+  auto it = shaders_.find(hash);
+  if (it != shaders_.end()) {
+    return it->second.get();
+  }
+  shader_ranges_.emplace_back(guest_address & 0x1FFFFFFF, dword_count);
+  auto shader = CreateMetalShader(shader_type, hash, host_address, dword_count);
+  Shader* shader_ptr = shader.get();
+  shaders_.emplace(hash, std::move(shader));
+  return shader_ptr;
+}
+
+bool MetalCommandProcessor::IssueDraw([[maybe_unused]] xenos::PrimitiveType prim_type,
+                                      [[maybe_unused]] uint32_t index_count,
+                                      [[maybe_unused]] IndexBufferInfo* index_buffer_info,
+                                      [[maybe_unused]] bool major_mode_explicit) {
+  // A draw in copy mode is a resolve (EDRAM to memory), as in the other backends.
+  if (register_file_->Get<reg::RB_MODECONTROL>().edram_mode == xenos::EdramMode::kCopy) {
+    return IssueCopy();
+  }
+  ++stats_draws_;
+  return draw_ ? draw_->Draw(active_vertex_shader(), active_pixel_shader()) : false;
+}
+
+void MetalCommandProcessor::RequestDrawShaders() {
+  Shader* vertex_shader = active_vertex_shader();
+  if (!vertex_shader || !shader_compiler_) {
+    return;
+  }
+  Shader* pixel_shader = active_pixel_shader();
+  MetalShaderTranslator& translator = shader_compiler_->translator();
+  translator.EnsureAnalyzed(*vertex_shader);
+  if (pixel_shader) {
+    translator.EnsureAnalyzed(*pixel_shader);
+  }
+  uint64_t vertex_modification, pixel_modification;
+  translator.GetDrawModifications(*register_file_, *vertex_shader, pixel_shader, vertex_modification,
+                                  pixel_modification);
+  shader_compiler_->Request(*vertex_shader, vertex_modification);
+  if (pixel_shader) {
+    shader_compiler_->Request(*pixel_shader, pixel_modification);
+  }
+}
+
+bool MetalCommandProcessor::IssueCopy() {
+  ++stats_copies_;
+  return draw_ ? draw_->Resolve() : false;
+}
+
+void MetalCommandProcessor::IssueSwap([[maybe_unused]] uint32_t frontbuffer_ptr,
+                                      uint32_t frontbuffer_width, uint32_t frontbuffer_height) {
+  if (draw_) draw_->EndFrame();
+  ++swaps_;
+  ++stats_swaps_;
+  // In free roam on the scripted route (40 s in at 30 swaps a second), when most shaders are loaded.
+  if (swaps_ == 1200 && shared_memory_buffer_ && !shared_memory_checked_) {
+    CheckZeroCopySharedMemory();
+  }
+  ui::Presenter* presenter = graphics_system_->presenter();
+  if (presenter && command_queue_) {
+    if (!frontbuffer_width || !frontbuffer_height) {
+      frontbuffer_width = 1280;
+      frontbuffer_height = 720;
+    }
+    const uint64_t swap = swaps_;
+    presenter->RefreshGuestOutput(
+        frontbuffer_width, frontbuffer_height, 1280, 720,
+        [this, frontbuffer_ptr, swap](ui::Presenter::GuestOutputRefreshContext& context) -> bool {
+          auto& metal_context = static_cast<MetalGuestOutputRefreshContext&>(context);
+          @autoreleasepool {
+            if (draw_ && draw_->Present(frontbuffer_ptr, metal_context.texture())) return true;
+            // The placeholder: a slow pulse, so that a moving picture shows that the swaps arrive.
+            const double phase = double(swap % 120) / 120.0;
+            const double level = 0.10 + 0.08 * (phase < 0.5 ? phase : 1.0 - phase) * 2.0;
+            MTLRenderPassDescriptor* pass = [MTLRenderPassDescriptor renderPassDescriptor];
+            pass.colorAttachments[0].texture = metal_context.texture();
+            pass.colorAttachments[0].loadAction = MTLLoadActionClear;
+            pass.colorAttachments[0].clearColor = MTLClearColorMake(level * 0.6, level * 0.7, level, 1.0);
+            pass.colorAttachments[0].storeAction = MTLStoreActionStore;
+            id<MTLCommandBuffer> command_buffer = [metal_context.command_queue() commandBuffer];
+            command_buffer.label = @"rexglue guest output (M0 placeholder)";
+            [[command_buffer renderCommandEncoderWithDescriptor:pass] endEncoding];
+            [command_buffer commit];
+          }
+          return true;
+        });
+  }
+  MaybeLogStats();
+}
+
+void MetalCommandProcessor::CreateZeroCopySharedMemory() {
+  uint8_t* physical = memory_->physical_membase();
+  const size_t size = SharedMemory::kBufferSize;
+  const size_t page = size_t(getpagesize());
+  if (!physical || (reinterpret_cast<uintptr_t>(physical) & (page - 1)) || (size & (page - 1))) {
+    REXGPU_WARN("Metal: guest physical memory is not page-aligned; no zero-copy shared memory");
+    return;
+  }
+  const uint64_t start_ms = chrono::Clock::QueryHostUptimeMillis();
+  shared_memory_buffer_ = [device_ newBufferWithBytesNoCopy:physical
+                                                     length:size
+                                                    options:MTLResourceStorageModeShared
+                                                deallocator:nil];
+  if (!shared_memory_buffer_) {
+    REXGPU_WARN("Metal: the guest's physical memory could not be made a Metal buffer without a copy");
+    return;
+  }
+  shared_memory_buffer_.label = @"rexglue guest physical memory (no copy)";
+  REXGPU_INFO("Metal: guest physical memory ({} MB at {}) is a Metal buffer without a copy, in {} ms (GPU address "
+              "{:016X})",
+              size >> 20, static_cast<const void*>(physical), chrono::Clock::QueryHostUptimeMillis() - start_ms,
+              shared_memory_buffer_.gpuAddress);
+}
+
+void MetalCommandProcessor::CheckZeroCopySharedMemory() {
+  shared_memory_checked_ = true;
+  size_t total = 0;
+  for (const auto& range : shader_ranges_) {
+    total += range.second * sizeof(uint32_t);
+  }
+  if (!total) {
+    return;
+  }
+  @autoreleasepool {
+    id<MTLBuffer> readback = [device_ newBufferWithLength:total options:MTLResourceStorageModeShared];
+    id<MTLCommandBuffer> command_buffer = [command_queue_ commandBuffer];
+    command_buffer.label = @"rexglue zero-copy shared memory check";
+    id<MTLBlitCommandEncoder> blit = [command_buffer blitCommandEncoder];
+    size_t offset = 0;
+    for (const auto& range : shader_ranges_) {
+      const size_t length = range.second * sizeof(uint32_t);
+      [blit copyFromBuffer:shared_memory_buffer_ sourceOffset:range.first toBuffer:readback
+           destinationOffset:offset size:length];
+      offset += length;
+    }
+    [blit endEncoding];
+    [command_buffer commit];
+    [command_buffer waitUntilCompleted];
+    size_t mismatched = 0;
+    offset = 0;
+    const auto* gpu = static_cast<const uint8_t*>(readback.contents);
+    for (const auto& range : shader_ranges_) {
+      const size_t length = range.second * sizeof(uint32_t);
+      if (std::memcmp(gpu + offset, memory_->TranslatePhysical<const uint8_t*>(range.first), length)) {
+        ++mismatched;
+      }
+      offset += length;
+    }
+    if (command_buffer.status == MTLCommandBufferStatusCompleted && !mismatched) {
+      REXGPU_INFO("Metal: zero-copy shared memory checked: the GPU read the microcode of all {} shaders ({} bytes "
+                  "of guest physical memory) exactly as the CPU sees it",
+                  shader_ranges_.size(), total);
+    } else {
+      REXGPU_WARN("Metal: zero-copy shared memory check FAILED: {} of {} ranges differ (command buffer status {})",
+                  mismatched, shader_ranges_.size(), int(command_buffer.status));
+    }
+  }
+}
+
+void MetalCommandProcessor::MaybeLogStats() {
+  const uint64_t now_ms = chrono::Clock::QueryHostUptimeMillis();
+  const uint64_t elapsed_ms = now_ms - stats_since_ms_;
+  if (elapsed_ms < 5000) {
+    return;
+  }
+  const double seconds = double(elapsed_ms) / 1000.0;
+  REXGPU_INFO("Metal M1: {:.1f} swaps/s, {:.0f} draws and {:.0f} resolves a swap, {} shaders loaded",
+              stats_swaps_ / seconds, stats_swaps_ ? double(stats_draws_) / stats_swaps_ : 0.0,
+              stats_swaps_ ? double(stats_copies_) / stats_swaps_ : 0.0, shaders_.size());
+  if (draw_) REXGPU_INFO("Metal rasterizer: {} draws submitted, {} color resolves, {} failures total", draw_->draws(), draw_->resolves(), draw_->failures());
+  if (shader_compiler_) {
+    const MetalShaderCompiler::Stats& s = shader_compiler_->stats();
+    const uint32_t compiled = s.compiled.load();
+    REXGPU_INFO(
+        "Metal shaders: {} translated to SPIR-V ({} failed), {} refused by SPIRV-Cross, {} compiled by Metal "
+        "({} failed, {} pending); translation {:.2f} ms and Metal {:.1f} ms a shader on average",
+        s.translated.load(), s.translate_failed.load(), s.msl_failed.load(), compiled, s.compile_failed.load(),
+        s.pending.load(), s.translated ? s.translate_us.load() / 1000.0 / s.translated.load() : 0.0,
+        compiled ? s.compile_us.load() / 1000.0 / compiled : 0.0);
+  }
+  stats_swaps_ = 0;
+  stats_draws_ = 0;
+  stats_copies_ = 0;
+  stats_since_ms_ = now_ms;
+}
+
+}  // namespace rex::graphics::metal
diff --git a/src/graphics/metal/metal_draw.h b/src/graphics/metal/metal_draw.h
new file mode 100644
--- /dev/null
+++ b/src/graphics/metal/metal_draw.h
@@ -0,0 +1,94 @@
+/** Native Metal draw path. BSD-3-Clause, see LICENSE. */
+#pragma once
+#include "metal_shaders.h"
+#include <rex/graphics/pipeline/texture/info.h>
+#include <rex/graphics/pipeline/texture/util.h>
+#include <rex/graphics/pipeline/texture/conversion.h>
+#include <rex/graphics/shared_memory.h>
+#include <unordered_set>
+#include <atomic>
+#include <chrono>
+#include <memory>
+
+namespace rex::graphics::metal {
+class MetalPrimitiveProcessor;
+class MetalDraw {
+ public:
+  MetalDraw(id<MTLDevice> device, id<MTLCommandQueue> queue, id<MTLBuffer> memory_buffer,
+            memory::Memory& memory, RegisterFile& regs, MetalShaderCompiler& shaders, uint32_t edram_tiles);
+  ~MetalDraw();
+  bool Initialize();
+  bool Draw(Shader* vs, Shader* ps);
+  bool Resolve();
+  void EndFrame();
+  bool Present(uint32_t address, id<MTLTexture> destination);
+  uint64_t draws() const { return draws_; }
+  uint64_t resolves() const { return resolves_; }
+  uint64_t failures() const { return failures_ + gpu_errors_->load(); }
+ private:
+  bool DebugFrame() const;
+  uint64_t capture_frame_ = 0;
+  bool debug_draw_log_ = false;
+  void VerifyResolve(id<MTLTexture> texture, const draw_util::ResolveInfo& info);
+  bool resolve_verified_ = false;
+  void DumpTexture(id<MTLTexture> texture, const std::string& name);
+  void EndEncoder();
+  // Commits the pending commands; with wait, also waits for all GPU work and starts the snapshots afresh.
+  void Submit(bool wait = true);
+  id<MTLTexture> Target(uint32_t base, MTLPixelFormat format, uint32_t width, bool is_64bpp);
+  id<MTLTexture> Texture(const MetalTextureBinding& binding);
+  // A texture seen through a fetch constant's swizzle (views cached per texture and swizzle).
+  id<MTLTexture> View(id<MTLTexture> texture, uint32_t swizzle, bool cube);
+  void DropViews(id<MTLTexture> texture);
+  std::unordered_map<std::string, id<MTLTexture>> views_;
+  id<MTLSamplerState> Sampler(const MetalSamplerBinding& binding);
+  uint32_t Snapshot(uint32_t address, uint32_t size);
+  bool SnapshotDraw(Shader& vertex, PrimitiveProcessor::ProcessingResult& primitive);
+  void Bind(Shader& shader, Shader::Translation* translation, bool vertex, const std::vector<uint8_t>& system);
+  id<MTLBuffer> Upload(const void* data, size_t size);
+  id<MTLDevice> device_;
+  id<MTLCommandQueue> queue_;
+  id<MTLBuffer> memory_buffer_;
+  id<MTLBuffer> snapshot_buffer_ = nil;
+  // Two frames in flight: each has its own snapshot buffer, reused once that frame's GPU work is done.
+  std::array<id<MTLBuffer>, 2> snapshot_buffers_{};
+  std::array<id<MTLCommandBuffer>, 2> frame_done_{};
+  uint32_t slot_ = 0;
+  id<MTLCommandBuffer> last_committed_ = nil;
+  std::shared_ptr<std::atomic<uint64_t>> gpu_us_ = std::make_shared<std::atomic<uint64_t>>(0);
+  std::chrono::steady_clock::time_point stats_start_ = std::chrono::steady_clock::now();
+  uint64_t stats_frames_ = 0, wait_us_ = 0;
+  std::shared_ptr<std::atomic<uint64_t>> gpu_errors_ = std::make_shared<std::atomic<uint64_t>>(0);
+  size_t snapshot_used_ = 0;
+  // Offset in the snapshot buffer and the hash of the copied data, by address and size.
+  std::unordered_map<std::string, std::pair<uint32_t, uint64_t>> snapshots_;
+  std::array<uint32_t, 192> draw_fetch_{};
+  memory::Memory& memory_;
+  RegisterFile& regs_;
+  MetalShaderCompiler& shaders_;
+  uint32_t edram_tiles_;
+  std::unique_ptr<SharedMemory> shared_;
+  std::unique_ptr<MetalPrimitiveProcessor> primitives_;
+  id<MTLComputePipelineState> resolve_color_ = nil, resolve_depth_ = nil, present_ = nil, load_texture_ = nil;
+  uint64_t texture_loads_ = 0;
+  id<MTLCommandBuffer> commands_ = nil;
+  id<MTLRenderCommandEncoder> encoder_ = nil;
+  std::array<id<MTLTexture>, 5> attachments_{};
+  std::unordered_map<std::string, id<MTLTexture>> targets_, textures_;
+  std::unordered_map<std::string, uint64_t> texture_hashes_, texture_checked_frame_;
+  uint64_t frame_ = 1;
+  std::unordered_map<std::string, id<MTLSamplerState>> samplers_;
+  std::unordered_map<std::string, id<MTLRenderPipelineState>> pipelines_;
+  std::unordered_map<std::string, id<MTLDepthStencilState>> depth_states_;
+  // A resolve's own texture, used in place of a load from guest memory only by a fetch of exactly
+  // what it wrote (same address, size and format). Guest memory is the truth for everything else.
+  struct ResolvedTexture { id<MTLTexture> texture; uint32_t start, length, width, height, format; };
+  std::unordered_map<uint32_t, ResolvedTexture> resolved_;
+  // The guest memory each cached texture was made from, to drop it when a resolve writes there.
+  std::unordered_map<std::string, std::pair<uint32_t, uint32_t>> texture_ranges_;
+  void InvalidateRange(uint32_t start, uint32_t length);
+  std::unordered_set<uint32_t> unsupported_formats_;
+  std::vector<id<MTLBuffer>> uploads_;
+  uint64_t draws_ = 0, resolves_ = 0, failures_ = 0;
+};
+}
