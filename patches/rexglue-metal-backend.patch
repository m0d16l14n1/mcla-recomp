+
+void MetalCommandProcessor::IssueSwap([[maybe_unused]] uint32_t frontbuffer_ptr,
+                                      uint32_t frontbuffer_width, uint32_t frontbuffer_height) {
+  if (draw_) draw_->EndFrame();
+  ++swaps_;
+  {
+    // The time between frames (averaged), for the motion blur's length.
+    const auto now = std::chrono::steady_clock::now();
+    const double interval = std::chrono::duration<double>(now - last_swap_time_).count();
+    if (last_swap_time_ != std::chrono::steady_clock::time_point{} && interval < 0.25)
+      frame_interval_ = frame_interval_ > 0.0 ? frame_interval_ * 0.9 + interval * 0.1 : interval;
+    // The slow frame log: where a long frame's time went on this thread.
+    const uint32_t translated = shader_compiler_ ? shader_compiler_->stats().translated.load() : 0;
+    const uint64_t translate_us = shader_compiler_ ? shader_compiler_->stats().translate_us.load() : 0;
+    const int32_t slow_ms = REXCVAR_GET(metal_slow_frame_ms);
+    if (slow_ms > 0 && draw_ && last_swap_time_ != std::chrono::steady_clock::time_point{} &&
+        interval * 1000.0 >= slow_ms) {
+      if (now - slow_window_ > std::chrono::seconds(10)) {
+        slow_window_ = now;
+        slow_logged_ = 0;
+      }
+      if (slow_logged_++ < 20) {
+        const MetalDraw::FrameReport& r = draw_->last_frame();
+        const double wall_ms = interval * 1000.0;
+        const double cpu_ms = r.cpu_us / 1000.0, wait_ms = r.wait_us / 1000.0;
+        REXGPU_INFO("Metal slow frame: {:.1f} ms (swap {}): command thread CPU {:.1f} ms, waiting for the GPU {:.1f} ms, "
+                    "the rest {:.1f} ms (waiting for the game, or not scheduled); {} shaders translated ({:.1f} ms), "
+                    "{} pipelines made ({:.1f} ms), {:.1f} ms waited for stored pipelines, {} draws left out; {} texture "
+                    "loads ({} made from resolves, {} rows from memory), {:.1f} MB of textures hashed, {:.1f} MB of "
+                    "vertices copied; {} passes, {} EDRAM transfers; {} slow texture lookups {:.1f} ms (watches set "
+                    "{:.1f} ms, loads {:.1f} ms of which {:.1f} ms making textures)",
+                    wall_ms, swaps_ + 1, cpu_ms, wait_ms, std::max(0.0, wall_ms - cpu_ms - wait_ms),
+                    translated - slow_translated_, (translate_us - slow_translate_us_) / 1000.0, r.pipelines,
+                    r.pipeline_us / 1000.0, r.prebuilt_wait_us / 1000.0, r.async_skipped, r.texture_loads, r.composed,
+                    r.rows_loaded, r.texture_hashed / 1048576.0, r.snapshot_copied / 1048576.0, r.passes, r.transfers,
+                    r.tex_slow_calls, r.tex_slow_us / 1000.0, r.tex_watch_us / 1000.0, r.tex_load_us / 1000.0,
+                    r.tex_alloc_us / 1000.0);
+      }
+    }
+    slow_translated_ = translated;
+    slow_translate_us_ = translate_us;
+    last_swap_time_ = now;
+  }
+  ++stats_swaps_;
+  // In free roam on the scripted route (40 s in at 30 swaps a second), when most shaders are loaded.
+  if (swaps_ == 1200 && shared_memory_buffer_ && !shared_memory_checked_) {
+    CheckZeroCopySharedMemory();
+  }
+  ui::Presenter* presenter = graphics_system_->presenter();
+  if (presenter && command_queue_) {
+    if (!frontbuffer_width || !frontbuffer_height) {
+      frontbuffer_width = 1280;
+      frontbuffer_height = 720;
+    }
+    const uint64_t swap = swaps_;
+    // The guest output, HDR output's textures and composite are at the draws' size (resolution_scale).
+    const uint32_t rs = MetalResolutionScale();
+    hdr_output_width_ = frontbuffer_width * rs;
+    hdr_output_height_ = frontbuffer_height * rs;
+    // The ramp as the guest has it now, for this swap (the callback may run after more register writes).
+    auto gamma = std::make_shared<MetalDraw::GammaRamp>();
+    static_assert(sizeof(reg::DC_LUT_30_COLOR) == 4 && sizeof(reg::DC_LUT_PWL_DATA) == 4);
+    std::memcpy(gamma->table, gamma_ramp_256_entry_table(), sizeof(gamma->table));
+    std::memcpy(gamma->pwl, gamma_ramp_pwl_rgb(), sizeof(gamma->pwl));
+    presenter->RefreshGuestOutput(
+        frontbuffer_width * rs, frontbuffer_height * rs, 1280, 720,
+        [this, frontbuffer_ptr, swap, gamma](ui::Presenter::GuestOutputRefreshContext& context) -> bool {
+          auto& metal_context = static_cast<MetalGuestOutputRefreshContext&>(context);
+          @autoreleasepool {
+            // HDR output: the SDK's refresher (HDR10 code values) while the presenter's layer is HDR10.
+            const ui::Presenter::HdrOutputState hdr_state = ui::Presenter::GetHdrOutputState();
+            ui::Presenter::SetGuestOutputHdrAvailable(true);
+            const bool use_hdr = hdr_state.active && REXCVAR_GET(metal_gamma_ramp) &&
+                                 metal_context.texture().pixelFormat == MTLPixelFormatRGB10A2Unorm;
+            MetalDraw::HdrRefresh refresh{};
+            HdrComposite composite = HdrComposite::kWholeFrame;
+            if (use_hdr) {
+              const uint32_t width = uint32_t(metal_context.texture().width);
+              const uint32_t height = uint32_t(metal_context.texture().height);
+              composite = HdrGetComposite(width, height);
+              refresh.layer = composite == HdrComposite::kMask || composite == HdrComposite::kLayer;
+              if (refresh.layer && !draw_->HdrEnsureTextures(width, height)) {
+                composite = HdrComposite::kWholeFrame;
+                refresh.layer = false;
+              }
+              refresh.scene = hdr_frame_.scene && composite != HdrComposite::kWholeFrame;
+              refresh.constants[0] = width;
+              refresh.constants[1] = height;
+              HdrRefreshFlags(composite, hdr_state.debug_ui, &refresh.constants[2]);
+              refresh.constants[2] |= uint32_t(hdr_state.sdr_pure_gamma_2_2) | (uint32_t(hdr_state.test_pattern) << 1);
+              const float levels[4] = {hdr_state.sdr_white_nits, hdr_state.paper_white_nits,
+                                       hdr_state.rolloff_start_nits, hdr_state.peak_nits};
+              std::memcpy(&refresh.constants[4], levels, sizeof(levels));
+            }
+            // Frame generation (the presenter gives a texture for it while it's on): for frames of the game's 3D
+            // scene put together from the UI layer, or without UI, and with the tone map (menus, loading and legal
+            // screens are shown alone), with the temporal AA's camera; HDR or SDR (not with the PWL ramp).
+            MetalDraw::FrameGeneration fg{};
+            fg.generated = metal_context.generated();
+            if (fg.generated && !use_hdr && REXCVAR_GET(metal_gamma_ramp)) {
+              // SDR: the refresher's constants for the HUD-less image and the compose (the UI layer is kept apart
+              // while frame generation is on, Presenter::SetFrameGenerationUiSeparation).
+              const uint32_t width = uint32_t(metal_context.texture().width);
+              const uint32_t height = uint32_t(metal_context.texture().height);
+              composite = HdrGetComposite(width, height);
+              fg.sdr.layer = composite == HdrComposite::kMask || composite == HdrComposite::kLayer;
+              if (fg.sdr.layer && !draw_->HdrEnsureTextures(width, height)) {
+                composite = HdrComposite::kWholeFrame;
+                fg.sdr.layer = false;
+              }
+              fg.sdr.scene = hdr_frame_.scene && composite != HdrComposite::kWholeFrame;
+              fg.sdr.constants[0] = width;
+              fg.sdr.constants[1] = height;
+              HdrRefreshFlags(composite, 0, &fg.sdr.constants[2]);
+            }
+            if (fg.generated) {
+              fg.allowed = (composite == HdrComposite::kLayer || composite == HdrComposite::kScene) &&
+                           hdr_frame_.tonemap && (!use_hdr || (!hdr_state.debug_ui && !hdr_state.test_pattern));
+              fg.near_plane = taa_camera_.near_plane;
+              fg.far_plane = taa_camera_.far_plane;
+              fg.fov_vertical = taa_camera_.fov_vertical;
+              fg.delta_time = taa_frame_time_ms_ / 1000.0f;
+              fg.reset = taa_camera_.reset;
+            }
+            bool wrote_pq = false;
+            if (draw_ && draw_->Present(frontbuffer_ptr, metal_context.texture(), gamma.get(),
+                                        use_hdr ? &refresh : nullptr, &wrote_pq, fg.generated ? &fg : nullptr)) {
+              if (wrote_pq) context.SetHdr({true, hdr_state.sdr_white_nits, hdr_state.sdr_pure_gamma_2_2});
+              metal_context.SetGenerated(fg.generated_out);
+              return true;
+            }
+            // The placeholder: a slow pulse, so that a moving picture shows that the swaps arrive.
+            const double phase = double(swap % 120) / 120.0;
+            const double level = 0.10 + 0.08 * (phase < 0.5 ? phase : 1.0 - phase) * 2.0;
+            MTLRenderPassDescriptor* pass = [MTLRenderPassDescriptor renderPassDescriptor];
+            pass.colorAttachments[0].texture = metal_context.texture();
+            pass.colorAttachments[0].loadAction = MTLLoadActionClear;
+            pass.colorAttachments[0].clearColor = MTLClearColorMake(level * 0.6, level * 0.7, level, 1.0);
+            pass.colorAttachments[0].storeAction = MTLStoreActionStore;
+            id<MTLCommandBuffer> command_buffer = [metal_context.command_queue() commandBuffer];
+            command_buffer.label = @"rexglue guest output (M0 placeholder)";
+            [[command_buffer renderCommandEncoderWithDescriptor:pass] endEncoding];
+            [command_buffer commit];
+          }
+          return true;
+        });
+  }
+  MaybeLogStats();
+}
+
+void MetalCommandProcessor::CreateZeroCopySharedMemory() {
+  uint8_t* physical = memory_->physical_membase();
+  const size_t size = SharedMemory::kBufferSize;
+  const size_t page = size_t(getpagesize());
+  if (!physical || (reinterpret_cast<uintptr_t>(physical) & (page - 1)) || (size & (page - 1))) {
+    REXGPU_WARN("Metal: guest physical memory is not page-aligned; no zero-copy shared memory");
+    return;
+  }
+  const uint64_t start_ms = chrono::Clock::QueryHostUptimeMillis();
+  shared_memory_buffer_ = [device_ newBufferWithBytesNoCopy:physical
+                                                     length:size
+                                                    options:MTLResourceStorageModeShared |
+                                                            (REXCVAR_GET(metal_memory_untracked)
+                                                                 ? MTLResourceHazardTrackingModeUntracked
+                                                                 : MTLResourceHazardTrackingModeDefault)
+                                                deallocator:nil];
+  if (!shared_memory_buffer_) {
+    REXGPU_WARN("Metal: the guest's physical memory could not be made a Metal buffer without a copy");
+    return;
+  }
+  shared_memory_buffer_.label = @"rexglue guest physical memory (no copy)";
+  REXGPU_INFO("Metal: guest physical memory ({} MB at {}) is a Metal buffer without a copy, in {} ms (GPU address "
+              "{:016X})",
+              size >> 20, static_cast<const void*>(physical), chrono::Clock::QueryHostUptimeMillis() - start_ms,
+              shared_memory_buffer_.gpuAddress);
+}
+
+void MetalCommandProcessor::CheckZeroCopySharedMemory() {
+  shared_memory_checked_ = true;
+  size_t total = 0;
+  for (const auto& range : shader_ranges_) {
+    total += range.second * sizeof(uint32_t);
+  }
+  if (!total) {
+    return;
+  }
+  @autoreleasepool {
+    id<MTLBuffer> readback = [device_ newBufferWithLength:total options:MTLResourceStorageModeShared];
+    id<MTLCommandBuffer> command_buffer = [command_queue_ commandBuffer];
+    command_buffer.label = @"rexglue zero-copy shared memory check";
+    id<MTLBlitCommandEncoder> blit = [command_buffer blitCommandEncoder];
+    size_t offset = 0;
+    for (const auto& range : shader_ranges_) {
+      const size_t length = range.second * sizeof(uint32_t);
+      [blit copyFromBuffer:shared_memory_buffer_ sourceOffset:range.first toBuffer:readback
+           destinationOffset:offset size:length];
+      offset += length;
+    }
+    [blit endEncoding];
+    [command_buffer commit];
+    [command_buffer waitUntilCompleted];
+    size_t mismatched = 0;
+    offset = 0;
+    const auto* gpu = static_cast<const uint8_t*>(readback.contents);
+    for (const auto& range : shader_ranges_) {
+      const size_t length = range.second * sizeof(uint32_t);
+      if (std::memcmp(gpu + offset, memory_->TranslatePhysical<const uint8_t*>(range.first), length)) {
+        ++mismatched;
+      }
+      offset += length;
+    }
+    if (command_buffer.status == MTLCommandBufferStatusCompleted && !mismatched) {
+      REXGPU_INFO("Metal: zero-copy shared memory checked: the GPU read the microcode of all {} shaders ({} bytes "
+                  "of guest physical memory) exactly as the CPU sees it",
+                  shader_ranges_.size(), total);
+    } else {
+      REXGPU_WARN("Metal: zero-copy shared memory check FAILED: {} of {} ranges differ (command buffer status {})",
+                  mismatched, shader_ranges_.size(), int(command_buffer.status));
+    }
+  }
+}
+
+void MetalCommandProcessor::MaybeLogStats() {
+  const uint64_t now_ms = chrono::Clock::QueryHostUptimeMillis();
+  const uint64_t elapsed_ms = now_ms - stats_since_ms_;
+  if (elapsed_ms < 5000) {
+    return;
+  }
+  const double seconds = double(elapsed_ms) / 1000.0;
+  REXGPU_INFO("Metal M1: {:.1f} swaps/s, {:.0f} draws and {:.0f} resolves a swap, {} shaders loaded",
+              stats_swaps_ / seconds, stats_swaps_ ? double(stats_draws_) / stats_swaps_ : 0.0,
+              stats_swaps_ ? double(stats_copies_) / stats_swaps_ : 0.0, shaders_.size());
+  if (draw_) REXGPU_INFO("Metal rasterizer: {} draws submitted, {} color resolves, {} failures total", draw_->draws(), draw_->resolves(), draw_->failures());
+  if (shader_compiler_) {
+    const MetalShaderCompiler::Stats& s = shader_compiler_->stats();
+    const uint32_t compiled = s.compiled.load();
+    REXGPU_INFO(
+        "Metal shaders: {} translated to SPIR-V ({} failed), {} refused by SPIRV-Cross, {} compiled by Metal "
+        "({} failed, {} pending); translation {:.2f} ms and Metal {:.1f} ms a shader on average",
+        s.translated.load(), s.translate_failed.load(), s.msl_failed.load(), compiled, s.compile_failed.load(),
+        s.pending.load(), s.translated ? s.translate_us.load() / 1000.0 / s.translated.load() : 0.0,
+        compiled ? s.compile_us.load() / 1000.0 / compiled : 0.0);
+  }
+  stats_swaps_ = 0;
+  stats_draws_ = 0;
+  stats_copies_ = 0;
+  stats_since_ms_ = now_ms;
+}
