+bool MetalCommandProcessor::HostOcclusionQueryRecording() const { return draw_ && draw_->OcclusionQueryRecording(); }
+bool MetalCommandProcessor::HostOcclusionQueryEnd(uint32_t& host_index_out, uint64_t& submission_out,
+                                                  uint32_t& draws_out) {
+  if (!draw_ || !draw_->OcclusionQueryEnd(host_index_out, submission_out, draws_out)) return false;
+  // A query of the scene drawn at the upscaler's render size counts that size's pixels: the game expects the
+  // output's (MCLA's sun: 1,250 samples in full view).
+  double scale = 1.0;
+  if (query_squeezed_ && taa_up_.render_width && taa_up_.render_height)
+    scale = double(taa_up_.out_width) * taa_up_.out_height / (double(taa_up_.render_width) * taa_up_.render_height);
+  query_scale_[host_index_out % query_scale_.size()] = float(scale);
+  return true;
+}
+void MetalCommandProcessor::HostOcclusionQueryAbandon() { if (draw_) draw_->OcclusionQueryAbandon(); }
+bool MetalCommandProcessor::HostOcclusionQueryRead(uint32_t host_index, uint64_t submission, uint64_t& samples_out,
+                                                   uint64_t& raw_samples_out) {
+  // Host pixels are guest samples (MSAA is drawn as supersampling), as the other backends count at 1x scale.
+  if (!draw_ || !draw_->OcclusionQueryRead(host_index, submission, raw_samples_out)) return false;
+  samples_out = uint64_t(double(raw_samples_out) * query_scale_[host_index % query_scale_.size()] + 0.5);
+  return true;
+}
