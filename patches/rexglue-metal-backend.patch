+// Puts an 8_8_8_8 target back after the UI layer: target + underlay x (1 - target alpha), by the blend.
+constexpr const char kHdrRestoreSource[] = R"(
+#include <metal_stdlib>
+using namespace metal;
+vertex float4 hdr_restore_vs(uint id [[vertex_id]]) {
+  return float4(float2((id << 1) & 2, id & 2) * 2.0f - 1.0f, 0.0f, 1.0f);
+}
+fragment float4 hdr_restore_ps(float4 position [[position]], texture2d<float> underlay [[texture(0)]]) {
+  uint2 p = uint2(position.xy);
+  if (p.x >= underlay.get_width() || p.y >= underlay.get_height()) discard_fragment();
+  return underlay.read(p);
+}
+)";
+// PrimitiveProcessor needs the common shared-memory range service. No uploads or write watches
+// are necessary for the no-copy buffer. Converted indices are invalidated at each draw below.
+class UnifiedMemory final : public SharedMemory {
+ public:
+  explicit UnifiedMemory(memory::Memory& memory) : SharedMemory(memory) { InitializeCommon(); }
+ private:
+  bool UploadRanges(const std::vector<std::pair<uint32_t, uint32_t>>&) override { return true; }
+};
+MTLPixelFormat ColorFormat(xenos::ColorRenderTargetFormat format) {
+  using F = xenos::ColorRenderTargetFormat;
+  switch (format) {
+    case F::k_8_8_8_8: case F::k_8_8_8_8_GAMMA: return MTLPixelFormatRGBA8Unorm;
+    case F::k_2_10_10_10: return MTLPixelFormatRGB10A2Unorm;
+    case F::k_2_10_10_10_FLOAT: case F::k_2_10_10_10_AS_10_10_10_10:
+    case F::k_2_10_10_10_FLOAT_AS_16_16_16_16: return MTLPixelFormatRGBA16Float;
+    case F::k_16_16: return MTLPixelFormatRG16Snorm;
+    case F::k_16_16_16_16: return MTLPixelFormatRGBA16Snorm;
+    case F::k_16_16_FLOAT: return MTLPixelFormatRG16Float;
+    case F::k_16_16_16_16_FLOAT: return MTLPixelFormatRGBA16Float;
+    case F::k_32_FLOAT: return MTLPixelFormatR32Float;
+    case F::k_32_32_FLOAT: return MTLPixelFormatRG32Float;
+    default: return MTLPixelFormatInvalid;
+  }
+}
+MTLBlendFactor BlendFactor(xenos::BlendFactor f) {
+  switch (uint32_t(f)) {
+    case 0: return MTLBlendFactorZero; case 1: return MTLBlendFactorOne;
+    case 4: return MTLBlendFactorSourceColor; case 5: return MTLBlendFactorOneMinusSourceColor;
+    case 6: return MTLBlendFactorSourceAlpha; case 7: return MTLBlendFactorOneMinusSourceAlpha;
+    case 8: return MTLBlendFactorDestinationColor; case 9: return MTLBlendFactorOneMinusDestinationColor;
+    case 10: return MTLBlendFactorDestinationAlpha; case 11: return MTLBlendFactorOneMinusDestinationAlpha;
+    case 12: return MTLBlendFactorBlendColor; case 13: return MTLBlendFactorOneMinusBlendColor;
+    case 14: return MTLBlendFactorBlendAlpha; case 15: return MTLBlendFactorOneMinusBlendAlpha;
+    case 16: return MTLBlendFactorSourceAlphaSaturated;
+    default: return MTLBlendFactorOne;
+  }
+}
+MTLBlendOperation BlendOp(xenos::BlendOp op) {
+  switch (uint32_t(op)) {
+    case 1: return MTLBlendOperationSubtract; case 2: return MTLBlendOperationMin;
+    case 3: return MTLBlendOperationMax; case 4: return MTLBlendOperationReverseSubtract;
+    default: return MTLBlendOperationAdd;
+  }
+}
+MTLStencilOperation StencilOp(uint32_t op) {
+  static const MTLStencilOperation ops[] = {MTLStencilOperationKeep, MTLStencilOperationZero,
+    MTLStencilOperationReplace, MTLStencilOperationIncrementClamp, MTLStencilOperationDecrementClamp,
+    MTLStencilOperationInvert, MTLStencilOperationIncrementWrap, MTLStencilOperationDecrementWrap};
+  return ops[op & 7];
+}
+// ResolveConstants in metal_resolve.h (MSL layout: uint2 x3, uint x6, float, then uint2 at offset 56).
+struct ResolveConstants {
+  uint32_t sx = 0, sy = 0, width = 0, height = 0, dx = 0, dy = 0, pitch = 0, address = 0, format = 0, endian = 0,
+      swap = 0, write_memory = 0;
+  float scale = 1.0f; uint32_t padding = 0;
+  uint32_t samples_x = 1, samples_y = 1, sample_select = 0, extent_start = 0, extent_end = 0, stretch = 0;
+  uint32_t stretch_num[2] = {}, stretch_den[2] = {};  // temporal_aa_upscale: the render and output sizes
+  uint32_t tex_ss[2] = {1, 1};  // samples a texel of a single-sample source holds (metal_4x_as_1x)
+  uint32_t rs = 1, padding2 = 0;  // resolution_scale: source and destination texels across and down a guest pixel
+};
+static_assert(sizeof(ResolveConstants) == 112);
+// TransferConstants in metal_resolve.h.
+struct TransferConstants {
+  uint32_t dst_base, dst_pitch, src_base, src_pitch, lo, hi, src_kind, dst_kind;
+  uint32_t dst_ss[2], src_ss[2];
+  uint32_t dst_dw, src_dw;  // EDRAM dwords a sample: 2 for 64bpp formats
+  uint32_t scale = 1, padding = 0;  // the resolution scale (MetalResolutionScale), both single-sample targets
+};
+template <typename T> void Key(std::string& key, T value) {
+  key.append(reinterpret_cast<const char*>(&value), sizeof(value));
+}
+}
+
+// Buffers only the CPU writes and the GPU only reads (vertex snapshots, constants, index buffers, uploads) have no
+// GPU hazards for Metal to track (metal_ring_untracked).
+static MTLResourceOptions CpuWrittenOptions() {
+  return MTLResourceStorageModeShared |
+         (REXCVAR_GET(metal_ring_untracked) ? MTLResourceHazardTrackingModeUntracked : MTLResourceHazardTrackingModeDefault);
+}
+class MetalPrimitiveProcessor final : public PrimitiveProcessor {
+ public:
+  MetalPrimitiveProcessor(id<MTLDevice> device, const RegisterFile& regs, memory::Memory& memory, SharedMemory& shared)
+      : PrimitiveProcessor(regs, memory, shared), device_(device) {}
+  bool Initialize() { return InitializeCommon(true, false, false, false, false, false); }
+  void NextDraw() { ClearPerFrameCache(); buffers_.clear(); }
+  // A frame slot's converted indices start again (its last frame's GPU work is done).
+  void ResetSlot(uint32_t slot) { slot_ = slot & 1; ring_used_ = 0; }
+  std::pair<id<MTLBuffer>, size_t> Buffer(const ProcessingResult& p) const {
+    if (p.index_buffer_type == kHostConverted) return buffers_.at(p.host_index_buffer_handle);
+    return {builtin_, GetBuiltinIndexBufferOffsetBytes(p.host_index_buffer_handle)};
+  }
+ private:
+  bool InitializeBuiltinIndexBuffer(size_t size, std::function<void(void*)> fill) override {
+    builtin_ = [device_ newBufferWithLength:size options:CpuWrittenOptions()];
+    if (!builtin_) return false;
+    fill(builtin_.contents); return true;
+  }
+  void* RequestHostConvertedIndexBufferForCurrentFrame(xenos::IndexFormat format, uint32_t count,
+      bool align, uint32_t original, size_t& handle) override {
+    size_t size = count * (format == xenos::IndexFormat::kInt16 ? 2 : 4) + XE_GPU_PRIMITIVE_PROCESSOR_SIMD_SIZE;
+    // Into the frame slot's ring (a buffer a draw was a driver call each, and on Metal 4 a residency change).
+    auto& ring = rings_[slot_];
+    if (!ring) {
+      ring = [device_ newBufferWithLength:kRingSize options:CpuWrittenOptions()];
+      ring.label = @"Xenos converted indices";
+    }
+    if (ring && ring_used_ + size <= kRingSize) {
+      uint8_t* at = static_cast<uint8_t*>(ring.contents) + ring_used_;
+      size_t offset = align ? GetSimdCoalignmentOffset(at, original) : 0;
+      handle = buffers_.size(); buffers_.emplace_back(ring, ring_used_ + offset);
+      ring_used_ += (size + offset + 63) & ~size_t(63);
+      return at + offset;
+    }
+    id<MTLBuffer> buffer = [device_ newBufferWithLength:size options:CpuWrittenOptions()];
+    if (!buffer) return nullptr;
+    size_t offset = align ? GetSimdCoalignmentOffset(buffer.contents, original) : 0;
+    handle = buffers_.size(); buffers_.emplace_back(buffer, offset);
+    return static_cast<uint8_t*>(buffer.contents) + offset;
+  }
+  static constexpr size_t kRingSize = size_t(8) << 20;
+  id<MTLDevice> device_;
+  id<MTLBuffer> builtin_;
+  std::vector<std::pair<id<MTLBuffer>, size_t>> buffers_;
+  std::array<id<MTLBuffer>, 2> rings_{};
+  uint32_t slot_ = 0;
+  size_t ring_used_ = 0;
+};
+
+MetalDraw::MetalDraw(id<MTLDevice> device, id<MTLCommandQueue> queue, id<MTLBuffer> memory_buffer,
+    memory::Memory& memory, RegisterFile& regs, MetalShaderCompiler& shaders, uint32_t edram_tiles)
+    : device_(device), queue_(queue), memory_buffer_(memory_buffer), memory_(memory), regs_(regs),
+      shaders_(shaders), edram_tiles_(edram_tiles), rs_(MetalResolutionScale()) {}
+MetalDraw::~MetalDraw() {
+  if (prebuild_thread_.joinable()) prebuild_thread_.join();
+  {
+    std::unique_lock<std::mutex> lock(prebuild_mutex_);
+    prebuild_cv_.wait(lock, [this] { return prebuild_in_flight_ == 0; });
+  }
+  Submit(); primitives_.reset(); shared_.reset();
+}
+bool MetalDraw::Initialize() {
+  gpu_ = std::make_unique<GpuQueue>(device_, queue_);
+  if (!gpu_->Initialize()) return false;
+  if (gpu_->metal4() && REXCVAR_GET(metal_gpu_phase_times) > 0) {
+    if (@available(macOS 26.0, *)) {
+      auto counters = std::make_unique<MetalCounters4>();
+      std::string log;
+      // 4 ranges: the frames in flight (2) and the one being resolved; 512 stamps: every phase of the frame
+      // (mcla_render_markers_all_phases, both tiles) and a resume and a suspend a command buffer. Relaxed: only the
+      // encoder stamps would use it, and there are none.
+      if (counters->Init(device_, 4, 512, true, log)) {
+        counters_ = std::move(counters);
+        counters_->BeginFrame();
+      }
+      REXGPU_INFO("Metal {}", log);
+    }
+  }
+  if (gpu_->metal4() && REXCVAR_GET(metal_texture_view_pool)) {
+    if (@available(macOS 26.0, *)) {
+      auto views = std::make_unique<MetalViews4>();
+      std::string log;
+      // A texture has one to three swizzles; free roam keeps some 2,000 textures with views.
+      if (views->Init(device_, 16384, log)) views4_ = std::move(views);
+      REXGPU_INFO("Metal {}", log);
+    }
+  }
+  if (gpu_->metal4() && REXCVAR_GET(metal_rt)) {
+    if (@available(macOS 26.0, *)) {
+      auto rt = std::make_unique<MetalRt4>();
+      std::string log;
+      MetalRt4::Options options;
+      options.build_budget = uint32_t(std::max(REXCVAR_GET(metal_rt_build_budget), 1000));
+      options.fast_build = REXCVAR_GET(metal_rt_fast_build);
+      options.static_level = REXCVAR_GET(metal_rt_static);
+      if (rt->Init(device_, options, log)) {
+        for (auto& buffer : rt_upload_) {
+          buffer = [device_ newBufferWithLength:size_t(32) << 20 options:CpuWrittenOptions()];
+          gpu_->MakeResident(buffer);
+        }
+        rt_ = std::move(rt);
+        std::string error;
+        rt_check_ = MetalRtCheckPipeline(device_, error);
+        if (!rt_check_) REXGPU_WARN("Metal ray tracing: no depth check: {}", error);
+        for (auto& buffer : rt_counts_) {
+          buffer = [device_ newBufferWithLength:kRtCountsBytes options:MTLResourceStorageModeShared];
+          std::memset(buffer.contents, 0, kRtCountsBytes);
+          gpu_->MakeResident(buffer);
+        }
+      }
+      REXGPU_INFO("Metal {}", log);
+    }
+  }
+  // Metal 4's encoder calls are argument table writes: no encoder thread for them (decided by measurement later).
+  if (REXCVAR_GET(metal_encoder_thread) && !gpu_->metal4()) {
+    equeue_ = std::make_unique<EncoderQueue>();
+    equeue_batch_ = uint32_t(std::max(1, REXCVAR_GET(metal_encoder_batch)));
+    equeue_->Start(uint32_t(std::max(0, REXCVAR_GET(metal_encoder_spin))));
+  }
+  snapshot_buffer_ = [device_ newBufferWithLength:2 * kSnapshotRing + kSnapshotPersistent options:CpuWrittenOptions()];
+  if (REXCVAR_GET(metal_constant_ring)) {
+    constant_ring_ = [device_ newBufferWithLength:2 * kConstantRing options:CpuWrittenOptions()];
+    constant_ring_.label = @"Xenos shader constants (two frames)";
+  }
+  if (!snapshot_buffer_) return false;
+  snapshot_buffer_.label = @"Xenos draw-time vertex and index snapshots";
+  ring_base_ = 0;
+  resolve_rejected_ = [device_ newBufferWithLength:4 options:MTLResourceStorageModeShared];
+  fence_values_ = [device_ newBufferWithLength:4096 * 4 options:MTLResourceStorageModeShared];
+  visibility_ = [device_ newBufferWithLength:kQuerySlots * 8 options:MTLResourceStorageModeShared];
+  // Guest memory without Metal's hazard tracking (metal_memory_untracked): its users are ordered by this fence.
+  if (memory_buffer_ && memory_buffer_.hazardTrackingMode == MTLHazardTrackingModeUntracked) { memory_fence_ = [device_ newFence]; memory_read_fence_ = [device_ newFence]; }
+  for (id resource : {(id)memory_buffer_, (id)snapshot_buffer_, (id)constant_ring_, (id)resolve_rejected_,
+                      (id)fence_values_, (id)visibility_})
+    gpu_->MakeResident(resource);
+  query_done_.reset(new std::atomic<uint64_t>[kQuerySlots]);
+  for (uint32_t i = 0; i < kQuerySlots; ++i) query_done_[i].store(0);
+  *static_cast<uint32_t*>(resolve_rejected_.contents) = 0;
+  NSError* error = nil;
+  auto library = [device_ newLibraryWithSource:[NSString stringWithUTF8String:kMetalResolveSource] options:nil error:&error];
+  if (library) {
+    resolve_color_ = [device_ newComputePipelineStateWithFunction:[library newFunctionWithName:@"resolve_color"] error:&error];
+    resolve_depth_ = [device_ newComputePipelineStateWithFunction:[library newFunctionWithName:@"resolve_depth"] error:&error];
+    resolve_color_ms_ = [device_ newComputePipelineStateWithFunction:[library newFunctionWithName:@"resolve_color_ms"] error:&error];
+    resolve_depth_ms_ = [device_ newComputePipelineStateWithFunction:[library newFunctionWithName:@"resolve_depth_ms"] error:&error];
+    present_ = [device_ newComputePipelineStateWithFunction:[library newFunctionWithName:@"present_color"] error:&error];
+    load_texture_ = [device_ newComputePipelineStateWithFunction:[library newFunctionWithName:@"load_texture"] error:&error];
+  }
+  helper_library_ = library;
+  {
+    // EDRAM transfers into depth: every sample written, depth and stencil from the shader.
+    auto desc = [MTLDepthStencilDescriptor new];
+    desc.depthCompareFunction = MTLCompareFunctionAlways; desc.depthWriteEnabled = YES;
+    auto stencil = [MTLStencilDescriptor new];
+    stencil.stencilCompareFunction = MTLCompareFunctionAlways;
+    stencil.depthStencilPassOperation = MTLStencilOperationReplace;
+    stencil.readMask = stencil.writeMask = 0xFF;
+    desc.frontFaceStencil = desc.backFaceStencil = stencil;
+    transfer_depth_state_ = [device_ newDepthStencilStateWithDescriptor:desc];
+    auto keep = [MTLDepthStencilDescriptor new];  // color transfers in a pass with depth: depth untouched
+    keep.depthCompareFunction = MTLCompareFunctionAlways; keep.depthWriteEnabled = NO;
+    transfer_color_depth_state_ = [device_ newDepthStencilStateWithDescriptor:keep];
+  }
+  if (!resolve_color_ || !resolve_depth_ || !resolve_color_ms_ || !resolve_depth_ms_ || !present_ || !load_texture_) {
+    REXGPU_ERROR("Metal resolve shader failed: {}", error.localizedDescription.UTF8String); return false;
+  }
+  shared_ = std::make_unique<UnifiedMemory>(memory_);
+  primitives_ = std::make_unique<MetalPrimitiveProcessor>(device_, regs_, memory_, *shared_);
+  return primitives_->Initialize();
+}
+void MetalDraw::EndEncoder() {
+  if (equeue_ && queued_encoder_) {
+    // The encoder thread's calls into it first; then what they used may go.
+    equeue_->Drain();
+    queued_encoder_ = nullptr;
+  }
+  retired_.clear();
+  if (encoder_) {
+    // The command buffer before a pass takes texture work only while that pass is open (a later encoder may get
+    // the same address).
+    if (pre_encoder_ == encoder_.key()) pre_encoder_ = nullptr;
+    const auto end_start = std::chrono::steady_clock::now();
+    encoder_.End(); encoder_ = {};
+    end_us_ += uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - end_start).count());
+    // A new encoder may be allocated at the same address. Metal 4: bound_pass_ holds the ended one (no new one
+    // gets its address), and the next pass may carry its bindings over (Bind).
+    if (!gpu_->metal4()) bound_encoder_ = nullptr;
+    enc_state_.encoder = nullptr;
+    encoder_query_slot_ = -1; pass_visibility_ = false;
+    if (commands_ && DebugFrame() && REXCVAR_GET(metal_debug_profile)) ProfileCut(pass_label_, draws_ - pass_first_draw_);
+  }
+  if (pending_mark_ >= 0 && counters_ && commands_) Stamp(MetalCounters4::Kind::kMark, uint16_t(pending_mark_), commands_);
+  pending_mark_ = -1;
+  attachments_ = {};
+}
+void MetalDraw::ProfileCut(const std::string& label, uint64_t draws) {
+  // A command buffer per pass in a dumped frame: its GPU time is the pass's (with the compute work before it).
+  std::string text = label;
+  commands_.AddCompleted(^(const GpuDone& done) {
+    REXGPU_INFO("Metal GPU profile: {:.3f} ms, {} draws: {}", (done.gpu_end - done.gpu_start) * 1000.0, draws, text);
+  });
+  Submit(false);
+  Commands();
+}
+void MetalDraw::CommitBefore() {
+  if (!pre_commands_) return;
+  Commit(pre_commands_);
+  pre_encoder_ = nullptr;
+}
+GpuCommands& MetalDraw::Commands() {
+  if (!commands_) {
+    commands_ = gpu_->Begin(@"Xenos M1 draws");
+    if (counters_) Stamp(MetalCounters4::Kind::kResume, 0, commands_);
+  }
+  return commands_;
+}
+void MetalDraw::Stamp(MetalCounters4::Kind kind, uint16_t phase, GpuCommands& commands) {
+  if (@available(macOS 26.0, *)) {
+    const int32_t index = counters_->Reserve(kind, phase);
+    if (index != MetalCounters4::kNone) commands.Timestamp(counters_->heap(), NSUInteger(index));
+  }
+}
+void MetalDraw::GuestMarker(uint32_t kind, uint32_t value) {
+  if (kind != 0x100) rt_scene_ = kind == 7;  // the scene's opaque draws, until the next stretch (translucent)
+  else rt_phase_bit_ = value;
+  if (!counters_) return;
+  // kPhase names a phase bit (mcla_render_markers_all_phases); the other kinds name the stretch they begin.
+  const uint64_t key = kind == 0x100 ? (uint64_t(kind) << 32 | value) : uint64_t(kind) << 32;
+  auto found = phase_ids_.find(key);
+  if (found == phase_ids_.end()) {
+    static const char* const kNames[] = {"marker 0", "offscreen", "frame end", "post", "tonemap+glows", "UI",
+                                         "after render", "scene", "translucent", "composite"};
+    std::string name = kind == 0x100 ? fmt::format("phase {:08X}", value)
+                       : kind < std::size(kNames) ? std::string(kNames[kind]) : fmt::format("marker {}", kind);
+    uint16_t id = 0;
+    if (@available(macOS 26.0, *)) id = counters_->Phase(name);
+    found = phase_ids_.emplace(key, id).first;
+  }
+  // In an open pass: at its end (EndEncoder); a later marker in the same pass replaces it (the one before had no
+  // work outside the pass).
+  current_phase_ = found->second;
+  if (encoder_) pending_mark_ = found->second;
+  else Stamp(MetalCounters4::Kind::kMark, found->second, Commands());
+}
+void MetalDraw::Commit(GpuCommands& commands) {
+  GpuCommands* list[1] = {&commands};
+  Commit(list, 1);
+}
+void MetalDraw::Commit(GpuCommands* const* list, size_t count) {
+  auto errors = gpu_errors_; auto gpu_us = gpu_us_;
+  const bool metal4 = gpu_->metal4();
+  bool any = false;
+  for (size_t i = 0; i < count; ++i) {
+    if (!*list[i]) continue;
+    any = true;
+    list[i]->AddCompleted(^(const GpuDone& done) {
+      if (done.gpu_end > done.gpu_start) gpu_us->fetch_add(uint64_t((done.gpu_end - done.gpu_start) * 1e6));
+      // Metal 4's errors are reported by the queue.
+      if (done.error && !metal4 && errors->fetch_add(1) < 16)
+        REXGPU_ERROR("Metal draw command buffer failed: {}", done.error.localizedDescription.UTF8String);
+    });
+    if (counters_) Stamp(MetalCounters4::Kind::kSuspend, 0, *list[i]);
+  }
+  if (!any) return;
+  const auto commit_start = std::chrono::steady_clock::now();
+  last_committed_ = gpu_->Commit(list, count);
+  commit_us_ += uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - commit_start).count());
+}
+GpuCommands& MetalDraw::TextureWorkCommands() {
+  // Texture loads and surfaces made from resolves are compute and blit work, which cannot run in a render pass.
+  // In a pass that has a command buffer of its own, it goes into the one before (which runs first); otherwise
+  // it ends the pass, and the next frame's pass of the same ordinal gets a command buffer of its own.
+  if (encoder_ && pre_commands_ && pre_encoder_ == encoder_.key()) { ++texture_work_before_pass_; return pre_commands_; }
+  if (encoder_) {
+    ++passes_split_for_textures_;
+    if (open_pass_ordinal_ < split_now_.size()) split_now_[open_pass_ordinal_] = 1;
+  }
+  EndEncoder();
+  return Commands();
+}
+void MetalDraw::Submit(bool wait) {
+  EndEncoder();
+  // The command buffer before the open pass and the pass's own go back to back: one commit. A profiled frame keeps
+  // them apart (ProfileCut reports each command buffer's GPU time).
+  if (pre_commands_ && commands_ && !(DebugFrame() && REXCVAR_GET(metal_debug_profile))) {
+    GpuCommands* list[2] = {&pre_commands_, &commands_};
+    Commit(list, 2);
+    pre_encoder_ = nullptr;
+  } else {
+    CommitBefore();
+    if (commands_) Commit(commands_);
+  }
+  // Command buffers keep what they use alive; the uploads list only has to outlive the encoding.
+  uploads_.clear();
+  if (wait) {
+    // One queue: its last command buffer completes after the ones before it.
+    if (last_committed_) gpu_->Wait(last_committed_);
+    snapshots_.clear(); snapshot_used_ = 0; staging_used_ = 0; constant_used_ = 0;
+    primitives_->ResetSlot(slot_);
+  }
+}
+bool MetalDraw::OcclusionQueryBegin() {
+  if (!visibility_) return false;
+  query_slot_ = int32_t(query_cursor_++ % kQuerySlots);
+  // The slot's last use was a thousand queries ago (the game makes one a frame), long completed.
+  static_cast<uint64_t*>(visibility_.contents)[query_slot_] = 0;
+  query_done_[query_slot_].store(0, std::memory_order_relaxed);
+  query_draws_ = 0;
+  return true;
+}
+bool MetalDraw::OcclusionQueryEnd(uint32_t& slot_out, uint64_t& generation_out, uint32_t& draws_out) {
+  if (query_slot_ < 0) return false;
+  const uint32_t slot = uint32_t(query_slot_);
+  const uint64_t generation = ++query_generation_;
+  query_slot_ = -1;
+  // The count is complete when the command buffer being recorded is (one queue: those before it are too). A
+  // draw after this one in the same encoder stops counting (Draw).
+  auto done = query_done_;
+  Commands().AddCompleted(^(const GpuDone&) { done[slot].store(generation, std::memory_order_release); });
+  slot_out = slot; generation_out = generation; draws_out = query_draws_;
+  return true;
+}
+bool MetalDraw::OcclusionQueryRead(uint32_t slot, uint64_t generation, uint64_t& samples_out) {
+  if (slot >= kQuerySlots || query_done_[slot].load(std::memory_order_acquire) != generation) return false;
+  samples_out = static_cast<const uint64_t*>(visibility_.contents)[slot];
+  // Guest samples: rs x rs host pixels each at resolution_scale (one seen stays one).
+  if (rs_ > 1) samples_out = (samples_out + rs_ * rs_ - 1) / (rs_ * rs_);
+  return true;
+}
+bool MetalDraw::DebugFrame() const {
+  return frame_ == REXCVAR_GET(metal_debug_frame) || frame_ == capture_frame_;
+}
+bool MetalDraw::WriteFence(uint32_t address, uint32_t value) {
+  if (!REXCVAR_GET(metal_gpu_fences) || !memory_buffer_ || !fence_values_ || address > 0x1FFFFFFCu) return false;
+  // 4096 slots: about 8 fences a frame and two frames in flight, so a slot is long done before its reuse.
+  uint32_t slot = fence_slot_++ & 4095;
+  static_cast<uint32_t*>(fence_values_.contents)[slot] = value;
+  EndEncoder();
+  auto blit = Commands().Blit();
+  if (memory_fence_) { blit.WaitForFence(memory_fence_); blit.WaitForFence(memory_read_fence_); }
+  blit.CopyBuffer(fence_values_, slot * 4, memory_buffer_, address, 4);
+  if (memory_fence_) blit.UpdateFence(memory_fence_);
+  blit.End();
+  // Committed now, so a guest waiting for it doesn't wait for the end of the frame.
+  Submit(false);
+  ++fences_;
+  return true;
+}
+void MetalDraw::EndFrame() {
+  if (int32_t ms = REXCVAR_GET(metal_frame_sleep_ms)) std::this_thread::sleep_for(std::chrono::milliseconds(ms));
