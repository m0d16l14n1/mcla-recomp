+++ b/src/graphics/metal/metal_draw.h
@@ -0,0 +1,748 @@
+/** Native Metal draw path. BSD-3-Clause, see LICENSE. */
+#pragma once
+#include "metal_counters4.h"
+#include "metal_fx4.h"
+#include "metal_gpu.h"
+#include "metal_pipelines4.h"
+#include "metal_rt4.h"
+#include "metal_views4.h"
+
+#include <filesystem>
+#include <functional>
+#include "metal_shaders.h"
+#include "metal_encoder_queue.h"
+#include <rex/graphics/pipeline/texture/info.h>
+#include <rex/graphics/pipeline/texture/util.h>
+#include <rex/graphics/pipeline/texture/conversion.h>
+#include <rex/graphics/shared_memory.h>
+#include <unordered_set>
+#include <map>
+#include <atomic>
+#include <chrono>
+#include <memory>
+#include <mutex>
+#include <condition_variable>
+#include <thread>
+#include <array>
+#include <vector>
+
+namespace rex::graphics::metal {
+class MetalPrimitiveProcessor;
+class MetalDraw {
+ public:
+  MetalDraw(id<MTLDevice> device, id<MTLCommandQueue> queue, id<MTLBuffer> memory_buffer,
+            memory::Memory& memory, RegisterFile& regs, MetalShaderCompiler& shaders, uint32_t edram_tiles);
+  ~MetalDraw();
+  bool Initialize();
+  bool Draw(Shader* vs, Shader* ps);
+  bool Resolve();
+  // A guest fence value stored by the GPU, in order after the work encoded so far (metal_gpu_fences);
+  // false: the caller stores it.
+  bool WriteFence(uint32_t address, uint32_t value);
+  void EndFrame();
+  // A guest marker (CommandProcessor::OnGuestMarker): where a phase of the frame begins, for metal_gpu_phase_times
+  // and ray tracing (the opaque scene's draws are those after the scene marker).
+  void GuestMarker(uint32_t kind, uint32_t value);
+  // Ray tracing (metal_rt, Metal 4), before the draw that reads the frame's scene (the game's motion blur): the
+  // frame's captures and acceleration structure builds. `view_projection`: the scene camera's world to clip
+  // matrix (16 floats, rows, p' = p M); `camera`: its position (xyz, 1).
+  void RtRun(const float* view_projection, const float* camera);
+  // Occlusion queries (the SDK's HostOcclusionQuery*): the samples of the draws between a begin and an end that
+  // pass the depth and stencil tests, counted by the GPU into a slot of a visibility buffer (every pass of the
+  // query adds to it) and read without waiting once the command buffer of the query's last draw has completed.
+  bool OcclusionQueryBegin();
+  bool OcclusionQueryRecording() const { return query_slot_ >= 0; }
+  bool OcclusionQueryEnd(uint32_t& slot_out, uint64_t& generation_out, uint32_t& draws_out);
+  void OcclusionQueryAbandon() { query_slot_ = -1; }
+  bool OcclusionQueryRead(uint32_t slot, uint64_t generation, uint64_t& samples_out);
+  // Draws that reached the GPU (an occlusion query's draw that did not counts as hidden).
+  uint64_t draws_recorded() const { return draws_recorded_; }
+  // What the frame just ended cost the command thread (for the slow frame log, metal_slow_frame_ms).
+  struct FrameReport {
+    uint64_t cpu_us = 0, wait_us = 0, pipeline_us = 0, prebuilt_wait_us = 0, texture_hashed = 0, snapshot_copied = 0;
+    uint64_t texture_loads = 0, composed = 0, rows_loaded = 0, pipelines = 0, async_skipped = 0, passes = 0,
+             transfers = 0;
+    // The texture lookups the fast table missed (TextureSlow): calls and time, and of it the write watches set up
+    // and the loads (texture made, encoded).
+    uint64_t tex_slow_calls = 0, tex_slow_us = 0, tex_watch_us = 0, tex_load_us = 0, tex_alloc_us = 0;
+  };
+  const FrameReport& last_frame() const { return frame_report_; }
+  // Temporal anti-aliasing with MetalFX (the SDK's temporal_aa, which the fork's mcla_anti_aliasing = fsr
+  // turns on): the jitter of the scene's draws (the command processor's TaaJitterNdcOffset), and the pass
+  // before the game's motion blur draw. TaaRun returns the status for temporal_aa_debug 4 ('+' when it ran).
+  // For every draw, with its host viewport and scissor: the jitter (into the NDC offset), then, when the frame's
+  // scene is squeezed for upscaling (temporal_aa_upscale above 1), the viewport and scissor squeezed into the
+  // top-left render size of the target, and the ps_param_gen scale.
+  std::function<void(draw_util::ViewportInfo& viewport, draw_util::Scissor& scissor, float& param_gen_scale)> taa_draw_;
+  // Set by taa_draw_ for each draw: the upscaled scene's texture LOD bias, in -1/8 levels (CommandProcessor::TaaLodBias).
+  uint32_t taa_lod_bias_ = 0;
+  // For a resolve while the scene may be squeezed: whether to read the source through the stretch (num the render
+  // size, den the output size); copy_ok is whether this resolve can stretch.
+  std::function<bool(uint32_t pitch_px, uint32_t samples, uint32_t format, bool depth, uint32_t num[2], uint32_t den[2])>
+      taa_resolve_stretch_;
+  struct TaaInputs {
+    const void* vector_constants;  // CommandProcessor::TaaVectorConstants (size and stencil component set here)
