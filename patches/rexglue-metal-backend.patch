+namespace rex::graphics::metal {
+
+// The command thread decides each draw's state (pipeline, depth-stencil, viewport, buffers, textures, samplers)
+// and the draw; the Metal calls that send them to the open render encoder (a quarter of that thread's time in a
+// race) are queued here and made by the encoder thread, in order, while the command thread goes on with the
+// next draw. One producer (the command thread), one consumer.
+//
+// The rules that keep it correct, kept by MetalDraw:
+//  - The encoder is handed over (Encoder) after the command thread's own work in it at the pass's start (clears,
+//    EDRAM transfers); from then until Drain() returns, only the queue uses it. EndEncoder drains first.
+//  - Objects are queued unretained: everything queued must live until the next Drain() (pipelines, samplers,
+//    depth-stencil states and buffers live as long as the backend; texture views dropped while queued and
+//    per-draw index buffers are kept in MetalDraw's retired list until then).
+class EncoderQueue {
+ public:
+  enum class Op : uint8_t {
+    kEncoder, kPipeline, kDepthStencil, kStencilRef, kDepthClip, kViewport, kScissor, kWinding, kCull,
+    kBlendColor, kBuffer, kBufferOffset, kBytes, kTexture, kSampler, kDraw, kDrawIndexed, kVisibility,
+  };
+  struct Cmd {
+    Op op;
+    uint8_t vertex;  // the stage of a binding: 1 vertex, 0 fragment
+    uint16_t index;
+    uint32_t a, b, c;
+    union {
+      double d[6];
+      struct { void* obj; uint64_t offset; uint64_t extra; } r;
+      float f[4];
+    };
+  };
+  static_assert(sizeof(Cmd) == 64, "a cache line a command");
+
+  EncoderQueue() : ring_(new Cmd[kSize]), bytes_(new uint8_t[kBytes]) {}
+  ~EncoderQueue() { Stop(); }
+
+  void Start(uint32_t spin) {
+    if (thread_.joinable()) return;
+    spin_ = spin;
+    stop_.store(false);
+    thread_ = std::thread([this] {
+      pthread_setname_np("Metal encoder");
+      pthread_set_qos_class_self_np(QOS_CLASS_USER_INTERACTIVE, 0);
+      mach_port_.store(pthread_mach_thread_np(pthread_self()));
+      Run();
+    });
+  }
+  void Stop() {
+    if (!thread_.joinable()) return;
+    stop_.store(true, std::memory_order_seq_cst);
+    wake_.fetch_add(1, std::memory_order_seq_cst);
+    wake_.notify_all();
+    thread_.join();
+  }
+  bool active() const { return thread_.joinable(); }
+
+  // The next command's slot, filled by the caller; sent with the others since the last Push() by Push() (once a
+  // draw: a store and a load, and a wake-up only if the encoder thread went to sleep).
+  Cmd& Next(Op op) {
+    if (staged_ - tail_.load(std::memory_order_acquire) >= kSize) {
+      Push();
+      WaitForRoom(staged_);
+    }
+    Cmd& c = ring_[staged_ & (kSize - 1)];
+    ++staged_;
+    c.op = op;
+    return c;
+  }
+  void Push() {
+    if (head_.load(std::memory_order_relaxed) == staged_) return;
+    head_.store(staged_, std::memory_order_seq_cst);
+    if (sleeping_.load(std::memory_order_seq_cst)) {
+      wake_.fetch_add(1, std::memory_order_seq_cst);
+      wake_.notify_one();
+    }
+  }
+  // Inline bytes (setVertexBytes and the like, at most 4 KB): copied here, for the encoder thread to send.
+  // Returns false when the space is full until the next Drain (the caller drains and retries).
+  bool PutBytes(const void* data, uint32_t size, uint32_t& offset) {
+    if (bytes_used_ + size > kBytes) return false;
+    offset = bytes_used_;
+    std::memcpy(bytes_.get() + offset, data, size);
+    bytes_used_ += (size + 15) & ~uint32_t(15);
+    return true;
+  }
+  // Waits until the encoder thread has made every queued call; the encoder is the command thread's again.
+  void Drain() {
+    Push();
+    const uint64_t h = staged_;
+    for (uint32_t spin = 0; spin < 1000 && tail_.load(std::memory_order_acquire) != h; ++spin) {
+      __builtin_arm_yield();
+    }
+    if (tail_.load(std::memory_order_acquire) != h) {
+      ++drain_waits_;
+      const auto wait_start = std::chrono::steady_clock::now();
+      draining_.store(true, std::memory_order_seq_cst);
+      for (uint64_t t; (t = tail_.load(std::memory_order_seq_cst)) != h;) tail_.wait(t, std::memory_order_seq_cst);
+      draining_.store(false, std::memory_order_seq_cst);
+      drain_wait_us_ += uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
+          std::chrono::steady_clock::now() - wait_start).count());
+    }
+    bytes_used_ = 0;
+  }
+  uint64_t TakeDrainWaits() { uint64_t n = drain_waits_; drain_waits_ = 0; return n; }
+  uint64_t TakeDrainWaitUs() { uint64_t n = drain_wait_us_; drain_wait_us_ = 0; return n; }
+  // The encoder thread's CPU time so far, microseconds.
+  uint64_t ThreadCpuUs() const {
+    const mach_port_t port = mach_port_.load();
+    if (!port) return 0;
+    thread_basic_info_data_t info{};
+    mach_msg_type_number_t count = THREAD_BASIC_INFO_COUNT;
+    if (thread_info(port, THREAD_BASIC_INFO, reinterpret_cast<thread_info_t>(&info), &count) != KERN_SUCCESS) return 0;
+    return uint64_t(info.user_time.seconds + info.system_time.seconds) * 1000000 + info.user_time.microseconds +
+           info.system_time.microseconds;
+  }
+  uint64_t staged() const { return staged_ - head_.load(std::memory_order_relaxed); }
+  uint64_t TakeCommands() { uint64_t n = staged_ - counted_; counted_ = staged_; return n; }
+
+ private:
+  static constexpr uint64_t kSize = 1 << 15;
+  static constexpr uint32_t kBytes = 1 << 22;
+
+  void WaitForRoom(uint64_t h) {
+    draining_.store(true, std::memory_order_seq_cst);
+    for (uint64_t t; h - (t = tail_.load(std::memory_order_seq_cst)) >= kSize - 1024;) tail_.wait(t, std::memory_order_seq_cst);
+    draining_.store(false, std::memory_order_seq_cst);
+  }
+
+  void Run() {
+    uint64_t t = tail_.load(std::memory_order_relaxed);
+    __strong id<MTLRenderCommandEncoder> encoder = nil;
+    while (true) {
+      uint64_t h = head_.load(std::memory_order_acquire);
+      if (h == t) {
+        // A short spin before sleeping (the command thread publishes every few draws).
+        for (uint32_t spin = 0; spin < spin_ && h == t; ++spin) {
+          __builtin_arm_yield();
+          h = head_.load(std::memory_order_acquire);
+        }
+        if (h == t) {
+          if (stop_.load()) break;
+          const uint32_t w = wake_.load(std::memory_order_seq_cst);
+          sleeping_.store(true, std::memory_order_seq_cst);
+          h = head_.load(std::memory_order_seq_cst);
+          if (h == t && !stop_.load()) wake_.wait(w, std::memory_order_seq_cst);
+          sleeping_.store(false, std::memory_order_seq_cst);
+          continue;
+        }
+      }
+      @autoreleasepool {
+        for (; t != h; ++t) Execute(ring_[t & (kSize - 1)], encoder);
+      }
+      tail_.store(t, std::memory_order_seq_cst);
+      if (draining_.load(std::memory_order_seq_cst)) tail_.notify_all();
+    }
+  }
+
+  void Execute(const Cmd& c, __strong id<MTLRenderCommandEncoder>& e) {
+    switch (c.op) {
+      case Op::kEncoder: e = (__bridge id<MTLRenderCommandEncoder>)c.r.obj; break;
+      case Op::kPipeline: [e setRenderPipelineState:(__bridge id<MTLRenderPipelineState>)c.r.obj]; break;
+      case Op::kDepthStencil: [e setDepthStencilState:(__bridge id<MTLDepthStencilState>)c.r.obj]; break;
+      case Op::kStencilRef: [e setStencilFrontReferenceValue:c.a backReferenceValue:c.b]; break;
+      case Op::kDepthClip: [e setDepthClipMode:MTLDepthClipMode(c.a)]; break;
+      case Op::kViewport: [e setViewport:MTLViewport{c.d[0], c.d[1], c.d[2], c.d[3], c.d[4], c.d[5]}]; break;
+      case Op::kScissor: [e setScissorRect:MTLScissorRect{c.a, c.b, c.c, NSUInteger(c.r.extra)}]; break;
+      case Op::kWinding: [e setFrontFacingWinding:MTLWinding(c.a)]; break;
+      case Op::kCull: [e setCullMode:MTLCullMode(c.a)]; break;
+      case Op::kBlendColor: [e setBlendColorRed:c.f[0] green:c.f[1] blue:c.f[2] alpha:c.f[3]]; break;
+      case Op::kBuffer:
+        if (c.vertex) [e setVertexBuffer:(__bridge id<MTLBuffer>)c.r.obj offset:c.r.offset atIndex:c.index];
+        else [e setFragmentBuffer:(__bridge id<MTLBuffer>)c.r.obj offset:c.r.offset atIndex:c.index];
+        break;
+      case Op::kBufferOffset:
+        if (c.vertex) [e setVertexBufferOffset:c.r.offset atIndex:c.index];
+        else [e setFragmentBufferOffset:c.r.offset atIndex:c.index];
+        break;
+      case Op::kBytes:
+        if (c.vertex) [e setVertexBytes:bytes_.get() + c.a length:c.b atIndex:c.index];
+        else [e setFragmentBytes:bytes_.get() + c.a length:c.b atIndex:c.index];
+        break;
+      case Op::kTexture:
+        if (c.vertex) [e setVertexTexture:(__bridge id<MTLTexture>)c.r.obj atIndex:c.index];
+        else [e setFragmentTexture:(__bridge id<MTLTexture>)c.r.obj atIndex:c.index];
+        break;
+      case Op::kSampler:
+        if (c.vertex) [e setVertexSamplerState:(__bridge id<MTLSamplerState>)c.r.obj atIndex:c.index];
+        else [e setFragmentSamplerState:(__bridge id<MTLSamplerState>)c.r.obj atIndex:c.index];
+        break;
+      case Op::kVisibility: [e setVisibilityResultMode:MTLVisibilityResultMode(c.a) offset:c.r.offset]; break;
+      case Op::kDraw: [e drawPrimitives:MTLPrimitiveType(c.a) vertexStart:c.b vertexCount:c.c]; break;
+      case Op::kDrawIndexed:
+        [e drawIndexedPrimitives:MTLPrimitiveType(c.a) indexCount:c.b indexType:MTLIndexType(c.c)
+                     indexBuffer:(__bridge id<MTLBuffer>)c.r.obj indexBufferOffset:c.r.offset];
+        break;
+    }
+  }
+
+  std::unique_ptr<Cmd[]> ring_;
+  std::unique_ptr<uint8_t[]> bytes_;
+  uint32_t bytes_used_ = 0;  // the command thread's: reset by Drain
+  uint64_t staged_ = 0, counted_ = 0, drain_waits_ = 0, drain_wait_us_ = 0;  // the command thread's
+  std::atomic<mach_port_t> mach_port_{0};
+  uint32_t spin_ = 64;
+  alignas(64) std::atomic<uint64_t> head_{0};
+  alignas(64) std::atomic<uint64_t> tail_{0};
+  alignas(64) std::atomic<uint32_t> wake_{0};
+  std::atomic<bool> sleeping_{false}, draining_{false}, stop_{false};
+  std::thread thread_;
+};
+
+}  // namespace rex::graphics::metal
diff --git a/src/graphics/metal/metal_fx4.h b/src/graphics/metal/metal_fx4.h
new file mode 100644
