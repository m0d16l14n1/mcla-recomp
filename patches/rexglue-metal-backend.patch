+/**
+ * @file        graphics/metal/metal_internal.h
+ * @brief       The Metal backend's classes (Objective-C++ only)
+ *
+ * Added by the mcla-recomp macOS fork (patches/rexglue-metal-backend.patch). Milestone M0 (docs/metal-backend.md
+ * in the fork): a provider and a presenter that draws the guest output into the window's CAMetalLayer, and a
+ * command processor that runs the guest's command stream without drawing (draws and resolves are counted and
+ * skipped), so that the game runs on Metal end to end while the drawing parts are ported.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+#include <cstdio>
+#include <filesystem>
+#include <unordered_set>
+
+#if !defined(__OBJC__)
+#error "metal_internal.h is for the Objective-C++ sources of the Metal backend"
+#endif
+
+#import <Metal/Metal.h>
+#import <QuartzCore/CAMetalLayer.h>
+
+#include <array>
+#include <atomic>
+#include <mutex>
+#include <optional>
+#include <condition_variable>
+#include <thread>
+#include <cstdint>
+#include <memory>
+#include <chrono>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+#include <rex/graphics/command_processor.h>
+#include <rex/graphics/graphics_system.h>
+#include <rex/graphics/pipeline/shader/shader.h>
+#include <rex/ui/graphics_provider.h>
+#include <rex/ui/presenter.h>
+
+namespace rex::graphics::metal {
+
+class MetalShaderCompiler;
+class MetalDraw;
+
+class MetalProvider final : public ui::GraphicsProvider {
+ public:
+  static std::unique_ptr<MetalProvider> Create();
+
+  std::unique_ptr<ui::Presenter> CreatePresenter(
+      ui::Presenter::HostGpuLossCallback host_gpu_loss_callback =
+          ui::Presenter::FatalErrorHostGpuLossCallback) override;
+  // The ImGui overlays' drawer (metal_presenter.mm): draws into the presenter's paint pass.
+  std::unique_ptr<ui::ImmediateDrawer> CreateImmediateDrawer() override;
+
+  id<MTLDevice> device() const { return device_; }
+  // One queue for the guest's work and for presenting it: Metal runs a queue's command buffers in the order
+  // they are committed, so the guest output written for a swap is complete when a later paint reads it.
+  id<MTLCommandQueue> command_queue() const { return command_queue_; }
+
+ private:
+  MetalProvider() = default;
+
+  id<MTLDevice> device_ = nil;
+  id<MTLCommandQueue> command_queue_ = nil;
+};
+
+// What a guest output refresher gets: the texture to write the frame into, and the queue to do it on.
+class MetalGuestOutputRefreshContext final : public ui::Presenter::GuestOutputRefreshContext {
+ public:
+  MetalGuestOutputRefreshContext(bool& is_8bpc_out_ref, ui::Presenter::GuestOutputHdr& hdr_out_ref,
+                                 id<MTLTexture> texture, id<MTLCommandQueue> command_queue,
+                                 id<MTLTexture> generated = nil)
+      : GuestOutputRefreshContext(is_8bpc_out_ref, hdr_out_ref),
+        texture_(texture),
+        command_queue_(command_queue),
+        generated_(generated) {}
+
+  id<MTLTexture> texture() const { return texture_; }
+  id<MTLCommandQueue> command_queue() const { return command_queue_; }
+  // Frame generation: the texture for the frame generated between the last frame and this one (texture()'s size
+  // and format; nil while frame generation is off); the refresher says whether it wrote one there.
+  id<MTLTexture> generated() const { return generated_; }
+  void SetGenerated(bool written) { generated_written_ = written; }
+  bool generated_written() const { return generated_written_; }
+
+ private:
+  id<MTLTexture> texture_;
+  id<MTLCommandQueue> command_queue_;
+  id<MTLTexture> generated_;
+  bool generated_written_ = false;
+};
+
+class MetalPresenter final : public ui::Presenter {
+ public:
+  static std::unique_ptr<MetalPresenter> Create(HostGpuLossCallback host_gpu_loss_callback,
+                                                id<MTLDevice> device, id<MTLCommandQueue> command_queue);
+  ~MetalPresenter() override;
+
+  ui::Surface::TypeFlags GetSupportedSurfaceTypes() const override;
+  bool CaptureGuestOutput(ui::RawImage& image_out) override;
+  // Frame generation: MetalFX's frame interpolator (macOS 26), with HDR output.
+  bool SupportsFrameGeneration() const override;
+  const char* FrameGenerationUnsupportedReason() const override;
+
+  // The guest output is RGBA8, with the guest's own gamma (as the display would get it).
+  static constexpr MTLPixelFormat kGuestOutputFormat = MTLPixelFormatRGBA8Unorm;
+
+ protected:
+  SurfacePaintConnectResult ConnectOrReconnectPaintingToSurfaceFromUIThread(
+      ui::Surface& new_surface, uint32_t new_surface_width, uint32_t new_surface_height,
+      bool was_paintable, bool& is_vsync_implicit_out) override;
+  void DisconnectPaintingFromSurfaceFromUIThreadImpl() override;
+  bool RefreshGuestOutputImpl(uint32_t mailbox_index, uint32_t frontbuffer_width,
+                              uint32_t frontbuffer_height,
+                              std::function<bool(GuestOutputRefreshContext& context)> refresher,
+                              bool& is_8bpc_out_ref, GuestOutputHdr& hdr_out_ref) override;
+  PaintResult PaintAndPresentImpl(bool execute_ui_drawers) override;
+
+ private:
+  MetalPresenter(HostGpuLossCallback host_gpu_loss_callback, id<MTLDevice> device,
+                 id<MTLCommandQueue> command_queue)
+      : Presenter(host_gpu_loss_callback), device_(device), command_queue_(command_queue) {}
+  bool Initialize();
+  // metal_present_capture: the painted drawable to a PPM file once the GPU is done with it.
+  void CapturePaint(id<MTLCommandBuffer> command_buffer, id<MTLTexture> texture, float sdr_nits);
+  // HDR output: whether to paint HDR10 now (the hdr setting; auto: the display can show EDR), and switching the
+  // layer between BGRA8 sRGB and BGR10A2 PQ with EDR.
+  bool HdrWanted();
+  void ConfigureLayerHdr(CAMetalLayer* layer, bool hdr);
+  bool layer_hdr_ = false;
+  double edr_potential_ = 0.0;
+  std::chrono::steady_clock::time_point edr_checked_{};
+  float edr_metadata_peak_ = 0.0f, edr_metadata_white_ = 0.0f;
+  id<MTLRenderPipelineState> paint_hdr_pipeline_ = nil;
+  // What each guest output image holds (PQ or not), for captures.
+  std::array<GuestOutputHdr, kGuestOutputMailboxSize> guest_output_hdr_{};
+
+  id<MTLDevice> device_;
+  id<MTLCommandQueue> command_queue_;
+  std::chrono::steady_clock::time_point last_capture_{};
+  id<MTLRenderPipelineState> paint_pipeline_ = nil;
+  id<MTLSamplerState> paint_sampler_ = nil;
+  CAMetalLayer* layer_ = nil;
+  std::array<id<MTLTexture>, kGuestOutputMailboxSize> guest_output_textures_{};
+  // Frame generation: each guest output image's generated frame (shown before it), whether it has one, and which
+  // refresh it holds (so that a repaint shows neither twice nor counts as a new frame).
+  std::array<id<MTLTexture>, kGuestOutputMailboxSize> generated_textures_{};
+  std::array<bool, kGuestOutputMailboxSize> generated_{};
+  std::array<uint64_t, kGuestOutputMailboxSize> refresh_serial_{};
+  uint64_t next_refresh_serial_ = 0, painted_refresh_serial_ = 0;
+  // The paints' pacing: the time between the guest's refreshes (averaged; the refresher's thread measures it, from
+  // the game's own pacing, not from the paints, which wait for drawables).
+  std::chrono::steady_clock::time_point last_refresh_{};
+  std::atomic<double> refresh_interval_{0.0};
+  double display_hz_ = 0.0;
+  std::chrono::steady_clock::time_point display_hz_checked_{};
+  bool fg_logged_presenting_ = false;
+  uint32_t fg_presented_ = 0, fg_held_back_ = 0, fg_held_ui_ = 0, fg_held_late_ = 0, fg_held_rate_ = 0, fg_dropped_ = 0;
+  std::chrono::steady_clock::time_point fg_log_time_{};
+  // Where an image goes in the drawable (the paint flow's last size and offset), and the HDR paint's constants.
+  struct PaintPlacement {
+    bool draw = false;
+    MTLViewport viewport{};
+    struct { float sdr_nits; uint32_t is_pq, gamma22; } hdr{};
+  };
+  id<MTLCommandBuffer> EncodePaint(id<CAMetalDrawable> target, id<MTLTexture> image, const PaintPlacement& placement,
+                                   bool ui, const HdrOutputState& hdr_state);
+  // Frame generation's present thread: the UI thread copies a new frame and the generated one before it into a
+  // slot of fg_copies_ ([0] generated, [1] the new frame) and leaves them to the thread, which waits for drawables
+  // (two a frame, more than the layer's three let the UI thread have without waiting) and presents them half the
+  // time between frames apart. A job not started yet when the next comes is replaced (its frames are skipped).
+  struct FgJob {
+    CAMetalLayer* layer;
+    uint32_t slot;
+    PaintPlacement placement;
+    double half;
+  };
+  void FgPresentThread();
+  // Until the thread has presented what it was given (a paint of the UI thread's own comes after it).
+  void FgPresentWaitIdle();
+  void FgPresentStop();
+  std::thread fg_thread_;
+  std::mutex fg_mutex_;
+  std::condition_variable fg_cv_;
+  std::optional<FgJob> fg_job_;
+  uint32_t fg_busy_slot_ = UINT32_MAX;
+  bool fg_quit_ = false;
+  std::array<std::array<id<MTLTexture>, 2>, 3> fg_copies_{};
+};
+
+class MetalGraphicsSystem final : public GraphicsSystem {
+ public:
+  MetalGraphicsSystem() = default;
+  ~MetalGraphicsSystem() override = default;
+
+  std::string name() const override { return "Metal"; }
+  MetalProvider* metal_provider() const { return static_cast<MetalProvider*>(provider()); }
+
+ protected:
+  void CreateProvider(bool with_presentation) override;
+
+ private:
+  std::unique_ptr<CommandProcessor> CreateCommandProcessor() override;
+};
+
+class MetalCommandProcessor final : public CommandProcessor {
+ public:
+  MetalCommandProcessor(MetalGraphicsSystem* graphics_system, system::KernelState* kernel_state);
+  ~MetalCommandProcessor() override;
+
+  void IssueSwap(uint32_t frontbuffer_ptr, uint32_t frontbuffer_width,
+                 uint32_t frontbuffer_height) override;
+
+ protected:
+  bool SetupContext() override;
+  void ShutdownContext() override;
+
+  Shader* LoadShader(xenos::ShaderType shader_type, uint32_t guest_address,
+                     const uint32_t* host_address, uint32_t dword_count) override;
+  bool IssueDraw(xenos::PrimitiveType prim_type, uint32_t index_count,
+                 IndexBufferInfo* index_buffer_info, bool major_mode_explicit) override;
+  bool IssueCopy() override;
+  void WriteFenceValue(uint32_t address, uint32_t value) override;
+  // Register writes: blocks copied in bulk (as D3D12 and xenia-canary do), and the shader constant blocks
+  // written reported to the draw path, which then resends only those (metal_constant_generations).
+  void WriteRegister(uint32_t index, uint32_t value) override;
+  void WriteRegistersFromMem(uint32_t start_index, uint32_t* base, uint32_t num_registers) override;
+  // The Metal shader storage: the microcode and modifications of every shader translated before, warmed up
+  // (translated and compiled on worker threads) before the title starts.
+  void InitializeShaderStorage(const std::filesystem::path& cache_root, uint32_t title_id, bool blocking) override;
+  // Temporal anti-aliasing with MetalFX's temporal scaler (the SDK's temporal_aa: jitter, motion vectors from
+  // the game's motion blur constants), at native size.
+  bool TaaReady() const override;
+  // Upscaling (temporal_aa_upscale): the scene squeezed into the host render targets' corner and resolves that
+  // stretch it back (metal_taa_upscale).
+  bool TaaUpscaleSupported() const override;
+  bool HdrHostRenderTargets() const override { return true; }
+  uint32_t HdrEdramTileCount() const override { return graphics_system_->edram_tile_count(); }
+  bool HdrCopyFromColorTarget(uint32_t key, HdrTexture dest, const HdrRect& source, uint32_t dest_x,
+                              uint32_t dest_y) override;
+  bool HdrClearColorTarget(uint32_t key, const HdrRect& rect) override;
+  bool HdrRestoreColorTarget(uint32_t key, const HdrRect& rect) override;
+  bool HdrCopyTexture(HdrTexture source, HdrTexture dest, const HdrRect& source_rect, uint32_t dest_x,
+                      uint32_t dest_y) override;
+  bool HdrClearTexture(HdrTexture texture) override;
+  void HdrReleaseTextures() override;
+  bool TaaCheckAvailable() override;
+
+ private:
+  // Starts the translation and compile of the draw's shaders (M1: coverage of the shader path).
+  void RequestDrawShaders();
+  // The guest's physical memory as a Metal buffer without a copy (unified memory), and a check that the GPU
+  // reads what the CPU sees (metal_shared_memory_zero_copy).
+  void CreateZeroCopySharedMemory();
+  void CheckZeroCopySharedMemory();
+  void MaybeLogStats();
+
+  MetalGraphicsSystem* metal_graphics_system_;
+  std::unique_ptr<MetalShaderCompiler> shader_compiler_;
+  std::unique_ptr<MetalDraw> draw_;
+  id<MTLBuffer> shared_memory_buffer_ = nil;
+  bool shared_memory_checked_ = false;
+  // Where the loaded shaders' microcode is: ranges of guest memory that stay the same while the game runs
+  // (physical address, dwords), for the check.
+  std::vector<std::pair<uint32_t, uint32_t>> shader_ranges_;
+  id<MTLDevice> device_ = nil;
+  id<MTLCommandQueue> command_queue_ = nil;
+  // The guest's shaders, by the hash of their microcode (the base class keeps pointers to them).
+  std::unordered_map<uint64_t, std::unique_ptr<Shader>> shaders_;
+  std::FILE* shader_storage_ = nullptr;
+  std::unordered_set<uint64_t> stored_shaders_;
+  // The pipeline storage: each pipeline a draw built (its shaders' hashes and modifications, and the rest of
+  // MetalDraw's key), built ahead from the next start (metal_pipeline_storage).
+  void InitializePipelineStorage(const std::filesystem::path& dir, uint32_t title_id);
+  std::FILE* pipeline_storage_ = nullptr;
+  std::unordered_set<uint64_t> stored_pipelines_;
+
+  uint64_t swaps_ = 0;
+  // The time between swaps (seconds, averaged): the motion blur's scale (metal_motion_blur_fps).
+  std::chrono::steady_clock::time_point last_swap_time_{};
+  double frame_interval_ = 0.0;
+  uint64_t stats_draws_ = 0;
+  uint64_t stats_copies_ = 0;
+  uint64_t stats_swaps_ = 0;
+  uint64_t stats_since_ms_ = 0;
+};
+
+}  // namespace rex::graphics::metal
