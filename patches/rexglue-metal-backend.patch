+class MetalPrimitiveProcessor final : public PrimitiveProcessor {
+ public:
+  MetalPrimitiveProcessor(id<MTLDevice> device, const RegisterFile& regs, memory::Memory& memory, SharedMemory& shared)
+      : PrimitiveProcessor(regs, memory, shared), device_(device) {}
+  bool Initialize() { return InitializeCommon(true, false, false, false, false, false); }
+  void NextDraw() { ClearPerFrameCache(); buffers_.clear(); }
+  std::pair<id<MTLBuffer>, size_t> Buffer(const ProcessingResult& p) const {
+    if (p.index_buffer_type == kHostConverted) return buffers_.at(p.host_index_buffer_handle);
+    return {builtin_, GetBuiltinIndexBufferOffsetBytes(p.host_index_buffer_handle)};
+  }
+ private:
+  bool InitializeBuiltinIndexBuffer(size_t size, std::function<void(void*)> fill) override {
+    builtin_ = [device_ newBufferWithLength:size options:MTLResourceStorageModeShared];
+    if (!builtin_) return false;
+    fill(builtin_.contents); return true;
+  }
+  void* RequestHostConvertedIndexBufferForCurrentFrame(xenos::IndexFormat format, uint32_t count,
+      bool align, uint32_t original, size_t& handle) override {
+    size_t size = count * (format == xenos::IndexFormat::kInt16 ? 2 : 4) + XE_GPU_PRIMITIVE_PROCESSOR_SIMD_SIZE;
+    id<MTLBuffer> buffer = [device_ newBufferWithLength:size options:MTLResourceStorageModeShared];
+    if (!buffer) return nullptr;
+    size_t offset = align ? GetSimdCoalignmentOffset(buffer.contents, original) : 0;
+    handle = buffers_.size(); buffers_.emplace_back(buffer, offset);
+    return static_cast<uint8_t*>(buffer.contents) + offset;
+  }
+  id<MTLDevice> device_;
+  id<MTLBuffer> builtin_;
+  std::vector<std::pair<id<MTLBuffer>, size_t>> buffers_;
+};
