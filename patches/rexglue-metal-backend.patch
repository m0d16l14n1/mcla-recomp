+// Metal 4: skips a render state call that sets what the encoder has (the draws' state filter is per pass segment;
+// clears and transfers in a pass reset it).
+#define SAME4(bit, cond, assign) \
+  auto& st = rec_->state; \
+  if ((st.known & (1u << bit)) && (cond)) return; \
+  st.known |= 1u << bit; assign;
+void GpuEncoder::SetPipeline(id<MTLRenderPipelineState> pipeline) {
+  M4 {
+    SAME4(0, st.pipeline == (__bridge void*)pipeline, st.pipeline = (__bridge void*)pipeline)
+    [RENDER4 setRenderPipelineState:pipeline];
+    return;
+  }
+  [RENDER3 setRenderPipelineState:pipeline];
+}
