new file mode 100644
--- /dev/null
+++ b/src/graphics/metal/metal_shader_translator.h
@@ -0,0 +1,143 @@
+/**
+ * @file        graphics/metal/metal_shader_translator.h
+ * @brief       Guest microcode to MSL: the SDK's SPIR-V translator, then SPIRV-Cross (plain C++)
+ *
+ * Added by the mcla-recomp macOS fork (patches/rexglue-metal-backend.patch). The same translator as the Vulkan
+ * backend, and the same SPIR-V to MSL step MoltenVK performs (the SDK's SPIRV-Cross is MoltenVK's), so that what
+ * draws correctly through MoltenVK translates the same way here. Plain C++ behind this header: the translator's
+ * headers bring Vulkan's C++ bindings, which do not compile as Objective-C++.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <cstring>
+#include <array>
+#include <memory>
+#include <string>
+#include <vector>
+#include <rex/graphics/primitive_processor.h>
+#include <rex/graphics/util/draw.h>
+
+#include <rex/graphics/pipeline/shader/shader.h>
+#include <rex/graphics/registers.h>
+#include <rex/string/buffer.h>
+
+namespace rex::graphics {
+class RegisterFile;
+class SpirvShaderTranslator;
+}  // namespace rex::graphics
+
+namespace rex::graphics::metal {
+
+// The draw resolution scale (resolution_scale: 1, 2 or 3; 1 with metal_msaa), read once: the render targets, the
+// textures made from resolves and the translated shaders are made for it, so it changes at the next start only.
+uint32_t MetalResolutionScale();
+
+struct MetalTextureBinding {
+  uint32_t index, fetch_constant;
+  xenos::FetchOpDimension dimension;
+  bool is_signed;
+};
+struct MetalSamplerBinding {
+  uint32_t index, fetch_constant;
+  xenos::TextureFilter mag_filter, min_filter, mip_filter;
+  xenos::AnisoFilter aniso_filter;
+};
+struct MetalShaderBindings {
+  std::vector<MetalTextureBinding> textures;
+  std::vector<MetalSamplerBinding> samplers;
+};
+std::unique_ptr<Shader> CreateMetalShader(xenos::ShaderType type, uint64_t hash,
+                                        const uint32_t* code, uint32_t count);
+// Buffer slots 0..4 are system, VS float, PS float, bool/loop, fetch. Slot 5 is physical memory.
+// Into `out` (kept by the caller, so no allocation a draw). `texture_signs` (8 words), when given, are the
+// texture fetches' swizzled signs computed for the current fetch constants, else they are computed here.
+void BuildMetalSystemConstants(const RegisterFile& regs, const PrimitiveProcessor::ProcessingResult& primitive,
+    const draw_util::ViewportInfo& viewport, std::vector<uint8_t>& out, const uint32_t* texture_signs = nullptr,
+    float ps_param_gen_scale = 1.0f, uint32_t resolution_scale = 1, uint32_t textures_scaled = 0);
+void MetalTextureSwizzledSigns(const RegisterFile& regs, uint32_t* signs);
+// The SDK's own compute shaders (the Vulkan backend's SPIR-V, such as the HDR output's refresher and scene pass)
+// as MSL, through the same SPIRV-Cross: each (descriptor set, binding) to a texture index, push constants to
+// buffer 0, texel buffers as Metal texture buffers. Empty, with error_out set, if SPIRV-Cross refuses it.
+struct MetalSpirvTextureSlot { uint32_t set, binding, texture; };
+std::string MetalSpirvComputeToMsl(const uint32_t* words, size_t word_count,
+                                   const std::vector<MetalSpirvTextureSlot>& slots, std::string& error_out);
+
+// Ray tracing's capture variant of a translated vertex shader (its MSL): a compute kernel, `xe_rt_capture`, that
+// runs the shader for one vertex index a thread and writes the clip position the guest shader left (before the
+// host's NDC transform) times a matrix, divided by its w: buffer 6 is a MetalRtCaptureArgs (the kernel writes its
+// bounds), buffer 7 float4s out (w 1). The other bindings are the vertex shader's own, at the same indices.
+constexpr uint32_t kMetalRtCaptureArgs = 6, kMetalRtCaptureOut = 7;
+// The capture's bounds: a uint that orders as the floats do, and back.
+inline float MetalRtUnordered(uint32_t u) {
+  u = (u & 0x80000000u) ? (u & 0x7FFFFFFFu) : ~u;
+  float f;
+  std::memcpy(&f, &u, sizeof(f));
+  return f;
+}
+struct MetalRtCaptureArgs {
+  // Clip to the mesh's space, for row vectors (p' = p M): M column by column. With xyw, M takes (x, y, w, 1) (a
+  // perspective's clip x, y and w, its depth left out: z and w nearly cancel far away, in floats).
+  float to_space[16];
+  // The valid positions' bounds, min xyz then max xyz: floats as uints that order as the floats do
+  // (MetalRtUnordered's way back), set to 0xFFFFFFFF and 0 before.
+  uint32_t bounds[6];
+  uint32_t xyw;
+  uint32_t pad;
+  uint32_t ids[1];     // the vertex indices, one a thread (as many as the dispatch's threads)
+};
+// Empty, with error_out set, if the MSL isn't of the translator's shape.
+std::string MetalRtCaptureMsl(const std::string& vertex_msl, std::string& error_out);
+
+class MetalShaderTranslator {
+ public:
+  explicit MetalShaderTranslator(uint32_t edram_tile_count);
+  ~MetalShaderTranslator();
+
+  // The microcode analysis that the modifications depend on.
+  void EnsureAnalyzed(Shader& shader);
+
+  // The modifications of the current draw, as the Vulkan backend chooses them (interpolators both stages use,
+  // the pixel shader's parameter generation). The shaders must be analyzed. pixel_shader may be null.
+  void GetDrawModifications(const RegisterFile& regs, const Shader& vertex_shader, const Shader* pixel_shader,
+                            uint64_t& vertex_modification_out, uint64_t& pixel_modification_out,
+                            Shader::HostVertexShaderType host_type = Shader::HostVertexShaderType::kVertex) const;
+
+  enum class Result {
+    kExisting,         // translated before (the translation is returned)
+    kNew,              // translated now: msl_out holds the MSL
+    kTranslateFailed,  // the SPIR-V translator failed
+    kMslFailed,        // SPIRV-Cross refused the SPIR-V: error_out says why
+  };
+  Result Translate(Shader& shader, uint64_t modification, Shader::Translation*& translation_out,
+                   std::string& msl_out, std::string& error_out);
+  // The MSL of a translation made before (SPIRV-Cross again; the SPIR-V is the translation's). Any thread: it
+  // touches no translator state.
+  static bool ToMsl(const Shader& shader, const Shader::Translation& translation, MetalShaderBindings* info,
+                    std::string& msl_out, std::string& error_out);
+  // Asked four or five times a draw (the hash map's lookup was 1.4% of the command thread): the last few
+  // answers are kept (the map's elements don't move, and none is removed). The command thread's only.
+  const MetalShaderBindings& bindings(const Shader::Translation* t) const {
+    auto& slot = bindings_memo_[(reinterpret_cast<uintptr_t>(t) >> 4) & 7];
+    if (slot.first != t) slot = {t, &bindings_.at(t)};
+    return *slot.second;
+  }
+  // Takes the bindings of another translator's translations (the warm-up's workers, once they are done).
+  void AdoptBindings(MetalShaderTranslator& other) {
+    for (auto& entry : other.bindings_) bindings_[entry.first] = std::move(entry.second);
+    other.bindings_.clear();
+    other.bindings_memo_ = {};
+  }
+
+ private:
+  std::unordered_map<const Shader::Translation*, MetalShaderBindings> bindings_;
+  mutable std::array<std::pair<const Shader::Translation*, const MetalShaderBindings*>, 8> bindings_memo_{};
+  std::unique_ptr<SpirvShaderTranslator> translator_;
+  string::StringBuffer ucode_disasm_buffer_;
+};
+
+}  // namespace rex::graphics::metal
diff --git a/src/graphics/metal/metal_shaders.h b/src/graphics/metal/metal_shaders.h
new file mode 100644
--- /dev/null
+++ b/src/graphics/metal/metal_shaders.h
@@ -0,0 +1,92 @@
+/**
+ * @file        graphics/metal/metal_shaders.h
+ * @brief       Guest shaders to Metal libraries: MetalShaderTranslator's MSL through Metal's compiler
+ *
+ * Added by the mcla-recomp macOS fork (patches/rexglue-metal-backend.patch). Objective-C++ only.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#if !defined(__OBJC__)
+#error "metal_shaders.h is for the Objective-C++ sources of the Metal backend"
+#endif
+
+#import <Metal/Metal.h>
+
+#include <atomic>
+#include <cstdint>
+#include <mutex>
+#include <condition_variable>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include <chrono>
+#include <functional>
+#include <vector>
+
+#include "metal_shader_translator.h"
+
+namespace rex::graphics::metal {
+
+class MetalShaderCompiler {
+ public:
+  struct Stats {
+    std::atomic<uint32_t> translated{0};        // guest microcode to SPIR-V to MSL
+    std::atomic<uint32_t> translate_failed{0};  // the SPIR-V translator failed
+    std::atomic<uint32_t> msl_failed{0};        // SPIRV-Cross refused the SPIR-V
+    std::atomic<uint32_t> compiled{0};          // Metal compiled the MSL
+    std::atomic<uint32_t> compile_failed{0};
+    std::atomic<uint32_t> pending{0};           // Metal compiles not finished yet
+    std::atomic<uint64_t> translate_us{0};      // microcode to MSL, summed
+    std::atomic<uint64_t> compile_us{0};        // Metal compile time, summed (on Metal's threads)
+  };
+
+  MetalShaderCompiler(id<MTLDevice> device, uint32_t edram_tile_count);
+  ~MetalShaderCompiler();
+  void Wait();
+
+  MetalShaderTranslator& translator() { return translator_; }
+
+  // Translates this modification of the shader once and starts its Metal compile. Command processor thread.
+  void Request(Shader& shader, uint64_t modification);
+  // Translates and compiles these shaders' modifications on worker threads (a shader's all on one), and
+  // returns once all are translated (Metal's compiles may still run). Only while no draws are issued.
+  void Warm(const std::vector<std::pair<Shader*, std::vector<uint64_t>>>& jobs);
+  // Called by Request for each new translation (the shader storage records it).
+  std::function<void(const Shader&, uint64_t)> on_new_translation;
+
+  // The compiled library of a translation, nil while compiling or after a failure. Any thread.
+  id<MTLLibrary> GetLibrary(const Shader::Translation* translation) const;
+  // Waits at most until the deadline for a translation's library; nil with compiling set while Metal still compiles
+  // it, nil without it after a failure (or when it was never compiled).
+  id<MTLLibrary> WaitForLibrary(const Shader::Translation* translation,
+                                std::chrono::steady_clock::time_point deadline, bool& compiling);
+
+  // Ray tracing: the capture kernel of a vertex shader's translation (see MetalRtCaptureMsl), made on other threads
+  // at the first ask; nil until it is ready, and for good if it can't be made. The command thread's.
+  id<MTLComputePipelineState> CapturePipeline(const Shader& shader, const Shader::Translation* translation);
+
+  const Stats& stats() const { return stats_; }
+
+ private:
+  void Dump(const Shader& shader, uint64_t modification, const std::string& msl, const char* error) const;
+  void Compile(const Shader& shader, uint64_t modification, Shader::Translation* translation, const std::string& msl);
+  uint32_t edram_tile_count_;
+
+  id<MTLDevice> device_;
+  MetalShaderTranslator translator_;
+  MTLCompileOptions* compile_options_;
+  Stats stats_;
+
+  mutable std::mutex libraries_mutex_;
+  std::condition_variable libraries_ready_;
+  std::unordered_map<const Shader::Translation*, id<MTLLibrary>> libraries_;
+  std::unordered_set<const Shader::Translation*> compiling_;
+  // Capture kernels: present once asked for (nil until made, or after a failure). Under libraries_mutex_.
+  std::unordered_map<const Shader::Translation*, id<MTLComputePipelineState>> captures_;
+};
+
+}  // namespace rex::graphics::metal
diff --git a/src/graphics/metal/metal_shaders.mm b/src/graphics/metal/metal_shaders.mm
new file mode 100644
--- /dev/null
+++ b/src/graphics/metal/metal_shaders.mm
@@ -0,0 +1,235 @@
+/**
+ * @file        graphics/metal/metal_shaders.mm
+ * @brief       Guest shaders to Metal (see metal_shaders.h)
+ *
+ * Added by the mcla-recomp macOS fork (patches/rexglue-metal-backend.patch).
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include "metal_shaders.h"
+
+#include <chrono>
+#include <thread>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <vector>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+REXCVAR_DEFINE_STRING(metal_shader_dump_dir, "", "GPU/Metal",
+                      "Development: a folder to write the MSL of the guest shaders Metal could not compile "
+                      "(with the compiler's message), or of all of them with metal_shader_dump_all");
+REXCVAR_DEFINE_INT32(metal_shader_math, 0, "GPU/Metal",
+                     "Guest shader float math: 0 safe (as the guest), 1 relaxed (reassociation; NaN and infinity kept), "
+                     "2 fast (also no NaN or infinity, fast library functions)")
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+REXCVAR_DEFINE_BOOL(metal_shader_dump_all, false, "GPU/Metal",
+                    "Development: with metal_shader_dump_dir, write the MSL of every guest shader");
+
+namespace rex::graphics::metal {
+
+namespace {
+
+uint64_t MicrosecondsSince(std::chrono::steady_clock::time_point start) {
+  return uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
+                      std::chrono::steady_clock::now() - start)
+                      .count());
+}
+
+}  // namespace
+
+MetalShaderCompiler::MetalShaderCompiler(id<MTLDevice> device, uint32_t edram_tile_count)
+    : device_(device), translator_(edram_tile_count), edram_tile_count_(edram_tile_count) {
+  compile_options_ = [[MTLCompileOptions alloc] init];
+  compile_options_.languageVersion = MTLLanguageVersion3_0;
+  // The guest's float behaviour (no reassociation, NaN and infinity kept) over speed, unless
+  // metal_shader_math asks for relaxed (reassociation, NaN and infinity kept) or fast math.
+  if (@available(macOS 15.0, *)) {
+    int32_t math = REXCVAR_GET(metal_shader_math);
+    compile_options_.mathMode = math >= 2 ? MTLMathModeFast : math == 1 ? MTLMathModeRelaxed : MTLMathModeSafe;
+    if (math >= 2) compile_options_.mathFloatingPointFunctions = MTLMathFloatingPointFunctionsFast;
+  } else {
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+    compile_options_.fastMathEnabled = NO;
+#pragma clang diagnostic pop
+  }
+}
+
+MetalShaderCompiler::~MetalShaderCompiler() { Wait(); }
+void MetalShaderCompiler::Wait() {
+  std::unique_lock<std::mutex> lock(libraries_mutex_);
+  libraries_ready_.wait(lock, [this] { return stats_.pending.load() == 0; });
+}
+
+void MetalShaderCompiler::Request(Shader& shader, uint64_t modification) {
+  Shader::Translation* translation = nullptr;
+  std::string msl, error;
+  const auto translate_start = std::chrono::steady_clock::now();
+  const MetalShaderTranslator::Result result =
+      translator_.Translate(shader, modification, translation, msl, error);
+  switch (result) {
+    case MetalShaderTranslator::Result::kExisting:
+      return;
+    case MetalShaderTranslator::Result::kTranslateFailed:
+      ++stats_.translate_failed;
+      REXGPU_WARN("Metal: shader {:016X} (modification {:016X}) did not translate to SPIR-V",
+                  shader.ucode_data_hash(), modification);
+      return;
+    case MetalShaderTranslator::Result::kMslFailed:
+      ++stats_.msl_failed;
+      REXGPU_WARN("Metal: SPIRV-Cross refused shader {:016X} (modification {:016X}): {}", shader.ucode_data_hash(),
+                  modification, error);
+      return;
+    case MetalShaderTranslator::Result::kNew:
+      break;
+  }
+  ++stats_.translated;
+  stats_.translate_us += MicrosecondsSince(translate_start);
+  if (REXCVAR_GET(metal_shader_dump_all)) {
+    Dump(shader, modification, msl, nullptr);
+  }
+
+  if (on_new_translation) on_new_translation(shader, modification);
+  Compile(shader, modification, translation, msl);
+}
+
+void MetalShaderCompiler::Compile(const Shader& shader, uint64_t modification, Shader::Translation* translation,
+                                  const std::string& msl) {
+  ++stats_.pending;
+  const auto compile_start = std::chrono::steady_clock::now();
+  const uint64_t hash = shader.ucode_data_hash();
+  const Shader* shader_ptr = &shader;
+  // The handler runs on a Metal thread; it copies what it needs (the MSL for a dump, the translation pointer as
+  // the key: translations live as long as their shader, which the command processor keeps).
+  std::string msl_copy = msl;
+  { std::lock_guard<std::mutex> lock(libraries_mutex_); compiling_.insert(translation); }
+  [device_ newLibraryWithSource:[NSString stringWithUTF8String:msl.c_str()]
+                        options:compile_options_
+              completionHandler:^(id<MTLLibrary> library, NSError* error) {
+                stats_.compile_us += MicrosecondsSince(compile_start);
+
+                if (!library) {
+                  ++stats_.compile_failed;
+                  const char* message = error ? [error.localizedDescription UTF8String] : "?";
+                  REXGPU_WARN("Metal: shader {:016X} (modification {:016X}) did not compile: {}", hash,
+                              modification, std::string(message).substr(0, 300));
+                  Dump(*shader_ptr, modification, msl_copy, message);
+                  { std::lock_guard<std::mutex> lock(libraries_mutex_);
+                    compiling_.erase(translation); --stats_.pending; libraries_ready_.notify_all(); }
+                  return;
+                }
+                ++stats_.compiled;
+                { std::lock_guard<std::mutex> lock(libraries_mutex_);
+                  libraries_[translation] = library; compiling_.erase(translation); --stats_.pending;
+                  libraries_ready_.notify_all(); }
+              }];
+}
+
+void MetalShaderCompiler::Warm(const std::vector<std::pair<Shader*, std::vector<uint64_t>>>& jobs) {
+  if (jobs.empty()) return;
+  const auto start = std::chrono::steady_clock::now();
+  uint32_t threads = std::max(1u, std::min<uint32_t>(uint32_t(jobs.size()), std::thread::hardware_concurrency() - 1));
+  std::vector<std::unique_ptr<MetalShaderTranslator>> translators;
+  for (uint32_t i = 0; i < threads; ++i) translators.push_back(std::make_unique<MetalShaderTranslator>(edram_tile_count_));
+  std::atomic<size_t> next{0};
+  std::atomic<uint32_t> translated{0};
+  std::vector<std::thread> workers;
+  for (uint32_t i = 0; i < threads; ++i) {
+    workers.emplace_back([&, i] {
+      MetalShaderTranslator& translator = *translators[i];
+      for (size_t job; (job = next.fetch_add(1)) < jobs.size();) {
+        Shader& shader = *jobs[job].first;
+        for (uint64_t modification : jobs[job].second) {
+          Shader::Translation* translation = nullptr;
+          std::string msl, error;
+          if (translator.Translate(shader, modification, translation, msl, error) != MetalShaderTranslator::Result::kNew)
+            continue;
+          ++translated; ++stats_.translated;
+          if (REXCVAR_GET(metal_shader_dump_all)) Dump(shader, modification, msl, nullptr);
+          Compile(shader, modification, translation, msl);
+        }
+      }
+    });
+  }
+  for (auto& worker : workers) worker.join();
+  for (auto& translator : translators) translator_.AdoptBindings(*translator);
+  REXGPU_INFO("Metal shader warm-up: {} translations of {} shaders on {} threads in {} ms (Metal compiles go on)",
+              translated.load(), jobs.size(), threads, MicrosecondsSince(start) / 1000);
+}
+
+id<MTLLibrary> MetalShaderCompiler::GetLibrary(const Shader::Translation* translation) const {
+  std::lock_guard<std::mutex> lock(libraries_mutex_);
+  auto it = libraries_.find(translation);
+  return it != libraries_.end() ? it->second : nil;
+}
+
+id<MTLLibrary> MetalShaderCompiler::WaitForLibrary(const Shader::Translation* translation,
+                                                   std::chrono::steady_clock::time_point deadline, bool& compiling) {
+  std::unique_lock<std::mutex> lock(libraries_mutex_);
+  libraries_ready_.wait_until(lock, deadline, [&] { return !compiling_.count(translation); });
+  compiling = compiling_.count(translation) != 0;
+  auto it = libraries_.find(translation);
+  return it != libraries_.end() ? it->second : nil;
+}
+
+id<MTLComputePipelineState> MetalShaderCompiler::CapturePipeline(const Shader& shader,
+                                                                 const Shader::Translation* translation) {
+  {
+    std::lock_guard<std::mutex> lock(libraries_mutex_);
+    auto it = captures_.find(translation);
+    if (it != captures_.end()) return it->second;
+    captures_[translation] = nil;
+  }
+  // SPIRV-Cross here (the shader's binding lists are the command thread's), Metal's compile on another thread.
+  std::string msl, error;
+  if (MetalShaderTranslator::ToMsl(shader, *translation, nullptr, msl, error)) msl = MetalRtCaptureMsl(msl, error);
+  else msl.clear();
+  if (msl.empty()) {
+    REXGPU_WARN("Metal: no ray tracing capture for vertex shader {:016X}: {}", shader.ucode_data_hash(), error);
+    return nil;
+  }
+  ++stats_.pending;  // the destructor waits for it
+  auto done = [this, translation](id<MTLComputePipelineState> pipeline, const std::string& error) {
+    if (!pipeline)
+      REXGPU_WARN("Metal: no ray tracing capture for vertex shader translation {}: {}", (const void*)translation,
+                  error.substr(0, 300));
+    std::lock_guard<std::mutex> lock(libraries_mutex_);
+    captures_[translation] = pipeline;
+    --stats_.pending;
+    libraries_ready_.notify_all();
+  };
+  NSString* source = [NSString stringWithUTF8String:msl.c_str()];
+  dispatch_async(dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+    NSError* ns_error = nil;
+    id<MTLLibrary> library = [device_ newLibraryWithSource:source options:compile_options_ error:&ns_error];
+    id<MTLFunction> function = [library newFunctionWithName:@"xe_rt_capture"];
+    id<MTLComputePipelineState> pipeline =
+        function ? [device_ newComputePipelineStateWithFunction:function error:&ns_error] : nil;
+    done(pipeline, pipeline ? std::string() : ns_error ? [ns_error.localizedDescription UTF8String] : "no kernel");
+  });
+  return nil;
+}
+
+void MetalShaderCompiler::Dump(const Shader& shader, uint64_t modification, const std::string& msl,
+                               const char* error) const {
+  const std::string dir = REXCVAR_GET(metal_shader_dump_dir);
+  if (dir.empty()) {
+    return;
+  }
+  std::error_code ec;
+  std::filesystem::create_directories(dir, ec);
+  const std::string stem = fmt::format("{}/{}_{:016X}_{:016X}", dir,
+                                       shader.type() == xenos::ShaderType::kVertex ? "vs" : "ps",
+                                       shader.ucode_data_hash(), modification);
+  std::ofstream(stem + ".metal") << msl;
+  if (error) {
+    std::ofstream(stem + ".error.txt") << error;
+  }
+}
+
+}  // namespace rex::graphics::metal
