+  }
+}
+
+id<MTL4CommandBuffer> GpuCommands::metal4() const {
+  if (!rec_) return nil;
+  GpuRecording& r = *rec_;
+  r.EndCompute();
+  if (REXCVAR_GET(metal_metal4_narrow_barriers)) {
+    // MetalFX's encoders don't wait for anything of ours: an encoder between that waits for all before it and that
+    // all after it waits for (a copy of four bytes, so it has work of its stage to order).
+    id<MTL4ComputeCommandEncoder> fence = [r.cb computeCommandEncoder];
+    [fence barrierAfterQueueStages:kAllStages beforeStages:MTLStageBlit visibilityOptions:MTL4VisibilityOptionDevice];
+    [fence fillBuffer:r.queue->scratch_ range:NSMakeRange(0, 4) value:0];
+    [fence barrierAfterStages:MTLStageBlit beforeQueueStages:kAllStages visibilityOptions:MTL4VisibilityOptionDevice];
+    [fence endEncoding];
+    // And after it, whatever stages its encoders used: the next encoder of ours waits for all of them.
+    r.after_external = true;
+  }
+  return r.cb;
+}
