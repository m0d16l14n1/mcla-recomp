+/** Native Metal draw path: the command stream, on Metal 3 or Metal 4. BSD-3-Clause, see LICENSE. */
+#include "metal_gpu.h"
+
+#include "metal_fx4.h"
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+#include <algorithm>
+#include <cstring>
+
+REXCVAR_DEFINE_BOOL(metal_metal4_draws, true, "GPU/Metal",
+                    "Metal 4 for the draws (macOS 26, with metal_metal4, the switch between Metal 4 and Metal 3): the "
+                    "passes, resolves, texture loads, EDRAM transfers, temporal AA and the front buffer's copy are "
+                    "recorded on a Metal 4 queue (argument tables, residency sets, explicit barriers, Metal 4's MetalFX "
+                    "in the same command buffers); false: the draws on Metal 3 with MetalFX on Metal 4 (for "
+                    "comparing)")
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+REXCVAR_DEFINE_BOOL(metal_metal4_submit_thread, true, "GPU/Metal",
+                    "Metal 4 draws: command buffers committed on a thread of their own (a commit with MetalFX runs "
+                    "its ML setup on the committing thread); false: on the GPU command thread")
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+REXCVAR_DEFINE_BOOL(metal_metal4_narrow_barriers, true, "GPU/Metal",
+                    "Metal 4 draws: each pass waits only for what it can depend on (its vertex and fragment stages for "
+                    "earlier compute and copies, its fragment stage for earlier passes' fragments: a pass's vertex work "
+                    "overlaps the last pass's fragments); false: every encoder waits for all before it and holds all "
+                    "after it");
+
+namespace rex::graphics::metal {
+
+bool MetalUseMetal4Draws(id<MTLDevice> device) {
+  if (@available(macOS 26.0, *)) {
+    return REXCVAR_GET(metal_metal4_draws) && MetalUseMetal4() && device && [device supportsFamily:MTLGPUFamilyMetal4];
+  }
+  return false;
+}
+
+// A resource the Metal 4 queue keeps resident and alive: until no recording or running commands use it and
+// (unless kept for the queue's life) nothing else holds it.
+struct GpuResident {
+  id object = nil;
+  uint64_t serial = 0;  // the last commit that used it
+  uint64_t stamp = 0;   // the last recording that used it
+  uint64_t frame = 0;   // the last frame it was used in
+  uint32_t open = 0;    // recordings using it, not committed yet
+  bool permanent = false;
+  bool in_set = true;   // in the residency set (not: placed in a heap that is, or a view of a texture)
+  id parent = nil;      // a view's texture, a texture's buffer: used (resident, kept) with it
+};
+
+namespace {
+// References a tracked resource has from the queue: its entry, and the residency set (which retains what it holds).
+constexpr long kOwnReferences = 2;
+// Frames a resource stays resident unused.
+constexpr uint64_t kIdleFrames = 60;
+// Argument table sizes: the Xenos shaders bind buffers 0 to 5, up to 32 textures and 16 samplers a stage; the
+// helper shaders fewer.
+constexpr NSUInteger kTableBuffers = 16, kTableTextures = 32, kTableSamplers = 16;
+// Each stage's table as large as its shaders need (Metal snapshots a table at every draw): the translated
+// shaders' highest slots over 641 of the game's shaders were vertex 5/1/0 and fragment 5/25/13 (buffers, textures,
+// samplers); the helpers' compute shaders 2/7/none. Indexed by GpuStage; a binding past them is dropped (logged).
+constexpr NSUInteger kStageBuffers[3] = {8, 8, 8}, kStageTextures[3] = {32, 8, 16}, kStageSamplers[3] = {16, 4, 4};
+bool OutOfTable(uint32_t stage, const char* what, uint32_t index, NSUInteger size) {
+  if (index < size) return false;
+  static std::atomic<int> logged{0};
+  if (logged.fetch_add(1) < 8)
+    REXGPU_ERROR("Metal 4 draws: {} slot {} past the {} stage's argument table ({}): dropped", what, index,
+                 stage == 0 ? "fragment" : stage == 1 ? "vertex" : "compute", size);
+  return true;
+}
+constexpr size_t kChunkSize = size_t(4) << 20;
+constexpr MTLStages kRenderStages = MTLStageVertex | MTLStageFragment;
+// The shared compute encoder's ops: dispatches, copies and acceleration structure builds (ray tracing).
+constexpr MTLStages kComputeStages = MTLStageDispatch | MTLStageBlit | MTLStageAccelerationStructure;
+constexpr MTLStages kAllStages = MTLStageVertex | MTLStageFragment | kComputeStages;
+}  // namespace
+
+// A Metal 4 command buffer being recorded, with what it uses.
+struct API_AVAILABLE(macos(26.0)) GpuRecording {
+  GpuQueue* queue = nullptr;
+  id<MTL4CommandBuffer> cb = nil;
+  id<MTL4CommandAllocator> allocator = nil;
+  id<MTL4ComputeCommandEncoder> compute = nil;  // open: the compute and blit work since the last render pass
+  bool compute_ops = false;                     // an op is in it: the next one waits for it
+  uint8_t concurrent = 0;                       // GpuEncoder::BeginConcurrent: 1 its first op to come, 2 after it
+  // Argument tables: fragment, vertex, compute. Each command buffer has its own: two may be recorded at once (the
+  // one before a pass takes texture work while the pass is open), and a render encoder's bindings stay as Bind
+  // left them until the next encoder.
+  std::array<id<MTL4ArgumentTable>, 3> tables{};
+  std::array<std::array<uint64_t, kTableBuffers>, 3> base{};  // each slot's buffer, for SetBufferOffset
+  // What each table slot holds, as last written in this command buffer: a binding the slot already holds is
+  // skipped (the table and the residency bookkeeping alike). Reset to kUnknown when recording starts, since the
+  // pooled tables still hold the last command buffer's bindings.
+  static inline void* const kUnknown = reinterpret_cast<void*>(uintptr_t(1));
+  std::array<std::array<uint64_t, kTableBuffers>, 3> address{};
+  std::array<std::array<void*, kTableTextures>, 3> textures{};
+  std::array<std::array<void*, kTableSamplers>, 3> samplers{};
+  void ResetBindings() {
+    for (auto& a : address) a.fill(1);
+    for (auto& b : base) b.fill(0);
+    for (auto& t : textures) t.fill(kUnknown);
+    for (auto& t : samplers) t.fill(kUnknown);
+  }
+  uint64_t stamp = 0;
+  uint32_t renders = 0;  // render encoders so far
+  bool after_external = false;  // MetalFX encoded since the last encoder of ours: the next one waits for all of it
+  // The open render encoder's state as last set (Metal 4 encoders start with Metal's defaults; a call setting what
+  // is already set is skipped), and the compute encoder's pipeline.
+  struct RenderState {
+    uint32_t known = 0;  // bits: which of the below are set
+    void* pipeline = nullptr;
+    void* depth_stencil = nullptr;
+    uint32_t stencil_front = 0, stencil_back = 0;
+    MTLDepthClipMode clip = MTLDepthClipModeClip;
+    MTLViewport viewport{};
+    MTLScissorRect scissor{};
+    MTLWinding winding = MTLWindingClockwise;
+    MTLCullMode cull = MTLCullModeNone;
+    std::array<float, 4> blend{};
+    void* index_buffer = nullptr;
+    uint64_t index_address = 0, index_length = 0;
+  } state;
+  void* compute_pipeline = nullptr;
+  std::vector<GpuResident*> used;
+  std::vector<GpuDoneBlock> done;
+  NSString* label = nil;
+
+  void EndCompute() {
+    if (!compute) return;
+    // Coarse barriers: what comes after waits for all of this. Narrow ones: every encoder of the draws waits for
+    // what it depends on itself (MetalFX's encoders after a fence encoder, GpuCommands::metal4).
+    if (!REXCVAR_GET(metal_metal4_narrow_barriers))
+      [compute barrierAfterStages:kComputeStages beforeQueueStages:kAllStages visibilityOptions:MTL4VisibilityOptionDevice];
+    [compute endEncoding];
+    compute = nil;
+    compute_ops = false;
+    concurrent = 0;
+  }
+};
+
+// ---------------------------------------------------------------------------------------------------------------
+// GpuEncoder
+
+#define M4 if (@available(macOS 26.0, *)) if (rec_)
+#define RENDER4 ((id<MTL4RenderCommandEncoder>)enc_)
+#define COMPUTE4 ((id<MTL4ComputeCommandEncoder>)enc_)
+#define RENDER3 ((id<MTLRenderCommandEncoder>)enc_)
+#define COMPUTE3 ((id<MTLComputeCommandEncoder>)enc_)
+#define BLIT3 ((id<MTLBlitCommandEncoder>)enc_)
+
+void GpuEncoder::Op() {
+  if (@available(macOS 26.0, *)) {
+    // In a concurrent group only its first op waits (for what came before the group).
+    if (rec_->compute_ops && rec_->concurrent != 2)
+      [COMPUTE4 barrierAfterEncoderStages:kComputeStages beforeEncoderStages:kComputeStages
+                        visibilityOptions:MTL4VisibilityOptionDevice];
+    if (rec_->concurrent == 1) rec_->concurrent = 2;
+    rec_->compute_ops = true;
+  }
+}
+
+void GpuEncoder::BeginConcurrent() {
+  M4 rec_->concurrent = 1;
+}
+void GpuEncoder::EndConcurrent() {
+  M4 rec_->concurrent = 0;
+}
+
+void GpuEncoder::SetLabel(NSString* label) {
+  M4 { if (kind_ == Kind::kRender) RENDER4.label = label; return; }  // the shared compute encoder keeps its own
+  [(id<MTLCommandEncoder>)enc_ setLabel:label];
+}
+
+void GpuEncoder::End() {
+  if (!enc_) return;
+  M4 {
+    if (kind_ == Kind::kRender) {
+      if (!REXCVAR_GET(metal_metal4_narrow_barriers))
+        [RENDER4 barrierAfterStages:MTLStageFragment | MTLStageVertex beforeQueueStages:kAllStages
+                  visibilityOptions:MTL4VisibilityOptionDevice];
+      [RENDER4 endEncoding];
+    }
+    // The compute encoder stays open for the next compute or blit work (ended by a render pass or the commit).
+    enc_ = nil;
+    return;
+  }
+  [(id<MTLCommandEncoder>)enc_ endEncoding];
+  enc_ = nil;
+}
+
+
+// Metal 4: skips a render state call that sets what the encoder has (the draws' state filter is per pass segment;
+// clears and transfers in a pass reset it).
+#define SAME4(bit, cond, assign) \
+  auto& st = rec_->state; \
+  if ((st.known & (1u << bit)) && (cond)) return; \
+  st.known |= 1u << bit; assign;
+void GpuEncoder::SetPipeline(id<MTLRenderPipelineState> pipeline) {
+  M4 {
+    SAME4(0, st.pipeline == (__bridge void*)pipeline, st.pipeline = (__bridge void*)pipeline)
+    [RENDER4 setRenderPipelineState:pipeline];
+    return;
+  }
+  [RENDER3 setRenderPipelineState:pipeline];
+}
+void GpuEncoder::SetDepthStencil(id<MTLDepthStencilState> state) {
+  M4 {
+    SAME4(1, st.depth_stencil == (__bridge void*)state, st.depth_stencil = (__bridge void*)state)
+    [RENDER4 setDepthStencilState:state];
+    return;
+  }
+  [RENDER3 setDepthStencilState:state];
+}
+void GpuEncoder::SetStencilRef(uint32_t front, uint32_t back) {
+  M4 {
+    SAME4(2, st.stencil_front == front && st.stencil_back == back, (st.stencil_front = front, st.stencil_back = back))
+    [RENDER4 setStencilFrontReferenceValue:front backReferenceValue:back];
+    return;
+  }
+  [RENDER3 setStencilFrontReferenceValue:front backReferenceValue:back];
+}
+void GpuEncoder::SetDepthClip(MTLDepthClipMode mode) {
+  M4 {
+    SAME4(3, st.clip == mode, st.clip = mode)
+    [RENDER4 setDepthClipMode:mode];
+    return;
+  }
+  [RENDER3 setDepthClipMode:mode];
+}
+void GpuEncoder::SetViewport(const MTLViewport& viewport) {
+  M4 {
+    SAME4(4, !std::memcmp(&st.viewport, &viewport, sizeof(viewport)), st.viewport = viewport)
+    [RENDER4 setViewport:viewport];
+    return;
+  }
+  [RENDER3 setViewport:viewport];
+}
+void GpuEncoder::SetScissor(const MTLScissorRect& rect) {
+  M4 {
+    SAME4(5, !std::memcmp(&st.scissor, &rect, sizeof(rect)), st.scissor = rect)
+    [RENDER4 setScissorRect:rect];
+    return;
+  }
+  [RENDER3 setScissorRect:rect];
+}
+void GpuEncoder::SetWinding(MTLWinding winding) {
+  M4 {
+    SAME4(6, st.winding == winding, st.winding = winding)
+    [RENDER4 setFrontFacingWinding:winding];
+    return;
+  }
+  [RENDER3 setFrontFacingWinding:winding];
+}
+void GpuEncoder::SetCull(MTLCullMode mode) {
+  M4 {
+    SAME4(7, st.cull == mode, st.cull = mode)
+    [RENDER4 setCullMode:mode];
+    return;
+  }
+  [RENDER3 setCullMode:mode];
+}
+void GpuEncoder::SetBlendColor(float r, float g, float b, float a) {
+  M4 {
+    const std::array<float, 4> c{r, g, b, a};
+    SAME4(8, !std::memcmp(st.blend.data(), c.data(), sizeof(c)), st.blend = c)
+    [RENDER4 setBlendColorRed:r green:g blue:b alpha:a];
+    return;
+  }
+  [RENDER3 setBlendColorRed:r green:g blue:b alpha:a];
+}
+void GpuEncoder::SetVisibility(MTLVisibilityResultMode mode, NSUInteger offset) {
+  M4 { [RENDER4 setVisibilityResultMode:mode offset:offset]; return; }
+  [RENDER3 setVisibilityResultMode:mode offset:offset];
+}
+void GpuEncoder::Draw(MTLPrimitiveType type, uint32_t start, uint32_t count) {
+  M4 { [RENDER4 drawPrimitives:type vertexStart:start vertexCount:count]; return; }
+  [RENDER3 drawPrimitives:type vertexStart:start vertexCount:count];
+}
+void GpuEncoder::DrawIndexed(MTLPrimitiveType type, uint32_t count, MTLIndexType index_type, id<MTLBuffer> buffer,
+                             NSUInteger offset) {
+  M4 {
+    auto& st = rec_->state;
+    if (st.index_buffer != (__bridge void*)buffer) {
+      // A buffer of this encoder's draws before is in use by the command buffer already.
+      rec_->queue->UseIn(*rec_, buffer);
+      st.index_buffer = (__bridge void*)buffer;
+      st.index_address = buffer.gpuAddress;
+      st.index_length = buffer.length;
+    }
+    assert(offset <= st.index_length);
+    [RENDER4 drawIndexedPrimitives:type indexCount:count indexType:index_type indexBuffer:st.index_address + offset
+                 indexBufferLength:(st.index_length - offset) & ~NSUInteger(3)];  // Metal 4: a multiple of 4
+    return;
+  }
+  [RENDER3 drawIndexedPrimitives:type indexCount:count indexType:index_type indexBuffer:buffer indexBufferOffset:offset];
+}
+
+void GpuEncoder::SetBuffer(GpuStage stage, id<MTLBuffer> buffer, NSUInteger offset, uint32_t index) {
+  M4 {
+    if (!buffer) return;
+    const uint32_t s = kind_ == Kind::kRender ? uint32_t(stage) : 2u;
+    if (OutOfTable(s, "buffer", index, kStageBuffers[s])) return;
+    const uint64_t base = buffer.gpuAddress;
+    if (index < kTableBuffers) {
+      // The same buffer as the slot's: already in use by this command buffer.
+      if (rec_->base[s][index] != base) rec_->queue->UseIn(*rec_, buffer);
+      rec_->base[s][index] = base;
+      if (rec_->address[s][index] == base + offset) return;
+      rec_->address[s][index] = base + offset;
+    } else {
+      rec_->queue->UseIn(*rec_, buffer);
+    }
+    [rec_->tables[s] setAddress:base + offset atIndex:index];
+    return;
+  }
+  if (kind_ != Kind::kRender) [COMPUTE3 setBuffer:buffer offset:offset atIndex:index];
+  else if (stage == GpuStage::kVertex) [RENDER3 setVertexBuffer:buffer offset:offset atIndex:index];
+  else [RENDER3 setFragmentBuffer:buffer offset:offset atIndex:index];
+}
+void GpuEncoder::SetBufferOffset(GpuStage stage, NSUInteger offset, uint32_t index) {
+  M4 {
+    const uint32_t s = kind_ == Kind::kRender ? uint32_t(stage) : 2u;
+    assert(index < kTableBuffers && rec_->base[s][index] && "SetBufferOffset without SetBuffer");
+    const uint64_t address = rec_->base[s][index] + offset;
+    if (rec_->address[s][index] == address) return;
+    rec_->address[s][index] = address;
+    [rec_->tables[s] setAddress:address atIndex:index];
+    return;
+  }
+  if (kind_ != Kind::kRender) [COMPUTE3 setBufferOffset:offset atIndex:index];
+  else if (stage == GpuStage::kVertex) [RENDER3 setVertexBufferOffset:offset atIndex:index];
+  else [RENDER3 setFragmentBufferOffset:offset atIndex:index];
+}
+void GpuEncoder::SetBytes(GpuStage stage, const void* data, size_t size, uint32_t index) {
+  M4 {
+    const uint32_t s = kind_ == Kind::kRender ? uint32_t(stage) : 2u;
+    if (OutOfTable(s, "buffer", index, kStageBuffers[s])) return;
+    const uint64_t address = rec_->queue->Transient(*rec_, data, size);
+    if (index < kTableBuffers) { rec_->base[s][index] = 0; rec_->address[s][index] = address; }
+    [rec_->tables[s] setAddress:address atIndex:index];
+    return;
+  }
+  if (kind_ != Kind::kRender) [COMPUTE3 setBytes:data length:size atIndex:index];
+  else if (stage == GpuStage::kVertex) [RENDER3 setVertexBytes:data length:size atIndex:index];
+  else [RENDER3 setFragmentBytes:data length:size atIndex:index];
+}
+void GpuEncoder::SetTexture(GpuStage stage, id<MTLTexture> texture, uint32_t index) {
+  M4 {
+    const uint32_t s = kind_ == Kind::kRender ? uint32_t(stage) : 2u;
+    if (OutOfTable(s, "texture", index, kStageTextures[s])) return;
+    void* key = (__bridge void*)texture;
+    if (index < kTableTextures) {
+      // The slot's texture is in use by this command buffer already (and lives until it is done).
+      if (rec_->textures[s][index] == key) return;
+      rec_->textures[s][index] = key;
+    }
+    if (texture) rec_->queue->UseIn(*rec_, texture);
+    [rec_->tables[s] setTexture:texture ? texture.gpuResourceID : MTLResourceID{} atIndex:index];
+    return;
+  }
+  if (kind_ != Kind::kRender) [COMPUTE3 setTexture:texture atIndex:index];
+  else if (stage == GpuStage::kVertex) [RENDER3 setVertexTexture:texture atIndex:index];
+  else [RENDER3 setFragmentTexture:texture atIndex:index];
+}
+void GpuEncoder::SetTextureView(GpuStage stage, MTLResourceID view, uint64_t key, id<MTLTexture> texture,
+                                uint32_t index) {
+  M4 {
+    const uint32_t s = kind_ == Kind::kRender ? uint32_t(stage) : 2u;
+    if (OutOfTable(s, "texture", index, kStageTextures[s])) return;
+    void* k = reinterpret_cast<void*>(uintptr_t(key));
+    if (index < kTableTextures) {
+      if (rec_->textures[s][index] == k) return;
+      rec_->textures[s][index] = k;
+    }
+    // The pool isn't an allocation: its views are resident through the textures they view.
+    if (texture) rec_->queue->UseIn(*rec_, texture);
+    [rec_->tables[s] setTexture:view atIndex:index];
+    return;
+  }
+  SetTexture(stage, texture, index);
+}
