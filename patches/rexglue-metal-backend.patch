+/**
+ * @file        graphics/metal/metal_presenter.mm
+ * @brief       The Metal backend's provider and presenter
+ *
+ * Added by the mcla-recomp macOS fork (patches/rexglue-metal-backend.patch). The presenter draws the newest
+ * guest output image into the window's CAMetalLayer (the surface the SDK makes on macOS), letterboxed and
+ * bilinearly scaled, on the provider's one command queue, then the UI drawers (the ImGui overlays: settings, debug,
+ * console, achievements) through MetalImmediateDrawer. HDR output (the SDK's `hdr` setting): the layer becomes HDR10
+ * (BGR10A2, PQ, BT.2020) with EDR and HDR10 metadata whose optical output scale puts paper white at the display's
+ * SDR white, so macOS maps the highlights into the display's EDR headroom; the guest output then holds PQ code
+ * values (the refresher's) or SDR ones (encoded here), and the UI is blended in light at the SDR level. The other
+ * presenter effects of the other backends (FSR, CAS, dither) are not done.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include "metal_internal.h"
+#import <MetalFX/MetalFX.h>
+#include <chrono>
+#include <cstdio>
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <string>
+
+#include <rex/cvar.h>
+
+#include <rex/logging.h>
+#include <rex/ui/immediate_drawer.h>
+#include <rex/ui/surface_mac.h>
+
+#import <AppKit/AppKit.h>
+#import <QuartzCore/QuartzCore.h>
+
+REXCVAR_DEFINE_STRING(metal_present_capture, "", "GPU/Metal",
+    "Development: write what the presenter paints (the guest output and the UI overlays) to this PPM file, at most "
+    "every 2 seconds");
+
+REXCVAR_DECLARE(std::string, hdr);
+REXCVAR_DECLARE(int32_t, frame_generation_debug);
+REXCVAR_DEFINE_BOOL(metal_hdr_auto_edr, true, "GPU/Metal",
+    "With hdr = auto: HDR output when the display can show extended dynamic range (EDR) at all (macOS has no HDR "
+    "switch; on a Mac the built-in displays and HDR monitors can)");
+
+namespace rex::graphics::metal {
+
+namespace {
+
+// HDR10 (PQ, BT.2020) in the presenter's shaders, as the SDK's hdr_output.xesli writes it.
+#define METAL_HDR_FUNCTIONS R"(
+float3 hdr_sdr_to_linear(float3 code, bool gamma22) {
+  code = max(code, 0.0);
+  return gamma22 ? pow(code, 2.2) : select(code / 12.92, pow((code + 0.055) / 1.055, 2.4), code > 0.04045);
+}
+float3 hdr_encode_pq(float3 nits) {
+  float3 bt2020 = float3(dot(nits, float3(0.627404, 0.329283, 0.043313)),
+                         dot(nits, float3(0.069097, 0.919540, 0.011362)),
+                         dot(nits, float3(0.016391, 0.088013, 0.895595)));
+  float3 y = pow(clamp(bt2020 / 10000.0, 0.0, 1.0), 0.1593017578125);
+  return pow((0.8359375 + 18.8515625 * y) / (1.0 + 18.6875 * y), 78.84375);
+}
+float3 hdr_decode_pq(float3 code) {
+  float3 e = pow(clamp(code, 0.0, 1.0), 1.0 / 78.84375);
+  float3 bt2020 = pow(max(e - 0.8359375, 0.0) / (18.8515625 - 18.6875 * e), 1.0 / 0.1593017578125) * 10000.0;
+  return max(float3(dot(bt2020, float3(1.660491, -0.587641, -0.072850)),
+                    dot(bt2020, float3(-0.124550, 1.132900, -0.008349)),
+                    dot(bt2020, float3(-0.018151, -0.100579, 1.118730))), 0.0);
+}
+)"
+
+// A quad over the viewport (the guest output's rectangle in the drawable), sampling the guest output.
+constexpr const char kPaintShaderSource[] = R"(
+#include <metal_stdlib>
+using namespace metal;
+
+struct PaintVertexOut {
+  float4 position [[position]];
+  float2 uv;
+};
+
+vertex PaintVertexOut paint_vs(uint vertex_id [[vertex_id]]) {
+  float2 uv = float2(float(vertex_id & 1u), float(vertex_id >> 1u));
+  PaintVertexOut out;
+  out.position = float4(uv * float2(2.0, -2.0) + float2(-1.0, 1.0), 0.0, 1.0);
+  out.uv = uv;
+  return out;
+}
+
+fragment float4 paint_ps(PaintVertexOut in [[stage_in]], texture2d<float> guest_output [[texture(0)]],
+                         sampler guest_output_sampler [[sampler(0)]]) {
+  return float4(guest_output.sample(guest_output_sampler, in.uv).rgb, 1.0);
+}
+)" METAL_HDR_FUNCTIONS R"(
+// Into the HDR10 layer: PQ code values as they are, or SDR ones placed at the SDR level.
+struct PaintHdr { float sdr_nits; uint is_pq; uint gamma22; };
+fragment float4 paint_hdr_ps(PaintVertexOut in [[stage_in]], texture2d<float> guest_output [[texture(0)]],
+                             sampler guest_output_sampler [[sampler(0)]], constant PaintHdr& c [[buffer(0)]]) {
+  float3 color = guest_output.sample(guest_output_sampler, in.uv).rgb;
+  return float4(c.is_pq ? color : hdr_encode_pq(hdr_sdr_to_linear(color, c.gamma22 != 0) * c.sdr_nits), 1.0);
+}
+)";
+
+// The immediate drawer's (ImGui's) vertices: position in the coordinate space, texture coordinates, RGBA8 color.
+constexpr const char kImmediateShaderSource[] = R"(
+#include <metal_stdlib>
+using namespace metal;
+
+struct ImmediateVertex { packed_float2 position; packed_float2 uv; uint color; };
+struct ImmediateOut {
+  float4 position [[position]];
+  float2 uv;
+  float4 color;
+};
+
+vertex ImmediateOut immediate_vs(uint id [[vertex_id]], const device ImmediateVertex* vertices [[buffer(0)]],
+                                 constant float2& coordinate_space [[buffer(1)]]) {
+  ImmediateVertex v = vertices[id];
+  ImmediateOut out;
+  out.position = float4(float2(v.position) / coordinate_space * float2(2.0, -2.0) + float2(-1.0, 1.0), 0.0, 1.0);
+  out.uv = float2(v.uv);
+  out.color = unpack_unorm4x8_to_float(v.color);
+  return out;
+}
+
+fragment float4 immediate_ps(ImmediateOut in [[stage_in]], texture2d<float> texture [[texture(0)]],
+                             sampler texture_sampler [[sampler(0)]]) {
+  return in.color * texture.sample(texture_sampler, in.uv);
+}
+)" METAL_HDR_FUNCTIONS R"(
+// Over the HDR10 layer: the UI's colour as SDR content at the SDR level, blended in light with what is there
+// (read from the attachment: Apple GPUs keep it in tile memory).
+struct ImmediateHdr { float sdr_nits; uint gamma22; };
+fragment float4 immediate_hdr_ps(ImmediateOut in [[stage_in]], texture2d<float> texture [[texture(0)]],
+                                 sampler texture_sampler [[sampler(0)]], constant ImmediateHdr& c [[buffer(0)]],
+                                 float4 destination [[color(0)]]) {
+  float4 color = in.color * texture.sample(texture_sampler, in.uv);
+  float3 under = hdr_decode_pq(destination.rgb);
+  float3 over = hdr_sdr_to_linear(color.rgb, c.gamma22 != 0) * c.sdr_nits;
+  return float4(hdr_encode_pq(mix(under, over, saturate(color.a))), 1.0);
+}
+)";
+
+}  // namespace
+
+// What the presenter gives the UI drawers: the encoder of its paint pass, after the guest output.
+class MetalUIDrawContext final : public ui::UIDrawContext {
+ public:
+  MetalUIDrawContext(ui::Presenter& presenter, uint32_t width, uint32_t height, id<MTLRenderCommandEncoder> encoder,
+                     bool hdr = false, float sdr_nits = 0.0f, bool gamma22 = false)
+      : UIDrawContext(presenter, width, height), encoder_(encoder), hdr_(hdr), sdr_nits_(sdr_nits),
+        gamma22_(gamma22) {}
+  id<MTLRenderCommandEncoder> encoder() const { return encoder_; }
+  // The paint pass draws into the HDR10 layer: the UI at this SDR level.
+  bool hdr() const { return hdr_; }
+  float sdr_nits() const { return sdr_nits_; }
+  bool gamma22() const { return gamma22_; }
+
+ private:
+  id<MTLRenderCommandEncoder> encoder_;
+  bool hdr_;
+  float sdr_nits_;
+  bool gamma22_;
+};
+
+namespace {
+
+class MetalImmediateTexture final : public ui::ImmediateTexture {
+ public:
+  MetalImmediateTexture(uint32_t width, uint32_t height, id<MTLTexture> texture, id<MTLSamplerState> sampler)
+      : ImmediateTexture(width, height), texture(texture), sampler(sampler) {}
+  id<MTLTexture> texture;
+  id<MTLSamplerState> sampler;
+};
+
+// ImGui's draws in the presenter's paint pass. A command buffer keeps what it uses alive (textures, the batch
+// buffers), so nothing here waits for the GPU.
+class MetalImmediateDrawer final : public ui::ImmediateDrawer {
+ public:
+  static std::unique_ptr<MetalImmediateDrawer> Create(id<MTLDevice> device) {
+    std::unique_ptr<MetalImmediateDrawer> drawer(new MetalImmediateDrawer(device));
+    return drawer->Initialize() ? std::move(drawer) : nullptr;
+  }
+
+  std::unique_ptr<ui::ImmediateTexture> CreateTexture(uint32_t width, uint32_t height,
+                                                      ui::ImmediateTextureFilter filter, bool is_repeated,
+                                                      const uint8_t* data) override {
+    if (!width || !height) return nullptr;
+    @autoreleasepool {
+      MTLTextureDescriptor* desc = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm
+                                                                                       width:width
+                                                                                      height:height
+                                                                                   mipmapped:NO];
+      desc.usage = MTLTextureUsageShaderRead;
+      desc.storageMode = MTLStorageModeShared;
+      id<MTLTexture> texture = [device_ newTextureWithDescriptor:desc];
+      if (!texture) return nullptr;
+      if (data) {
+        [texture replaceRegion:MTLRegionMake2D(0, 0, width, height) mipmapLevel:0 withBytes:data
+                   bytesPerRow:width * 4];
+      }
+      return std::make_unique<MetalImmediateTexture>(
+          width, height, texture, samplers_[(filter == ui::ImmediateTextureFilter::kLinear ? 1 : 0) | (is_repeated ? 2 : 0)]);
+    }
+  }
+
+  void Begin(ui::UIDrawContext& ui_draw_context, float coordinate_space_width,
+             float coordinate_space_height) override {
+    ImmediateDrawer::Begin(ui_draw_context, coordinate_space_width, coordinate_space_height);
+    auto& metal_context = static_cast<MetalUIDrawContext&>(ui_draw_context);
+    encoder_ = metal_context.encoder();
+    if (metal_context.hdr()) {
+      if (!hdr_pipeline_) {
+        encoder_ = nil;
+        return;
+      }
+      [encoder_ setRenderPipelineState:hdr_pipeline_];
+      struct { float sdr_nits; uint32_t gamma22; } c{metal_context.sdr_nits(), metal_context.gamma22() ? 1u : 0u};
+      [encoder_ setFragmentBytes:&c length:sizeof(c) atIndex:0];
+    } else {
+      [encoder_ setRenderPipelineState:pipeline_];
+    }
+    [encoder_ setViewport:MTLViewport{0.0, 0.0, double(ui_draw_context.render_target_width()),
+                                      double(ui_draw_context.render_target_height()), 0.0, 1.0}];
+    const float space[2] = {this->coordinate_space_width(), this->coordinate_space_height()};
+    [encoder_ setVertexBytes:space length:sizeof(space) atIndex:1];
+  }
+
+  void BeginDrawBatch(const ui::ImmediateDrawBatch& batch) override {
+    batch_ok_ = false;
+    if (!encoder_ || !batch.vertices || batch.vertex_count <= 0) return;
+    const size_t vertex_bytes = sizeof(ui::ImmediateVertex) * size_t(batch.vertex_count);
+    if (vertex_bytes <= 4096) {
+      [encoder_ setVertexBytes:batch.vertices length:vertex_bytes atIndex:0];
+    } else {
+      id<MTLBuffer> vertices = [device_ newBufferWithBytes:batch.vertices length:vertex_bytes
+                                                   options:MTLResourceStorageModeShared];
+      if (!vertices) return;
+      [encoder_ setVertexBuffer:vertices offset:0 atIndex:0];
+    }
+    indices_ = nil;
+    if (batch.indices && batch.index_count > 0) {
+      indices_ = [device_ newBufferWithBytes:batch.indices length:sizeof(uint16_t) * size_t(batch.index_count)
+                                     options:MTLResourceStorageModeShared];
+      if (!indices_) return;
+    }
+    batch_ok_ = true;
+  }
+
+  void Draw(const ui::ImmediateDraw& draw) override {
+    if (!batch_ok_ || draw.count <= 0) return;
+    uint32_t left, top, width, height;
+    if (!ScissorToRenderTarget(draw, left, top, width, height)) return;
+    [encoder_ setScissorRect:MTLScissorRect{left, top, width, height}];
+    auto* texture = static_cast<MetalImmediateTexture*>(draw.texture);
+    [encoder_ setFragmentTexture:texture ? texture->texture : white_ atIndex:0];
+    [encoder_ setFragmentSamplerState:texture ? texture->sampler : samplers_[0] atIndex:0];
+    const MTLPrimitiveType type =
+        draw.primitive_type == ui::ImmediatePrimitiveType::kLines ? MTLPrimitiveTypeLine : MTLPrimitiveTypeTriangle;
+    if (indices_) {
+      [encoder_ drawIndexedPrimitives:type indexCount:NSUInteger(draw.count) indexType:MTLIndexTypeUInt16
+                          indexBuffer:indices_ indexBufferOffset:sizeof(uint16_t) * NSUInteger(draw.index_offset)
+                        instanceCount:1 baseVertex:draw.base_vertex baseInstance:0];
+    } else {
+      [encoder_ drawPrimitives:type vertexStart:NSUInteger(draw.base_vertex) vertexCount:NSUInteger(draw.count)];
+    }
+  }
+
+  void EndDrawBatch() override {
+    batch_ok_ = false;
+    indices_ = nil;
+  }
+
+  void End() override {
+    // The pass goes on after the UI (the presenter ends it): the scissor back to the whole target.
+    if (encoder_ && ui_draw_context()) {
+      [encoder_ setScissorRect:MTLScissorRect{0, 0, ui_draw_context()->render_target_width(),
+                                              ui_draw_context()->render_target_height()}];
+    }
+    encoder_ = nil;
+    ImmediateDrawer::End();
+  }
+
+ private:
+  explicit MetalImmediateDrawer(id<MTLDevice> device) : device_(device) {}
+
+  bool Initialize() {
+    NSError* error = nil;
+    id<MTLLibrary> library = [device_ newLibraryWithSource:[NSString stringWithUTF8String:kImmediateShaderSource]
+                                                   options:nil
+                                                     error:&error];
+    if (!library) {
+      REXGPU_ERROR("Metal immediate drawer: the shaders did not compile: {}",
+                   error ? [error.localizedDescription UTF8String] : "?");
+      return false;
+    }
+    MTLRenderPipelineDescriptor* desc = [[MTLRenderPipelineDescriptor alloc] init];
+    desc.label = @"rexglue immediate drawer";
+    desc.vertexFunction = [library newFunctionWithName:@"immediate_vs"];
+    desc.fragmentFunction = [library newFunctionWithName:@"immediate_ps"];
+    auto* color = desc.colorAttachments[0];
+    color.pixelFormat = MTLPixelFormatBGRA8Unorm;
+    color.blendingEnabled = YES;
+    color.sourceRGBBlendFactor = MTLBlendFactorSourceAlpha;
+    color.destinationRGBBlendFactor = MTLBlendFactorOneMinusSourceAlpha;
+    color.sourceAlphaBlendFactor = MTLBlendFactorOne;
+    color.destinationAlphaBlendFactor = MTLBlendFactorOneMinusSourceAlpha;
+    pipeline_ = [device_ newRenderPipelineStateWithDescriptor:desc error:&error];
+    if (!pipeline_) {
+      REXGPU_ERROR("Metal immediate drawer: no pipeline: {}", error ? [error.localizedDescription UTF8String] : "?");
+      return false;
+    }
+    // HDR10 layer: blended in the shader (it reads the attachment).
+    desc.label = @"rexglue immediate drawer (HDR10)";
+    desc.fragmentFunction = [library newFunctionWithName:@"immediate_hdr_ps"];
+    color.pixelFormat = MTLPixelFormatBGR10A2Unorm;
+    color.blendingEnabled = NO;
+    hdr_pipeline_ = [device_ newRenderPipelineStateWithDescriptor:desc error:&error];
+    if (!hdr_pipeline_) {
+      REXGPU_WARN("Metal immediate drawer: no HDR pipeline (the UI is hidden in HDR): {}",
+                  error ? [error.localizedDescription UTF8String] : "?");
+    }
+    for (uint32_t i = 0; i < 4; ++i) {
+      MTLSamplerDescriptor* sd = [[MTLSamplerDescriptor alloc] init];
+      sd.minFilter = sd.magFilter = (i & 1) ? MTLSamplerMinMagFilterLinear : MTLSamplerMinMagFilterNearest;
+      sd.sAddressMode = sd.tAddressMode = (i & 2) ? MTLSamplerAddressModeRepeat : MTLSamplerAddressModeClampToEdge;
+      samplers_[i] = [device_ newSamplerStateWithDescriptor:sd];
+      if (!samplers_[i]) return false;
+    }
+    const uint32_t white = 0xFFFFFFFFu;
+    MTLTextureDescriptor* td = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm
+                                                                                  width:1
+                                                                                 height:1
+                                                                              mipmapped:NO];
+    td.usage = MTLTextureUsageShaderRead;
+    td.storageMode = MTLStorageModeShared;
+    white_ = [device_ newTextureWithDescriptor:td];
+    if (!white_) return false;
+    [white_ replaceRegion:MTLRegionMake2D(0, 0, 1, 1) mipmapLevel:0 withBytes:&white bytesPerRow:4];
+    return true;
+  }
+
+  id<MTLDevice> device_;
+  id<MTLRenderPipelineState> pipeline_ = nil;
+  id<MTLRenderPipelineState> hdr_pipeline_ = nil;
+  id<MTLSamplerState> samplers_[4] = {};  // nearest or linear (bit 0), clamped or repeated (bit 1)
+  id<MTLTexture> white_ = nil;
+  id<MTLRenderCommandEncoder> encoder_ = nil;
+  id<MTLBuffer> indices_ = nil;
+  bool batch_ok_ = false;
+};
+
+}  // namespace
+
+std::unique_ptr<ui::ImmediateDrawer> MetalProvider::CreateImmediateDrawer() {
+  return MetalImmediateDrawer::Create(device_);
+}
