+
+void MetalCommandProcessor::IssueSwap([[maybe_unused]] uint32_t frontbuffer_ptr,
+                                      uint32_t frontbuffer_width, uint32_t frontbuffer_height) {
+  if (draw_) draw_->EndFrame();
+  ++swaps_;
+  {
+    // The time between frames (averaged), for the motion blur's length.
+    const auto now = std::chrono::steady_clock::now();
+    const double interval = std::chrono::duration<double>(now - last_swap_time_).count();
+    if (last_swap_time_ != std::chrono::steady_clock::time_point{} && interval < 0.25)
+      frame_interval_ = frame_interval_ > 0.0 ? frame_interval_ * 0.9 + interval * 0.1 : interval;
+    // The slow frame log: where a long frame's time went on this thread.
+    const uint32_t translated = shader_compiler_ ? shader_compiler_->stats().translated.load() : 0;
+    const uint64_t translate_us = shader_compiler_ ? shader_compiler_->stats().translate_us.load() : 0;
+    const int32_t slow_ms = REXCVAR_GET(metal_slow_frame_ms);
+    if (slow_ms > 0 && draw_ && last_swap_time_ != std::chrono::steady_clock::time_point{} &&
+        interval * 1000.0 >= slow_ms) {
+      if (now - slow_window_ > std::chrono::seconds(10)) {
+        slow_window_ = now;
+        slow_logged_ = 0;
+      }
+      if (slow_logged_++ < 20) {
+        const MetalDraw::FrameReport& r = draw_->last_frame();
+        const double wall_ms = interval * 1000.0;
+        const double cpu_ms = r.cpu_us / 1000.0, wait_ms = r.wait_us / 1000.0;
+        REXGPU_INFO("Metal slow frame: {:.1f} ms (swap {}): command thread CPU {:.1f} ms, waiting for the GPU {:.1f} ms, "
+                    "the rest {:.1f} ms (waiting for the game, or not scheduled); {} shaders translated ({:.1f} ms), "
+                    "{} pipelines made ({:.1f} ms), {:.1f} ms waited for stored pipelines, {} draws left out; {} texture "
+                    "loads ({} made from resolves, {} rows from memory), {:.1f} MB of textures hashed, {:.1f} MB of "
+                    "vertices copied; {} passes, {} EDRAM transfers; {} slow texture lookups {:.1f} ms (watches set "
+                    "{:.1f} ms, loads {:.1f} ms of which {:.1f} ms making textures)",
+                    wall_ms, swaps_ + 1, cpu_ms, wait_ms, std::max(0.0, wall_ms - cpu_ms - wait_ms),
+                    translated - slow_translated_, (translate_us - slow_translate_us_) / 1000.0, r.pipelines,
+                    r.pipeline_us / 1000.0, r.prebuilt_wait_us / 1000.0, r.async_skipped, r.texture_loads, r.composed,
+                    r.rows_loaded, r.texture_hashed / 1048576.0, r.snapshot_copied / 1048576.0, r.passes, r.transfers,
+                    r.tex_slow_calls, r.tex_slow_us / 1000.0, r.tex_watch_us / 1000.0, r.tex_load_us / 1000.0,
+                    r.tex_alloc_us / 1000.0);
+      }
+    }
+    slow_translated_ = translated;
+    slow_translate_us_ = translate_us;
+    last_swap_time_ = now;
+  }
+  ++stats_swaps_;
+  // In free roam on the scripted route (40 s in at 30 swaps a second), when most shaders are loaded.
+  if (swaps_ == 1200 && shared_memory_buffer_ && !shared_memory_checked_) {
+    CheckZeroCopySharedMemory();
+  }
+  ui::Presenter* presenter = graphics_system_->presenter();
+  if (presenter && command_queue_) {
+    if (!frontbuffer_width || !frontbuffer_height) {
+      frontbuffer_width = 1280;
+      frontbuffer_height = 720;
+    }
+    const uint64_t swap = swaps_;
+    // The guest output, HDR output's textures and composite are at the draws' size (resolution_scale).
+    const uint32_t rs = MetalResolutionScale();
+    hdr_output_width_ = frontbuffer_width * rs;
+    hdr_output_height_ = frontbuffer_height * rs;
+    // The ramp as the guest has it now, for this swap (the callback may run after more register writes).
+    auto gamma = std::make_shared<MetalDraw::GammaRamp>();
+    static_assert(sizeof(reg::DC_LUT_30_COLOR) == 4 && sizeof(reg::DC_LUT_PWL_DATA) == 4);
+    std::memcpy(gamma->table, gamma_ramp_256_entry_table(), sizeof(gamma->table));
+    std::memcpy(gamma->pwl, gamma_ramp_pwl_rgb(), sizeof(gamma->pwl));
+    presenter->RefreshGuestOutput(
+        frontbuffer_width * rs, frontbuffer_height * rs, 1280, 720,
+        [this, frontbuffer_ptr, swap, gamma](ui::Presenter::GuestOutputRefreshContext& context) -> bool {
+          auto& metal_context = static_cast<MetalGuestOutputRefreshContext&>(context);
+          @autoreleasepool {
+            // HDR output: the SDK's refresher (HDR10 code values) while the presenter's layer is HDR10.
+            const ui::Presenter::HdrOutputState hdr_state = ui::Presenter::GetHdrOutputState();
+            ui::Presenter::SetGuestOutputHdrAvailable(true);
+            const bool use_hdr = hdr_state.active && REXCVAR_GET(metal_gamma_ramp) &&
+                                 metal_context.texture().pixelFormat == MTLPixelFormatRGB10A2Unorm;
+            MetalDraw::HdrRefresh refresh{};
+            HdrComposite composite = HdrComposite::kWholeFrame;
+            if (use_hdr) {
+              const uint32_t width = uint32_t(metal_context.texture().width);
+              const uint32_t height = uint32_t(metal_context.texture().height);
+              composite = HdrGetComposite(width, height);
+              refresh.layer = composite == HdrComposite::kMask || composite == HdrComposite::kLayer;
+              if (refresh.layer && !draw_->HdrEnsureTextures(width, height)) {
+                composite = HdrComposite::kWholeFrame;
+                refresh.layer = false;
+              }
+              refresh.scene = hdr_frame_.scene && composite != HdrComposite::kWholeFrame;
+              refresh.constants[0] = width;
+              refresh.constants[1] = height;
+              HdrRefreshFlags(composite, hdr_state.debug_ui, &refresh.constants[2]);
+              refresh.constants[2] |= uint32_t(hdr_state.sdr_pure_gamma_2_2) | (uint32_t(hdr_state.test_pattern) << 1);
+              const float levels[4] = {hdr_state.sdr_white_nits, hdr_state.paper_white_nits,
+                                       hdr_state.rolloff_start_nits, hdr_state.peak_nits};
+              std::memcpy(&refresh.constants[4], levels, sizeof(levels));
+            }
+            // Frame generation (the presenter gives a texture for it while it's on): for frames of the game's 3D
+            // scene put together from the UI layer, or without UI, and with the tone map (menus, loading and legal
+            // screens are shown alone), with the temporal AA's camera; HDR or SDR (not with the PWL ramp).
+            MetalDraw::FrameGeneration fg{};
+            fg.generated = metal_context.generated();
+            if (fg.generated && !use_hdr && REXCVAR_GET(metal_gamma_ramp)) {
+              // SDR: the refresher's constants for the HUD-less image and the compose (the UI layer is kept apart
+              // while frame generation is on, Presenter::SetFrameGenerationUiSeparation).
+              const uint32_t width = uint32_t(metal_context.texture().width);
+              const uint32_t height = uint32_t(metal_context.texture().height);
+              composite = HdrGetComposite(width, height);
+              fg.sdr.layer = composite == HdrComposite::kMask || composite == HdrComposite::kLayer;
+              if (fg.sdr.layer && !draw_->HdrEnsureTextures(width, height)) {
+                composite = HdrComposite::kWholeFrame;
+                fg.sdr.layer = false;
+              }
+              fg.sdr.scene = hdr_frame_.scene && composite != HdrComposite::kWholeFrame;
+              fg.sdr.constants[0] = width;
+              fg.sdr.constants[1] = height;
+              HdrRefreshFlags(composite, 0, &fg.sdr.constants[2]);
+            }
+            if (fg.generated) {
+              fg.allowed = (composite == HdrComposite::kLayer || composite == HdrComposite::kScene) &&
+                           hdr_frame_.tonemap && (!use_hdr || (!hdr_state.debug_ui && !hdr_state.test_pattern));
+              fg.near_plane = taa_camera_.near_plane;
+              fg.far_plane = taa_camera_.far_plane;
+              fg.fov_vertical = taa_camera_.fov_vertical;
+              fg.delta_time = taa_frame_time_ms_ / 1000.0f;
+              fg.reset = taa_camera_.reset;
+            }
+            bool wrote_pq = false;
+            if (draw_ && draw_->Present(frontbuffer_ptr, metal_context.texture(), gamma.get(),
+                                        use_hdr ? &refresh : nullptr, &wrote_pq, fg.generated ? &fg : nullptr)) {
+              if (wrote_pq) context.SetHdr({true, hdr_state.sdr_white_nits, hdr_state.sdr_pure_gamma_2_2});
+              metal_context.SetGenerated(fg.generated_out);
+              return true;
+            }
+            // The placeholder: a slow pulse, so that a moving picture shows that the swaps arrive.
+            const double phase = double(swap % 120) / 120.0;
+            const double level = 0.10 + 0.08 * (phase < 0.5 ? phase : 1.0 - phase) * 2.0;
+            MTLRenderPassDescriptor* pass = [MTLRenderPassDescriptor renderPassDescriptor];
+            pass.colorAttachments[0].texture = metal_context.texture();
+            pass.colorAttachments[0].loadAction = MTLLoadActionClear;
+            pass.colorAttachments[0].clearColor = MTLClearColorMake(level * 0.6, level * 0.7, level, 1.0);
+            pass.colorAttachments[0].storeAction = MTLStoreActionStore;
+            id<MTLCommandBuffer> command_buffer = [metal_context.command_queue() commandBuffer];
+            command_buffer.label = @"rexglue guest output (M0 placeholder)";
+            [[command_buffer renderCommandEncoderWithDescriptor:pass] endEncoding];
+            [command_buffer commit];
+          }
+          return true;
+        });
+  }
+  MaybeLogStats();
+}
+
+void MetalCommandProcessor::CreateZeroCopySharedMemory() {
+  uint8_t* physical = memory_->physical_membase();
+  const size_t size = SharedMemory::kBufferSize;
+  const size_t page = size_t(getpagesize());
+  if (!physical || (reinterpret_cast<uintptr_t>(physical) & (page - 1)) || (size & (page - 1))) {
+    REXGPU_WARN("Metal: guest physical memory is not page-aligned; no zero-copy shared memory");
+    return;
+  }
+  const uint64_t start_ms = chrono::Clock::QueryHostUptimeMillis();
+  shared_memory_buffer_ = [device_ newBufferWithBytesNoCopy:physical
+                                                     length:size
+                                                    options:MTLResourceStorageModeShared |
+                                                            (REXCVAR_GET(metal_memory_untracked)
+                                                                 ? MTLResourceHazardTrackingModeUntracked
+                                                                 : MTLResourceHazardTrackingModeDefault)
+                                                deallocator:nil];
+  if (!shared_memory_buffer_) {
+    REXGPU_WARN("Metal: the guest's physical memory could not be made a Metal buffer without a copy");
+    return;
+  }
+  shared_memory_buffer_.label = @"rexglue guest physical memory (no copy)";
+  REXGPU_INFO("Metal: guest physical memory ({} MB at {}) is a Metal buffer without a copy, in {} ms (GPU address "
+              "{:016X})",
+              size >> 20, static_cast<const void*>(physical), chrono::Clock::QueryHostUptimeMillis() - start_ms,
+              shared_memory_buffer_.gpuAddress);
+}
+
+void MetalCommandProcessor::CheckZeroCopySharedMemory() {
+  shared_memory_checked_ = true;
+  size_t total = 0;
+  for (const auto& range : shader_ranges_) {
+    total += range.second * sizeof(uint32_t);
+  }
+  if (!total) {
+    return;
+  }
+  @autoreleasepool {
+    id<MTLBuffer> readback = [device_ newBufferWithLength:total options:MTLResourceStorageModeShared];
+    id<MTLCommandBuffer> command_buffer = [command_queue_ commandBuffer];
+    command_buffer.label = @"rexglue zero-copy shared memory check";
+    id<MTLBlitCommandEncoder> blit = [command_buffer blitCommandEncoder];
+    size_t offset = 0;
+    for (const auto& range : shader_ranges_) {
+      const size_t length = range.second * sizeof(uint32_t);
+      [blit copyFromBuffer:shared_memory_buffer_ sourceOffset:range.first toBuffer:readback
+           destinationOffset:offset size:length];
+      offset += length;
+    }
+    [blit endEncoding];
+    [command_buffer commit];
+    [command_buffer waitUntilCompleted];
+    size_t mismatched = 0;
+    offset = 0;
+    const auto* gpu = static_cast<const uint8_t*>(readback.contents);
+    for (const auto& range : shader_ranges_) {
+      const size_t length = range.second * sizeof(uint32_t);
+      if (std::memcmp(gpu + offset, memory_->TranslatePhysical<const uint8_t*>(range.first), length)) {
+        ++mismatched;
+      }
+      offset += length;
+    }
+    if (command_buffer.status == MTLCommandBufferStatusCompleted && !mismatched) {
+      REXGPU_INFO("Metal: zero-copy shared memory checked: the GPU read the microcode of all {} shaders ({} bytes "
+                  "of guest physical memory) exactly as the CPU sees it",
+                  shader_ranges_.size(), total);
+    } else {
+      REXGPU_WARN("Metal: zero-copy shared memory check FAILED: {} of {} ranges differ (command buffer status {})",
+                  mismatched, shader_ranges_.size(), int(command_buffer.status));
+    }
+  }
+}
+
+void MetalCommandProcessor::MaybeLogStats() {
+  const uint64_t now_ms = chrono::Clock::QueryHostUptimeMillis();
+  const uint64_t elapsed_ms = now_ms - stats_since_ms_;
+  if (elapsed_ms < 5000) {
+    return;
+  }
+  const double seconds = double(elapsed_ms) / 1000.0;
+  REXGPU_INFO("Metal M1: {:.1f} swaps/s, {:.0f} draws and {:.0f} resolves a swap, {} shaders loaded",
+              stats_swaps_ / seconds, stats_swaps_ ? double(stats_draws_) / stats_swaps_ : 0.0,
+              stats_swaps_ ? double(stats_copies_) / stats_swaps_ : 0.0, shaders_.size());
+  if (draw_) REXGPU_INFO("Metal rasterizer: {} draws submitted, {} color resolves, {} failures total", draw_->draws(), draw_->resolves(), draw_->failures());
+  if (shader_compiler_) {
+    const MetalShaderCompiler::Stats& s = shader_compiler_->stats();
+    const uint32_t compiled = s.compiled.load();
+    REXGPU_INFO(
+        "Metal shaders: {} translated to SPIR-V ({} failed), {} refused by SPIRV-Cross, {} compiled by Metal "
+        "({} failed, {} pending); translation {:.2f} ms and Metal {:.1f} ms a shader on average",
+        s.translated.load(), s.translate_failed.load(), s.msl_failed.load(), compiled, s.compile_failed.load(),
+        s.pending.load(), s.translated ? s.translate_us.load() / 1000.0 / s.translated.load() : 0.0,
+        compiled ? s.compile_us.load() / 1000.0 / compiled : 0.0);
+  }
+  stats_swaps_ = 0;
+  stats_draws_ = 0;
+  stats_copies_ = 0;
+  stats_since_ms_ = now_ms;
+}
+
+}  // namespace rex::graphics::metal
diff --git a/src/graphics/metal/metal_counters4.h b/src/graphics/metal/metal_counters4.h
new file mode 100644
--- /dev/null
+++ b/src/graphics/metal/metal_counters4.h
@@ -0,0 +1,106 @@
+/** Per-phase GPU times through MTL4CounterHeap timestamps. BSD-3-Clause, see LICENSE. */
+#pragma once
+#import <Metal/Metal.h>
+
+#include <atomic>
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace rex::graphics::metal {
+
+// GPU time per phase of the frame on a Metal 4 queue (macOS 26). The caller names phases (the guest markers, for
+// MCLA) and stamps where one begins; the module owns a timestamp counter heap split into one range per frame in
+// flight, and once the GPU is done with a frame it resolves that frame's stamps on the CPU and adds each interval
+// to the phase that was current at its start.
+//
+// - A stamp's index is reserved here (Reserve) and written by the caller with whichever call fits where it is
+//   recording: -[MTL4RenderCommandEncoder writeTimestampWithGranularity:afterStage:intoHeap:atIndex:] in an open
+//   render pass, the compute encoder's in an open compute encoder, else -[MTL4CommandBuffer
+//   writeTimestampIntoHeap:atIndex:]. Write() does that for raw Metal objects.
+// - Each command buffer gets a kResume stamp when recording starts and a kSuspend stamp right before its commit:
+//   time with no command buffer of the frame open on the GPU (between a suspend and the next resume) is idle, and
+//   is reported apart, not added to a phase. The stamps are sorted by their GPU time before they are attributed,
+//   so command buffers recorded at once and committed out of order (MetalDraw's pre_commands_) still add up.
+// - A frame whose range is still in use by the GPU when it begins is not timed (counted in Report: skipped).
+// - Off (Init not called or failed): Reserve returns -1 after one branch; nothing else runs.
+//
+// Threads: everything but Completed on the command thread; Completed from a Metal completion handler.
+class API_AVAILABLE(macos(26.0)) MetalCounters4 {
+ public:
+  enum class Kind : uint8_t { kMark, kResume, kSuspend };
+  static constexpr int32_t kNone = -1;
+
+  MetalCounters4();
+  ~MetalCounters4();
+  // frames_in_flight ranges of stamps_per_frame stamps each. `relaxed`: MTL4TimestampGranularityRelaxed for the
+  // encoder stamps (may group a pass's stamps at its ends), else Precise (may split encoders).
+  bool Init(id<MTLDevice> device, uint32_t frames_in_flight, uint32_t stamps_per_frame, bool relaxed,
+            std::string& log);
+  bool enabled() const { return heap_ != nil; }
+  id<MTL4CounterHeap> heap() const { return heap_; }
+  MTL4TimestampGranularity granularity() const {
+    return relaxed_ ? MTL4TimestampGranularityRelaxed : MTL4TimestampGranularityPrecise;
+  }
+
+  // A phase by name (made the first time; ids are small and stable for the module's life). Names are the report's.
+  uint16_t Phase(const std::string& name);
+
+  // The frame's stamps from here on go to the next range. Resolves the frames the GPU is done with first.
+  void BeginFrame();
+  // The heap index to write a stamp to, or kNone (off, a frame not timed, the range full). `phase` is used for
+  // kMark only: the phase that begins at this stamp.
+  int32_t Reserve(Kind kind, uint16_t phase = 0) {
+    if (!heap_ || !frame_open_) return kNone;
+    return ReserveSlow(kind, phase);
+  }
+  // Writes a reserved stamp (nothing for kNone). Give the open encoder if there is one, else the command buffer.
+  void Write(int32_t index, id<MTL4CommandBuffer> cb);
+  void Write(int32_t index, id<MTL4RenderCommandEncoder> render);
+  void Write(int32_t index, id<MTL4ComputeCommandEncoder> compute);
+  // The open frame, for Completed (kNone: not timed). Call Completed(token) from the completion of a command buffer
+  // committed after every one that holds the frame's stamps (one queue completes in order: the frame's last).
+  // EndFrame: no more stamps for this frame. The frame is resolved once it has both, in either order.
+  int32_t Token() const;
+  void EndFrame();
+  void Completed(int32_t token);
+
+  struct Report {
+    uint32_t frames = 0, skipped = 0, overflowed = 0;
+    std::vector<std::pair<std::string, double>> phases;  // ms a frame, in the order phases were first seen
+    double idle_ms = 0, busy_ms = 0;                      // a frame: idle within the frame, and the rest
+  };
+  // The averages since the last call, then starts over. Resolves what is done first.
+  Report Take();
+  static std::string Format(const Report& report);
+
+ private:
+  int32_t ReserveSlow(Kind kind, uint16_t phase);
+  void ResolveDone();
+  void Resolve(uint32_t slot);
+
+  static constexpr uint32_t kRecording = 1, kEnded = 2, kDone = 4, kAbandoned = 8;
+  struct Stamp { Kind kind; uint16_t phase; };
+  struct Slot {
+    std::vector<Stamp> stamps;               // in reservation order; index i is heap entry base + i
+    std::atomic<uint32_t> state{0};  // 0 free, else kRecording plus kEnded, kDone, kAbandoned
+    bool overflowed = false;
+    uint64_t seq = 0;  // which frame (BeginFrame's count)
+  };
+  id<MTLDevice> device_ = nil;
+  id<MTL4CounterHeap> heap_ = nil;
+  bool relaxed_ = true;
+  uint32_t frames_ = 0, per_frame_ = 0, current_ = 0;
+  uint64_t seq_ = 0;
+  bool frame_open_ = false;
+  double ticks_to_ms_ = 0;
+  std::unique_ptr<Slot[]> slots_;
+  std::vector<std::string> names_;
+  // Totals since Take, ms, per phase id.
+  std::vector<double> total_ms_;
+  double idle_ms_ = 0, busy_ms_ = 0;
+  uint32_t frames_done_ = 0, skipped_ = 0, overflowed_ = 0;
+};
+
+}  // namespace rex::graphics::metal
diff --git a/src/graphics/metal/metal_counters4.mm b/src/graphics/metal/metal_counters4.mm
new file mode 100644
--- /dev/null
+++ b/src/graphics/metal/metal_counters4.mm
@@ -0,0 +1,218 @@
+/** Per-phase GPU times through MTL4CounterHeap timestamps. BSD-3-Clause, see LICENSE. */
+#include "metal_counters4.h"
+
+#include <algorithm>
+#include <cstdio>
+
+namespace rex::graphics::metal {
+
+MetalCounters4::MetalCounters4() = default;
+MetalCounters4::~MetalCounters4() = default;
+
+bool MetalCounters4::Init(id<MTLDevice> device, uint32_t frames_in_flight, uint32_t stamps_per_frame, bool relaxed,
+                          std::string& log) {
+  frames_ = std::max(2u, frames_in_flight);
+  per_frame_ = std::max(4u, stamps_per_frame);
+  relaxed_ = relaxed;
+  device_ = device;
+  if ([device sizeOfCounterHeapEntry:MTL4CounterHeapTypeTimestamp] != sizeof(MTL4TimestampHeapEntry)) {
+    log = "MTL4 counters: unexpected timestamp entry size";
+    return false;
+  }
+  const uint64_t frequency = [device queryTimestampFrequency];
+  if (!frequency) {
+    log = "MTL4 counters: no timestamp frequency";
+    return false;
+  }
+  ticks_to_ms_ = 1000.0 / double(frequency);
+  auto desc = [MTL4CounterHeapDescriptor new];
+  desc.type = MTL4CounterHeapTypeTimestamp;
+  desc.count = NSUInteger(frames_) * per_frame_;
+  NSError* error = nil;
+  id<MTL4CounterHeap> heap = [device newCounterHeapWithDescriptor:desc error:&error];
+  if (!heap) {
+    log = std::string("MTL4 counters: no counter heap: ") +
+          (error ? error.localizedDescription.UTF8String : "unknown error");
+    return false;
+  }
+  heap.label = @"phase timestamps";
+  slots_ = std::make_unique<Slot[]>(frames_);
+  for (uint32_t i = 0; i < frames_; ++i) slots_[i].stamps.reserve(per_frame_);
+  heap_ = heap;
+  current_ = frames_ - 1;
+  char text[160];
+  std::snprintf(text, sizeof(text), "MTL4 counters: %u frames x %u stamps, %llu ticks/s, %s", frames_, per_frame_,
+                (unsigned long long)frequency, relaxed_ ? "relaxed" : "precise");
+  log = text;
+  return true;
+}
+
+uint16_t MetalCounters4::Phase(const std::string& name) {
+  for (size_t i = 0; i < names_.size(); ++i) {
+    if (names_[i] == name) return uint16_t(i);
+  }
+  names_.push_back(name);
+  total_ms_.push_back(0.0);
+  return uint16_t(names_.size() - 1);
+}
+
+void MetalCounters4::BeginFrame() {
+  if (!heap_) return;
+  ResolveDone();
+  if (frame_open_) {
+    // No EndFrame for the last one (a frame cut short): its stamps may still be in flight. Abandoned, not timed;
+    // its range is free once a later frame completes (one queue: everything committed before has too).
+    frame_open_ = false;
+    slots_[current_].state.fetch_or(kAbandoned, std::memory_order_acq_rel);
+    ++skipped_;
+  }
+  const uint32_t next = (current_ + 1) % frames_;
+  Slot& slot = slots_[next];
+  if (slot.state.load(std::memory_order_acquire) != 0) {
+    ++skipped_;  // that range's frame is still on the GPU
+    return;
+  }
+  current_ = next;
+  slot.seq = ++seq_;
+  slot.stamps.clear();
+  slot.overflowed = false;
+  [heap_ invalidateCounterRange:NSMakeRange(NSUInteger(next) * per_frame_, per_frame_)];
+  slot.state.store(kRecording, std::memory_order_relaxed);
+  frame_open_ = true;
+}
+
+int32_t MetalCounters4::ReserveSlow(Kind kind, uint16_t phase) {
+  Slot& slot = slots_[current_];
+  // The last entry is kept for the frame's final suspend, so an overflowing frame still closes.
+  if (slot.stamps.size() + (kind == Kind::kSuspend ? 0 : 1) >= per_frame_) {
+    slot.overflowed = true;
+    return kNone;
+  }
+  slot.stamps.push_back({kind, phase});
+  return int32_t(current_ * per_frame_ + slot.stamps.size() - 1);
+}
+
+void MetalCounters4::Write(int32_t index, id<MTL4CommandBuffer> cb) {
+  if (index < 0) return;
+  [cb writeTimestampIntoHeap:heap_ atIndex:NSUInteger(index)];
+}
+
+void MetalCounters4::Write(int32_t index, id<MTL4RenderCommandEncoder> render) {
+  if (index < 0) return;
+  // After the fragments of the draws so far; before any draw it is written before the stage starts.
+  [render writeTimestampWithGranularity:granularity() afterStage:MTLRenderStageFragment intoHeap:heap_
+                                atIndex:NSUInteger(index)];
+}
+
+void MetalCounters4::Write(int32_t index, id<MTL4ComputeCommandEncoder> compute) {
+  if (index < 0) return;
+  [compute writeTimestampWithGranularity:granularity() intoHeap:heap_ atIndex:NSUInteger(index)];
+}
+
+int32_t MetalCounters4::Token() const {
+  return heap_ && frame_open_ ? int32_t(current_) : kNone;
+}
+
+void MetalCounters4::EndFrame() {
+  if (!heap_ || !frame_open_) return;
+  frame_open_ = false;
+  slots_[current_].state.fetch_or(kEnded, std::memory_order_acq_rel);
+}
+
+void MetalCounters4::Completed(int32_t token) {
+  if (token < 0 || uint32_t(token) >= frames_) return;
+  slots_[token].state.fetch_or(kDone, std::memory_order_acq_rel);
+}
+
+void MetalCounters4::ResolveDone() {
+  uint64_t newest_done = 0;
+  for (uint32_t i = 0; i < frames_; ++i) {
+    const uint32_t state = slots_[i].state.load(std::memory_order_acquire);
+    if ((state & (kEnded | kDone)) == (kEnded | kDone) && !(state & kAbandoned)) {
+      Resolve(i);
+      newest_done = std::max(newest_done, slots_[i].seq);
+      slots_[i].state.store(0, std::memory_order_release);
+    }
+  }
+  // An abandoned range's stamps were committed before those of any later frame that has completed.
+  for (uint32_t i = 0; i < frames_; ++i) {
+    const uint32_t state = slots_[i].state.load(std::memory_order_acquire);
+    if ((state & kAbandoned) && slots_[i].seq < newest_done) slots_[i].state.store(0, std::memory_order_release);
+  }
+}
+
+void MetalCounters4::Resolve(uint32_t i) {
+  Slot& slot = slots_[i];
+  const size_t count = slot.stamps.size();
+  NSData* data = [heap_ resolveCounterRange:NSMakeRange(NSUInteger(i) * per_frame_, count)];
+  if (!data || data.length < count * sizeof(MTL4TimestampHeapEntry)) {
+    ++skipped_;
+    return;
+  }
+  const auto* entries = static_cast<const MTL4TimestampHeapEntry*>(data.bytes);
+  struct Timed { uint64_t t; Stamp s; };
+  std::vector<Timed> timed;
+  timed.reserve(count);
+  for (size_t k = 0; k < count; ++k) {
+    // An entry the GPU never wrote (a command buffer that failed, a stamp skipped by Metal) resolves to 0.
+    if (entries[k].timestamp) timed.push_back({entries[k].timestamp, slot.stamps[k]});
+  }
+  if (timed.size() < 2) {
+    ++skipped_;
+    return;
+  }
+  // GPU order. Equal times keep reservation order (a resume and a mark written back to back).
+  std::stable_sort(timed.begin(), timed.end(), [](const Timed& a, const Timed& b) { return a.t < b.t; });
+  int open = 0;
+  int32_t phase = -1;  // none yet: time before the frame's first mark is the "(start)" phase
+  for (size_t k = 0; k + 1 < timed.size(); ++k) {
+    const Stamp& s = timed[k].s;
+    if (s.kind == Kind::kResume) ++open;
+    else if (s.kind == Kind::kSuspend) open = std::max(0, open - 1);
+    else phase = s.phase;
+    const double ms = double(timed[k + 1].t - timed[k].t) * ticks_to_ms_;
+    if (open <= 0) {
+      idle_ms_ += ms;
+      continue;
+    }
+    busy_ms_ += ms;
+    if (phase < 0) phase = Phase("(start)");
+    total_ms_[size_t(phase)] += ms;
+  }
+  ++frames_done_;
+  if (slot.overflowed) ++overflowed_;
+}
+
+MetalCounters4::Report MetalCounters4::Take() {
+  Report report;
+  if (!heap_) return report;
+  ResolveDone();
+  report.frames = frames_done_;
+  report.skipped = skipped_;
+  report.overflowed = overflowed_;
+  const double n = frames_done_ ? double(frames_done_) : 1.0;
+  for (size_t i = 0; i < names_.size(); ++i) {
+    if (total_ms_[i] > 0) report.phases.emplace_back(names_[i], total_ms_[i] / n);
+    total_ms_[i] = 0;
+  }
+  report.idle_ms = idle_ms_ / n;
+  report.busy_ms = busy_ms_ / n;
+  idle_ms_ = busy_ms_ = 0;
+  frames_done_ = skipped_ = overflowed_ = 0;
+  return report;
+}
+
+std::string MetalCounters4::Format(const Report& r) {
+  std::string text;
+  char part[128];
+  std::snprintf(part, sizeof(part), "GPU phases, %u frames (%u not timed%s): busy %.2f ms, idle %.2f ms;", r.frames,
+                r.skipped, r.overflowed ? ", some full" : "", r.busy_ms, r.idle_ms);
+  text += part;
+  for (auto& [name, ms] : r.phases) {
+    std::snprintf(part, sizeof(part), " %s %.2f", name.c_str(), ms);
+    text += part;
+  }
+  return text;
+}
+
+}  // namespace rex::graphics::metal
diff --git a/src/graphics/metal/metal_draw.h b/src/graphics/metal/metal_draw.h
new file mode 100644
