@@ -0,0 +1,79 @@
+/**
+ * @file        graphics/metal/metal_shaders.h
+ * @brief       Guest shaders to Metal libraries: MetalShaderTranslator's MSL through Metal's compiler
+ *
+ * Added by the mcla-recomp macOS fork (patches/rexglue-metal-backend.patch). Objective-C++ only.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#if !defined(__OBJC__)
+#error "metal_shaders.h is for the Objective-C++ sources of the Metal backend"
+#endif
+
+#import <Metal/Metal.h>
+
+#include <atomic>
+#include <cstdint>
+#include <mutex>
+#include <condition_variable>
+#include <string>
+#include <unordered_map>
+#include <functional>
+#include <vector>
+
+#include "metal_shader_translator.h"
+
+namespace rex::graphics::metal {
+
+class MetalShaderCompiler {
+ public:
+  struct Stats {
+    std::atomic<uint32_t> translated{0};        // guest microcode to SPIR-V to MSL
+    std::atomic<uint32_t> translate_failed{0};  // the SPIR-V translator failed
+    std::atomic<uint32_t> msl_failed{0};        // SPIRV-Cross refused the SPIR-V
+    std::atomic<uint32_t> compiled{0};          // Metal compiled the MSL
+    std::atomic<uint32_t> compile_failed{0};
+    std::atomic<uint32_t> pending{0};           // Metal compiles not finished yet
+    std::atomic<uint64_t> translate_us{0};      // microcode to MSL, summed
+    std::atomic<uint64_t> compile_us{0};        // Metal compile time, summed (on Metal's threads)
+  };
+
+  MetalShaderCompiler(id<MTLDevice> device, uint32_t edram_tile_count);
+  ~MetalShaderCompiler();
+  void Wait();
+
+  MetalShaderTranslator& translator() { return translator_; }
+
+  // Translates this modification of the shader once and starts its Metal compile. Command processor thread.
+  void Request(Shader& shader, uint64_t modification);
+  // Translates and compiles these shaders' modifications on worker threads (a shader's all on one), and
+  // returns once all are translated (Metal's compiles may still run). Only while no draws are issued.
+  void Warm(const std::vector<std::pair<Shader*, std::vector<uint64_t>>>& jobs);
+  // Called by Request for each new translation (the shader storage records it).
+  std::function<void(const Shader&, uint64_t)> on_new_translation;
+
+  // The compiled library of a translation, nil while compiling or after a failure. Any thread.
+  id<MTLLibrary> GetLibrary(const Shader::Translation* translation) const;
+
+  const Stats& stats() const { return stats_; }
+
+ private:
+  void Dump(const Shader& shader, uint64_t modification, const std::string& msl, const char* error) const;
+  void Compile(const Shader& shader, uint64_t modification, Shader::Translation* translation, const std::string& msl);
+  uint32_t edram_tile_count_;
+
+  id<MTLDevice> device_;
+  MetalShaderTranslator translator_;
+  MTLCompileOptions* compile_options_;
+  Stats stats_;
+
+  mutable std::mutex libraries_mutex_;
+  std::condition_variable libraries_ready_;
+  std::unordered_map<const Shader::Translation*, id<MTLLibrary>> libraries_;
+};
+
+}  // namespace rex::graphics::metal
