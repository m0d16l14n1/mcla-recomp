diff --git a/src/graphics/vulkan/pass_stats.h b/src/graphics/vulkan/pass_stats.h
new file mode 100644
index 0000000..c1d28c1
--- /dev/null
+++ b/src/graphics/vulkan/pass_stats.h
@@ -0,0 +1,88 @@
+/**
+ * @file        graphics/vulkan/pass_stats.h
+ * @brief       Counts of what begins and ends render passes (vulkan_pass_stats)
+ *
+ * Added by the mcla-recomp fork (patches/rexglue-vulkan-pass-stats.patch), for tile-based GPUs (Apple's,
+ * through MoltenVK), where every render pass ends with its attachments written out of tile memory and the
+ * next one reads them back: what costs a little on a desktop GPU costs a pass's worth of bandwidth there.
+ * Everything is counted on the command processor's thread; the line is logged once a second from IssueSwap.
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#pragma once
+
+#include <cstdint>
+
+namespace rex::graphics::vulkan {
+
+struct PassStats {
+  enum class Scope : uint8_t { kDraw, kTransfer };
+  Scope scope = Scope::kDraw;
+
+  uint64_t draws = 0;
+  uint64_t passes_for_draws = 0;      // a render pass begun to draw a guest draw into
+  uint64_t passes_for_transfers = 0;  // begun by the render target cache: EDRAM transfers, resolve clears
+  uint64_t ended_by_barrier = 0;      // a render pass ended because barriers had to go in
+  uint64_t barrier_buffers = 0;       // buffer memory barriers in those
+  uint64_t barrier_images = 0;        // image memory barriers in those
+  uint64_t transfer_targets = 0;      // render targets that had transfers to them
+  uint64_t resolves = 0;
+  uint64_t texture_loads = 0;         // texture load dispatches
+  uint64_t swaps = 0;
+
+  // Where the buffer barriers that ended render passes came from: a call site sets next_source before
+  // PushBufferMemoryBarrier, which adds it to the pending sources; SubmitBarriers counts them.
+  enum Source : uint32_t {
+    kSharedToRead,          // shared memory: back to read after uploads, memexport or resolve writes
+    kSharedToUpload,        // shared memory: CPU-written pages copied in
+    kSharedToComputeWrite,  // shared memory: resolves written by compute
+    kSharedToDrawWrite,     // shared memory: a draw that may memexport
+    kSharedCommit,          // shared memory: committing a write range with the same usage
+    kScratch,
+    kEdram,
+    kTextureScratch,
+    kOther,
+    kSourceCount,
+  };
+  static constexpr const char* kSourceNames[kSourceCount] = {
+      "shared->read", "shared->upload", "shared->compute write", "shared->draw write", "shared commit",
+      "scratch", "edram", "texture scratch", "other"};
+  Source next_source = kOther;
+  uint32_t pending_sources = 0;
+  uint64_t ended_by_source[kSourceCount] = {};
+
+  void NoteBufferBarrier() {
+    pending_sources |= 1u << next_source;
+    next_source = kOther;
+  }
+  void CountEndedBy() {
+    for (uint32_t i = 0; i < kSourceCount; ++i) {
+      if (pending_sources & (1u << i)) {
+        ++ended_by_source[i];
+      }
+    }
+  }
+
+  struct ScopedTransfer {
+    explicit ScopedTransfer(PassStats& s) : stats(s), previous(s.scope) { s.scope = Scope::kTransfer; }
+    ~ScopedTransfer() { stats.scope = previous; }
+    PassStats& stats;
+    Scope previous;
+  };
+
+  void CountPassBegin() {
+    if (scope == Scope::kTransfer) {
+      ++passes_for_transfers;
+    } else {
+      ++passes_for_draws;
+    }
+  }
+};
+
+PassStats& GetPassStats();
+// Logs and clears the counts when a second has passed since the last line (vulkan_pass_stats only).
+void MaybeLogPassStats();
+
+}  // namespace rex::graphics::vulkan
