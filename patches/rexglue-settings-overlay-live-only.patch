@@ -22,8 +22,38 @@
 #include <string>
 #include <vector>
 
+REXCVAR_DEFINE_BOOL(settings_overlay_live_only, true, "UI",
+                    "The settings overlay lists only the settings that take effect at once (those that need a "
+                    "restart are set in the launcher or mcla.toml); false lists all of them");
+REXCVAR_DEFINE_STRING(settings_overlay_hide, "", "UI",
+                      "Settings the overlay leaves out, comma-separated: a category (with the ones under it, "
+                      "\"GPU/D3D12\") or the start of a setting's name (\"low_latency\")");
+
 namespace rex::ui {
 
+namespace {
+// Shown in the overlay: settings that apply while the game runs (and the key bindings, which do).
+bool ShownInOverlay(const rex::cvar::FlagEntry& entry) {
+  if (entry.transient) return false;
+  const std::string hide = REXCVAR_GET(settings_overlay_hide);
+  for (size_t start = 0; start < hide.size();) {
+    size_t end = hide.find(',', start);
+    if (end == std::string::npos) end = hide.size();
+    std::string item = hide.substr(start, end - start);
+    start = end + 1;
+    while (!item.empty() && item.front() == ' ') item.erase(item.begin());
+    while (!item.empty() && item.back() == ' ') item.pop_back();
+    if (item.empty()) continue;
+    if (entry.category == item || entry.category.rfind(item + "/", 0) == 0 || entry.name.rfind(item, 0) == 0) {
+      return false;
+    }
+  }
+  if (!REXCVAR_GET(settings_overlay_live_only)) return true;
+  if (entry.category == "Input/Keybinds" || entry.category.rfind("Input/Keybinds/", 0) == 0) return true;
+  return entry.lifecycle == rex::cvar::Lifecycle::kHotReload;
+}
+}  // namespace
+
 SettingsDialog::SettingsDialog(ImGuiDrawer* imgui_drawer, std::filesystem::path config_path)
     : ImGuiDialog(imgui_drawer), config_path_(std::move(config_path)) {}
 
